@{
    ViewBag.Title = "Create Journal";
    Layout = "~/Views/Shared/_adminLedgerLayout.cshtml";
}

<div class="content">
    <!-- ── Page Header ───────────────────────────────────────────── -->
    <div class="mb-6 content-header">
        <div class="flex items-center gap-2 text-sm text-gray-500 mb-2">
            <span>GL - Journal</span>
            <i class="bi bi-chevron-right text-xs"></i>
            <span class="font-medium text-blue-600">Create Journal Entry</span>
        </div>
        <div class="flex flex-wrap items-start justify-between gap-4">
            <div>
                <h2 class="text-2xl font-semibold text-gray-800">Create Journal Entry</h2>
                <p class="text-sm text-gray-500 mt-0.5">Record debit and credit transactions for the general ledger.</p>
            </div>
        </div>
    </div>

    <div id="app">

        <!-- ── Shimmer ────────────────────────────────────────────── -->
        <div v-if="isShimmerLoading" class="card flex items-center justify-center py-20 text-gray-400 gap-3">
            <span class="spinner-border" role="status" style="width:22px;height:22px"></span>
            <span class="text-sm">Initialising journal…</span>
        </div>

        <template v-else>

            <!-- ── Header Card ─────────────────────────────────────── -->
            <div class="card mb-4 p-5">
                <div class="flex flex-col sm:flex-row flex-wrap lg:flex-nowrap items-end gap-4">

                    <!-- Batch No -->
                    <div class="gl-field w-full sm:w-36 lg:w-40 flex-shrink-0">
                        <label for="batchNumber">Batch No#</label>
                        <input id="batchNumber" v-model="batchNumber" type="text"
                               class="gl-input" placeholder="e.g. JNL-0001" />
                    </div>

                    <!-- Batch Date -->
                    <div class="gl-field w-full sm:w-40 lg:w-44 flex-shrink-0">
                        <label for="batchDate">
                            Batch Date <span class="text-red-500">*</span>
                        </label>
                        <input id="batchDate" v-model="batchDate" type="date"
                               class="gl-input" :class="{ 'border-red-400': errors.batchDate }" />
                        <p v-if="errors.batchDate" class="mt-1 text-xs text-red-500">{{ errors.batchDate }}</p>
                    </div>

                    <!-- OU (Cost Center) - Expanded width -->
                    <div class="gl-field w-full sm:flex-1 sm:min-w-[260px]">
                        <label for="ouId">OU (Cost Center)</label>
                        <select id="ouId" v-model="ouId" class="gl-input" @@change="onHeaderOuChange">
                            <option value="">— Select OU —</option>
                            <option v-for="cc in costCenterHierarchyList" :key="cc.id" :value="cc.id">
                                {{ cc.name }}
                            </option>
                        </select>
                    </div>

                    <!-- Multi-Currency Checkbox -->
                    <div class="flex items-center h-[38px] px-2 flex-shrink-0">
                        <label class="inline-flex items-center gap-2 cursor-pointer select-none text-xs font-semibold text-gray-700 hover:text-gray-900 m-0">
                            <input type="checkbox"
                                   id="isMultiCurrency"
                                   v-model="isMultiCurrency"
                                   class="h-4 w-4 rounded border-gray-300 accent-blue-600 cursor-pointer focus:ring-0" />
                            <span class="whitespace-nowrap">Multi-Currency</span>
                        </label>
                    </div>

                    <!-- Save Button (compact width) -->
                    <div class="w-full sm:w-auto flex-shrink-0">
                        <button type="button"
                                :disabled="isLoading"
                                @@click="saveJournal()"
                                class="w-full sm:w-auto inline-flex items-center justify-center gap-2 rounded-lg bg-blue-600 px-4 py-2 text-sm font-semibold text-white shadow-sm hover:bg-blue-700 transition disabled:cursor-not-allowed disabled:opacity-60 whitespace-nowrap h-[38px]">
                            <i class="bi bi-floppy"></i>
                            <span>Save Journal</span>
                            <span v-if="isLoading" class="spinner-border" role="status" aria-hidden="true" style="width:14px;height:14px"></span>
                        </button>
                    </div>
                </div>
            </div>

            <!-- ── Balance Summary Bar ─────────────────────────────── -->
            <div class="balance-bar mb-3" :class="isBalanced ? 'balanced' : 'unbalanced'">
                <div class="balance-item">
                    <span class="balance-label">Total Debit</span>
                    <span class="balance-value">{{ formatCurrency(totalDebit) }}</span>
                </div>
                <div class="balance-divider"></div>
                <div class="balance-item">
                    <span class="balance-label">Total Credit</span>
                    <span class="balance-value">{{ formatCurrency(totalCredit) }}</span>
                </div>
                <div class="balance-divider"></div>
                <div class="balance-item">
                    <span class="balance-label">Difference</span>
                    <span class="balance-value" :class="isBalanced ? 'text-green-600' : 'text-red-500'">
                        {{ formatCurrency(Math.abs(totalDebit - totalCredit)) }}
                    </span>
                </div>
                <div class="balance-status">
                    <span v-if="isBalanced" class="badge-balanced">
                        <i class="bi bi-check-circle-fill"></i> Balanced
                    </span>
                    <span v-else class="badge-unbalanced">
                        <i class="bi bi-exclamation-triangle-fill"></i> Not Balanced
                    </span>
                </div>
            </div>

            <!-- ── Lines Card ──────────────────────────────────────── -->
            <div class="card">
                <!-- Toolbar -->
                <div class="flex items-center gap-2 px-4 py-3 border-b border-gray-100">
                    <button type="button" @@click="addLine"
                            class="inline-flex items-center gap-1.5 rounded-lg bg-blue-50 text-blue-700 border border-blue-200 px-3 py-1.5 text-xs font-semibold hover:bg-blue-100 transition">
                        <i class="bi bi-plus-lg"></i> Add Row
                    </button>
                    <button type="button" v-if="journalEntryList.length > 2" @@click="removeLastLine"
                            class="inline-flex items-center gap-1.5 rounded-lg bg-red-50 text-red-600 border border-red-200 px-3 py-1.5 text-xs font-semibold hover:bg-red-100 transition">
                        <i class="bi bi-dash-lg"></i> Remove Last
                    </button>
                    <span class="ml-auto text-xs text-gray-400">
                        <i class="bi bi-arrow-left-right me-1"></i>Scroll right to see more columns
                    </span>
                </div>

                <!-- Table -->
                <div style="overflow-x:auto">
                    <table class="journal-table">
                        <colgroup>
                            <col style="width:130px">  <!-- Ref No -->
                            <col style="width:260px">  <!-- GL Account -->
                            <col style="width:220px">  <!-- OU / Dept -->
                            <col v-if="isMultiCurrency" style="width:200px"> <!-- Currency -->
                            <col v-if="isMultiCurrency" style="width:110px"> <!-- Rate -->
                            <col style="width:220px">  <!-- Description -->
                            <col style="width:140px">  <!-- Local Debit -->
                            <col style="width:140px">  <!-- Local Credit -->
                            <col v-if="isMultiCurrency" style="width:130px"> <!-- Fgn Debit -->
                            <col v-if="isMultiCurrency" style="width:130px"> <!-- Fgn Credit -->
                            <col style="width:160px">  <!-- Recipient -->
                            <col style="width:130px">  <!-- Cheque No -->
                            <col style="width:60px">   <!-- Action -->
                        </colgroup>

                        <thead>
                            <tr>
                                <th>Ref No.</th>
                                <th>G/L Account</th>
                                <th>Dept. (OU)</th>
                                <th v-if="isMultiCurrency">Currency</th>
                                <th v-if="isMultiCurrency">Rate</th>
                                <th>Description</th>
                                <th>{{ isMultiCurrency ? 'Local Debit' : 'Debit' }}</th>
                                <th>{{ isMultiCurrency ? 'Local Credit' : 'Credit' }}</th>
                                <th v-if="isMultiCurrency">Fgn. Debit</th>
                                <th v-if="isMultiCurrency">Fgn. Credit</th>
                                <th>Recipient</th>
                                <th>Cheque No.</th>
                                <th></th>
                            </tr>
                        </thead>

                        <tbody>
                            <tr v-for="(line, index) in journalEntryList" :key="index"
                                :class="{ 'row-error': lineHasError(index) }">

                                <!-- Ref No -->
                                <td>
                                    <input type="text" class="jl-input" v-model="line.referenceNumber" />
                                </td>

                                <!-- GL Account -->
                                <td>
                                    <select class="jl-input" v-model="line.accountId"
                                            @@change="onAccountChange(line.accountId, index)">
                                        <option value="">Select Account</option>
                                        <option v-for="a in accountsList" :key="a.id" :value="a.id">
                                            {{ a.accountNo }} – {{ a.accountName }}
                                        </option>
                                    </select>
                                </td>

                                <!-- OU -->
                                <td>
                                    <select class="jl-input" v-model="line.ouId">
                                        <option value="">Select OU</option>
                                        <option v-for="cc in costCenterHierarchyList" :key="cc.id" :value="cc.id">
                                            {{ cc.name }}
                                        </option>
                                    </select>
                                </td>

                                <!-- Currency (MC only) -->
                                <td v-if="isMultiCurrency">
                                    <select class="jl-input" v-model="line.currencyId" disabled>
                                        <option value="">—</option>
                                        <option v-for="c in currencyRateList" :key="c.id" :value="c.id">
                                            {{ c.currencyCode }} – {{ c.currencyName }}
                                        </option>
                                    </select>
                                </td>

                                <!-- Rate (MC only) -->
                                <td v-if="isMultiCurrency">
                                    <input type="number" class="jl-input text-right" v-model="line.buyRate" disabled />
                                </td>

                                <!-- Description -->
                                <td>
                                    <input type="text" class="jl-input" v-model="line.description" />
                                </td>

                                <!-- Local Debit -->
                                <td>
                                    <input type="number" class="jl-input text-right"
                                           v-model.number="line.localDebit"
                                           :disabled="isMultiCurrency && !isLocalFieldEnabled(index)"
                                           min="0" step="0.01" />
                                </td>

                                <!-- Local Credit -->
                                <td>
                                    <input type="number" class="jl-input text-right"
                                           v-model.number="line.localCredit"
                                           :disabled="isMultiCurrency && !isLocalFieldEnabled(index)"
                                           min="0" step="0.01" />
                                </td>

                                <!-- Foreign Debit (MC only) -->
                                <td v-if="isMultiCurrency">
                                    <input type="number" class="jl-input text-right"
                                           v-model.number="line.foreignDebit"
                                           :disabled="!isForeignFieldEnabled(index)"
                                           min="0" step="0.01" />
                                </td>

                                <!-- Foreign Credit (MC only) -->
                                <td v-if="isMultiCurrency">
                                    <input type="number" class="jl-input text-right"
                                           v-model.number="line.foreignCredit"
                                           :disabled="!isForeignFieldEnabled(index)"
                                           min="0" step="0.01" />
                                </td>

                                <!-- Recipient -->
                                <td>
                                    <input type="text" class="jl-input" v-model="line.recipient" />
                                </td>

                                <!-- Cheque No -->
                                <td>
                                    <input type="text" class="jl-input" v-model="line.chequeNo" />
                                </td>

                                <!-- Action -->
                                <td class="text-center">
                                    <button type="button" v-if="index >= 2" @@click="removeLine(index)"
                                            class="row-del-btn" title="Delete row">
                                        <i class="bi bi-trash3"></i>
                                    </button>
                                    <span v-else class="text-slate-300 inline-flex items-center justify-center w-7 h-7" title="Default rows cannot be deleted">
                                        <i class="bi bi-lock-fill text-xs"></i>
                                    </span>
                                </td>
                            </tr>
                        </tbody>

                        <tfoot>
                            <tr class="totals-row">
                                <td :colspan="isMultiCurrency ? 6 : 4">TOTAL</td>
                                <td class="text-right font-semibold">{{ formatCurrency(totalDebit) }}</td>
                                <td class="text-right font-semibold">{{ formatCurrency(totalCredit) }}</td>
                                <td v-if="isMultiCurrency" class="text-right font-semibold">{{ formatCurrency(totalForeignDebit) }}</td>
                                <td v-if="isMultiCurrency" class="text-right font-semibold">{{ formatCurrency(totalForeignCredit) }}</td>
                                <td colspan="3"></td>
                            </tr>
                        </tfoot>
                    </table>
                </div>
            </div>

        </template>
    </div>
</div>

<style>
    /* ── Field helpers ── */
    .gl-field label { display:block; font-size:.75rem; font-weight:500; color:#6b7280; margin-bottom:.375rem; }
    .gl-input {
        width:100%; border-radius:.5rem; border:1px solid #d1d5db;
        padding:.5rem .75rem; font-size:.8125rem; color:#111827; background:#fff;
        outline:none; transition:border-color .15s,box-shadow .15s;
    }
    .gl-input:focus { border-color:#3b82f6; box-shadow:0 0 0 3px rgba(59,130,246,.15); }
    .gl-input.border-red-400 { border-color:#f87171; }

    /* ── Balance Bar ── */
    .balance-bar {
        display:flex; align-items:center; gap:.75rem; flex-wrap:wrap;
        padding:.75rem 1.25rem; border-radius:.75rem; border:1px solid;
        font-size:.8125rem;
    }
    .balance-bar.balanced { background:#f0fdf4; border-color:#bbf7d0; }
    .balance-bar.unbalanced { background:#fff7ed; border-color:#fed7aa; }
    .balance-item { display:flex; flex-direction:column; gap:.125rem; }
    .balance-label { font-size:.7rem; color:#6b7280; font-weight:500; text-transform:uppercase; letter-spacing:.04em; }
    .balance-value { font-size:.9rem; font-weight:700; color:#111827; }
    .balance-divider { width:1px; height:2rem; background:#e5e7eb; }
    .balance-status { margin-left:auto; }
    .badge-balanced { display:inline-flex; align-items:center; gap:.4rem; color:#16a34a; font-size:.8rem; font-weight:600; }
    .badge-unbalanced { display:inline-flex; align-items:center; gap:.4rem; color:#ea580c; font-size:.8rem; font-weight:600; }

    /* ── Journal Table ── */
    .journal-table {
        width:100%; border-collapse:collapse; font-size:.8rem;
        min-width:900px; table-layout:fixed;
    }
    .journal-table thead tr { background:#f9fafb; }
    .journal-table th {
        padding:.6rem .75rem; font-size:.7rem; font-weight:600;
        color:#6b7280; text-align:left; border-bottom:1px solid #e5e7eb;
        white-space:nowrap;
    }
    .journal-table td { padding:.35rem .4rem; border-bottom:1px solid #f3f4f6; vertical-align:middle; }
    .journal-table tbody tr:hover { background:#fafafa; }
    .journal-table tr.row-error { background:#fff5f5; }
    .journal-table tfoot tr.totals-row { background:#f9fafb; font-size:.8rem; }
    .journal-table tfoot td { padding:.5rem .75rem; border-top:2px solid #e5e7eb; }

    .jl-input {
        width:100%; border-radius:.375rem; border:1px solid #e5e7eb;
        padding:.3rem .5rem; font-size:.8rem; color:#111827;
        background:#fff; outline:none; transition:border-color .12s;
    }
    .jl-input:focus { border-color:#3b82f6; box-shadow:0 0 0 2px rgba(59,130,246,.12); }
    .jl-input:disabled { background:#f9fafb; color:#9ca3af; cursor:not-allowed; }
    .jl-input.text-right { text-align:right; }

    .row-del-btn {
        display:inline-flex; align-items:center; justify-content:center;
        width:28px; height:28px; border-radius:.375rem;
        border:1px solid #cae4fe; background:#fff5f5; color:#dc2626;
        cursor:pointer; transition:background .15s;
    }
    .row-del-btn:hover { background: #c3ddf8; }
</style>

<script src="~/js/gl/create-journal.js" asp-append-version="true"></script>