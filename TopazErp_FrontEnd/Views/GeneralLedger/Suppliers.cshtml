@{
    ViewBag.Title = "Suppliers";
    Layout = "~/Views/Shared/_adminLedgerLayout.cshtml";
}

<div class="content" id="app">
    <!-- Page Header & Breadcrumbs -->
    <div class="mb-6 content-header">
        <div class="flex items-center gap-2 text-sm text-gray-500 mb-2">
            <span>GL - Master Data</span>
            <i class="bi bi-chevron-right text-xs"></i>
            <span class="text-blue-600 font-medium">Suppliers</span>
        </div>

        <div class="flex flex-wrap items-center justify-between gap-4">
            <div class="page-title">
                <h2 class="text-2xl font-bold tracking-tight text-gray-900 dark:text-white">
                    Suppliers
                </h2>
                <p class="mt-1 text-sm text-gray-500 dark:text-gray-400">
                    Manage vendor accounts, payables ledger mapping, financial terms and contact details.
                </p>
            </div>

            <div class="flex items-center gap-2.5">
                <button type="button"
                        @@click="getSuppliers"
                        :disabled="isShimmerLoading"
                        title="Reload directory"
                        class="inline-flex items-center gap-2 rounded-lg border border-gray-200 bg-white px-3.5 py-2.5 text-sm font-semibold text-gray-700 shadow-sm hover:bg-gray-50 transition disabled:opacity-50 dark:border-slate-700 dark:bg-slate-800 dark:text-gray-200">
                    <i class="bi bi-arrow-clockwise" :class="{ 'animate-spin': isShimmerLoading }"></i>
                    <span class="hidden sm:inline">Refresh</span>
                </button>

                <a href="/GeneralLedger/CreateSupplier"
                   class="inline-flex items-center gap-2 rounded-lg bg-blue-600 px-4 py-2.5 text-sm font-semibold text-white shadow-sm hover:bg-blue-700 transition">
                    <i class="bi bi-plus-lg"></i>
                    <span>Add Supplier</span>
                </a>
            </div>
        </div>
    </div>

    <!-- KPI Metric Summary Cards -->
    <div class="mb-6 grid grid-cols-1 gap-4 sm:grid-cols-2 lg:grid-cols-4">
        <div class="card flex items-center gap-4 p-5">
            <div class="flex h-12 w-12 shrink-0 items-center justify-center rounded-xl bg-blue-50 text-blue-600 dark:bg-blue-900/30 dark:text-blue-400">
                <i class="bi bi-truck text-2xl"></i>
            </div>
            <div>
                <p class="text-xs font-medium uppercase tracking-wider text-gray-500 dark:text-gray-400">Total Suppliers</p>
                <h3 class="text-2xl font-bold text-gray-900 dark:text-white">{{ totalSuppliers }}</h3>
            </div>
        </div>

        <div class="card flex items-center gap-4 p-5">
            <div class="flex h-12 w-12 shrink-0 items-center justify-center rounded-xl bg-emerald-50 text-emerald-600 dark:bg-emerald-900/30 dark:text-emerald-400">
                <i class="bi bi-check-circle-fill text-2xl"></i>
            </div>
            <div>
                <p class="text-xs font-medium uppercase tracking-wider text-gray-500 dark:text-gray-400">Active Accounts</p>
                <h3 class="text-2xl font-bold text-emerald-600 dark:text-emerald-400">{{ activeSuppliersCount }}</h3>
            </div>
        </div>

        <div class="card flex items-center gap-4 p-5">
            <div class="flex h-12 w-12 shrink-0 items-center justify-center rounded-xl bg-amber-50 text-amber-600 dark:bg-amber-900/30 dark:text-amber-400">
                <i class="bi bi-cash-stack text-2xl"></i>
            </div>
            <div>
                <p class="text-xs font-medium uppercase tracking-wider text-gray-500 dark:text-gray-400">Payable Balance</p>
                <h3 class="text-xl font-bold font-mono text-gray-900 dark:text-white">{{ totalPayableBalance }}</h3>
            </div>
        </div>

        <div class="card flex items-center gap-4 p-5">
            <div class="flex h-12 w-12 shrink-0 items-center justify-center rounded-xl bg-indigo-50 text-indigo-600 dark:bg-indigo-900/30 dark:text-indigo-400">
                <i class="bi bi-diagram-3-fill text-2xl"></i>
            </div>
            <div>
                <p class="text-xs font-medium uppercase tracking-wider text-gray-500 dark:text-gray-400">Supplier Groups</p>
                <h3 class="text-2xl font-bold text-gray-900 dark:text-white">{{ supplierGroupsCount }}</h3>
            </div>
        </div>
    </div>

    <!-- Supplier Directory DataGrid -->
    <div class="card" data-card-title="Supplier Directory">
        <data-grid
            title="Supplier Directory"
            :columns="supplierColumns"
            :data="supplierList"
            :theme="theme"
            row-id="id"
            label-key="name"
            item-label="supplier"
            item-label-plural="suppliers"
            add-label="Add Supplier"
            :page-size="10"
            :selectable="true"
            :actions="true"
            :aggregates="false"
            :show-row-numbers="false"
            :loading="isShimmerLoading"
            @@open-form="onGridOpenForm"
            @@delete="onGridDelete">
        </data-grid>
    </div>
</div>

<script src="~/js/gl/suppliers.js" asp-append-version="true"></script>
