@{
    ViewBag.Title = "Petty Cash Transactions";
    Layout = "~/Views/Shared/_adminLedgerLayout.cshtml";
}

<div class="content" id="app">
    <!-- ── Page Header & Breadcrumbs ────────────────────────────────────── -->
    <div class="mb-6 content-header">
        <div class="flex items-center gap-2 text-sm text-gray-500 mb-2">
            <span>GL - Petty Cash</span>
            <i class="bi bi-chevron-right text-xs"></i>
            <span class="text-blue-600 font-medium">Petty Cash Transactions</span>
        </div>

        <div class="flex flex-wrap items-center justify-between gap-4">
            <div class="page-title">
                <h2 class="text-2xl font-bold tracking-tight text-gray-900 dark:text-white">
                    Petty Cash Transactions
                </h2>
                <p class="mt-1 text-sm text-gray-500 dark:text-gray-400">
                    Review petty cash disbursement batches, line totals and posting status.
                </p>
            </div>

            <div class="flex items-center gap-2.5">
                <a href="/GeneralLedger/CreatePettyCash"
                   class="inline-flex items-center gap-2 rounded-lg bg-blue-600 px-4 py-2.5 text-sm font-semibold text-white shadow-sm hover:bg-blue-700 transition">
                    <i class="bi bi-plus-lg"></i>
                    <span>New Petty Cash Entry</span>
                </a>
            </div>
        </div>
    </div>

    <!-- ═══════════════════════════════════════════════════════════════════ -->
    <!-- PETTY CASH BATCHES LISTING                                          -->
    <!-- ═══════════════════════════════════════════════════════════════════ -->
    <div>
        <!-- KPI Summary Cards -->
        <div class="mb-6 grid grid-cols-1 gap-4 sm:grid-cols-2 lg:grid-cols-4">
            <div class="card flex items-center gap-4 p-5">
                <div class="flex h-12 w-12 shrink-0 items-center justify-center rounded-xl bg-blue-50 text-blue-600 dark:bg-blue-900/30 dark:text-blue-400">
                    <i class="bi bi-wallet2 text-2xl"></i>
                </div>
                <div>
                    <p class="text-xs font-medium uppercase tracking-wider text-gray-500 dark:text-gray-400">Total Batches</p>
                    <h3 class="text-2xl font-bold text-gray-900 dark:text-white">{{ totalBatches }}</h3>
                </div>
            </div>

            <div class="card flex items-center gap-4 p-5">
                <div class="flex h-12 w-12 shrink-0 items-center justify-center rounded-xl bg-emerald-50 text-emerald-600 dark:bg-emerald-900/30 dark:text-emerald-400">
                    <i class="bi bi-cash-stack text-2xl"></i>
                </div>
                <div>
                    <p class="text-xs font-medium uppercase tracking-wider text-gray-500 dark:text-gray-400">Total Disbursed</p>
                    <h3 class="text-xl font-bold font-mono text-emerald-600 dark:text-emerald-400">{{ totalDisbursementsFormatted }}</h3>
                </div>
            </div>

            <div class="card flex items-center gap-4 p-5">
                <div class="flex h-12 w-12 shrink-0 items-center justify-center rounded-xl bg-indigo-50 text-indigo-600 dark:bg-indigo-900/30 dark:text-indigo-400">
                    <i class="bi bi-receipt text-2xl"></i>
                </div>
                <div>
                    <p class="text-xs font-medium uppercase tracking-wider text-gray-500 dark:text-gray-400">Expense Lines</p>
                    <h3 class="text-2xl font-bold text-gray-900 dark:text-white">{{ totalLineItems }}</h3>
                </div>
            </div>

            <div class="card flex items-center gap-4 p-5">
                <div class="flex h-12 w-12 shrink-0 items-center justify-center rounded-xl bg-amber-50 text-amber-600 dark:bg-amber-900/30 dark:text-amber-400">
                    <i class="bi bi-people-fill text-2xl"></i>
                </div>
                <div>
                    <p class="text-xs font-medium uppercase tracking-wider text-gray-500 dark:text-gray-400">Recipients Count</p>
                    <h3 class="text-2xl font-bold text-gray-900 dark:text-white">{{ recipientsCount }}</h3>
                </div>
            </div>
        </div>

        <!-- Filter Bar -->
        <div class="card mb-6 p-4">
            <div class="flex flex-col sm:flex-row flex-wrap items-end gap-3.5">
                <div class="gl-field w-full sm:w-44">
                    <label class="text-xs font-semibold text-gray-600 dark:text-gray-300">From Date</label>
                    <input type="date" v-model="filterParams.startDate" class="gl-input" />
                </div>

                <div class="gl-field w-full sm:w-44">
                    <label class="text-xs font-semibold text-gray-600 dark:text-gray-300">To Date</label>
                    <input type="date" v-model="filterParams.endDate" class="gl-input" />
                </div>

                <div class="gl-field flex-1 min-w-[200px]">
                    <label class="text-xs font-semibold text-gray-600 dark:text-gray-300">Petty Cash G/L Account</label>
                    <select v-model="filterParams.accountId" class="gl-select">
                        <option value="">All Petty Cash Accounts</option>
                        <option v-for="acc in pettyCashAccounts" :key="acc.id" :value="acc.id">
                            {{ acc.accountIdentifier }}
                        </option>
                    </select>
                </div>

                <div class="flex gap-2 items-end">
                    <button type="button"
                            @@click="getPettyCashList()"
                            :disabled="isShimmerLoading"
                            class="inline-flex items-center gap-2 rounded-lg bg-blue-600 px-4 py-2 text-sm font-semibold text-white shadow-sm hover:bg-blue-700 transition disabled:opacity-60 h-[38px]">
                        <i class="bi bi-funnel"></i>
                        <span>Filter</span>
                    </button>
                    <button type="button"
                            @@click="resetFilterParams()"
                            class="inline-flex items-center gap-2 rounded-lg border border-gray-200 bg-white px-3 py-2 text-sm font-medium text-gray-600 hover:bg-gray-50 transition h-[38px] dark:border-slate-700 dark:bg-slate-800 dark:text-gray-300">
                        <i class="bi bi-arrow-counterclockwise"></i>
                        <span>Reset</span>
                    </button>
                </div>
            </div>
        </div>

        <!-- Petty Cash Batches DataGrid -->
        <div class="card" data-card-title="Petty Cash Batches">
            <data-grid
                title="Petty Cash Directory"
                :columns="pettyCashColumns"
                :data="filteredPettyCashList"
                :theme="theme"
                row-id="id"
                label-key="batchNo"
                item-label="transaction"
                item-label-plural="transactions"
                :allow-add="false"
                :allow-edit="true"
                :page-size="10"
                :selectable="true"
                :actions="true"
                :aggregates="false"
                :show-row-numbers="false"
                :loading="isShimmerLoading"
                @@open-form="onGridOpenForm"
                @@delete="onGridDelete">
            </data-grid>
        </div>
    </div>
</div>

<style>
    .gl-field { display: flex; flex-direction: column; }
    .gl-field label { font-size: .75rem; font-weight: 600; color: #4b5563; margin-bottom: .35rem; }
    .gl-input, .gl-select {
        width: 100%; border-radius: .5rem; border: 1px solid #d1d5db;
        padding: .5rem .75rem; font-size: .8125rem; color: #111827;
        background: #fff; outline: none; transition: border-color .15s, box-shadow .15s;
    }
    .gl-input:focus, .gl-select:focus { border-color: #3b82f6; box-shadow: 0 0 0 3px rgba(59, 130, 246, .12); }
</style>

<script src="~/js/gl/petty-cash.js" asp-append-version="true"></script>
