@{
    ViewBag.Title = "Bank Accounts";
    Layout = "~/Views/Shared/_adminLedgerLayout.cshtml";
}

<div class="content">
    <div class="mb-6 content-header">
        <div class="flex items-center gap-2 text-sm text-gray-500 mb-2">
            <span>GL - Account Setup</span>
            <i class="bi bi-chevron-right text-xs"></i>
            <span class="text-blue-600 font-medium">Bank Accounts</span>
        </div>

        <div class="flex items-center gap-3">
            <div class="page-title">
                <h2 class="text-2xl font-semibold text-gray-800">
                    Bank Accounts
                </h2>
            </div>
        </div>
    </div>

    <div class="card" data-card-title="Bank Accounts">
        <div id="app">
            <data-grid
                title="Bank Accounts"
                :columns="bankAccountColumns"
                :data="bankAccountList"
                :theme="theme"
                row-id="id"
                label-key="accountName"
                item-label="Bank Account"
                item-label-plural="Bank Accounts"
                add-label="Add"
                :page-size="10"
                :selectable="true"
                :actions="true"
                :aggregates="false"
                :show-row-numbers="false"
                :loading="isShimmerLoading"
                @@create="onCreate"
                @@update="onUpdate"
                @@delete="onDelete"
            ></data-grid>
        </div>
    </div>
</div>

<script src="~/js/gl/bank-accounts.js" asp-append-version="true"></script>
