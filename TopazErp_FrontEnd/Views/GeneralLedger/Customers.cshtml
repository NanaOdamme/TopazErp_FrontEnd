@{
    ViewBag.Title = "Customers";
    Layout = "~/Views/Shared/_adminLedgerLayout.cshtml";
}

<div class="content" id="app">
    <!-- Page Header & Breadcrumbs -->
    <div class="mb-6 content-header">
        <div class="flex items-center gap-2 text-sm text-gray-500 mb-2">
            <span>GL - Master Data</span>
            <i class="bi bi-chevron-right text-xs"></i>
            <span class="text-blue-600 font-medium">Customers</span>
        </div>

        <div class="flex flex-wrap items-center justify-between gap-4">
            <div class="page-title">
                <h2 class="text-2xl font-bold tracking-tight text-gray-900 dark:text-white">
                    Customers
                </h2>
                <p class="mt-1 text-sm text-gray-500 dark:text-gray-400">
                    Manage customer accounts, financial limits, receivables ledger mapping and contact information.
                </p>
            </div>

            <div class="flex items-center gap-2.5">
                <button type="button"
                        @@click="switchTab('list')"
                        :class="activeTab === 'list'
                            ? 'bg-blue-600 text-white shadow-sm ring-1 ring-blue-600'
                            : 'bg-white text-gray-700 hover:bg-gray-50 border border-gray-200 dark:bg-slate-800 dark:text-gray-200 dark:border-slate-700'"
                        class="inline-flex items-center gap-2 rounded-lg px-4 py-2.5 text-sm font-semibold transition">
                    <i class="bi bi-people-fill text-base"></i>
                    <span>Customer Directory</span>
                    <span v-if="customerList.length"
                          :class="activeTab === 'list' ? 'bg-blue-700 text-white' : 'bg-gray-100 text-gray-700 dark:bg-slate-700 dark:text-gray-300'"
                          class="ml-1 rounded-full px-2 py-0.5 text-xs font-bold">
                        {{ customerList.length }}
                    </span>
                </button>

                <button type="button"
                        @@click="newCustomer"
                        :class="activeTab === 'form'
                            ? 'bg-blue-600 text-white shadow-sm ring-1 ring-blue-600'
                            : 'bg-white text-gray-700 hover:bg-gray-50 border border-gray-200 dark:bg-slate-800 dark:text-gray-200 dark:border-slate-700'"
                        class="inline-flex items-center gap-2 rounded-lg px-4 py-2.5 text-sm font-semibold transition">
                    <i :class="isEditing ? 'bi bi-pencil-square' : 'bi bi-person-plus-fill'" class="text-base"></i>
                    <span>{{ isEditing ? 'Edit Customer' : 'Add Customer' }}</span>
                </button>
            </div>
        </div>
    </div>

    <!-- KPI Metric Summary Cards (visible in Directory tab) -->
    <div v-show="activeTab === 'list'" class="mb-6 grid grid-cols-1 gap-4 sm:grid-cols-2 lg:grid-cols-4">
        <div class="card flex items-center gap-4 p-5">
            <div class="flex h-12 w-12 shrink-0 items-center justify-center rounded-xl bg-blue-50 text-blue-600 dark:bg-blue-900/30 dark:text-blue-400">
                <i class="bi bi-people-fill text-2xl"></i>
            </div>
            <div>
                <p class="text-xs font-medium uppercase tracking-wider text-gray-500 dark:text-gray-400">Total Customers</p>
                <h3 class="text-2xl font-bold text-gray-900 dark:text-white">{{ totalCustomers }}</h3>
            </div>
        </div>

        <div class="card flex items-center gap-4 p-5">
            <div class="flex h-12 w-12 shrink-0 items-center justify-center rounded-xl bg-emerald-50 text-emerald-600 dark:bg-emerald-900/30 dark:text-emerald-400">
                <i class="bi bi-check-circle-fill text-2xl"></i>
            </div>
            <div>
                <p class="text-xs font-medium uppercase tracking-wider text-gray-500 dark:text-gray-400">Active Accounts</p>
                <h3 class="text-2xl font-bold text-emerald-600 dark:text-emerald-400">{{ activeCustomersCount }}</h3>
            </div>
        </div>

        <div class="card flex items-center gap-4 p-5">
            <div class="flex h-12 w-12 shrink-0 items-center justify-center rounded-xl bg-indigo-50 text-indigo-600 dark:bg-indigo-900/30 dark:text-indigo-400">
                <i class="bi bi-cash-stack text-2xl"></i>
            </div>
            <div>
                <p class="text-xs font-medium uppercase tracking-wider text-gray-500 dark:text-gray-400">Receivable Balance</p>
                <h3 class="text-xl font-bold font-mono text-gray-900 dark:text-white">{{ totalReceivableBalance }}</h3>
            </div>
        </div>

        <div class="card flex items-center gap-4 p-5">
            <div class="flex h-12 w-12 shrink-0 items-center justify-center rounded-xl bg-amber-50 text-amber-600 dark:bg-amber-900/30 dark:text-amber-400">
                <i class="bi bi-diagram-3-fill text-2xl"></i>
            </div>
            <div>
                <p class="text-xs font-medium uppercase tracking-wider text-gray-500 dark:text-gray-400">Customer Groups</p>
                <h3 class="text-2xl font-bold text-gray-900 dark:text-white">{{ customerGroupsCount }}</h3>
            </div>
        </div>
    </div>

    <!-- Navigation Tabs Bar -->
    <div class="mb-6 border-b border-gray-200 dark:border-slate-800">
        <nav class="-mb-px flex gap-6" aria-label="Tabs">
            <button type="button"
                    @@click="switchTab('list')"
                    :class="activeTab === 'list'
                        ? 'border-blue-600 text-blue-600'
                        : 'border-transparent text-gray-500 hover:border-gray-300 hover:text-gray-700 dark:text-gray-400 dark:hover:text-gray-200'"
                    class="inline-flex items-center gap-2 border-b-2 pb-3 text-sm font-semibold transition-colors">
                <i class="bi bi-table text-base"></i>
                <span>Directory Table</span>
                <span class="rounded-full bg-blue-50 px-2 py-0.5 text-xs font-bold text-blue-700 dark:bg-blue-900/40 dark:text-blue-300">
                    {{ customerList.length }}
                </span>
            </button>

            <button type="button"
                    @@click="switchTab('form')"
                    :class="activeTab === 'form'
                        ? 'border-blue-600 text-blue-600'
                        : 'border-transparent text-gray-500 hover:border-gray-300 hover:text-gray-700 dark:text-gray-400 dark:hover:text-gray-200'"
                    class="inline-flex items-center gap-2 border-b-2 pb-3 text-sm font-semibold transition-colors">
                <i :class="isEditing ? 'bi bi-pencil-square' : 'bi bi-plus-circle'" class="text-base"></i>
                <span>{{ isEditing ? 'Edit Customer (' + (form.name || form.accountNumber || 'Record') + ')' : 'Add New Customer' }}</span>
            </button>
        </nav>
    </div>

    <!-- TAB 1: Customer Directory DataGrid -->
    <div v-show="activeTab === 'list'" class="space-y-6">
        <div class="card" data-card-title="Customer Directory">
            <data-grid
                title="Customer Directory"
                :columns="customerColumns"
                :data="customerList"
                :theme="theme"
                row-id="id"
                label-key="name"
                item-label="customer"
                item-label-plural="customers"
                add-label="Add Customer"
                :page-size="10"
                :selectable="true"
                :actions="true"
                :aggregates="false"
                :show-row-numbers="false"
                :loading="isShimmerLoading"
                @@open-form="onGridOpenForm"
                @@delete="onGridDelete">
            </data-grid>
        </div>
    </div>

    <!-- TAB 2: Customer Add / Edit Form -->
    <div v-show="activeTab === 'form'" class="space-y-6">
        <div class="card" data-card-title="Customer Information">
            <!-- Form Card Header -->
            <div class="border-b border-gray-100 px-6 py-4 dark:border-slate-800">
                <div class="flex flex-wrap items-center justify-between gap-3">
                    <div>
                        <h3 class="text-lg font-bold text-gray-900 dark:text-white">
                            {{ isEditing ? 'Update Customer Record' : 'Create New Customer' }}
                        </h3>
                        <p class="mt-0.5 text-xs text-gray-500 dark:text-gray-400">
                            {{ isEditing ? 'Modify customer profile, financial limits and GL account assignments.' : 'Fill in the customer identity, billing contacts and receivables account mapping.' }}
                        </p>
                    </div>

                    <div class="flex items-center gap-3">
                        <span class="inline-flex items-center gap-1.5 rounded-full px-3 py-1 text-xs font-semibold"
                              :class="isEditing
                                  ? 'bg-amber-50 text-amber-700 ring-1 ring-amber-600/20 dark:bg-amber-950/40 dark:text-amber-300'
                                  : 'bg-blue-50 text-blue-700 ring-1 ring-blue-600/20 dark:bg-blue-950/40 dark:text-blue-300'">
                            <i :class="isEditing ? 'bi bi-pencil-fill' : 'bi bi-plus-circle-fill'"></i>
                            {{ isEditing ? 'Editing Mode' : 'New Registration' }}
                        </span>

                        <button type="button"
                                @@click="switchTab('list')"
                                class="inline-flex items-center gap-1.5 rounded-lg border border-gray-200 bg-white px-3 py-1.5 text-xs font-semibold text-gray-600 hover:bg-gray-50 dark:border-slate-700 dark:bg-slate-800 dark:text-gray-300">
                            <i class="bi bi-arrow-left"></i>
                            Back to List
                        </button>
                    </div>
                </div>
            </div>

            <form @@submit.prevent="saveCustomer" class="p-6">
                <!-- Search Box for Existing Customer -->
                <div class="mb-8 rounded-xl border border-blue-100 bg-blue-50/50 p-4 dark:border-slate-800 dark:bg-slate-900/40">
                    <label for="customerSearch" class="mb-1.5 block text-xs font-bold uppercase tracking-wider text-blue-900 dark:text-blue-300">
                        Quick Lookup / Edit Existing Customer
                    </label>
                    <div class="flex flex-col gap-3 sm:flex-row">
                        <div class="relative flex-1">
                            <i class="bi bi-search absolute left-3 top-1/2 -translate-y-1/2 text-gray-400"></i>
                            <input id="customerSearch"
                                   v-model="customerSearch"
                                   type="text"
                                   @@keyup.enter="loadCustomerFromSearch"
                                   placeholder="Search by customer name or account number (e.g. AR-1001)..."
                                   class="input-control w-full rounded-lg border border-gray-300 py-2.5 pl-10 pr-4 text-sm focus:border-blue-500 focus:ring-1 focus:ring-blue-500 dark:border-slate-700 dark:bg-slate-800" />
                        </div>
                        <button type="button"
                                @@click="loadCustomerFromSearch"
                                class="inline-flex items-center justify-center gap-2 rounded-lg bg-gray-800 px-5 py-2.5 text-sm font-semibold text-white hover:bg-gray-700 dark:bg-slate-700 dark:hover:bg-slate-600">
                            <i class="bi bi-arrow-down-circle"></i>
                            Load Record
                        </button>
                    </div>
                    <p class="mt-2 text-xs text-gray-500 dark:text-gray-400">
                        Type a customer name or account number and click Load Record to edit.
                    </p>
                </div>

                <!-- SECTION 1: Basic Information -->
                <div class="mb-6 flex items-center gap-3">
                    <div class="flex h-9 w-9 items-center justify-center rounded-lg bg-blue-50 text-blue-600 dark:bg-slate-800 dark:text-blue-400">
                        <i class="bi bi-person-vcard text-lg"></i>
                    </div>
                    <div>
                        <h4 class="font-bold text-gray-900 dark:text-white">Basic Information</h4>
                        <p class="text-xs text-gray-500 dark:text-gray-400">Customer identity, account code and categorization</p>
                    </div>
                </div>

                <div class="grid grid-cols-1 gap-5 sm:grid-cols-2 lg:grid-cols-3 xl:grid-cols-4">
                    <!-- Account Number -->
                    <div>
                        <label for="accountNumber" class="label mb-1.5 block text-xs font-semibold text-gray-700 dark:text-gray-300">
                            Account Number <span class="text-red-500">*</span>
                        </label>
                        <div class="flex gap-2">
                            <input id="accountNumber"
                                   v-model.trim="form.accountNumber"
                                   type="text"
                                   required
                                   placeholder="e.g. AR-00101"
                                   class="input-control w-full rounded-lg border border-gray-300 py-2 px-3 font-mono text-sm uppercase dark:border-slate-700 dark:bg-slate-800" />
                            <button type="button"
                                    @@click="generateAccountNumber"
                                    title="Auto-generate from system numbers"
                                    class="inline-flex items-center justify-center rounded-lg border border-blue-200 bg-blue-50 px-3 text-blue-700 hover:bg-blue-100 dark:border-slate-700 dark:bg-slate-800 dark:text-blue-400">
                                <i class="bi bi-magic"></i>
                            </button>
                        </div>
                    </div>

                    <!-- Customer Name -->
                    <div class="sm:col-span-2">
                        <label for="customerName" class="label mb-1.5 block text-xs font-semibold text-gray-700 dark:text-gray-300">
                            Customer Name <span class="text-red-500">*</span>
                        </label>
                        <input id="customerName"
                               v-model.trim="form.name"
                               type="text"
                               required
                               placeholder="Full customer / business name"
                               class="input-control w-full rounded-lg border border-gray-300 py-2 px-3 text-sm dark:border-slate-700 dark:bg-slate-800" />
                    </div>

                    <!-- Customer Group -->
                    <div>
                        <label for="customerGroup" class="label mb-1.5 block text-xs font-semibold text-gray-700 dark:text-gray-300">
                            Customer Group
                        </label>
                        <select id="customerGroup"
                                v-model="form.customerGroupId"
                                @@change="onCustomerGroupChange"
                                class="input-control w-full rounded-lg border border-gray-300 py-2 px-3 text-sm dark:border-slate-700 dark:bg-slate-800">
                            <option value="">Select Group</option>
                            <option v-for="group in customerGroupList" :key="group.id" :value="group.id">
                                {{ group.name }}
                            </option>
                        </select>
                    </div>

                    <!-- Status -->
                    <div>
                        <label for="customerStatus" class="label mb-1.5 block text-xs font-semibold text-gray-700 dark:text-gray-300">
                            Account Status <span class="text-red-500">*</span>
                        </label>
                        <select id="customerStatus"
                                v-model="form.status"
                                required
                                class="input-control w-full rounded-lg border border-gray-300 py-2 px-3 text-sm dark:border-slate-700 dark:bg-slate-800">
                            <option v-for="s in statusList" :key="s.id" :value="s.name">
                                {{ s.name }}
                            </option>
                        </select>
                    </div>

                    <!-- Contact Number -->
                    <div>
                        <label for="phoneNo" class="label mb-1.5 block text-xs font-semibold text-gray-700 dark:text-gray-300">
                            Contact Phone
                        </label>
                        <input id="phoneNo"
                               v-model.trim="form.phoneNo"
                               type="tel"
                               placeholder="e.g. +233 24 000 0000"
                               class="input-control w-full rounded-lg border border-gray-300 py-2 px-3 font-mono text-sm dark:border-slate-700 dark:bg-slate-800" />
                    </div>

                    <!-- Email Address -->
                    <div>
                        <label for="email" class="label mb-1.5 block text-xs font-semibold text-gray-700 dark:text-gray-300">
                            Email Address
                        </label>
                        <input id="email"
                               v-model.trim="form.email"
                               type="email"
                               placeholder="customer@domain.com"
                               class="input-control w-full rounded-lg border border-gray-300 py-2 px-3 text-sm dark:border-slate-700 dark:bg-slate-800" />
                    </div>

                    <!-- Address -->
                    <div>
                        <label for="address" class="label mb-1.5 block text-xs font-semibold text-gray-700 dark:text-gray-300">
                            Physical / Postal Address
                        </label>
                        <input id="address"
                               v-model.trim="form.address"
                               type="text"
                               placeholder="Street, Building, City"
                               class="input-control w-full rounded-lg border border-gray-300 py-2 px-3 text-sm dark:border-slate-700 dark:bg-slate-800" />
                    </div>
                </div>

                <!-- SECTION 2: Financial & Tax Details -->
                <div class="mb-5 mt-10 flex items-center gap-3 border-t border-gray-100 pt-6 dark:border-slate-800">
                    <div class="flex h-9 w-9 items-center justify-center rounded-lg bg-emerald-50 text-emerald-600 dark:bg-slate-800 dark:text-emerald-400">
                        <i class="bi bi-currency-exchange text-lg"></i>
                    </div>
                    <div>
                        <h4 class="font-bold text-gray-900 dark:text-white">Financial & Tax Details</h4>
                        <p class="text-xs text-gray-500 dark:text-gray-400">Currency, credit limits, balances and tax identification</p>
                    </div>
                </div>

                <div class="grid grid-cols-1 gap-5 sm:grid-cols-2 lg:grid-cols-3 xl:grid-cols-4">
                    <!-- Default Currency -->
                    <div>
                        <label for="currencyId" class="label mb-1.5 block text-xs font-semibold text-gray-700 dark:text-gray-300">
                            Default Currency <span class="text-red-500">*</span>
                        </label>
                        <select id="currencyId"
                                v-model="form.currencyId"
                                @@change="onCurrencyChange"
                                required
                                class="input-control w-full rounded-lg border border-gray-300 py-2 px-3 text-sm dark:border-slate-700 dark:bg-slate-800">
                            <option value="">Select Currency</option>
                            <option v-for="c in currencyList" :key="c.id" :value="c.id">
                                {{ c.currencyName }} ({{ c.currencyCode }})
                            </option>
                        </select>
                    </div>

                    <!-- Current Balance -->
                    <div>
                        <label for="balance" class="label mb-1.5 block text-xs font-semibold text-gray-700 dark:text-gray-300">
                            Current Balance
                        </label>
                        <input id="balance"
                               v-model.number="form.balance"
                               type="number"
                               step="0.01"
                               :disabled="isEditing"
                               class="input-control w-full rounded-lg border border-gray-300 py-2 px-3 font-mono text-sm dark:border-slate-700 dark:bg-slate-800"
                               :class="isEditing ? 'bg-gray-100 cursor-not-allowed opacity-75 dark:bg-slate-800' : ''" />
                        <span class="mt-1 block text-xs text-gray-400">
                            {{ isEditing ? 'Calculated automatically from receivables ledger.' : 'Initial opening balance.' }}
                        </span>
                    </div>

                    <!-- Credit Limit -->
                    <div>
                        <label for="creditLimit" class="label mb-1.5 block text-xs font-semibold text-gray-700 dark:text-gray-300">
                            Credit Limit
                        </label>
                        <input id="creditLimit"
                               v-model.number="form.creditLimit"
                               type="number"
                               step="0.01"
                               placeholder="0.00"
                               class="input-control w-full rounded-lg border border-gray-300 py-2 px-3 font-mono text-sm dark:border-slate-700 dark:bg-slate-800" />
                    </div>

                    <!-- TIN Number -->
                    <div>
                        <label for="tinNumber" class="label mb-1.5 block text-xs font-semibold text-gray-700 dark:text-gray-300">
                            Customer TIN No
                        </label>
                        <input id="tinNumber"
                               v-model.trim="form.tinNumber"
                               type="text"
                               placeholder="Taxpayer Identification No."
                               class="input-control w-full rounded-lg border border-gray-300 py-2 px-3 font-mono text-sm uppercase dark:border-slate-700 dark:bg-slate-800" />
                    </div>

                    <!-- VAT Number -->
                    <div>
                        <label for="vatNumber" class="label mb-1.5 block text-xs font-semibold text-gray-700 dark:text-gray-300">
                            VAT Number
                        </label>
                        <input id="vatNumber"
                               v-model.trim="form.vatNumber"
                               type="text"
                               placeholder="VAT Registration No."
                               class="input-control w-full rounded-lg border border-gray-300 py-2 px-3 font-mono text-sm uppercase dark:border-slate-700 dark:bg-slate-800" />
                    </div>

                    <!-- Tax Office -->
                    <div>
                        <label for="taxOffice" class="label mb-1.5 block text-xs font-semibold text-gray-700 dark:text-gray-300">
                            Tax Office
                        </label>
                        <input id="taxOffice"
                               v-model.trim="form.taxOffice"
                               type="text"
                               placeholder="e.g. Accra Central MTO"
                               class="input-control w-full rounded-lg border border-gray-300 py-2 px-3 text-sm dark:border-slate-700 dark:bg-slate-800" />
                    </div>

                    <!-- Residency Checkbox -->
                    <div class="sm:col-span-2 flex items-center pt-5">
                        <label class="inline-flex cursor-pointer items-center gap-3 rounded-xl border border-gray-200 p-3 hover:bg-gray-50 dark:border-slate-700 dark:bg-slate-800/40">
                            <input type="checkbox"
                                   v-model="form.isResident"
                                   class="h-4 w-4 rounded border-gray-300 text-blue-600 focus:ring-blue-500" />
                            <div>
                                <span class="block text-xs font-bold text-gray-800 dark:text-white">Resident Customer</span>
                                <span class="block text-xs text-gray-500 dark:text-gray-400">Specifies whether customer is tax-resident for withholding purposes</span>
                            </div>
                        </label>
                    </div>
                </div>

                <!-- SECTION 3: General Ledger Mapping -->
                <div class="mb-5 mt-10 flex items-center gap-3 border-t border-gray-100 pt-6 dark:border-slate-800">
                    <div class="flex h-9 w-9 items-center justify-center rounded-lg bg-indigo-50 text-indigo-600 dark:bg-slate-800 dark:text-indigo-400">
                        <i class="bi bi-journal-bookmark-fill text-lg"></i>
                    </div>
                    <div>
                        <h4 class="font-bold text-gray-900 dark:text-white">General Ledger Mapping</h4>
                        <p class="text-xs text-gray-500 dark:text-gray-400">Default accounting control accounts for automated accounts receivable journal entries</p>
                    </div>
                </div>

                <div class="grid grid-cols-1 gap-5 sm:grid-cols-3">
                    <!-- Credit G/L (Accounts Receivable GL) -->
                    <div>
                        <label for="creditAccountId" class="label mb-1.5 block text-xs font-semibold text-gray-700 dark:text-gray-300">
                            Credit G/L (Receivable Account)
                        </label>
                        <select id="creditAccountId"
                                v-model="form.creditAccountId"
                                class="input-control w-full rounded-lg border border-gray-300 py-2 px-3 text-sm dark:border-slate-700 dark:bg-slate-800">
                            <option value="">Select Accounts Receivable Account</option>
                            <option v-for="acc in accountList" :key="acc.id" :value="acc.id">
                                {{ acc.accountIdentifier }}
                            </option>
                        </select>
                        <span class="mt-1 block text-xs text-gray-400">Account credited / debited on customer invoices and receipts</span>
                    </div>

                    <!-- VAT G/L Number -->
                    <div>
                        <label for="vatAccountId" class="label mb-1.5 block text-xs font-semibold text-gray-700 dark:text-gray-300">
                            VAT G/L Number (VAT Output)
                        </label>
                        <select id="vatAccountId"
                                v-model="form.vatAccountId"
                                class="input-control w-full rounded-lg border border-gray-300 py-2 px-3 text-sm dark:border-slate-700 dark:bg-slate-800">
                            <option value="">Select VAT Account</option>
                            <option v-for="acc in accountList" :key="acc.id" :value="acc.id">
                                {{ acc.accountIdentifier }}
                            </option>
                        </select>
                        <span class="mt-1 block text-xs text-gray-400">Output VAT collected on sales to this customer</span>
                    </div>

                    <!-- IRS G/L Number -->
                    <div>
                        <label for="irsAccountId" class="label mb-1.5 block text-xs font-semibold text-gray-700 dark:text-gray-300">
                            IRS / Withholding G/L Number
                        </label>
                        <select id="irsAccountId"
                                v-model="form.irsAccountId"
                                class="input-control w-full rounded-lg border border-gray-300 py-2 px-3 text-sm dark:border-slate-700 dark:bg-slate-800">
                            <option value="">Select Withholding Tax Account</option>
                            <option v-for="acc in accountList" :key="acc.id" :value="acc.id">
                                {{ acc.accountIdentifier }}
                            </option>
                        </select>
                        <span class="mt-1 block text-xs text-gray-400">Withholding tax deductions suffered on customer receipts</span>
                    </div>
                </div>

                <!-- SECTION 4: Contact Person -->
                <div class="mb-5 mt-10 flex items-center gap-3 border-t border-gray-100 pt-6 dark:border-slate-800">
                    <div class="flex h-9 w-9 items-center justify-center rounded-lg bg-teal-50 text-teal-600 dark:bg-slate-800 dark:text-teal-400">
                        <i class="bi bi-person-lines-fill text-lg"></i>
                    </div>
                    <div>
                        <h4 class="font-bold text-gray-900 dark:text-white">Primary Contact Person</h4>
                        <p class="text-xs text-gray-500 dark:text-gray-400">Direct contact liaison at the customer entity</p>
                    </div>
                </div>

                <div class="grid grid-cols-1 gap-5 sm:grid-cols-3">
                    <div>
                        <label for="contactPerson" class="label mb-1.5 block text-xs font-semibold text-gray-700 dark:text-gray-300">
                            Contact Person Name
                        </label>
                        <input id="contactPerson"
                               v-model.trim="form.contactPerson"
                               type="text"
                               placeholder="Full name of contact person"
                               class="input-control w-full rounded-lg border border-gray-300 py-2 px-3 text-sm dark:border-slate-700 dark:bg-slate-800" />
                    </div>

                    <div>
                        <label for="contactPersonPhone" class="label mb-1.5 block text-xs font-semibold text-gray-700 dark:text-gray-300">
                            Contact Person Phone
                        </label>
                        <input id="contactPersonPhone"
                               v-model.trim="form.contactPersonPhone"
                               type="tel"
                               placeholder="Direct telephone / mobile"
                               class="input-control w-full rounded-lg border border-gray-300 py-2 px-3 font-mono text-sm dark:border-slate-700 dark:bg-slate-800" />
                    </div>

                    <div>
                        <label for="contactPersonEmail" class="label mb-1.5 block text-xs font-semibold text-gray-700 dark:text-gray-300">
                            Contact Person Email
                        </label>
                        <input id="contactPersonEmail"
                               v-model.trim="form.contactPersonEmail"
                               type="email"
                               placeholder="direct.email@domain.com"
                               class="input-control w-full rounded-lg border border-gray-300 py-2 px-3 text-sm dark:border-slate-700 dark:bg-slate-800" />
                    </div>
                </div>

                <!-- Form Action Buttons -->
                <div class="mt-10 flex flex-col-reverse gap-3 border-t border-gray-100 pt-6 sm:flex-row sm:items-center sm:justify-between dark:border-slate-800">
                    <div class="flex items-center gap-2">
                        <button type="button"
                                @@click="switchTab('list')"
                                class="inline-flex items-center justify-center gap-2 rounded-lg border border-gray-300 bg-white px-4 py-2.5 text-sm font-semibold text-gray-700 hover:bg-gray-50 dark:border-slate-700 dark:bg-slate-800 dark:text-gray-200">
                            <i class="bi bi-x-circle"></i>
                            Cancel / Back
                        </button>

                        <button type="button"
                                @@click="resetForm"
                                class="inline-flex items-center justify-center gap-2 rounded-lg border border-gray-200 bg-white px-4 py-2.5 text-sm font-semibold text-gray-600 hover:bg-gray-50 dark:border-slate-700 dark:bg-slate-800 dark:text-gray-300">
                            <i class="bi bi-arrow-counterclockwise"></i>
                            Clear Form
                        </button>
                    </div>

                    <div class="flex items-center gap-3">
                        <button v-if="isEditing"
                                type="button"
                                @@click="deleteCustomer(form.id, form.name)"
                                :disabled="isLoading"
                                class="inline-flex items-center justify-center gap-2 rounded-lg border border-red-200 bg-white px-5 py-2.5 text-sm font-semibold text-red-600 hover:bg-red-50 disabled:opacity-50 dark:border-red-900/40 dark:bg-slate-800 dark:text-red-400">
                            <i class="bi bi-trash"></i>
                            Delete Customer
                        </button>

                        <button type="submit"
                                :disabled="isLoading"
                                class="inline-flex items-center justify-center gap-2 rounded-lg bg-blue-600 px-6 py-2.5 text-sm font-semibold text-white shadow-sm hover:bg-blue-700 transition disabled:cursor-not-allowed disabled:opacity-60">
                            <i v-if="isLoading" class="bi bi-arrow-repeat animate-spin"></i>
                            <i v-else :class="isEditing ? 'bi bi-check2-circle' : 'bi bi-person-check-fill'"></i>
                            {{ isLoading ? 'Saving...' : (isEditing ? 'Update Customer' : 'Save Customer') }}
                        </button>
                    </div>
                </div>
            </form>
        </div>
    </div>
</div>

<script src="~/js/gl/customers.js" asp-append-version="true"></script>