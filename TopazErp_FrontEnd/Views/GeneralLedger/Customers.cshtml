@{
    ViewBag.Title = "Customers";
    Layout = "~/Views/Shared/_adminLedgerLayout.cshtml";
}

<div class="content" id="app">
    <!-- Page Header & Breadcrumbs -->
    <div class="mb-6 content-header">
        <div class="flex items-center gap-2 text-sm text-gray-500 mb-2">
            <span>GL - Shared Config</span>
            <i class="bi bi-chevron-right text-xs"></i>
            <span class="text-blue-600 font-medium">Customers</span>
        </div>

        <div class="flex flex-wrap items-center justify-between gap-4">
            <div class="page-title">
                <h2 class="text-2xl font-bold tracking-tight text-gray-900 dark:text-white">
                    Customers
                </h2>
                <p class="mt-1 text-sm text-gray-500 dark:text-gray-400">
                    Manage customer accounts, receivables ledger mapping, financial terms and contact details.
                </p>
            </div>

            <div class="flex items-center gap-2.5">
                <a href="/GeneralLedger/CreateCustomer"
                   class="inline-flex items-center gap-2 rounded-lg bg-blue-600 px-4 py-2.5 text-sm font-semibold text-white shadow-sm hover:bg-blue-700 transition">
                    <i class="bi bi-plus-lg"></i>
                    <span>Add Customer</span>
                </a>
            </div>
        </div>
    </div>

    <!-- KPI Metric Summary Cards -->
    <div class="mb-6 grid grid-cols-1 gap-4 sm:grid-cols-2 lg:grid-cols-4">
        <div class="card flex items-center gap-4 p-5">
            <div class="flex h-12 w-12 shrink-0 items-center justify-center rounded-xl bg-blue-50 text-blue-600 dark:bg-blue-900/30 dark:text-blue-400">
                <i class="bi bi-people text-2xl"></i>
            </div>
            <div>
                <p class="text-xs font-medium uppercase tracking-wider text-gray-500 dark:text-gray-400">Total Customers</p>
                <h3 class="text-2xl font-bold text-gray-900 dark:text-white">{{ totalCustomers }}</h3>
            </div>
        </div>

        <div class="card flex items-center gap-4 p-5">
            <div class="flex h-12 w-12 shrink-0 items-center justify-center rounded-xl bg-emerald-50 text-emerald-600 dark:bg-emerald-900/30 dark:text-emerald-400">
                <i class="bi bi-check-circle-fill text-2xl"></i>
            </div>
            <div>
                <p class="text-xs font-medium uppercase tracking-wider text-gray-500 dark:text-gray-400">Active Accounts</p>
                <h3 class="text-2xl font-bold text-emerald-600 dark:text-emerald-400">{{ activeCustomersCount }}</h3>
            </div>
        </div>

        <div class="card flex items-center gap-4 p-5">
            <div class="flex h-12 w-12 shrink-0 items-center justify-center rounded-xl bg-amber-50 text-amber-600 dark:bg-amber-900/30 dark:text-amber-400">
                <i class="bi bi-cash-stack text-2xl"></i>
            </div>
            <div>
                <p class="text-xs font-medium uppercase tracking-wider text-gray-500 dark:text-gray-400">Receivable Balance</p>
                <h3 class="text-xl font-bold font-mono text-gray-900 dark:text-white">{{ totalReceivableBalance }}</h3>
            </div>
        </div>

        <div class="card flex items-center gap-4 p-5">
            <div class="flex h-12 w-12 shrink-0 items-center justify-center rounded-xl bg-indigo-50 text-indigo-600 dark:bg-indigo-900/30 dark:text-indigo-400">
                <i class="bi bi-diagram-3-fill text-2xl"></i>
            </div>
            <div>
                <p class="text-xs font-medium uppercase tracking-wider text-gray-500 dark:text-gray-400">Customer Groups</p>
                <h3 class="text-2xl font-bold text-gray-900 dark:text-white">{{ customerGroupsCount }}</h3>
            </div>
        </div>
    </div>

    <!-- Customer Directory DataGrid -->
    <div class="card" data-card-title="Customer Directory">
        <data-grid
            title="Customer Directory"
            :columns="customerColumns"
            :data="customerList"
            :theme="theme"
            row-id="id"
            label-key="name"
            item-label="customer"
            item-label-plural="customers"
            :allow-add="false"
            :allow-edit="true"
            :page-size="10"
            :selectable="true"
            :actions="true"
            :aggregates="false"
            :show-row-numbers="false"
            :loading="isShimmerLoading"
            @@open-form="onGridOpenForm"
            @@delete="onGridDelete">
        </data-grid>
    </div>
</div>

<script src="~/js/gl/customers.js" asp-append-version="true"></script>
