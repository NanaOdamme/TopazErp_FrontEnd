@{
    ViewBag.Title = "Default GL Numbers";
    Layout = "~/Views/Shared/_adminLedgerLayout.cshtml";
}

<div class="content">
    <div class="mb-6 content-header">
        <div class="flex items-center gap-2 text-sm text-gray-500 mb-2">
            <span>GL - Shared Config</span>
            <i class="bi bi-chevron-right text-xs"></i>
            <span class="font-medium text-blue-600">Default GL Numbers</span>
        </div>
        <div class="flex flex-wrap items-start justify-between gap-4">
            <div>
                <h2 class="text-2xl font-semibold text-gray-800">Default GL Numbers</h2>
                <p class="text-sm text-gray-500 mt-0.5">Map each module to its default Chart of Accounts entry.</p>
            </div>
            <button type="button"
                    :disabled="isLoading"
                    @@click="saveDefaultGlNumbers()"
                    class="inline-flex items-center gap-2 rounded-lg bg-blue-600 px-5 py-2.5 text-sm font-semibold text-white shadow-sm hover:bg-blue-700 transition disabled:cursor-not-allowed disabled:opacity-60">
                <i class="bi bi-floppy"></i>
                Save Changes
                <span v-if="isLoading" class="spinner-border" role="status" aria-hidden="true" style="width:16px;height:16px"></span>
            </button>
        </div>
    </div>

    <div id="app">

        <!-- ── Loading overlay ───────────────────────────── -->
        <div v-if="isShimmerLoading" class="card flex items-center justify-center py-20 text-gray-400 gap-3">
            <span class="spinner-border" role="status" style="width:22px;height:22px"></span>
            <span class="text-sm">Loading accounts…</span>
        </div>

        <template v-else>

            <!-- ── Section: Banking ───────────────────────── -->
            <div class="card mb-4">
                <div class="card-section-header">
                    <i class="bi bi-bank2 text-blue-500"></i>
                    <span>Banking</span>
                </div>
                <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-4 gap-5 p-5">
                    <div v-for="f in bankingFields" :key="f.key" class="gl-field">
                        <label :for="f.key">{{ f.label }}</label>
                        <select :id="f.key" v-model="form[f.key]" class="gl-select">
                            <option value="">— Select Account —</option>
                            <option v-for="a in coaList" :key="a.id" :value="a.id">
                                {{ a.accountNo }} – {{ a.accountName }}
                            </option>
                        </select>
                    </div>
                </div>
            </div>

            <!-- ── Section: Payables & Receivables ───────── -->
            <div class="card mb-4">
                <div class="card-section-header">
                    <i class="bi bi-arrow-left-right text-blue-500"></i>
                    <span>Payables &amp; Receivables</span>
                </div>
                <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-4 gap-5 p-5">
                    <div v-for="f in apArFields" :key="f.key" class="gl-field">
                        <label :for="f.key">{{ f.label }}</label>
                        <select :id="f.key" v-model="form[f.key]" class="gl-select">
                            <option value="">— Select Account —</option>
                            <option v-for="a in coaList" :key="a.id" :value="a.id">
                                {{ a.accountNo }} – {{ a.accountName }}
                            </option>
                        </select>
                    </div>
                </div>
            </div>

            <!-- ── Section: Tax Accounts ──────────────────── -->
            <div class="card mb-4">
                <div class="card-section-header">
                    <i class="bi bi-receipt text-blue-500"></i>
                    <span>Tax Accounts</span>
                </div>
                <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-4 gap-5 p-5">
                    <div v-for="f in taxFields" :key="f.key" class="gl-field">
                        <label :for="f.key">{{ f.label }}</label>
                        <template v-if="f.type === 'number'">
                            <input :id="f.key" v-model.number="form[f.key]" type="number" min="0" max="100" step="0.01"
                                   class="gl-select" placeholder="0.00" />
                        </template>
                        <template v-else>
                            <select :id="f.key" v-model="form[f.key]" class="gl-select">
                                <option value="">— Select Account —</option>
                                <option v-for="a in coaList" :key="a.id" :value="a.id">
                                    {{ a.accountNo }} – {{ a.accountName }}
                                </option>
                            </select>
                        </template>
                    </div>
                </div>
            </div>

            <!-- ── Section: Inventory & Revenue ──────────── -->
            <div class="card mb-4">
                <div class="card-section-header">
                    <i class="bi bi-boxes text-blue-500"></i>
                    <span>Inventory &amp; Revenue</span>
                </div>
                <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-4 gap-5 p-5">
                    <div v-for="f in inventoryFields" :key="f.key" class="gl-field">
                        <label :for="f.key">{{ f.label }}</label>
                        <select :id="f.key" v-model="form[f.key]" class="gl-select">
                            <option value="">— Select Account —</option>
                            <option v-for="a in coaList" :key="a.id" :value="a.id">
                                {{ a.accountNo }} – {{ a.accountName }}
                            </option>
                        </select>
                    </div>
                </div>
            </div>

            <!-- ── Section: FX & Earnings ─────────────────── -->
            <div class="card mb-4">
                <div class="card-section-header">
                    <i class="bi bi-currency-exchange text-blue-500"></i>
                    <span>FX &amp; Earnings</span>
                </div>
                <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-4 gap-5 p-5">
                    <div v-for="f in fxFields" :key="f.key" class="gl-field">
                        <label :for="f.key">{{ f.label }}</label>
                        <select :id="f.key" v-model="form[f.key]" class="gl-select">
                            <option value="">— Select Account —</option>
                            <option v-for="a in coaList" :key="a.id" :value="a.id">
                                {{ a.accountNo }} – {{ a.accountName }}
                            </option>
                        </select>
                    </div>
                </div>
            </div>

            <!-- ── Section: Social Security ───────────────── -->
            <div class="card mb-4">
                <div class="card-section-header">
                    <i class="bi bi-shield-check text-blue-500"></i>
                    <span>Social Security (SSF)</span>
                </div>
                <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-4 gap-5 p-5">
                    <div v-for="f in ssfFields" :key="f.key" class="gl-field">
                        <label :for="f.key">{{ f.label }}</label>
                        <template v-if="f.type === 'number'">
                            <input :id="f.key" v-model.number="form[f.key]" type="number" min="0" max="100" step="0.01"
                                   class="gl-select" placeholder="0.00" />
                        </template>
                        <template v-else>
                            <select :id="f.key" v-model="form[f.key]" class="gl-select">
                                <option value="">— Select Account —</option>
                                <option v-for="a in coaList" :key="a.id" :value="a.id">
                                    {{ a.accountNo }} – {{ a.accountName }}
                                </option>
                            </select>
                        </template>
                    </div>
                </div>
            </div>

        </template>
    </div>
</div>

<style>
    .card-section-header {
        display: flex;
        align-items: center;
        gap: .5rem;
        padding: .75rem 1.25rem;
        font-weight: 600;
        font-size: .875rem;
        color: #374151;
        border-bottom: 1px solid #e5e7eb;
        background: #f9fafb;
        border-radius: var(--card-radius, .75rem) var(--card-radius, .75rem) 0 0;
    }

    .gl-field label {
        display: block;
        font-size: .75rem;
        font-weight: 500;
        color: #6b7280;
        margin-bottom: .375rem;
    }

    .gl-select {
        width: 100%;
        border-radius: .5rem;
        border: 1px solid #d1d5db;
        padding: .5rem .75rem;
        font-size: .8125rem;
        color: #111827;
        background: #fff;
        outline: none;
        transition: border-color .15s, box-shadow .15s;
        appearance: auto;
    }

    .gl-select:focus {
        border-color: #3b82f6;
        box-shadow: 0 0 0 3px rgba(59,130,246,.15);
    }

    input[type="number"].gl-select {
        appearance: textfield;
    }
</style>

<script src="~/js/shared/vue3/default-gl-numbers.js" asp-append-version="true"></script>