@{
    ViewBag.Title = "Customers";
    Layout = "~/Views/Shared/_adminLedgerLayout.cshtml";
    var customerId = ViewBag.CustomerId as Guid?;
}

<div class="create-customer-page" data-customer-id="@(customerId?.ToString() ?? "")">

    <!-- Page Header -->
    <div class="mb-6">
        <!-- Breadcrumb -->
        <nav class="mb-3 flex items-center space-x-2 text-sm text-gray-500 dark:text-gray-400">
            <a asp-controller="Dashboard" asp-action="GeneralLedger" class="transition-colors hover:text-blue-500">GL - Shared Config</a>
            <span class="text-gray-400">/</span>
            <a asp-controller="GeneralLedger" asp-action="Customers" class="transition-colors hover:text-blue-500">Customers</a>
            <span class="text-gray-400">/</span>
            <span class="font-medium text-gray-800 dark:text-gray-200">{{ isEditing ? 'Edit Customer' : 'New Customer' }}</span>
        </nav>

        <div class="flex flex-col gap-4 sm:flex-row sm:items-center sm:justify-between">
            <!-- Left side: Title -->
            <div>
                <h1 class="text-2xl font-bold text-gray-900 dark:text-white">
                    {{ isEditing ? 'Edit Customer' : 'New Customer' }}
                </h1>
                <p class="mt-1 text-sm text-gray-500 dark:text-gray-400">
                    <span v-if="isEditing && form.name">Editing {{ form.name }}</span>
                    <span v-else>Create and configure customer master data</span>
                </p>
            </div>

            <!-- Right side: Header Action Buttons -->
            <div class="flex items-center gap-3">
                <a href="/GeneralLedger/Customers" class="btn-outline">
                    <i class="bi bi-arrow-left mr-2"></i> Back to Customers
                </a>
                <button v-if="isEditing" type="button" class="btn-success" @@click="newCustomer">
                    <i class="bi bi-plus-circle mr-2"></i> New Customer
                </button>
            </div>
        </div>
    </div>

    <div class="customer-grid">

        <!-- Left Column: Form -->
        <div class="rounded-xl border border-gray-200 bg-white p-6 shadow-sm dark:border-slate-700 dark:bg-slate-800">

            <!-- Header row with account chip / fetching state -->
            <div class="mb-4 flex items-center justify-between rounded-lg border border-blue-100 bg-blue-50 px-4 py-3 dark:border-blue-900/50 dark:bg-blue-900/20">
                <div class="flex items-center gap-3">
                    <i class="bi bi-person-vcard text-lg text-blue-600 dark:text-blue-400"></i>
                    <div>
                        <p class="text-sm font-bold text-blue-900 dark:text-blue-200">
                            {{ isEditing ? 'Edit Customer' : 'New Customer' }}
                        </p>
                        <p class="text-xs text-blue-600 dark:text-blue-400" v-if="isFetching">
                            Fetching customer details…
                        </p>
                        <p class="text-xs text-blue-600 dark:text-blue-400" v-else-if="form.accountNumber && form.name">
                            {{ form.accountNumber }} &mdash; {{ form.name }}
                        </p>
                        <p class="text-xs text-blue-600 dark:text-blue-400" v-else-if="form.accountNumber">
                            {{ form.accountNumber }}
                        </p>
                    </div>
                </div>
                <span v-if="isFetching" class="inline-flex items-center gap-1 rounded-full bg-white px-3 py-1 text-xs font-semibold text-blue-700 ring-1 ring-blue-200 dark:bg-slate-900 dark:text-blue-300 dark:ring-blue-800">
                    <span class="h-2 w-2 animate-ping rounded-full bg-blue-500"></span>
                    Loading
                </span>
            </div>

            <form @@submit.prevent="saveCustomer" novalidate>
                <!-- SECTION 1: Basic Information -->
                <div class="mb-5 flex items-center gap-3 border-b border-gray-100 pb-4 dark:border-slate-800">
                    <div class="flex h-9 w-9 items-center justify-center rounded-lg bg-blue-50 text-blue-600 dark:bg-slate-800 dark:text-blue-400">
                        <i class="bi bi-person-vcard-fill text-lg"></i>
                    </div>
                    <div>
                        <h4 class="font-bold text-gray-900 dark:text-white">Basic Information</h4>
                        <p class="text-xs text-gray-500 dark:text-gray-400">Key identity, classification and contact details</p>
                    </div>
                </div>

                <div class="grid grid-cols-1 gap-5 sm:grid-cols-3">
                    <div>
                        <label for="accountNumber" class="label mb-1.5 block text-xs font-semibold text-gray-700 dark:text-gray-300">
                            Account Number <span class="ml-1 rounded bg-amber-100 px-1.5 py-0.5 text-[10px] font-bold uppercase text-amber-700">System</span>
                        </label>
                        <div class="flex">
                            <input type="text" id="accountNumber" v-model.trim="form.accountNumber" :readonly="isEditing"
                                   class="input-control w-full rounded-l-lg border border-gray-300 bg-gray-50 py-2 px-3 font-mono text-sm dark:border-slate-700 dark:bg-slate-900"
                                   :class="{ 'border-red-500': accountNumberInvalid, 'opacity-75': isEditing }"
                                   placeholder="e.g. AR-0001" />
                            <button type="button" v-if="!isEditing" @@click="generateAccountNumber"
                                    class="rounded-r-lg border border-l-0 border-gray-300 bg-white px-3 text-gray-500 transition-colors hover:bg-gray-50 hover:text-blue-600 dark:border-slate-700 dark:bg-slate-800 dark:hover:bg-slate-700"
                                    title="Generate account number">
                                <i class="bi bi-arrow-repeat"></i>
                            </button>
                            <span v-else class="inline-flex items-center rounded-r-lg border border-l-0 border-gray-300 bg-gray-100 px-3 text-gray-400 dark:border-slate-700 dark:bg-slate-900" title="Locked while editing">
                                <i class="bi bi-lock"></i>
                            </span>
                        </div>
                        <span class="mt-1 block text-xs font-medium text-amber-600">Auto-generated &mdash; locked once assigned</span>
                        <span v-if="accountNumberInvalid" class="mt-1 block text-xs font-medium text-red-500">Account number is required</span>
                    </div>

                    <div class="sm:col-span-2">
                        <label for="customerName" class="label mb-1.5 block text-xs font-semibold text-gray-700 dark:text-gray-300">
                            Customer Name <span class="text-red-500">*</span>
                        </label>
                        <input type="text" id="customerName" v-model.trim="form.name"
                               class="input-control w-full rounded-lg border border-gray-300 py-2 px-3 text-sm dark:border-slate-700 dark:bg-slate-800"
                               :class="{ 'border-red-500': nameInvalid }"
                               placeholder="e.g. Kwame Traders Ltd" />
                        <span v-if="nameInvalid" class="mt-1 block text-xs font-medium text-red-500">Customer name is required</span>
                    </div>

                    <div>
                        <label for="customerGroup" class="label mb-1.5 block text-xs font-semibold text-gray-700 dark:text-gray-300">
                            Customer Group <span class="text-red-500">*</span>
                        </label>
                        <select id="customerGroup"
                                v-model="form.customerGroupId"
                                @@change="onCustomerGroupChange"
                                class="input-control w-full rounded-lg border border-gray-300 py-2 px-3 text-sm dark:border-slate-700 dark:bg-slate-800"
                                :class="{ 'border-red-500': customerGroupIdInvalid }">
                            <option value="">Select Customer Group</option>
                            <option v-for="group in customerGroupList" :key="group.id" :value="group.id">{{ group.name }}</option>
                        </select>
                        <span v-if="customerGroupIdInvalid" class="mt-1 block text-xs font-medium text-red-500">Customer group is required</span>
                    </div>

                    <div>
                        <label for="customerStatus" class="label mb-1.5 block text-xs font-semibold text-gray-700 dark:text-gray-300">Status</label>
                        <select id="customerStatus" v-model="form.status"
                                class="input-control w-full rounded-lg border border-gray-300 py-2 px-3 text-sm dark:border-slate-700 dark:bg-slate-800">
                            <option v-for="status in statusList" :key="status" :value="status">{{ status }}</option>
                        </select>
                    </div>

                    <div>
                        <label for="phoneNo" class="label mb-1.5 block text-xs font-semibold text-gray-700 dark:text-gray-300">Phone</label>
                        <input type="tel" id="phoneNo" v-model.trim="form.phoneNo"
                               class="input-control w-full rounded-lg border border-gray-300 py-2 px-3 text-sm dark:border-slate-700 dark:bg-slate-800"
                               placeholder="e.g. 0244 123 456" />
                    </div>

                    <div>
                        <label for="email" class="label mb-1.5 block text-xs font-semibold text-gray-700 dark:text-gray-300">Email</label>
                        <input type="email" id="email" v-model.trim="form.email"
                               class="input-control w-full rounded-lg border border-gray-300 py-2 px-3 text-sm dark:border-slate-700 dark:bg-slate-800"
                               :class="{ 'border-red-500': emailInvalid }"
                               placeholder="e.g. info@kwametraders.com" />
                        <span v-if="emailInvalid" class="mt-1 block text-xs font-medium text-red-500">Please enter a valid email address</span>
                    </div>

                    <div class="sm:col-span-2">
                        <label for="address" class="label mb-1.5 block text-xs font-semibold text-gray-700 dark:text-gray-300">Address</label>
                        <input type="text" id="address" v-model.trim="form.address"
                               class="input-control w-full rounded-lg border border-gray-300 py-2 px-3 text-sm dark:border-slate-700 dark:bg-slate-800"
                               placeholder="e.g. 12 Independence Ave, Accra" />
                    </div>
                </div>

                <!-- SECTION 2: Financial & Tax Details -->
                <div class="mb-5 mt-10 flex items-center gap-3 border-t border-gray-100 pt-6 dark:border-slate-800">
                    <div class="flex h-9 w-9 items-center justify-center rounded-lg bg-purple-50 text-purple-600 dark:bg-slate-800 dark:text-purple-400">
                        <i class="bi bi-wallet2 text-lg"></i>
                    </div>
                    <div>
                        <h4 class="font-bold text-gray-900 dark:text-white">Financial &amp; Tax Details</h4>
                        <p class="text-xs text-gray-500 dark:text-gray-400">Currency, credit terms and tax registration data</p>
                    </div>
                </div>

                <div class="grid grid-cols-1 gap-5 sm:grid-cols-3">
                    <div>
                        <label for="currencyId" class="label mb-1.5 block text-xs font-semibold text-gray-700 dark:text-gray-300">
                            Currency <span class="text-red-500">*</span>
                        </label>
                        <select id="currencyId" v-model="form.currencyId" @@change="onCurrencyChange"
                                class="input-control w-full rounded-lg border border-gray-300 py-2 px-3 text-sm dark:border-slate-700 dark:bg-slate-800"
                                :class="{ 'border-red-500': currencyIdInvalid }">
                            <option value="">Select Currency</option>
                            <option v-for="currency in currencyList" :key="currency.id" :value="currency.id">{{ currency.name }}</option>
                        </select>
                        <span v-if="currencyIdInvalid" class="mt-1 block text-xs font-medium text-red-500">Currency is required</span>
                    </div>

                    <div>
                        <label for="balance" class="label mb-1.5 block text-xs font-semibold text-gray-700 dark:text-gray-300">Current Balance</label>
                        <input type="number" id="balance" v-model.number="form.balance" step="0.01" min="0" :disabled="isEditing"
                               class="input-control w-full rounded-lg border border-gray-300 py-2 px-3 text-sm disabled:cursor-not-allowed disabled:bg-gray-100 dark:border-slate-700 dark:bg-slate-800 dark:disabled:bg-slate-900"
                               placeholder="0.00" />
                        <span v-if="isEditing" class="mt-1 block text-xs text-gray-400">Managed automatically from postings</span>
                    </div>

                    <div>
                        <label for="creditLimit" class="label mb-1.5 block text-xs font-semibold text-gray-700 dark:text-gray-300">Credit Limit</label>
                        <input type="number" id="creditLimit" v-model.number="form.creditLimit" step="0.01" min="0"
                               class="input-control w-full rounded-lg border border-gray-300 py-2 px-3 text-sm dark:border-slate-700 dark:bg-slate-800"
                               placeholder="0.00" />
                    </div>

                    <div>
                        <label for="tinNumber" class="label mb-1.5 block text-xs font-semibold text-gray-700 dark:text-gray-300">TIN</label>
                        <input type="text" id="tinNumber" v-model.trim="form.tinNumber"
                               class="input-control w-full rounded-lg border border-gray-300 py-2 px-3 text-sm dark:border-slate-700 dark:bg-slate-800"
                               placeholder="e.g. C0001234567" />
                    </div>

                    <div>
                        <label for="vatNumber" class="label mb-1.5 block text-xs font-semibold text-gray-700 dark:text-gray-300">VAT Number</label>
                        <input type="text" id="vatNumber" v-model.trim="form.vatNumber"
                               class="input-control w-full rounded-lg border border-gray-300 py-2 px-3 text-sm dark:border-slate-700 dark:bg-slate-800"
                               placeholder="e.g. VAT-12345" />
                    </div>

                    <div>
                        <label for="taxOffice" class="label mb-1.5 block text-xs font-semibold text-gray-700 dark:text-gray-300">Tax Office</label>
                        <input type="text" id="taxOffice" v-model.trim="form.taxOffice"
                               class="input-control w-full rounded-lg border border-gray-300 py-2 px-3 text-sm dark:border-slate-700 dark:bg-slate-800"
                               placeholder="e.g. Accra Central" />
                    </div>

                    <label class="flex items-center gap-2 text-sm font-medium text-gray-700 dark:text-gray-300 sm:col-span-3">
                        <input type="checkbox" v-model="form.isResident"
                               class="h-4 w-4 rounded border-gray-300 text-blue-600 focus:ring-blue-500" />
                        Resident customer (registered for local tax purposes)
                    </label>
                </div>

                <!-- SECTION 3: General Ledger Mapping -->
                <div class="mb-5 mt-10 flex items-center gap-3 border-t border-gray-100 pt-6 dark:border-slate-800">
                    <div class="flex h-9 w-9 items-center justify-center rounded-lg bg-indigo-50 text-indigo-600 dark:bg-slate-800 dark:text-indigo-400">
                        <i class="bi bi-journal-bookmark-fill text-lg"></i>
                    </div>
                    <div>
                        <h4 class="font-bold text-gray-900 dark:text-white">General Ledger Mapping</h4>
                        <p class="text-xs text-gray-500 dark:text-gray-400">Default control accounts for automated accounts receivable entries</p>
                    </div>
                </div>

                <div class="grid grid-cols-1 gap-5 sm:grid-cols-3">
                    <div>
                        <label for="creditAccountId" class="label mb-1.5 block text-xs font-semibold text-gray-700 dark:text-gray-300">
                            Credit G/L (Receivable Account)
                        </label>
                        <select id="creditAccountId" v-model="form.creditAccountId" @@change="onCreditAccountChange"
                                class="input-control w-full rounded-lg border border-gray-300 py-2 px-3 text-sm dark:border-slate-700 dark:bg-slate-800">
                            <option value="">Select Accounts Receivable Account</option>
                            <option v-for="acc in accountsList" :key="acc.id" :value="acc.id">{{ acc.accountIdentifier }}</option>
                        </select>
                        <span class="mt-1 block text-xs text-gray-400">Account credited / debited on customer invoices and receipts</span>
                    </div>

                    <div>
                        <label for="vatAccountId" class="label mb-1.5 block text-xs font-semibold text-gray-700 dark:text-gray-300">
                            VAT G/L Number (VAT Output)
                        </label>
                        <select id="vatAccountId" v-model="form.vatAccountId" @@change="onVatAccountChange"
                                class="input-control w-full rounded-lg border border-gray-300 py-2 px-3 text-sm dark:border-slate-700 dark:bg-slate-800">
                            <option value="">Select VAT Account</option>
                            <option v-for="acc in accountsList" :key="acc.id" :value="acc.id">{{ acc.accountIdentifier }}</option>
                        </select>
                        <span class="mt-1 block text-xs text-gray-400">Output VAT collected on sales to this customer</span>
                    </div>

                    <div>
                        <label for="irsAccountId" class="label mb-1.5 block text-xs font-semibold text-gray-700 dark:text-gray-300">
                            IRS / Withholding G/L Number
                        </label>
                        <select id="irsAccountId" v-model="form.irsAccountId" @@change="onIrsAccountChange"
                                class="input-control w-full rounded-lg border border-gray-300 py-2 px-3 text-sm dark:border-slate-700 dark:bg-slate-800">
                            <option value="">Select Withholding Tax Account</option>
                            <option v-for="acc in accountsList" :key="acc.id" :value="acc.id">{{ acc.accountIdentifier }}</option>
                        </select>
                        <span class="mt-1 block text-xs text-gray-400">Withholding tax deductions suffered on customer receipts</span>
                    </div>
                </div>

                <!-- SECTION 4: Contact Person -->
                <div class="mb-5 mt-10 flex items-center gap-3 border-t border-gray-100 pt-6 dark:border-slate-800">
                    <div class="flex h-9 w-9 items-center justify-center rounded-lg bg-teal-50 text-teal-600 dark:bg-slate-800 dark:text-teal-400">
                        <i class="bi bi-person-lines-fill text-lg"></i>
                    </div>
                    <div>
                        <h4 class="font-bold text-gray-900 dark:text-white">Primary Contact Person</h4>
                        <p class="text-xs text-gray-500 dark:text-gray-400">Main point of contact for this customer</p>
                    </div>
                </div>

                <div class="grid grid-cols-1 gap-5 sm:grid-cols-3">
                    <div>
                        <label for="contactPerson" class="label mb-1.5 block text-xs font-semibold text-gray-700 dark:text-gray-300">Contact Person</label>
                        <input type="text" id="contactPerson" v-model.trim="form.contactPerson"
                               class="input-control w-full rounded-lg border border-gray-300 py-2 px-3 text-sm dark:border-slate-700 dark:bg-slate-800"
                               placeholder="e.g. Ama Owusu" />
                    </div>
                    <div>
                        <label for="contactPersonPhone" class="label mb-1.5 block text-xs font-semibold text-gray-700 dark:text-gray-300">Contact Phone</label>
                        <input type="tel" id="contactPersonPhone" v-model.trim="form.contactPersonPhone"
                               class="input-control w-full rounded-lg border border-gray-300 py-2 px-3 text-sm dark:border-slate-700 dark:bg-slate-800"
                               placeholder="e.g. 0244 123 456" />
                    </div>
                    <div>
                        <label for="contactPersonEmail" class="label mb-1.5 block text-xs font-semibold text-gray-700 dark:text-gray-300">Contact Email</label>
                        <input type="email" id="contactPersonEmail" v-model.trim="form.contactPersonEmail"
                               class="input-control w-full rounded-lg border border-gray-300 py-2 px-3 text-sm dark:border-slate-700 dark:bg-slate-800"
                               placeholder="e.g. ama@kwametraders.com" />
                    </div>
                </div>

                <!-- Action Buttons -->
                <div class="mt-8 flex flex-col gap-3 border-t border-gray-100 pt-6 dark:border-slate-800 sm:flex-row sm:justify-end">
                    <button type="button" class="btn-outline" @@click="handleBack">
                        Cancel
                    </button>
                    <button type="button" class="btn-outline" @@click="revertForm" :disabled="isSaving">
                        <i class="bi bi-arrow-counterclockwise mr-2"></i> {{ isEditing ? 'Revert' : 'Clear' }}
                    </button>
                    <button v-if="isEditing" type="button" class="btn-danger" @@click="confirmDelete" :disabled="isDeleting || isSaving">
                        <i class="bi bi-trash mr-2"></i> {{ isDeleting ? 'Deleting...' : 'Delete' }}
                    </button>
                    <button type="submit" class="btn-primary" :disabled="isFormInvalid || isSaving">
                        <span v-if="isSaving" class="inline-flex items-center gap-2">
                            <span class="h-4 w-4 animate-spin rounded-full border-2 border-white border-t-transparent"></span>
                            {{ isEditing ? 'Updating...' : 'Creating...' }}
                        </span>
                        <span v-else>
                            <i :class="isEditing ? 'bi bi-check-lg' : 'bi bi-plus-circle'" class="mr-2"></i>
                            {{ isEditing ? 'Update Customer' : 'Create Customer' }}
                        </span>
                    </button>
                </div>
            </form>
        </div>
    </div>
</div>

<script src="~/js/gl/create-customer.js" asp-append-version="true"></script>
