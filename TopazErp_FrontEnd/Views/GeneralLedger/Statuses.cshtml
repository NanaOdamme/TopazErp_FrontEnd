@{
    ViewBag.Title = "Statuses";
    Layout = "~/Views/Shared/_adminLedgerLayout.cshtml";
}

<div class="content">
    <div class="mb-6 content-header">
        <div class="flex items-center gap-2 text-sm text-gray-500 mb-2">
            <span>AR - Shared Resources</span>
            <i class="bi bi-chevron-right text-xs"></i>
            <span class="text-blue-600 font-medium">Statuses</span>
        </div>

        <div class="flex items-center gap-3">
            <div class="page-title">
                <h2 class="text-2xl font-semibold text-gray-800">
                    Statuses
                </h2>
                <p class="mt-1 text-sm text-gray-500">
                    Manage the statuses available across the system.
                </p>
            </div>
        </div>
    </div>

    <div class="card" data-card-title="Statuses">
        <div id="app">
            <data-grid
                title="Statuses"
                :columns="statusColumns"
                :data="statusList"
                :theme="theme"
                row-id="id"
                label-key="name"
                item-label="status"
                item-label-plural="statuses"
                add-label="Add Status"
                :page-size="10"
                :selectable="true"
                :allow-add="false"
                :allow-edit="false"
                :allow-delete="false"
            ></data-grid>
        </div>
    </div>
</div>

<script src="~/js/shared/vue3/statuses.js"
        asp-append-version="true"></script>