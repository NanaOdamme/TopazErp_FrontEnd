@{
    ViewBag.Title = "Debit Memo";
    Layout = "~/Views/Shared/_adminApLayout.cshtml";
}

<div class="content">
    <div class="mb-6 content-header">
        <div class="flex items-center gap-2 text-sm text-gray-500 mb-2">
            <span>AP - Data Entry</span>
            <i class="bi bi-chevron-right text-xs"></i>
            <span class="text-blue-600 font-medium">Debit Memo</span>
        </div>
    </div>

    <div id="app" class="space-y-6">
        <div class="card" data-card-title="Debit Memo">
            <data-grid
                title="Debit Memos"
                :columns="debitMemoColumns"
                :data="debitMemoList"
                row-id="id"
                label-key="supplierName"
                storage-key="debit-memo-register"
                item-label="Debit Memo"
                :page-size="10"
                :selectable="false"
                :actions="true"
                theme="#0645e7"
                @@create="onCreate"
                @@update="onUpdate"
                @@delete="onDelete">
            </data-grid>
               
        </div>
    </div>
</div>



<script src="~/js/ap/DataEntry/debitMemo.js" asp-append-version="true"></script>