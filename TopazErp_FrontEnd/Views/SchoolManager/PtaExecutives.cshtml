@{
    ViewBag.Title = "PTA Executives";
    Layout = "~/Views/Shared/_adminSchoolManagerLayout.cshtml";
}

<div class="content">
    <div class="mb-6 content-header">
        <div class="flex items-center gap-2 text-sm text-gray-500 mb-2 dark:text-gray-400">
            <span>School Manager - Data Entries</span>
            <i class="bi bi-chevron-right text-xs"></i>
            <span class="text-blue-600 font-medium dark:text-blue-400">PTA Executives</span>
        </div>

        <div class="flex items-center gap-3">
            <div class="page-title">
                <h2 class="text-xl font-semibold text-gray-800 dark:text-white">
                    PTA Executives
                </h2>
            </div>
        </div>
    </div>

    <div class="card" data-card-title="PTA Executives">
        <div id="app">
            <!-- initial shimmer -->
            <div v-if="!setupDone" class="flex flex-col items-center justify-center py-16 text-gray-400 dark:text-gray-500">
                <i class="bi bi-arrow-repeat animate-spin text-2xl mb-3"></i>
                <p class="text-sm">Loading PTA executives…</p>
            </div>

            <template v-else>
                <!-- scope -->
                <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-4 gap-4 mb-4">
                    <w-select v-model="academicYearId"
                              :options="academicYears"
                              display-key="name"
                              value-key="id"
                              label="Academic Year:"
                              required>
                    </w-select>
                </div>

                <template v-if="scopeReady">
                    <!-- toolbar -->
                    <div class="flex flex-col sm:flex-row sm:items-center sm:justify-between gap-3 mb-4">
                        <span class="inline-flex items-center gap-1.5 rounded-full border border-blue-200 bg-blue-50 px-3 py-1 text-[11px] font-semibold text-blue-800 dark:bg-blue-900/30 dark:border-blue-800 dark:text-blue-300">
                            <i class="bi bi-people-fill"></i>{{ executivesInYear.length }} executive{{ executivesInYear.length === 1 ? '' : 's' }} for {{ nameOf(academicYears, academicYearId) }}
                        </span>
                        <a class="cursor-pointer inline-flex items-center gap-2 whitespace-nowrap text-white bg-blue-900 hover:bg-blue-800 p-2 rounded-lg  text-sm font-semibold transition "
                           @@click="openAddModal">
                            <i class="bi bi-person-plus"></i> Add Executive
                        </a>
                    </div>

                    <!-- table -->
                    <div class="rounded-xl border border-gray-200 dark:border-slate-700 bg-white dark:bg-slate-800 shadow-sm overflow-hidden">
                        <div class="overflow-x-auto">
                            <table class="min-w-full text-sm divide-y divide-gray-100 dark:divide-slate-700">
                                <thead class="bg-white dark:bg-slate-900/40">
                                    <tr class="text-left text-[11px] uppercase tracking-wider text-gray-500 dark:text-gray-400">
                                        <th class="px-4 py-2.5 font-semibold">Position</th>
                                        <th class="px-4 py-2.5 font-semibold">Name</th>
                                        <th class="px-4 py-2.5 font-semibold">Phone</th>
                                        <th class="px-4 py-2.5 font-semibold">Email</th>
                                        <th class="px-4 py-2.5 font-semibold">Address</th>
                                        <th class="px-4 py-2.5 font-semibold">Start Date</th>
                                        <th class="px-4 py-2.5 font-semibold">End Date</th>
                                        <th class="px-4 py-2.5 font-semibold w-24 text-right">Actions</th>
                                    </tr>
                                </thead>
                                <tbody class="divide-y divide-gray-100 dark:divide-slate-700">
                                    <tr v-for="e in executivesInYear"
                                        :key="e.id"
                                        class="hover:bg-blue-50/40 dark:hover:bg-slate-700/40 transition-colors">
                                        <td class="px-4 py-2.5 whitespace-nowrap">
                                            <span class="inline-flex items-center rounded-full border border-slate-200 bg-slate-50 px-2.5 py-0.5 text-[11px] font-bold text-slate-800 dark:bg-slate-700 dark:border-slate-600 dark:text-gray-200">
                                                {{ e.ptaPositionName || '—' }}
                                            </span>
                                        </td>
                                        <td class="px-4 py-2.5 font-medium text-gray-800 dark:text-white">{{ e.name }}</td>
                                        <td class="px-4 py-2.5 whitespace-nowrap text-gray-600 dark:text-gray-300">
                                            <a v-if="e.phoneNumber" :href="'tel:' + e.phoneNumber" class="hover:underline">{{ e.phoneNumber }}</a>
                                            <span v-else>—</span>
                                        </td>
                                        <td class="px-4 py-2.5 text-gray-600 dark:text-gray-300">
                                            <a v-if="e.email" :href="'mailto:' + e.email" class="truncate block max-w-[12rem] hover:underline">{{ e.email }}</a>
                                            <span v-else>—</span>
                                        </td>
                                        <td class="px-4 py-2.5 text-gray-600 dark:text-gray-300">
                                            <span class="truncate block max-w-[12rem]">{{ e.address || '—' }}</span>
                                        </td>
                                        <td class="px-4 py-2.5 whitespace-nowrap text-gray-600 dark:text-gray-300">{{ prettyDate(e.startDate) }}</td>
                                        <td class="px-4 py-2.5 whitespace-nowrap text-gray-600 dark:text-gray-300">{{ prettyDate(e.endDate) }}</td>
                                        <td class="px-4 py-2.5">
                                            <div class="flex items-center justify-end gap-1.5">
                                                <button type="button"
                                                        class="p-2 rounded-lg border border-gray-200 dark:border-slate-600 text-gray-500 hover:text-blue-700 hover:border-blue-300 hover:bg-blue-50 transition dark:text-gray-400 dark:hover:text-blue-400"
                                                        title="Edit executive"
                                                        @@click="openEditModal(e)">
                                                    <i class="bi bi-pencil"></i>
                                                </button>
                                                <button type="button"
                                                        class="p-2 rounded-lg border border-gray-200 dark:border-slate-600 text-gray-500 hover:text-red-600 hover:border-red-300 hover:bg-red-50 transition dark:text-gray-400 dark:hover:text-red-400"
                                                        title="Delete executive"
                                                        @@click="deleteExecutive(e)">
                                                    <i class="bi bi-trash"></i>
                                                </button>
                                            </div>
                                        </td>
                                    </tr>
                                    <tr v-if="executivesInYear.length === 0">
                                        <td colspan="8" class="px-4 py-10 text-center text-sm text-gray-400 dark:text-gray-500">
                                            <i class="bi bi-inbox block text-2xl mb-2"></i>
                                            No executives for this academic year yet — use <span class="font-semibold">Add Executive</span>.
                                        </td>
                                    </tr>
                                </tbody>
                            </table>
                        </div>
                    </div>
                </template>

                <div v-else class="py-14 text-center text-gray-400 dark:text-gray-500">
                    <i class="bi bi-arrow-up-circle block text-2xl mb-2"></i>
                    <p class="text-sm">Pick an academic year to manage the PTA executives.</p>
                </div>
            </template>

            <!-- ============ MODAL — ADD / EDIT EXECUTIVE ============ -->
            <div v-if="modalOpen" class="fixed inset-0 z-50 flex items-center justify-center p-4">
                <div class="absolute inset-0 bg-slate-900/60 backdrop-blur-[2px]" @@click="closeModal"></div>
                <div class="relative w-full max-w-2xl rounded-2xl border border-gray-200 dark:border-slate-700 bg-white dark:bg-slate-800 shadow-2xl max-h-[92vh] overflow-y-auto">
                    <div class="flex items-center justify-between gap-3 border-b border-gray-100 dark:border-slate-700 px-5 py-4">
                        <div>
                            <h3 class="text-base font-semibold text-gray-800 dark:text-white flex items-center gap-2">
                                <i class="bi" :class="editingId ? 'bi-pencil-square text-blue-600 dark:text-blue-400' : 'bi-person-plus text-blue-600 dark:text-blue-400'"></i>
                                {{ editingId ? 'Edit Executive' : 'Add Executive' }}
                            </h3>
                            <p class="text-[11px] text-gray-400 dark:text-gray-500 mt-0.5">A PTA position for an academic year — one holder per position.</p>
                        </div>
                        <button type="button"
                                class="p-2 rounded-lg text-gray-400 hover:text-gray-700 hover:bg-gray-100 dark:hover:text-gray-300 dark:hover:bg-slate-700"
                                @@click="closeModal"
                                aria-label="Close">
                            <i class="bi bi-x-lg"></i>
                        </button>
                    </div>

                    <div class="px-5 py-4 grid grid-cols-1 md:grid-cols-2 gap-4">
                        <w-select v-model="draft.academicYearId"
                                  :options="academicYears"
                                  display-key="name"
                                  value-key="id"
                                  label="Academic Year:"
                                  required>
                        </w-select>

                        <w-select v-model="draft.ptaPositionId"
                                  :options="positions"
                                  display-key="name"
                                  value-key="id"
                                  label="PTA Position:"
                                  required>
                        </w-select>

                        <div class="md:col-span-2">
                            <label class="block text-[11px] font-semibold text-gray-500 dark:text-gray-400 mb-1.5">Full Name <span class="text-red-500">*</span></label>
                            <input type="text" class="input-control w-full" placeholder="e.g. Mrs Abena Serwaa" v-model="draft.name" />
                        </div>
                        <div>
                            <label class="block text-[11px] font-semibold text-gray-500 dark:text-gray-400 mb-1.5">Phone Number</label>
                            <input type="tel" class="input-control w-full" placeholder="e.g. 024 000 0000" v-model="draft.phoneNumber" />
                        </div>
                        <div>
                            <label class="block text-[11px] font-semibold text-gray-500 dark:text-gray-400 mb-1.5">Email</label>
                            <input type="email" class="input-control w-full" placeholder="name@example.com" v-model="draft.email" />
                        </div>
                        <div class="md:col-span-2">
                            <label class="block text-[11px] font-semibold text-gray-500 dark:text-gray-400 mb-1.5">Address</label>
                            <input type="text" class="input-control w-full" placeholder="Home / office address (optional)" v-model="draft.address" />
                        </div>
                        <div>
                            <label class="block text-[11px] font-semibold text-gray-500 dark:text-gray-400 mb-1.5">Start Date <span class="text-red-500">*</span></label>
                            <input type="date" class="input-control w-full" v-model="draft.startDate" />
                        </div>
                        <div>
                            <label class="block text-[11px] font-semibold text-gray-500 dark:text-gray-400 mb-1.5">End Date <span class="text-red-500">*</span></label>
                            <input type="date" class="input-control w-full" v-model="draft.endDate" />
                        </div>
                    </div>

                    <div class="flex items-center justify-end gap-2 border-t border-gray-100 dark:border-slate-700 px-5 py-4">
                        <button type="button"
                                class="inline-flex items-center gap-2 whitespace-nowrap rounded-lg border border-gray-300 bg-white px-4 py-2.5 text-sm font-semibold text-gray-700 hover:bg-gray-50 transition dark:border-slate-600 dark:bg-slate-800 dark:text-gray-200 dark:hover:bg-slate-700"
                                @@click="closeModal">
                            <i class="bi bi-x-circle"></i> Cancel
                        </button>
                        <button type="button"
                                class="inline-flex items-center gap-2 whitespace-nowrap rounded-lg border border-blue-800 bg-blue-900 px-5 py-2.5 text-sm font-semibold text-white transition hover:bg-blue-800 disabled:cursor-not-allowed disabled:opacity-50"
                                :disabled="saving"
                                @@click="saveExecutive">
                            <i class="bi" :class="saving ? 'bi-arrow-repeat animate-spin' : 'bi-check2-circle'"></i>
                            {{ saving ? 'Saving…' : (editingId ? 'Update Executive' : 'Add Executive') }}
                        </button>
                    </div>
                </div>
            </div>

        </div>
    </div>
</div>

<script src="~/js/school-manager/pta-executives.js"></script>
