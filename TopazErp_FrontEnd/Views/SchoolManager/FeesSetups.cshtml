@{
    ViewBag.Title = "Fee Setups";
    Layout = "~/Views/Shared/_adminSchoolManagerLayout.cshtml";
}

<div class="content">
    <div class="mb-5 content-header">
        <div class="flex items-center gap-2 text-sm text-gray-500 mb-1 dark:text-gray-400">
            <span>School Manager - Billing & Payments</span>
            <i class="bi bi-chevron-right text-xs"></i>
            <span class="text-blue-600 font-medium dark:text-blue-400">Fee Setups</span>
        </div>

        <div class="flex flex-col sm:flex-row sm:items-center sm:justify-between gap-3">
            <div>
                <h2 class="text-lg font-bold text-gray-800 dark:text-white tracking-tight flex items-center gap-2.5">
                    Class & School Fee Setups
                </h2>
               
            </div>

           
        </div>
    </div>

    <!-- Main Card -->
    <div class="card" data-card-title="Fee Setups">
        <div id="app">

            <!-- 3 Tabs: Standard | Supplementary | Boarding -->
            <div class="flex flex-col lg:flex-row lg:items-center lg:justify-between gap-3 mb-5 border-b border-gray-200 dark:border-slate-700">
                <div class="flex items-center gap-1" role="tablist" aria-label="Fee setup sections">
                    
                    <!-- Tab 1: Standard Fees -->
                    <button type="button"
                            role="tab"
                            :aria-selected="activeTab === 'Standard'"
                            :class="activeTab === 'Standard'
                                ? 'text-blue-700 border-blue-600 dark:text-blue-400 dark:border-blue-500'
                                : 'text-gray-500 border-transparent hover:text-blue-700 dark:text-gray-400 dark:hover:text-blue-400'"
                            class="inline-flex items-center gap-2 whitespace-nowrap border-b-2 -mb-px px-4 py-2.5 text-sm font-semibold transition-colors"
                            @@click="activeTab = 'Standard'">
                        <i class="bi bi-cash-stack"></i>
                        <span>Standard Fees</span>
                        </button>

                    <!-- Tab 2: Supplementary Fees -->
                    <button type="button"
                            role="tab"
                            :aria-selected="activeTab === 'Supplementary'"
                            :class="activeTab === 'Supplementary'
                                ? 'text-blue-700 border-blue-600 dark:text-blue-400 dark:border-blue-500'
                                : 'text-gray-500 border-transparent hover:text-blue-700 dark:text-gray-400 dark:hover:text-blue-400'"
                            class="inline-flex items-center gap-2 whitespace-nowrap border-b-2 -mb-px px-4 py-2.5 text-sm font-semibold transition-colors"
                            @@click="activeTab = 'Supplementary'">
                        <i class="bi bi-wallet2"></i>
                        <span>Supplementary Fees</span>
                       </button>

                    <!-- Tab 3: Boarding Fees -->
                    <button type="button"
                            role="tab"
                            :aria-selected="activeTab === 'Boarding'"
                            :class="activeTab === 'Boarding'
                                ? 'text-blue-700 border-blue-600 dark:text-blue-400 dark:border-blue-500'
                                : 'text-gray-500 border-transparent hover:text-blue-700 dark:text-gray-400 dark:hover:text-blue-400'"
                            class="inline-flex items-center gap-2 whitespace-nowrap border-b-2 -mb-px px-4 py-2.5 text-sm font-semibold transition-colors"
                            @@click="activeTab = 'Boarding'">
                        <i class="bi bi-door-open"></i>
                        <span>Boarding Fees</span>
                       </button>
                </div>

                <!-- Copy Quick Action Button -->
                <div v-if="currentGridData.length > 0" class="self-start lg:self-auto mb-2 lg:mb-0">
                    <span class="text-xs text-gray-500 dark:text-gray-400 mr-2">Need to replicate a setup?</span>
                    <button type="button"
                            @@click="openCopyModal(currentGridData[0])"
                            class="inline-flex items-center gap-1.5 rounded-lg px-3 py-1.5 text-xs font-semibold text-indigo-700 bg-indigo-50 hover:bg-indigo-100 border border-indigo-200 dark:bg-indigo-950/40 dark:border-indigo-800 dark:text-indigo-300 transition">
                        <i class="bi bi-copy"></i>
                        <span>Copy Setup to Other Classes</span>
                    </button>
                </div>
            </div>

            <!-- Initial Shimmer Loader -->
            <div v-if="!setupDone" class="py-24 text-center text-gray-400">
                <i class="text-blue-800 bi bi-arrow-repeat animate-spin text-3xl inline-block mb-2 text-[#062a81]"></i>
                <p class="text-sm">Loading fee items, classes, terms, and setups…</p>
            </div>

            <template v-else>
              

                <!-- DataGrid with Expandable Child Sub-Grid for Item Breakdown -->
                <data-grid :key="activeTab"
                           :title="`${activeTab} Fee Setups`"
                           :columns="headerColumns"
                           :child="detailSubgrid"
                           :data="currentGridData"
                           :theme="theme"
                           row-id="id"
                           label-key="classId"
                           :item-label="`${activeTab} Fee Setup`"
                           :item-label-plural="`${activeTab} Fee Setups`"
                           add-label="Add"
                           :page-size="10"
                           :selectable="true"
                           :actions="true"
                           :loading="isShimmerLoading"
                           :stripes="true"
                           density="compact"
                           @@create="onCreate"
                           @@update="onUpdate"
                           @@delete="onDelete">
                </data-grid>

                <!-- MODAL: Copy Class Fee Setup to Other Classes -->
                <div v-if="copyModalOpen" class="fixed inset-0 z-50 flex items-center justify-center p-4 bg-black/50 backdrop-blur-sm">
                    <div class="w-full max-w-xl rounded-2xl bg-white dark:bg-slate-800 shadow-2xl border border-gray-100 dark:border-slate-700 overflow-hidden transform transition-all">
                        
                        <!-- Modal Header -->
                        <div class="px-6 py-4 border-b border-gray-100 dark:border-slate-700 flex items-center justify-between bg-gray-50/50 dark:bg-slate-800/80">
                            <div>
                                <h3 class="font-bold text-sm text-gray-800 dark:text-white flex items-center gap-2">
                                    <i class="bi bi-copy text-indigo-600"></i>
                                    <span>Copy {{ activeTab }} Fee Setup</span>
                                </h3>
                                <p class="text-xs text-gray-400 mt-0.5">
                                    Replicate this class fee breakdown to other classes without a setup.
                                </p>
                            </div>
                            <button type="button"
                                    @@click="closeCopyModal"
                                    class="text-gray-400 hover:text-gray-600 dark:hover:text-gray-200 transition">
                                <i class="bi bi-x-lg"></i>
                            </button>
                        </div>

                        <!-- Modal Body -->
                        <div class="p-6 space-y-4 max-h-[75vh] overflow-y-auto">
                            <!-- Source Selection Info Card -->
                            <div class="p-3.5 rounded-xl bg-blue-50/70 dark:bg-slate-700/40 border border-blue-100 dark:border-slate-600 text-xs text-gray-700 dark:text-gray-300">
                                <div class="font-bold text-blue-900 dark:text-blue-300 mb-1">Source Setup to Copy:</div>
                                <div class="grid grid-cols-2 gap-2 mt-1">
                                    <div><strong>Academic Year:</strong> {{ getYearName(sourceSetup.academicYearId) }}</div>
                                    <div><strong>Term:</strong> {{ getTermName(sourceSetup.termId) }}</div>
                                    <div><strong>Source Target:</strong> {{ getClassName(sourceSetup.classId) }}</div>
                                    <div><strong>Total Amount:</strong> {{currencyCode}} {{ Number(sourceSetup.totalAmount || 0).toFixed(2) }} ({{ (sourceSetup.details || []).length }} item lines)</div>
                                </div>
                            </div>

                            <!-- Source Setup Selector (if multiple setups exist) -->
                            <div v-if="currentGridData.length > 1">
                                <label class="block text-xs font-semibold text-gray-700 dark:text-gray-300 mb-1">
                                    Choose Source Class Setup:
                                </label>
                                <select v-model="sourceSetup" class="input-control text-xs">
                                    <option v-for="s in currentGridData" :key="s.id" :value="s">
                                        {{ getClassName(s.classId) }} — {{currencyCode}} {{ Number(s.totalAmount || 0).toFixed(2) }} ({{ getYearName(s.academicYearId) }}, {{ getTermName(s.termId) }})
                                    </option>
                                </select>
                            </div>

                            <!-- Destination Class Selection -->
                            <div>
                                <div class="flex items-center justify-between mb-2">
                                    <label class="block text-xs font-semibold text-gray-700 dark:text-gray-300">
                                        Select Target Class(es) without a {{ activeTab }} Setup ({{ availableClassesForCopy.length }} available):
                                    </label>
                                    <button type="button"
                                            @@click="toggleAllTargetClasses"
                                            class="text-xs text-blue-600 dark:text-blue-400 hover:underline">
                                        {{ targetClassIds.length === availableClassesForCopy.length ? 'Deselect All' : 'Select All' }}
                                    </button>
                                </div>

                                <div v-if="availableClassesForCopy.length === 0" class="py-8 text-center text-xs text-gray-400 bg-gray-50 dark:bg-slate-700/30 rounded-xl">
                                    <i class="bi bi-check-all text-xl block mb-1 text-emerald-500"></i>
                                    All classes already have a {{ activeTab }} fee setup configured for this Year and Term.
                                </div>

                                <div v-else class="grid grid-cols-1 sm:grid-cols-2 gap-2 max-h-52 overflow-y-auto p-1">
                                    <label v-for="c in availableClassesForCopy"
                                           :key="c.id"
                                           class="flex items-center gap-2 p-2 rounded-lg border border-gray-200 dark:border-slate-700 hover:bg-gray-50 dark:hover:bg-slate-700/60 cursor-pointer text-xs transition">
                                        <input type="checkbox"
                                               :value="c.id"
                                               v-model="targetClassIds"
                                               class="rounded border-gray-300 text-blue-600 focus:ring-blue-500" />
                                        <span class="font-medium text-gray-800 dark:text-white">{{ c.name }}</span>
                                    </label>
                                </div>
                            </div>
                        </div>

                        <!-- Modal Footer -->
                        <div class="px-6 py-4 bg-gray-50 dark:bg-slate-800/80 border-t border-gray-100 dark:border-slate-700 flex items-center justify-end gap-2">
                            <button type="button"
                                    @@click="closeCopyModal"
                                    class="px-4 py-2 rounded-lg text-xs font-semibold text-gray-600 hover:bg-gray-100 dark:text-gray-300 dark:hover:bg-slate-700 transition">
                                Cancel
                            </button>
                            <button type="button"
                                    @@click="executeCopyFeeSetup"
                                    :disabled="copying || targetClassIds.length === 0"
                                    class="inline-flex items-center gap-1.5 px-4 py-2 rounded-lg text-xs font-semibold text-white bg-[#062a81] hover:bg-blue-900 shadow-sm transition disabled:opacity-40">
                                <i v-if="copying" class="bi bi-arrow-repeat animate-spin"></i>
                                <i v-else class="bi bi-copy"></i>
                                <span>Copy to {{ targetClassIds.length }} Class(es)</span>
                            </button>
                        </div>

                    </div>
                </div>

            </template>

        </div><!-- /#app -->
    </div><!-- /.card -->
</div><!-- /.content -->

<script src="~/js/school-manager/fee-setups.js"></script>
