@{
    ViewBag.Title = "Student Performance Skills";
    Layout = "~/Views/Shared/_adminSchoolManagerLayout.cshtml";
}

<div class="content">
    <div class="mb-5 content-header">
        <div class="flex items-center gap-2 text-sm text-gray-500 mb-1 dark:text-gray-400">
            <span>School Manager - Data Entry</span>
            <i class="bi bi-chevron-right text-xs"></i>
            <span class="text-blue-600 font-medium dark:text-blue-400">Student Performance Skills</span>
        </div>

        <div class="flex flex-col sm:flex-row sm:items-center sm:justify-between gap-3">
            <div>
                <h2 class="text-lg font-bold text-gray-800 dark:text-white tracking-tight flex items-center gap-2.5">
                    Student Performance Skills
                </h2>
            </div>
        </div>
    </div>

    <div class="card" data-card-title="Student Performance Skills">
        <div id="app">

            <!-- Loader -->
            <div v-if="!setupDone" class="py-24 text-center text-gray-400">
                <i class="text-blue-800 bi bi-arrow-repeat animate-spin text-3xl inline-block mb-2"></i>
                <p class="text-sm">Loading students, classes and performance skills…</p>
            </div>

            <template v-else>
                <div class="flex justify-end gap-1.5 mb-2 flex-wrap">
                    <button type="button"
                            @@click="openCreateModal()"
                            class="border border-[#062a81] text-white px-2.5 py-1.5 text-xs rounded-lg bg-[#062a81] hover:bg-blue-800">
                        <i class="bi bi-plus-lg mr-1"></i>New Entry
                    </button>

                    <button type="button"
                            @@click="editSelected()"
                            class="border border-slate-500 text-white px-2.5 py-1.5 text-xs rounded-lg bg-slate-700 hover:bg-slate-600">
                        <i class="bi bi-pencil-square mr-1"></i>Edit
                    </button>

                    <button type="button"
                            @@click="deleteSelected()"
                            :disabled="busy"
                            class="border border-rose-600 text-white bg-rose-600 px-2.5 py-1.5 text-xs rounded-lg hover:bg-rose-500 disabled:opacity-60">
                        <i class="bi bi-trash mr-1"></i>Delete
                    </button>
                </div>

                <data-grid ref="skillsGrid"
                           title="Student Performance Skills"
                           :columns="columns"
                           :data="records"
                           :theme="theme"
                           row-id="id"
                           label-key="studentName"
                           storage-key="school-manager-st-performance-skills"
                           item-label="Performance Skill"
                           item-label-plural="Performance Skills"
                           :page-size="15"
                           :selectable="true"
                           :actions="false"
                           :allow-add="false"
                           :allow-edit="false"
                           :allow-delete="false"
                           :loading="isShimmerLoading"
                           :stripes="true"
                           density="compact">
                </data-grid>
            </template>

            <!-- ===================== MODAL ===================== -->
            <div v-if="modalOpen" class="fixed inset-0 z-50 flex items-center justify-center p-4 bg-black/50 backdrop-blur-sm">
                <div class="w-full max-w-5xl rounded-2xl bg-white dark:bg-slate-800 shadow-2xl border border-gray-100 dark:border-slate-700 overflow-hidden flex flex-col max-h-[92vh]">

                    <!-- Header -->
                    <div class="px-6 py-4 border-b border-gray-100 dark:border-slate-700 flex items-center justify-between bg-white dark:bg-slate-800/80">
                        <div>
                            <h3 class="font-bold text-sm text-gray-800 dark:text-white flex items-center gap-2">
                                <i class="bi bi-award"></i>
                                <span>{{ editMode ? 'Edit Performance Skill' : 'New Performance Skill' }}</span>
                            </h3>
                        </div>
                        <button type="button" @@click="closeModal" class="text-gray-400 hover:text-gray-600 dark:hover:text-gray-200 transition">
                            <i class="bi bi-x-lg"></i>
                        </button>
                    </div>

                    <!-- Body -->
                    <div class="p-6 space-y-5 overflow-y-auto flex-1">

                        <div class="grid grid-cols-1 sm:grid-cols-4 gap-4">
                            <div>
                                <w-select v-model="form.academicYearId"
                                          :options="academicYears"
                                          display-key="name"
                                          value-key="id"
                                          label="Academic Year:"
                                          :disabled="editMode"
                                          @@update:model-value="onScopeChanged"
                                          required>
                                </w-select>
                            </div>

                            <div>
                                <w-select v-model="form.termId"
                                          :options="terms"
                                          display-key="name"
                                          value-key="id"
                                          label="Term:"
                                          :disabled="editMode"
                                          @@update:model-value="onScopeChanged"
                                          required>
                                </w-select>
                            </div>

                            <div>
                                <w-select v-model="form.classId"
                                          :options="classes"
                                          display-key="name"
                                          value-key="id"
                                          label="Class:"
                                          :disabled="editMode"
                                          @@update:model-value="onScopeChanged"
                                          required>
                                </w-select>
                            </div>

                            <div>
                                <label class="label">
                                    Date <span class="text-rose-500">*</span>
                                </label>
                                <input type="date" v-model="form.date" class="input-control" />
                            </div>
                        </div>

                        <!-- Bulk apply -->
                        <div class="grid grid-cols-1 sm:grid-cols-3 gap-4 items-end rounded-xl border border-gray-200 dark:border-slate-700 p-4"
                             v-if="!editMode">
                            <div>
                                <w-select v-model="bulkAreaId"
                                          :options="performanceAreas"
                                          display-key="name"
                                          value-key="id"
                                          label="Apply Area to all students:">
                                </w-select>
                            </div>

                            <div class="flex items-center gap-2">
                                <button type="button"
                                        @@click="applyAreaToAll(bulkAreaId)"
                                        :disabled="!bulkAreaId"
                                        class="rounded-lg px-2.5 py-2 text-[11px] font-semibold border border-gray-200 dark:border-slate-700 text-gray-700 dark:text-gray-200 hover:bg-gray-50 dark:hover:bg-slate-700 transition disabled:opacity-60">
                                    <i class="bi bi-magic mr-1"></i>Apply to all
                                </button>
                                <button type="button"
                                        @@click="clearAllRows()"
                                        class="rounded-lg px-2.5 py-2 text-[11px] font-semibold border border-gray-200 dark:border-slate-700 text-gray-700 dark:text-gray-200 hover:bg-gray-50 dark:hover:bg-slate-700 transition">
                                    <i class="bi bi-eraser mr-1"></i>Clear all
                                </button>
                            </div>

                            <div class="text-[11px] text-gray-500">
                                {{ readyRows.length }} of {{ rows.length }} student(s) ready to save
                            </div>
                        </div>

                        <!-- Roster -->
                        <div class="rounded-xl border border-gray-200 dark:border-slate-700 p-4">
                            <div class="flex items-center justify-between mb-3 flex-wrap gap-2">
                                <h4 class="text-xs font-bold text-gray-700 dark:text-gray-200 flex items-center gap-1.5">
                                    <i class="bi bi-people text-blue-600"></i>
                                    <span>Students ({{ rows.length }})</span>
                                </h4>
                            </div>

                            <div v-if="!rows.length" class="py-4 text-center text-[11px] text-amber-600">
                                <i class="bi bi-info-circle mr-1"></i>
                                <span v-if="!form.classId">Select a class to load its students.</span>
                                <span v-else>No students found for this class.</span>
                            </div>

                            <div v-else class="overflow-x-auto">
                                <table class="w-full text-xs text-left">
                                    <thead class="text-[11px] uppercase tracking-wider text-gray-500 border-b dark:border-slate-700">
                                        <tr>
                                            <th class="py-2 px-2">#</th>
                                            <th class="py-2 px-2">Student Name</th>
                                            <th class="py-2 px-2">Student ID</th>
                                            <th class="py-2 px-2 w-56">Performance Area</th>
                                            <th class="py-2 px-2 w-56">Performance Skill</th>
                                            <th class="py-2 px-2">Saved</th>
                                        </tr>
                                    </thead>
                                    <tbody class="divide-y divide-gray-100 dark:divide-slate-800">
                                        <tr v-for="(row, idx) in rows" :key="row.studentId">
                                            <td class="py-2 px-2 text-gray-400">{{ idx + 1 }}</td>
                                            <td class="py-2 px-2 font-medium text-gray-700 dark:text-gray-200">
                                                {{ row.studentName }}
                                            </td>
                                            <td class="py-2 px-2 text-gray-500">{{ row.studentIdentifier }}</td>

                                            <td class="py-2 px-2">
                                                <select class="select w-full"
                                                        v-model="row.performanceAreaId"
                                                        :disabled="editMode"
                                                        @@change="onAreaChanged(row)">
                                                    <option value="">-- Select area --</option>
                                                    <option v-for="a in performanceAreas" :key="a.id" :value="a.id">
                                                        {{ a.name }}
                                                    </option>
                                                </select>
                                            </td>

                                            <td class="py-2 px-2">
                                                <select class="select w-full"
                                                        v-model="row.performanceSkillId"
                                                        :disabled="editMode ? false : !row.performanceAreaId">
                                                    <option value="">-- Select skill --</option>
                                                    <option v-for="s in skillsForArea(row.performanceAreaId)" :key="s.id" :value="s.id">
                                                        {{ s.name }}
                                                    </option>
                                                </select>
                                            </td>

                                            <td class="py-2 px-2">
                                                <div class="flex flex-wrap items-center gap-1">
                                                    <span v-for="sk in row.savedSkills"
                                                          :key="sk.id"
                                                          class="inline-flex items-center gap-1 rounded-full bg-emerald-50 px-2 py-0.5 text-[10px] font-semibold text-emerald-700">
                                                        <i class="bi bi-check-circle"></i>
                                                        <span :title="sk.areaName">{{ sk.name }}</span>
                                                        <button type="button"
                                                                @@click="removeSavedSkill(row, sk)"
                                                                :disabled="busy"
                                                                class="text-emerald-700 hover:text-rose-600 disabled:opacity-50">
                                                            <i class="bi bi-x"></i>
                                                        </button>
                                                    </span>
                                                    <span v-if="!row.savedSkills.length" class="text-[10px] text-gray-400">None</span>
                                                </div>
                                            </td>
                                        </tr>
                                    </tbody>
                                </table>
                            </div>
                        </div>
                    </div>

                    <!-- Footer -->
                    <div class="px-6 py-3.5 border-t border-gray-100 dark:border-slate-700 flex items-center justify-between bg-gray-50/50 dark:bg-slate-800/80">
                        <div class="text-xs text-gray-500">
                            <span>{{ getClassName(form.classId) }}</span>
                            <span v-if="form.termId"> · {{ getTermName(form.termId) }}</span>
                        </div>
                        <div class="flex items-center gap-2">
                            <button type="button"
                                    @@click="closeModal"
                                    class="rounded-lg px-4 py-2 text-xs font-semibold text-gray-700 bg-white border border-gray-200 hover:bg-gray-50 dark:bg-slate-800 dark:border-slate-700 dark:text-gray-200 transition">
                                Close
                            </button>
                            <button type="button"
                                    @@click="save()"
                                    :disabled="saving || (!editMode && !readyRows.length)"
                                    class="inline-flex items-center gap-1.5 rounded-lg px-4 py-2 text-xs font-semibold text-white bg-blue-600 hover:bg-blue-700 transition shadow-sm disabled:opacity-60">
                                <i class="bi" :class="saving ? 'bi-arrow-repeat animate-spin' : 'bi-save'"></i>
                                <span>{{ saving ? 'Saving…' : 'Save' }}</span>
                            </button>
                        </div>
                    </div>
                </div>
            </div>

        </div>
    </div>
</div>

<script src="~/js/school-manager/performance-skills.js" asp-append-version="true"></script>
