@{
    ViewBag.Title = "Boarding Items";
    Layout = "~/Views/Shared/_adminSchoolManagerLayout.cshtml";
}
<div class="content">
    <div class="mb-6 content-header">
        <div class="flex items-center gap-2 text-sm text-gray-500 mb-2">
            <span>School Manager - Main Setups</span>
            <i class="bi bi-chevron-right text-xs"></i>
            <span class="text-blue-600 font-medium">Boarding Items</span>
        </div>

        <div class="flex items-center gap-3">

            <div class="page-title">
                <h2 class="text-2xl font-semibold text-gray-800">
                    Boarding Items
                </h2>
                
            </div>
        </div>
    </div>
    <div class="card" data-card-title="Boarding Items">
        <div id="app">
            <data-grid
                title="Boarding Items"
                :columns="boardingItemColumns"
                :data="boardingItemList"
                :theme="theme"
                row-id="id"
                label-key="name"
                item-label="Boarding Item"
                item-label-plural="Boarding Items"
                add-label="Add Boarding Item"
                :page-size="10"
                :selectable="true"
                :actions="true"
                :loading="isShimmerLoading"
                :stripes="true"
                @@create="onCreateBoardingItem"
                @@update="onUpdateBoardingItem"
                @@delete="onDeleteBoardingItem"
            ></data-grid>
          
        </div>
       
    </div>
</div>
<script src="~/js/school-manager/boardingItems-classrooms.js" asp-append-version="true"></script>
