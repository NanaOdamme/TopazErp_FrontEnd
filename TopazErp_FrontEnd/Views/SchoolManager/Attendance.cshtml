@{
    ViewBag.Title = "Attendance";
    Layout = "~/Views/Shared/_adminSchoolManagerLayout.cshtml";
}

<div class="content">
    <div class="mb-5 content-header">
        <div class="flex items-center gap-2 text-sm text-gray-500 mb-1 dark:text-gray-400">
            <span>School Manager - Data Entry</span>
            <i class="bi bi-chevron-right text-xs"></i>
            <span class="text-blue-600 font-medium dark:text-blue-400">Attendance</span>
        </div>

        <div class="flex flex-col sm:flex-row sm:items-center sm:justify-between gap-3">
            <div>
                <h2 class="text-lg font-bold text-gray-800 dark:text-white tracking-tight flex items-center gap-2.5">
                    Attendance
                </h2>
            </div>
        </div>
    </div>

    <div class="card" data-card-title="Attendance">
        <div id="app">

            <!-- Loader -->
            <div v-if="!setupDone" class="py-24 text-center text-gray-400">
                <i class="text-blue-800 bi bi-arrow-repeat animate-spin text-3xl inline-block mb-2"></i>
                <p class="text-sm">Loading students, classes and attendance records…</p>
            </div>

            <template v-else>
                <!-- ============ Attendance type selector ============ -->
                <div class="mb-5 p-4 rounded-xl border border-gray-200 dark:border-slate-700">
                    <p class="text-xs font-bold text-gray-700 dark:text-gray-200 mb-3 flex items-center gap-1.5">
                        <i class="bi bi-ui-checks text-blue-600"></i>
                        <span>Choose Attendance Type</span>
                    </p>

                    <div class="grid grid-cols-1 sm:grid-cols-2 gap-3">
                        <!-- Daily -->
                        <label class="flex items-start gap-3 p-3 rounded-lg border cursor-pointer transition"
                               :class="attendanceType === 'daily'
                                   ? 'border-blue-500 bg-blue-50/60 dark:bg-blue-950/30'
                                   : 'border-gray-200 dark:border-slate-700 hover:border-blue-300'">
                            <input type="radio" value="daily" v-model="attendanceType" class="mt-1" />
                            <span>
                                <span class="block text-xs font-bold text-gray-800 dark:text-gray-100">
                                    Daily Attendance
                                </span>
                                <span class="block text-[11px] text-gray-500">
                                    Pick a class and a date, then mark each student present or absent.
                                </span>
                            </span>
                        </label>

                        <!-- Cumulative -->
                        <label class="flex items-start gap-3 p-3 rounded-lg border cursor-pointer transition"
                               :class="attendanceType === 'cumulative'
                                   ? 'border-blue-500 bg-blue-50/60 dark:bg-blue-950/30'
                                   : 'border-gray-200 dark:border-slate-700 hover:border-blue-300'">
                            <input type="radio" value="cumulative" v-model="attendanceType" class="mt-1" />
                            <span>
                                <span class="block text-xs font-bold text-gray-800 dark:text-gray-100">
                                    Cumulative Attendance
                                </span>
                                <span class="block text-[11px] text-gray-500">
                                    Record attendance days per student for an academic year and term.
                                </span>
                            </span>
                        </label>
                    </div>
                </div>

                <!-- ==================== DAILY ATTENDANCE ==================== -->
                <div v-show="attendanceType === 'daily'">
                    <div class="flex justify-end gap-1.5 mb-2 flex-wrap">
                        <button type="button"
                                @@click="openDailyModal()"
                                class="border border-[#062a81] text-white px-2.5 py-1.5 text-xs rounded-lg bg-[#062a81] hover:bg-blue-800">
                            <i class="bi bi-plus-lg mr-1"></i>Take Attendance
                        </button>

                        <button type="button"
                                @@click="editSelectedDaily"
                                class="border border-slate-500 text-white px-2.5 py-1.5 text-xs rounded-lg bg-slate-700 hover:bg-slate-600">
                            <i class="bi bi-pencil-square mr-1"></i>Edit Register
                        </button>

                        <button type="button"
                                @@click="deleteSelectedDaily"
                                :disabled="busy"
                                class="border border-rose-600 text-white bg-rose-600 px-2.5 py-1.5 text-xs rounded-lg hover:bg-rose-500 disabled:opacity-60">
                            <i class="bi bi-trash mr-1"></i>Delete
                        </button>
                    </div>

                    <data-grid ref="dailyGrid"
                               title="Daily Attendance"
                               :columns="dailyColumns"
                               :data="attendances"
                               :theme="theme"
                               row-id="id"
                               label-key="studentName"
                               storage-key="school-manager-daily-attendance"
                               item-label="Attendance"
                               item-label-plural="Attendance Records"
                               :page-size="15"
                               :selectable="true"
                               :actions="false"
                               :allow-add="false"
                               :allow-edit="false"
                               :allow-delete="false"
                               :loading="isShimmerLoading"
                               :stripes="true"
                               density="compact">
                    </data-grid>
                </div>

                <!-- ==================== CUMULATIVE ATTENDANCE ==================== -->
                <div v-show="attendanceType === 'cumulative'">
                    <div class="flex justify-end gap-1.5 mb-2 flex-wrap">
                        <button type="button"
                                @@click="openCumulativeModal()"
                                class="border border-[#062a81] text-white px-2.5 py-1.5 text-xs rounded-lg bg-[#062a81] hover:bg-blue-800">
                            <i class="bi bi-plus-lg mr-1"></i>Set Attendance Days
                        </button>

                        <button type="button"
                                @@click="deleteSelectedCumulative"
                                :disabled="busy"
                                class="border border-rose-600 text-white bg-rose-600 px-2.5 py-1.5 text-xs rounded-lg hover:bg-rose-500 disabled:opacity-60">
                            <i class="bi bi-trash mr-1"></i>Delete
                        </button>
                    </div>

                    <data-grid ref="cumulativeGrid"
                               title="Cumulative Attendance"
                               :columns="cumulativeColumns"
                               :data="cumulativeAttendances"
                               :theme="theme"
                               row-id="id"
                               label-key="studentName"
                               storage-key="school-manager-cumulative-attendance"
                               item-label="Cumulative Record"
                               item-label-plural="Cumulative Records"
                               :page-size="15"
                               :selectable="true"
                               :actions="false"
                               :allow-add="false"
                               :allow-edit="false"
                               :allow-delete="false"
                               :loading="isShimmerLoading"
                               :stripes="true"
                               density="compact">
                    </data-grid>
                </div>
            </template>

            <!-- ===================== MODAL: DAILY ATTENDANCE ===================== -->
            <div v-if="dailyModalOpen" class="fixed inset-0 z-50 flex items-center justify-center p-4 bg-black/50 backdrop-blur-sm">
                <div class="w-full max-w-4xl rounded-2xl bg-white dark:bg-slate-800 shadow-2xl border border-gray-100 dark:border-slate-700 overflow-hidden flex flex-col max-h-[92vh]">

                    <!-- Header -->
                    <div class="px-6 py-4 border-b border-gray-100 dark:border-slate-700 flex items-center justify-between bg-white dark:bg-slate-800/80">
                        <div>
                            <h3 class="font-bold text-sm text-gray-800 dark:text-white flex items-center gap-2">
                                <i class="bi bi-calendar-check"></i>
                                <span>Daily Attendance</span>
                            </h3>
                        </div>
                        <button type="button" @@click="closeDailyModal" class="text-gray-400 hover:text-gray-600 dark:hover:text-gray-200 transition">
                            <i class="bi bi-x-lg"></i>
                        </button>
                    </div>

                    <!-- Body -->
                    <div class="p-6 space-y-5 overflow-y-auto flex-1">

                        <div class="grid grid-cols-1 sm:grid-cols-3 gap-4">
                            <div>
                                <w-select v-model="dailyForm.classId"
                                          :options="classes"
                                          display-key="name"
                                          value-key="id"
                                          label="Class:"
                                          @@update:model-value="onDailyClassChanged"
                                          required>
                                </w-select>
                            </div>

                            <div>
                                <label class="label">
                                    Date <span class="text-rose-500">*</span>
                                </label>
                                <input type="date"
                                       v-model="dailyForm.date"
                                       @@change="onDailyDateChanged"
                                       class="input-control" />
                            </div>

                            <div class="flex items-end">
                                <button type="button"
                                        @@click="toggleDailyAll"
                                        class="w-full rounded-lg px-3 py-2 text-xs font-semibold border border-gray-200 dark:border-slate-700 text-gray-700 dark:text-gray-200 hover:bg-gray-50 dark:hover:bg-slate-700 transition">
                                    <i class="bi bi-check2-square mr-1"></i>
                                    {{ dailyAllPresent ? 'Mark all absent' : 'Mark all present' }}
                                </button>
                            </div>
                        </div>

                        <!-- Register -->
                        <div class="rounded-xl border border-gray-200 dark:border-slate-700 p-4">
                            <div class="flex items-center justify-between mb-3 flex-wrap gap-2">
                                <h4 class="text-xs font-bold text-gray-700 dark:text-gray-200 flex items-center gap-1.5">
                                    <i class="bi bi-people text-blue-600"></i>
                                    <span>Class Register ({{ dailyRows.length }})</span>
                                </h4>
                                <div class="flex items-center gap-3 text-[11px]">
                                    <span class="text-emerald-600 font-semibold">Present: {{ dailyPresentCount }}</span>
                                    <span class="text-rose-600 font-semibold">Absent: {{ dailyAbsentCount }}</span>
                                </div>
                            </div>

                            <div v-if="!dailyForm.classId" class="py-4 text-center text-[11px] text-gray-400">
                                Select a class to load its students.
                            </div>
                            <div v-else-if="!dailyRows.length" class="py-4 text-center text-[11px] text-amber-600">
                                <i class="bi bi-info-circle mr-1"></i>
                                No students found for this class.
                            </div>

                            <div v-else class="overflow-x-auto">
                                <table class="w-full text-xs text-left">
                                    <thead class="text-[11px] uppercase tracking-wider text-gray-500 border-b dark:border-slate-700">
                                        <tr>
                                            <th class="py-2 px-2">#</th>
                                            <th class="py-2 px-2">Student Name</th>
                                            <th class="py-2 px-2">Student ID</th>
                                            <th class="py-2 px-2 text-center">Present</th>
                                            <th class="py-2 px-2 text-center">Status</th>
                                        </tr>
                                    </thead>
                                    <tbody class="divide-y divide-gray-100 dark:divide-slate-800">
                                        <tr v-for="(row, idx) in dailyRows" :key="row.studentId"
                                            :class="row.isPresent ? '' : 'bg-rose-50/40 dark:bg-rose-950/20'">
                                            <td class="py-2 px-2 text-gray-400">{{ idx + 1 }}</td>
                                            <td class="py-2 px-2 font-medium text-gray-700 dark:text-gray-200">
                                                {{ row.studentName }}
                                            </td>
                                            <td class="py-2 px-2 text-gray-500">{{ row.studentIdentifier }}</td>
                                            <td class="py-2 px-2 text-center">
                                                <input type="checkbox" v-model="row.isPresent" />
                                            </td>
                                            <td class="py-2 px-2 text-center">
                                                <span v-if="row.isPresent"
                                                      class="inline-flex items-center gap-1 rounded-full bg-emerald-50 px-2 py-0.5 text-[10px] font-semibold text-emerald-700">
                                                    <i class="bi bi-check-circle"></i> Present
                                                </span>
                                                <span v-else
                                                      class="inline-flex items-center gap-1 rounded-full bg-rose-50 px-2 py-0.5 text-[10px] font-semibold text-rose-700">
                                                    <i class="bi bi-x-circle"></i> Absent
                                                </span>
                                                <span v-if="row.existingId" class="ml-1 text-[10px] text-gray-400">(saved)</span>
                                            </td>
                                        </tr>
                                    </tbody>
                                </table>
                            </div>
                        </div>
                    </div>

                    <!-- Footer -->
                    <div class="px-6 py-3.5 border-t border-gray-100 dark:border-slate-700 flex items-center justify-between bg-gray-50/50 dark:bg-slate-800/80">
                        <div class="text-xs text-gray-500">
                            <span>{{ dailyClassName }}</span>
                            <span v-if="dailyForm.date"> · {{ dailyForm.date }}</span>
                        </div>
                        <div class="flex items-center gap-2">
                            <button type="button"
                                    @@click="closeDailyModal"
                                    class="rounded-lg px-4 py-2 text-xs font-semibold text-gray-700 bg-white border border-gray-200 hover:bg-gray-50 dark:bg-slate-800 dark:border-slate-700 dark:text-gray-200 transition">
                                Close
                            </button>
                            <button type="button"
                                    @@click="saveDailyAttendance"
                                    :disabled="saving"
                                    class="inline-flex items-center gap-1.5 rounded-lg px-4 py-2 text-xs font-semibold text-white bg-blue-600 hover:bg-blue-700 transition shadow-sm disabled:opacity-60">
                                <i class="bi" :class="saving ? 'bi-arrow-repeat animate-spin' : 'bi-save'"></i>
                                <span>{{ saving ? 'Saving…' : 'Save Attendance' }}</span>
                            </button>
                        </div>
                    </div>
                </div>
            </div>

            <!-- ===================== MODAL: CUMULATIVE ATTENDANCE ===================== -->
            <div v-if="cumulativeModalOpen" class="fixed inset-0 z-50 flex items-center justify-center p-4 bg-black/50 backdrop-blur-sm">
                <div class="w-full max-w-4xl rounded-2xl bg-white dark:bg-slate-800 shadow-2xl border border-gray-100 dark:border-slate-700 overflow-hidden flex flex-col max-h-[92vh]">

                    <!-- Header -->
                    <div class="px-6 py-4 border-b border-gray-100 dark:border-slate-700 flex items-center justify-between bg-white dark:bg-slate-800/80">
                        <div>
                            <h3 class="font-bold text-sm text-gray-800 dark:text-white flex items-center gap-2">
                                <i class="bi bi-calendar3-range"></i>
                                <span>Cumulative Attendance Days</span>
                            </h3>
                        </div>
                        <button type="button" @@click="closeCumulativeModal" class="text-gray-400 hover:text-gray-600 dark:hover:text-gray-200 transition">
                            <i class="bi bi-x-lg"></i>
                        </button>
                    </div>

                    <!-- Body -->
                    <div class="p-6 space-y-5 overflow-y-auto flex-1">

                        <div class="grid grid-cols-1 sm:grid-cols-3 gap-4">
                            <div>
                                <w-select v-model="cumulativeForm.academicYearId"
                                          :options="academicYears"
                                          display-key="name"
                                          value-key="id"
                                          label="Academic Year:"
                                          @@update:model-value="onCumulativeScopeChanged"
                                          required>
                                </w-select>
                            </div>

                            <div>
                                <w-select v-model="cumulativeForm.termId"
                                          :options="terms"
                                          display-key="name"
                                          value-key="id"
                                          label="Term:"
                                          @@update:model-value="onCumulativeScopeChanged"
                                          required>
                                </w-select>
                            </div>

                            <div>
                                <w-select v-model="cumulativeForm.classId"
                                          :options="classes"
                                          display-key="name"
                                          value-key="id"
                                          label="Class:"
                                          @@update:model-value="onCumulativeScopeChanged"
                                          required>
                                </w-select>
                            </div>
                        </div>

                        <!-- Register -->
                        <div class="rounded-xl border border-gray-200 dark:border-slate-700 p-4">
                            <div class="flex items-center justify-between mb-3 flex-wrap gap-2">
                                <h4 class="text-xs font-bold text-gray-700 dark:text-gray-200 flex items-center gap-1.5">
                                    <i class="bi bi-people text-blue-600"></i>
                                    <span>Students ({{ cumulativeRows.length }})</span>
                                </h4>

                                <div class="flex items-center gap-2">
                                    <input type="number"
                                           min="0"
                                           step="1"
                                           v-model.number="cumulativeFillDays"
                                           placeholder="Days"
                                           class="input-control w-20" />
                                    <button type="button"
                                            @@click="fillCumulativeDays(cumulativeFillDays)"
                                            class="rounded-lg px-2.5 py-2 text-[11px] font-semibold border border-gray-200 dark:border-slate-700 text-gray-700 dark:text-gray-200 hover:bg-gray-50 dark:hover:bg-slate-700 transition">
                                        <i class="bi bi-magic mr-1"></i>Apply to all
                                    </button>
                                </div>
                            </div>

                            <div v-if="!cumulativeForm.classId" class="py-4 text-center text-[11px] text-gray-400">
                                Select a class to load its students.
                            </div>
                            <div v-else-if="!cumulativeRows.length" class="py-4 text-center text-[11px] text-amber-600">
                                <i class="bi bi-info-circle mr-1"></i>
                                No students found for this class.
                            </div>

                            <div v-else class="overflow-x-auto">
                                <table class="w-full text-xs text-left">
                                    <thead class="text-[11px] uppercase tracking-wider text-gray-500 border-b dark:border-slate-700">
                                        <tr>
                                            <th class="py-2 px-2">#</th>
                                            <th class="py-2 px-2">Student Name</th>
                                            <th class="py-2 px-2">Student ID</th>
                                            <th class="py-2 px-2 text-right">Attendance Days</th>
                                        </tr>
                                    </thead>
                                    <tbody class="divide-y divide-gray-100 dark:divide-slate-800">
                                        <tr v-for="(row, idx) in cumulativeRows" :key="row.studentId">
                                            <td class="py-2 px-2 text-gray-400">{{ idx + 1 }}</td>
                                            <td class="py-2 px-2 font-medium text-gray-700 dark:text-gray-200">
                                                {{ row.studentName }}
                                                <span v-if="row.existingId" class="ml-1 text-[10px] text-gray-400">(saved)</span>
                                            </td>
                                            <td class="py-2 px-2 text-gray-500">{{ row.studentIdentifier }}</td>
                                            <td class="py-2 px-2 text-right">
                                                <input type="number"
                                                       min="0"
                                                       step="1"
                                                       v-model.number="row.days"
                                                       class="input-control w-24 text-right" />
                                            </td>
                                        </tr>
                                    </tbody>
                                    <tfoot class="border-t border-gray-200 dark:border-slate-700 text-[11px]">
                                        <tr>
                                            <td class="py-2 px-2 font-semibold text-gray-600 dark:text-gray-300" colspan="3">Total days</td>
                                            <td class="py-2 px-2 text-right font-semibold">{{ cumulativeTotalDays }}</td>
                                        </tr>
                                    </tfoot>
                                </table>
                            </div>
                        </div>
                    </div>

                    <!-- Footer -->
                    <div class="px-6 py-3.5 border-t border-gray-100 dark:border-slate-700 flex items-center justify-between bg-gray-50/50 dark:bg-slate-800/80">
                        <div class="text-xs text-gray-500">
                            <span>{{ cumulativeClassName }}</span>
                            <span v-if="cumulativeForm.termId"> · {{ getTermName(cumulativeForm.termId) }}</span>
                        </div>
                        <div class="flex items-center gap-2">
                            <button type="button"
                                    @@click="closeCumulativeModal"
                                    class="rounded-lg px-4 py-2 text-xs font-semibold text-gray-700 bg-white border border-gray-200 hover:bg-gray-50 dark:bg-slate-800 dark:border-slate-700 dark:text-gray-200 transition">
                                Close
                            </button>
                            <button type="button"
                                    @@click="saveCumulativeAttendance"
                                    :disabled="saving"
                                    class="inline-flex items-center gap-1.5 rounded-lg px-4 py-2 text-xs font-semibold text-white bg-blue-600 hover:bg-blue-700 transition shadow-sm disabled:opacity-60">
                                <i class="bi" :class="saving ? 'bi-arrow-repeat animate-spin' : 'bi-save'"></i>
                                <span>{{ saving ? 'Saving…' : 'Save Attendance' }}</span>
                            </button>
                        </div>
                    </div>
                </div>
            </div>

        </div>
    </div>
</div>

<script src="~/js/school-manager/attendance.js" asp-append-version="true"></script>
