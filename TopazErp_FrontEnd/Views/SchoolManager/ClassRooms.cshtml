@{
    ViewBag.Title = "Class Rooms";
    Layout = "~/Views/Shared/_adminSchoolManagerLayout.cshtml";
}
<div class="content">
    <div class="mb-6 content-header">
        <div class="flex items-center gap-2 text-sm text-gray-500 mb-2">
            <span>School Manager - Main Setups</span>
            <i class="bi bi-chevron-right text-xs"></i>
            <span class="text-blue-600 font-medium">Class Rooms</span>
        </div>

        <div class="flex items-center gap-3">

            <div class="page-title">
                <h2 class="text-lg font-semibold text-gray-800">
                    Class Rooms
                </h2>
                
            </div>
        </div>
    </div>
    <div class="card" data-card-title="Class Rooms">
        <div id="app">
         
            <data-grid
                title="Class Rooms"
                :columns="classRoomColumns"
                :data="classRoomList"
                :theme="theme"
                row-id="id"
                label-key="name"
                item-label="Class Room"
                item-label-plural="Class Rooms"
                add-label="Add Class Room"
                :page-size="10"
                :selectable="true"
                :actions="true"
                :loading="isShimmerLoading"
                :stripes="true"
                @@create="onCreateClassRoom"
                @@update="onUpdateClassRoom"
                @@delete="onDeleteClassRoom"
            ></data-grid>
        </div>
       
    </div>
</div>
<script src="~/js/school-manager/boardingItems-classrooms.js" asp-append-version="true"></script>
