@{
    ViewBag.Title = "Class Registration";
    Layout = "~/Views/Shared/_adminSchoolManagerLayout.cshtml";
}

<div class="content">
    <div class="mb-4 content-header">
        <div class="flex items-center gap-2 text-sm text-gray-500 mb-1.5 dark:text-gray-400">
            <span>School Manager - Data Entries</span>
            <i class="bi bi-chevron-right text-xs"></i>
            <span class="text-blue-600 font-medium dark:text-blue-400">Class Registration</span>
        </div>

        <div class="flex items-center gap-3">
            <div class="page-title">
                <h2 class="text-lg font-semibold text-gray-800 dark:text-white">
                    Class Registration
                </h2>
            </div>
        
        </div>
    </div>

    <div class="card" data-card-title="Class Registration">
        <div id="app">

        

            <!-- Initial Loading -->
            <div v-if="!setupDone" class="py-20 text-center text-gray-400">
                <i class="text-blue-800 bi bi-arrow-repeat animate-spin text-3xl inline-block mb-2 text-[#062a81]"></i>
                <p class="text-sm">Loading registered classes…</p>
            </div>

            <!-- Data Table View -->
            <template v-else>
                <data-grid title="Registered Classes"
                           :columns="columns"
                           :data="filteredClasses"
                           :theme="theme"
                           row-id="id"
                           label-key="className"
                           item-label="Registered Class"
                           item-label-plural="Registered Classes"
                           add-label="Register Class"
                           :page-size="10"
                           :selectable="true"
                           :actions="true"
                           :loading="isShimmerLoading"
                           :stripes="true"
                           density="compact"
                           @@create="onCreate"
                           @@update="onUpdate"
                           @@delete="onDelete">
                </data-grid>
            </template>

        </div>
    </div>
</div>

<script src="~/js/school-manager/registered-classes.js"></script>
