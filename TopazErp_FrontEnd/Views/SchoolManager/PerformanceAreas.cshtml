@{
    ViewBag.Title = "Performance Areas";
    Layout = "~/Views/Shared/_adminSchoolManagerLayout.cshtml";
}
<div class="content">
    <div class="mb-6 content-header">
        <div class="flex items-center gap-2 text-sm text-gray-500 mb-2">
            <span>School Manager - Main Setups</span>
            <i class="bi bi-chevron-right text-xs"></i>
            <span class="text-blue-600 font-medium">Performance Areas & Skills</span>
        </div>

        <div class="flex items-center gap-3">
            <div class="page-title">
                <h2 class="text-lg font-semibold text-gray-800">
                    Performance Areas & Skills
                </h2>
            </div>
        </div>
    </div>
    <div class="card" data-card-title="Performance Area & Skills">
        <div id="app">
            <data-grid
                title="Performance Areas"
                :columns="columns"
                :data="performanceAreaList"
                :theme="theme"
                row-id="id"
                label-key="name"
                item-label="Performance Area"
                item-label-plural="Performance Areas"
                add-label="Add Performance Area"
                :page-size="10"
                :selectable="true"
                :actions="true"
                :loading="isShimmerLoading"
                :stripes="true"
                @@create="onCreate"
                @@update="onUpdate"
                @@delete="onDelete"
            ></data-grid>

            <!-- ===================== PERFORMANCE SKILLS ===================== -->
            <div class="mt-6 pt-6 border-t border-gray-100">
                <data-grid
                    title="Performance Skills"
                    :columns="skillColumns"
                    :data="performanceSkillList"
                    :theme="theme"
                    row-id="id"
                    label-key="name"
                    item-label="Performance Skill"
                    item-label-plural="Performance Skills"
                    add-label="Add Performance Skill"
                    :page-size="10"
                    :selectable="true"
                    :actions="true"
                    :loading="isShimmerLoading"
                    :stripes="true"
                    @@create="onCreateSkill"
                    @@update="onUpdateSkill"
                    @@delete="onDeleteSkill"
                ></data-grid>
            </div>
        </div>
    </div>
</div>

<script src="~/js/school-manager/performance-areas.js" asp-append-version="true"></script>
