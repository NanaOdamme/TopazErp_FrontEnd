@{
    ViewBag.Title = "Student Promotion";
    Layout = "~/Views/Shared/_adminSchoolManagerLayout.cshtml";
}

<div class="content">
    <div class="mb-5 content-header">
        <div class="flex items-center gap-2 text-sm text-gray-500 mb-1 dark:text-gray-400">
            <span>School Manager - Promotions & Results</span>
            <i class="bi bi-chevron-right text-xs"></i>
            <span class="text-blue-600 font-medium dark:text-blue-400">Student Promotion</span>
        </div>

        <div class="flex flex-col sm:flex-row sm:items-center sm:justify-between gap-3">
            <div>
                <h2 class="text-lg font-bold text-gray-800 dark:text-white tracking-tight flex items-center gap-2.5">
                    Student Promotion
                </h2>
            </div>
        </div>
    </div>

    <div class="card" data-card-title="Student Promotion">
        <div id="app">

            <!-- Loader -->
            <div v-if="!setupDone" class="py-24 text-center text-gray-400">
                <i class="text-blue-800 bi bi-arrow-repeat animate-spin text-3xl inline-block mb-2"></i>
                <p class="text-sm">Loading classes, students and promotions…</p>
            </div>

            <template v-else>
                <!-- Tabs -->
                <div class="flex items-center gap-2 mb-5 border-b border-gray-200 dark:border-slate-700">
                    <button type="button"
                            class="inline-flex items-center gap-2 whitespace-nowrap border-b-2 -mb-px px-4 py-2.5 text-sm font-semibold transition-colors"
                            :class="activeTab === 'class'
                                ? 'text-blue-700 border-blue-600 dark:text-blue-400 dark:border-blue-500'
                                : 'text-gray-500 border-transparent hover:text-blue-700 dark:text-gray-400'"
                            @@click="activeTab = 'class'">
                        <i class="bi bi-mortarboard"></i>
                        <span>Class Promotion</span>
                    </button>

                    <button type="button"
                            class="inline-flex items-center gap-2 whitespace-nowrap border-b-2 -mb-px px-4 py-2.5 text-sm font-semibold transition-colors"
                            :class="activeTab === 'pre'
                                ? 'text-blue-700 border-blue-600 dark:text-blue-400 dark:border-blue-500'
                                : 'text-gray-500 border-transparent hover:text-blue-700 dark:text-gray-400'"
                            @@click="activeTab = 'pre'">
                        <i class="bi bi-person-badge"></i>
                        <span>Pre-Class Promotion</span>
                    </button>
                </div>

                <div class="flex justify-end gap-1.5 mb-2 flex-wrap">
                    <button type="button"
                            @@click="openCreateModal()"
                            class="border border-[#062a81] text-white px-2.5 py-1.5 text-xs rounded-lg bg-[#062a81] hover:bg-blue-800">
                        <i class="bi bi-plus-lg mr-1"></i>New Promotion
                    </button>

                    <button type="button"
                            @@click="viewSelected()"
                            class="border border-slate-500 text-white px-2.5 py-1.5 text-xs rounded-lg bg-slate-700 hover:bg-slate-600">
                        <i class="bi bi-eye mr-1"></i>View Students
                    </button>

                    <button type="button"
                            @@click="editSelected()"
                            class="border border-amber-500 text-white bg-amber-600 px-2.5 py-1.5 text-xs rounded-lg hover:bg-amber-500">
                        <i class="bi bi-pencil-square mr-1"></i>Edit
                    </button>
                </div>

                <!-- ============ CLASS PROMOTION ============ -->
                <div v-show="activeTab === 'class'">
                    <data-grid ref="promoGrid"
                               title="Class Promotions"
                               :columns="columns"
                               :data="promotions"
                               :theme="theme"
                               row-id="id"
                               label-key="fromClassId"
                               storage-key="school-manager-promotions"
                               item-label="Promotion"
                               item-label-plural="Promotions"
                               :page-size="10"
                               :selectable="true"
                               :actions="false"
                               :allow-add="false"
                               :allow-edit="false"
                               :allow-delete="false"
                               :loading="isShimmerLoading"
                               :stripes="true"
                               density="compact">
                    </data-grid>
                </div>

                <!-- ============ PRE-CLASS PROMOTION ============ -->
                <div v-show="activeTab === 'pre'">
                    <data-grid ref="preGrid"
                               title="Pre-Class Promotions"
                               :columns="columns"
                               :data="prePromotions"
                               :theme="theme"
                               row-id="id"
                               label-key="fromClassId"
                               storage-key="school-manager-pre-promotions"
                               item-label="Pre-Class Promotion"
                               item-label-plural="Pre-Class Promotions"
                               :page-size="10"
                               :selectable="true"
                               :actions="false"
                               :allow-add="false"
                               :allow-edit="false"
                               :allow-delete="false"
                               :loading="isShimmerLoading"
                               :stripes="true"
                               density="compact">
                    </data-grid>
                </div>
            </template>

            <!-- ===================== PROMOTION MODAL ===================== -->
            <div v-if="modalOpen" class="fixed inset-0 z-50 flex items-center justify-center p-4 bg-black/50 backdrop-blur-sm">
                <div class="w-full max-w-5xl rounded-2xl bg-white dark:bg-slate-800 shadow-2xl border border-gray-100 dark:border-slate-700 overflow-hidden flex flex-col max-h-[92vh]">

                    <!-- Header -->
                    <div class="px-6 py-4 border-b border-gray-100 dark:border-slate-700 flex items-center justify-between bg-white dark:bg-slate-800/80">
                        <div>
                            <h3 class="font-bold text-sm text-gray-800 dark:text-white flex items-center gap-2">
                                <i class="bi bi-mortarboard"></i>
                                <span>{{ editMode ? 'Edit Promotion' : 'New Promotion' }} — {{ isPreTab ? 'Pre-Class Students' : 'Class Students' }}</span>
                            </h3>
                        </div>
                        <button type="button" @@click="closeModal" class="text-gray-400 hover:text-gray-600 dark:hover:text-gray-200 transition">
                            <i class="bi bi-x-lg"></i>
                        </button>
                    </div>

                    <!-- Body -->
                    <div class="p-6 space-y-5 overflow-y-auto flex-1">

                        <!-- Scope -->
                        <div class="grid grid-cols-1 sm:grid-cols-2 gap-4">
                            <div>
                                <w-select v-model="form.academicYearId"
                                          :options="academicYears"
                                          display-key="name"
                                          value-key="id"
                                          label="Academic Year:"
                                          required>
                                </w-select>
                            </div>

                            <div>
                                <w-select v-model="form.fromClassId"
                                          :options="classes"
                                          display-key="name"
                                          value-key="id"
                                          label="From Class:"
                                          @@update:model-value="onFromClassChanged"
                                          required>
                                </w-select>
                            </div>
                        </div>

                        <!-- Promotion type -->
                        <div class="rounded-xl border border-gray-200 dark:border-slate-700 p-4">
                            <p class="text-xs font-bold text-gray-700 dark:text-gray-200 mb-3 flex items-center gap-1.5">
                                <i class="bi bi-signpost-split text-blue-600"></i>
                                <span>Promotion Type</span>
                            </p>

                            <div class="grid grid-cols-1 sm:grid-cols-2 gap-3">
                                <label class="flex items-start gap-2.5 p-3 rounded-lg border cursor-pointer transition"
                                       :class="form.mode === 'individual'
                                           ? 'border-blue-500 bg-blue-50/60 dark:bg-blue-950/30'
                                           : 'border-gray-200 dark:border-slate-700 hover:border-blue-300'">
                                    <input type="radio" value="individual" v-model="form.mode" class="mt-1" @@change="onModeChanged" />
                                    <span>
                                        <span class="block text-xs font-bold text-gray-800 dark:text-gray-100">Individual Class</span>
                                        <span class="block text-[11px] text-gray-500">Promote the selected students of this class.</span>
                                    </span>
                                </label>

                                <label class="flex items-start gap-2.5 p-3 rounded-lg border cursor-pointer transition"
                                       :class="form.mode === 'alumni'
                                           ? 'border-rose-400 bg-rose-50/60 dark:bg-rose-950/30'
                                           : 'border-gray-200 dark:border-slate-700 hover:border-rose-300'">
                                    <input type="radio" value="alumni" v-model="form.mode" class="mt-1" @@change="onModeChanged" />
                                    <span>
                                        <span class="block text-xs font-bold text-gray-800 dark:text-gray-100">Alumni</span>
                                        <span class="block text-[11px] text-gray-500">Flag the selected students as alumni and clear their class.</span>
                                    </span>
                                </label>
                            </div>
                        </div>

                        <!-- Destination -->
                        <div v-if="form.mode === 'individual'" class="grid grid-cols-1 sm:grid-cols-2 gap-4">
                            <div>
                                <w-select v-model="form.toClassId"
                                          :options="toClassOptions"
                                          display-key="name"
                                          value-key="id"
                                          label="To Class:"
                                          @@update:model-value="onToClassChanged"
                                          required>
                                </w-select>
                            </div>
                            <div class="text-[11px] text-gray-500 self-end pb-2">
                                Applied to every selected student; you can still change it per student below.
                            </div>
                        </div>

                        <div v-if="form.mode === 'alumni'"
                             class="p-3 rounded-xl border border-rose-200 bg-rose-50 text-rose-700 text-[11px]">
                            <i class="bi bi-exclamation-triangle-fill mr-1"></i>
                            All selected students will be moved to Alumni.
                        </div>

                        <!-- Roster -->
                        <div class="rounded-xl border border-gray-200 dark:border-slate-700 p-4">
                            <div class="flex items-center justify-between mb-3 flex-wrap gap-2">
                                <h4 class="text-xs font-bold text-gray-700 dark:text-gray-200 flex items-center gap-1.5">
                                    <i class="bi bi-people text-blue-600"></i>
                                    <span>Students ({{ rows.length }})</span>
                                </h4>

                                <button type="button"
                                        @@click="toggleAllSelected"
                                        class="rounded-lg px-2.5 py-1.5 text-[11px] font-semibold border border-gray-200 dark:border-slate-700 text-gray-700 dark:text-gray-200 hover:bg-gray-50 dark:hover:bg-slate-700 transition">
                                    <i class="bi bi-check2-square mr-1"></i>
                                    {{ allSelected ? 'Deselect all' : 'Select all' }}
                                </button>
                            </div>

                            <div v-if="!rows.length" class="py-4 text-center text-[11px] text-amber-600">
                                <i class="bi bi-info-circle mr-1"></i>
                                <span v-if="isPreTab">No pre-class students found for this selection.</span>
                                <span v-else>No students found for this selection.</span>
                            </div>

                            <div v-else class="overflow-x-auto max-h-80 overflow-y-auto">
                                <table class="w-full text-xs text-left">
                                    <thead class="text-[11px] uppercase tracking-wider text-gray-500 border-b dark:border-slate-700 sticky top-0 bg-white dark:bg-slate-800">
                                        <tr>
                                            <th class="py-2 px-2 w-10">
                                                <input type="checkbox" :checked="allSelected" @@change="toggleAllSelected" />
                                            </th>
                                            <th class="py-2 px-2">#</th>
                                            <th class="py-2 px-2">Student Name</th>
                                            <th class="py-2 px-2">Student ID</th>
                                            <th class="py-2 px-2" v-if="form.mode !== 'individual'">Current Class</th>
                                            <th class="py-2 px-2 w-52" v-if="form.mode === 'individual'">Promote To</th>
                                        </tr>
                                    </thead>
                                    <tbody class="divide-y divide-gray-100 dark:divide-slate-800">
                                        <tr v-for="(row, idx) in rows" :key="row.studentId">
                                            <td class="py-2 px-2">
                                                <input type="checkbox" v-model="row.selected" />
                                            </td>
                                            <td class="py-2 px-2 text-gray-400">{{ idx + 1 }}</td>
                                            <td class="py-2 px-2 font-medium text-gray-700 dark:text-gray-200">
                                                {{ row.studentName }}
                                            </td>
                                            <td class="py-2 px-2 text-gray-500">{{ row.studentIdentifier }}</td>
                                            <td class="py-2 px-2 text-gray-500" v-if="form.mode !== 'individual'">
                                                {{ row.className }}
                                            </td>
                                            <td class="py-2 px-2" v-if="form.mode === 'individual'">
                                                <select class="select w-full" v-model="row.toClassId" :disabled="!row.selected">
                                                    <option value="">-- Select class --</option>
                                                    <option v-for="c in toClassOptions" :key="c.id" :value="c.id">{{ c.name }}</option>
                                                </select>
                                            </td>
                                        </tr>
                                    </tbody>
                                </table>
                            </div>
                        </div>
                    </div>

                    <!-- Footer -->
                    <div class="px-6 py-3.5 border-t border-gray-100 dark:border-slate-700 flex items-center justify-between bg-gray-50/50 dark:bg-slate-800/80">
                        <div class="text-xs text-gray-500">
                            <span>{{ fromClassName || '—' }}</span>
                            <span v-if="form.mode === 'alumni'"> → Alumni</span>
                            <span v-else-if="selectedToClassName"> → {{ selectedToClassName }}</span>
                            <span> · {{ selectedCount }} selected</span>
                        </div>
                        <div class="flex items-center gap-2">
                            <button type="button"
                                    @@click="closeModal"
                                    class="rounded-lg px-4 py-2 text-xs font-semibold text-gray-700 bg-white border border-gray-200 hover:bg-gray-50 dark:bg-slate-800 dark:border-slate-700 dark:text-gray-200 transition">
                                Close
                            </button>
                            <button type="button"
                                    @@click="save()"
                                    :disabled="saving || !canSave"
                                    class="inline-flex items-center gap-1.5 rounded-lg px-4 py-2 text-xs font-semibold text-white bg-blue-600 hover:bg-blue-700 transition shadow-sm disabled:opacity-60">
                                <i class="bi" :class="saving ? 'bi-arrow-repeat animate-spin' : 'bi-mortarboard'"></i>
                                <span>{{ saving ? 'Saving…' : (editMode ? 'Update Promotion' : 'Promote Students') }}</span>
                            </button>
                        </div>
                    </div>
                </div>
            </div>

            <!-- ===================== VIEW PROMOTED STUDENTS ===================== -->
            <div v-if="viewerOpen" class="fixed inset-0 z-50 flex items-center justify-center p-4 bg-black/50 backdrop-blur-sm">
                <div class="w-full max-w-3xl rounded-2xl bg-white dark:bg-slate-800 shadow-2xl border border-gray-100 dark:border-slate-700 overflow-hidden flex flex-col max-h-[85vh]">
                    <div class="px-6 py-4 border-b border-gray-100 dark:border-slate-700 flex items-center justify-between">
                        <h3 class="font-bold text-sm text-gray-800 dark:text-white flex items-center gap-2">
                            <i class="bi bi-people"></i>
                            <span>Promoted Students</span>
                        </h3>
                        <button type="button" @@click="viewerOpen = false" class="text-gray-400 hover:text-gray-600 dark:hover:text-gray-200 transition">
                            <i class="bi bi-x-lg"></i>
                        </button>
                    </div>

                    <div class="px-6 py-3 text-[11px] text-gray-500">{{ viewerTitle }} · {{ viewerRows.length }} student(s)</div>

                    <div class="p-6 pt-0 overflow-y-auto flex-1">
                        <table class="w-full text-xs text-left">
                            <thead class="text-[11px] uppercase tracking-wider text-gray-500 border-b dark:border-slate-700">
                                <tr>
                                    <th class="py-2 px-2">#</th>
                                    <th class="py-2 px-2">Student Name</th>
                                    <th class="py-2 px-2">Student ID</th>
                                    <th class="py-2 px-2">To Class</th>
                                </tr>
                            </thead>
                            <tbody class="divide-y divide-gray-100 dark:divide-slate-800">
                                <tr v-for="(s, i) in viewerRows" :key="s.studentId">
                                    <td class="py-2 px-2 text-gray-400">{{ i + 1 }}</td>
                                    <td class="py-2 px-2 font-medium text-gray-700 dark:text-gray-200">{{ s.studentName }}</td>
                                    <td class="py-2 px-2 text-gray-500">{{ s.studentIdentifier }}</td>
                                    <td class="py-2 px-2 text-gray-500">{{ s.toClassName || '—' }}</td>
                                </tr>
                            </tbody>
                        </table>
                    </div>

                    <div class="px-6 py-3.5 border-t border-gray-100 dark:border-slate-700 flex justify-end bg-gray-50/50 dark:bg-slate-800/80">
                        <button type="button"
                                @@click="viewerOpen = false"
                                class="rounded-lg px-4 py-2 text-xs font-semibold text-gray-700 bg-white border border-gray-200 hover:bg-gray-50 dark:bg-slate-800 dark:border-slate-700 dark:text-gray-200 transition">
                            Close
                        </button>
                    </div>
                </div>
            </div>

        </div>
    </div>
</div>

<script src="~/js/school-manager/promotion.js" asp-append-version="true"></script>
