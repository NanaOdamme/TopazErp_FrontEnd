@{
    ViewBag.Title = "Payment Methods";
    Layout = "~/Views/Shared/_adminSchoolManagerLayout.cshtml";
}
<div class="content">
    <div class="mb-6 content-header">
        <div class="flex items-center gap-2 text-sm text-gray-500 mb-2">
            <span>School Manager - Main Setups</span>
            <i class="bi bi-chevron-right text-xs"></i>
            <span class="text-blue-600 font-medium">Payment Methods</span>
        </div>

        <div class="flex items-center gap-3">
            <div class="page-title">
                <h2 class="text-lg font-semibold text-gray-800">
                    Payment Methods
                </h2>
            </div>
        </div>
    </div>
    <div class="card" data-card-title="Payment Methods">
        <div id="app">
            <data-grid
                title="Payment Methods"
                :columns="columns"
                :data="paymentMethods"
                :theme="theme"
                row-id="id"
                label-key="name"
                item-label="Payment Methods"
                item-label-plural="Payment Methods"
                :page-size="10"
                :selectable="true"
                :loading="isShimmerLoading"
                :stripes="true"
                :allow-add="false"
                :allow-edit="false"
                :allow-delete="false"
            ></data-grid>
        </div>
    </div>
</div>
<script src="~/js/school-manager/payment-methods.js" asp-append-version="true"></script>