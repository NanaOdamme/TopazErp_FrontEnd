@{
    ViewBag.Title = "Process Bills";
    Layout = "~/Views/Shared/_adminSchoolManagerLayout.cshtml";
}

<div class="content">
    <div class="mb-5 content-header">
        <div class="flex items-center gap-2 text-sm text-gray-500 mb-1 dark:text-gray-400">
            <span>School Manager - Billing & Payments</span>
            <i class="bi bi-chevron-right text-xs"></i>
            <span class="text-blue-600 font-medium dark:text-blue-400">Process Bills</span>
        </div>

        <div class="flex flex-col sm:flex-row sm:items-center sm:justify-between gap-3">
            <div>
                <h2 class="text-lg font-bold text-gray-800 dark:text-white tracking-tight flex items-center gap-2.5">
                    Student Billing & Invoicing
                </h2>
              
            </div>

        </div>
    </div>

    <!-- Main Card -->
    <div class="card" data-card-title="Process Bills">
        <div id="app">
            <!-- Tabs: Class Bills | Student Bill Invoices -->
            <div class="flex items-center gap-2 mb-5 border-b border-gray-200 dark:border-slate-700">
                <button type="button"
                        class="inline-flex items-center gap-2 whitespace-nowrap border-b-2 -mb-px px-4 py-2.5 text-sm font-semibold transition-colors"
                        :class="activeTab === 'bills'
                            ? 'text-blue-700 border-blue-600 dark:text-blue-400 dark:border-blue-500'
                            : 'text-gray-500 border-transparent hover:text-blue-700 dark:text-gray-400'"
                        @@click="activeTab = 'bills'">
                    <i class="bi bi-file-earmark-spreadsheet"></i>
                    <span>Process Bills</span>
                   </button>

                <button type="button"
                        class="inline-flex items-center gap-2 whitespace-nowrap border-b-2 -mb-px px-4 py-2.5 text-sm font-semibold transition-colors"
                        :class="activeTab === 'studentBills'
                            ? 'text-blue-700 border-blue-600 dark:text-blue-400 dark:border-blue-500'
                            : 'text-gray-500 border-transparent hover:text-blue-700 dark:text-gray-400'"
                        @@click="activeTab = 'studentBills'">
                    <i class="bi bi-person-lines-fill"></i>
                    <span>Student Bill Records</span>
                     </button>
            </div>

            <!-- Loader -->
            <div v-if="!setupDone" class="py-24 text-center text-gray-400">
                <i class="text-blue-800 bi bi-arrow-repeat animate-spin text-3xl inline-block mb-2 text-[#062a81]"></i>
                <p class="text-sm">Loading bills, students, and setup lookups…</p>
            </div>

            <template v-else>
                <!-- ================= TAB 1: CLASS BILLS ================= -->
                <div v-show="activeTab === 'bills'">
                    <!-- Custom Toolbar for Selected Rows Actions -->
                    <div class="flex justify-end gap-1.5 mb-2 flex-wrap">
                        <button type="button"
                                @@click="openBillModal()"
                                class="border border-[#062a81] text-white px-2.5 py-1.5 text-xs rounded-lg bg-[#062a81] hover:bg-blue-800 hover:text-white">
                            <i class="bi bi-plus-lg mr-1"></i>Process
                        </button>

                        <button type="button"
                                @@click="editSelectedBill"
                                class="border border-slate-500 text-white px-2.5 py-1.5 text-xs rounded-lg bg-slate-700 hover:bg-slate-600 hover:text-white">
                            <i class="bi bi-pencil-square mr-1"></i>Edit
                        </button>

                    
                    </div>
                    <!-- DataGrid for Class Bills (actions disabled: creation and edit done via modal) -->
                    <data-grid ref="billsGrid"
                               title="Class Bills"
                               :columns="billColumns"
                               :child="detailSubgrid"
                               :data="bills"
                               :theme="theme"
                               row-id="id"
                               label-key="billNumber"
                               item-label="Bill"
                               item-label-plural="Bills"
                               :page-size="10"
                               :selectable="true"
                               :actions="false"
                               :allow-add="false"
                               :allow-edit="false"
                               :allow-delete="false"
                               :loading="isShimmerLoading"
                               :stripes="true"
                               density="compact">
                    </data-grid>
                </div>

                <!-- ================= TAB 2: STUDENT BILL RECORDS ================= -->
                <div v-show="activeTab === 'studentBills'">
                
                    <!-- Actions Toolbar for Student Bills -->
                    <div class="flex justify-end gap-1.5 mb-2 flex-wrap">
                        <button type="button"
                                @@click="cancelSelectedStudentBills"
                                class="border border-rose-600 text-white bg-rose-600 px-2.5 py-1.5 text-xs rounded-lg hover:bg-rose-400 hover:text-white">
                            <i class="bi bi-x-circle mr-1"></i>Cancel
                        </button>
                    </div>

                    <data-grid ref="studentBillsGrid"
                               title="Student Bill Records"
                               :columns="studentBillColumns"
                               :data="studentBills"
                               :theme="theme"
                               row-id="id"
                               label-key="studentName"
                               item-label="Student Bill"
                               item-label-plural="Student Bills"
                               :page-size="15"
                               :selectable="true"
                               :actions="false"
                               :allow-add="false"
                               :allow-edit="false"
                               :allow-delete="false"
                               :loading="isShimmerLoading"
                               :stripes="true"
                               density="compact">
                    </data-grid>
                </div>
            </template>

            <!-- MODAL: Create / Edit Class Bill with Fee Items & Class Students using w-select -->
            <div v-if="billModalOpen" class="fixed inset-0 z-50 flex items-center justify-center p-4 bg-black/50 backdrop-blur-sm">
                <div class="w-full max-w-4xl rounded-2xl bg-white dark:bg-slate-800 shadow-2xl border border-gray-100 dark:border-slate-700 overflow-hidden flex flex-col max-h-[92vh]">
                    
                    <!-- Modal Header -->
                    <div class="px-6 py-4 border-b border-gray-100 dark:border-slate-700 flex items-center justify-between bg-white dark:bg-slate-800/80">
                        <div>
                            <h3 class="font-bold text-sm text-gray-800 dark:text-white flex items-center gap-2">
                                <i class="bi bi-receipt"></i>
                                <span>{{ activeBill.id ? 'Edit Bill' : 'New Bill' }}</span>
                            </h3>
                          
                        </div>
                        <button type="button"
                                @@click="closeBillModal"
                                class="text-gray-400 hover:text-gray-600 dark:hover:text-gray-200 transition">
                            <i class="bi bi-x-lg "></i>
                        </button>
                    </div>

                    <!-- Modal Body -->
                    <div class="p-6 space-y-5 overflow-y-auto flex-1">
                        <!-- Top Form Controls with w-select -->
                        <div class="grid grid-cols-1 sm:grid-cols-2 md:grid-cols-4 gap-4">
                            <div>
                                <w-select v-model="activeBill.academicYearId"
                                          :options="academicYears"
                                          display-key="name"
                                          value-key="id"
                                          label="Academic Year:"
                                          :disabled="activeBill.isPosted"
                                          required>
                                </w-select>
                            </div>

                            <div>
                                <w-select v-model="activeBill.termId"
                                          :options="terms"
                                          display-key="name"
                                          value-key="id"
                                          label="Term:"
                                          :disabled="activeBill.isPosted"
                                          required>
                                </w-select>
                            </div>

                            <div>
                                <w-select v-model="activeBill.classId"
                                          :options="classes"
                                          display-key="name"
                                          value-key="id"
                                          label="Class:"
                                          :disabled="activeBill.isPosted"
                                          @@update:model-value="onClassChanged"
                                          required>
                                </w-select>
                            </div>

                            <div>
                                <w-select v-model="activeBill.billTypeId"
                                          :options="billTypes"
                                          display-key="name"
                                          value-key="id"
                                          label="Bill Type:"
                                          :disabled="activeBill.isPosted"
                                          @@update:model-value="onBillTypeChanged"
                                          required>
                                </w-select>
                            </div>
                        </div>

                        <!-- Supplementary Fixed vs Not Fixed Toggle -->
                        <div v-if="Number(activeBill.billTypeId) === 2"
                             class="p-3.5 rounded-xl border border-indigo-100 bg-indigo-50/50 dark:border-indigo-900/50 dark:bg-indigo-950/20 flex flex-col sm:flex-row sm:items-center sm:justify-between gap-3">
                            <div>
                                <h5 class="text-xs font-bold text-indigo-900 dark:text-indigo-300 flex items-center gap-1.5">
                                    <i class="bi bi-sliders text-indigo-600"></i>
                                    <span>Supplementary Category</span>
                                </h5>
                            
                            </div>
                            <div class="flex items-center gap-3 text-xs">
                                <label class="inline-flex items-center gap-1.5 cursor-pointer">
                                    <input type="radio"
                                           :value="true"
                                           v-model="isSupplementaryFixed"
                                           :disabled="activeBill.isPosted"
                                           @@change="onSupplementaryModeChanged"
                                           class="text-indigo-600" />
                                    <span class="font-medium text-gray-700 dark:text-gray-200">Fixed Supplementary</span>
                                </label>
                                <label class="inline-flex items-center gap-1.5 cursor-pointer">
                                    <input type="radio"
                                           :value="false"
                                           v-model="isSupplementaryFixed"
                                           :disabled="activeBill.isPosted"
                                           @@change="onSupplementaryModeChanged"
                                           class="text-indigo-600" />
                                    <span class="font-medium text-gray-700 dark:text-gray-200">Not Fixed (Discounts Allowed)</span>
                                </label>
                            </div>
                        </div>

                        <div class="grid grid-cols-1 sm:grid-cols-3 gap-4">
                            <div>
                                <label class="label">Bill Number</label>
                                <input type="text"
                                       v-model="activeBill.billNumber"
                                       :disabled="activeBill.isPosted"
                                       placeholder="Auto-generated if blank"
                                       class="input-control text-xs" />
                            </div>

                            <div>
                                <label class="label">Bill Date <span class="text-rose-500">*</span></label>
                                <input type="date"
                                       v-model="activeBill.billDate"
                                       :disabled="activeBill.isPosted"
                                       class="input-control text-xs" />
                            </div>

                            <div>
                                <label class="label">Batch Number</label>
                                <input type="text"
                                       v-model="activeBill.batchNumber"
                                       :disabled="activeBill.isPosted"
                                       placeholder="Optional batch code"
                                       class="input-control text-xs" />
                            </div>
                        </div>

                        <!-- Section: Fee Details Breakdown -->
                        <div class="border rounded-xl p-4 bg-white dark:border-slate-700 dark:bg-slate-800/40">
                            <div class="flex items-center justify-between mb-3">
                                <div>
                                    <h4 class="text-xs font-bold text-gray-700 dark:text-gray-200 flex items-center gap-1.5">
                                        <i class="bi bi-card-checklist text-blue-600"></i>
                                        <span>Fee Items</span>
                                    </h4>
                                    <p class="text-[11px] text-gray-400">Total Bill Base Amount: <strong class="text-gray-700 dark:text-gray-200">{{currency}} {{ totalBaseBillAmount.toFixed(2) }}</strong></p>
                                </div>
                                <div class="flex items-center gap-2">
                                    <button v-if="!activeBill.isPosted"
                                            type="button"
                                            @@click="autoPopulateFeeItems"
                                            class="inline-flex items-center gap-1 rounded-md px-2.5 py-1 text-[11px] font-semibold text-indigo-700 bg-indigo-50 hover:bg-indigo-100 border border-indigo-200 dark:bg-indigo-950/40 dark:border-indigo-800 dark:text-indigo-300 transition">
                                        <i class="bi bi-magic"></i>
                                        <span>Load From Fee Setups</span>
                                    </button>
                                    <button v-if="!activeBill.isPosted"
                                            type="button"
                                            @@click="addFeeDetailLine"
                                            class="inline-flex items-center gap-1 rounded-md px-2.5 py-1 text-[11px] font-semibold text-blue-700 bg-blue-50 hover:bg-blue-100 border border-blue-200 dark:bg-blue-950/40 dark:border-blue-800 dark:text-blue-300 transition">
                                        <i class="bi bi-plus"></i>
                                        <span>Add Item</span>
                                    </button>
                                </div>
                            </div>

                            <div v-if="!activeBill.details || activeBill.details.length === 0" class="text-center py-4 text-xs text-gray-400">
                                No fee items added. Click "Load From Fee Setups" or "Add Item".
                            </div>

                            <div v-else class="space-y-2 max-h-48 overflow-y-auto pr-1">
                                <div v-for="(det, dIdx) in activeBill.details" :key="det.id || dIdx"
                                     class="flex items-center gap-3 p-2 rounded-lg bg-white dark:bg-slate-900  text-xs">
                                    <div class="flex-1">
                                        <select v-model="det.feeItemId"
                                                :disabled="activeBill.isPosted"
                                                class="select text-xs">

                                            <option value="">— Select Fee Item —</option>

                                            <option v-for="item in availableFeeItems" :key="item.id" :value="item.id">
                                                {{ item.name }}
                                                {{ Number(activeBill.billTypeId) === 2 ? ' (Supplementary)' : '' }}
                                                {{ Number(activeBill.billTypeId) === 2 ? (item.isFixed ? ' [Fixed]' : ' [Not Fixed]') : '' }}
                                            </option>
                                        </select>
                                    </div>
                                    <div class="w-32">
                                        <input type="number"
                                               step="0.01"
                                               min="0"
                                               v-model.number="det.amount"
                                               :disabled="activeBill.isPosted"
                                               @@input="onDetailAmountChanged"
                                               placeholder="Amount"
                                               class="input-control text-xs" />
                                    </div>
                                    <button v-if="!activeBill.isPosted"
                                            type="button"
                                            @@click="removeFeeDetailLine(dIdx)"
                                            class="text-gray-400 hover:text-rose-600 transition p-1">
                                        <i class="bi bi-trash"></i>
                                    </button>
                                </div>
                            </div>
                        </div>

                        <!-- Section: Students In Class Allocation -->
                        <div class="border rounded-xl p-4 bg-white dark:border-slate-700 dark:bg-slate-800/40">
                            <div class="flex items-center justify-between mb-3">
                                <div>
                                    <h4 class="text-xs font-bold text-gray-700 dark:text-gray-200 flex items-center gap-1.5">
                                        <i class="bi bi-people text-blue-600"></i>
                                        <span>Billed Students ({{ billedStudentsCount }} of {{ activeBill.students ? activeBill.students.length : 0 }})</span>
                                    </h4>
                                    <p class="text-[11px] text-gray-400">Total Billed to Students: <strong class="text-gray-700 dark:text-gray-200">{{currency}} {{ totalStudentsBilledAmount.toFixed(2) }}</strong></p>
                                </div>
                                <div v-if="!activeBill.isPosted" class="flex items-center gap-2">
                                    <button type="button"
                                            @@click="toggleSelectAllStudents"
                                            class="text-[11px] font-semibold text-blue-600 hover:text-blue-800 dark:text-blue-400">
                                        {{ allStudentsSelected ? 'Deselect All' : 'Select All' }}
                                    </button>
                                    <button type="button"
                                            @@click="loadClassStudents"
                                            class="inline-flex items-center gap-1 rounded-md px-2.5 py-1 text-[11px] font-semibold text-gray-700 bg-white hover:bg-gray-50 border border-gray-200 dark:bg-slate-800 dark:border-slate-700 dark:text-gray-200 transition">
                                        <i class="bi bi-arrow-repeat"></i>
                                        <span>Reload Class List</span>
                                    </button>
                                </div>
                            </div>

                            <div v-if="!activeBill.students || activeBill.students.length === 0" class="text-center py-4 text-xs text-gray-400">
                                No students loaded for this class. Select a class above to populate students.
                            </div>

                            <div v-else class="max-h-60 overflow-y-auto pr-1">
                                <table class="w-full text-xs text-left">
                                    <thead class="text-[11px] uppercase tracking-wider bg-white text-gray-500 border-b dark:border-slate-700">
                                        <tr>
                                            <th class="py-2 px-1 w-8 text-center">
                                                <input type="checkbox"
                                                       :checked="allStudentsSelected"
                                                       :disabled="activeBill.isPosted"
                                                       @@change="toggleSelectAllStudents" />
                                            </th>
                                            <th class="py-2 px-2">Student Name</th>
                                            <th class="py-2 px-2 w-28 text-right">Amount (GHS)</th>
                                            <th v-if="discountsAllowed" class="py-2 px-2 w-24 text-center">Discount?</th>
                                            <th v-if="discountsAllowed" class="py-2 px-2 w-28 text-right">Discount (GHS)</th>
                                        </tr>
                                    </thead>
                                    <tbody class="divide-y divide-gray-100 dark:divide-slate-800">
                                        <tr v-for="st in activeBill.students" :key="st.studentId"
                                            :class="st.toBeBilled ? '' : 'opacity-50'">
                                            <td class="py-2 px-1 text-center">
                                                <input type="checkbox"
                                                       v-model="st.toBeBilled"
                                                       :disabled="activeBill.isPosted"
                                                       @@change="recalculateStudentAmount(st)" />
                                            </td>
                                            <td class="py-2 px-2 font-medium text-gray-700 dark:text-gray-200">
                                                {{ getStudentName(st.studentId) }}
                                            </td>
                                            <td class="py-2 px-2 text-right">
                                                <input type="number"
                                                       step="0.01"
                                                       min="0"
                                                       v-model.number="st.amount"
                                                       :disabled="activeBill.isPosted || !st.toBeBilled"
                                                       class="input-control text-xs" />
                                            </td>
                                            <td v-if="discountsAllowed" class="py-2 px-2 text-center">
                                                <input type="checkbox"
                                                       v-model="st.isDiscounted"
                                                       :disabled="activeBill.isPosted || !st.toBeBilled"
                                                       @@change="onDiscountToggled(st)" />
                                            </td>
                                            <td v-if="discountsAllowed" class="py-2 px-2 text-right">
                                                <input type="number"
                                                       step="0.01"
                                                       min="0"
                                                       v-model.number="st.discountAmount"
                                                       :disabled="activeBill.isPosted || !st.toBeBilled || !st.isDiscounted"
                                                       @@input="onDiscountAmountInput(st)"
                                                       class="input-control text-xs" />
                                            </td>
                                        </tr>
                                    </tbody>
                                </table>
                            </div>
                        </div>
                    </div>

                    <!-- Modal Footer -->
                    <div class="px-6 py-3.5 border-t border-gray-100 dark:border-slate-700 flex items-center justify-between bg-gray-50/50 dark:bg-slate-800/80">
                        <div class="text-xs text-gray-500">
                            <span v-if="activeBill.isProcessed" class="text-emerald-600 font-semibold flex items-center gap-1">
                                <i class="bi bi-check-circle"></i> Process Bill
                            </span>
                            <span v-if="activeBill.isPosted" class="text-red-600 font-semibold flex items-center gap-1">
                                <i class="bi bi-check-circle"></i> Can not update posted bills (Read Only)
                            </span>
                            <span v-else class="text-gray-400">
                                Click "Save Bill" to create or update this bill record.
                            </span>
                        </div>
                        <div class="flex items-center gap-2">
                            <button type="button"
                                    @@click="closeBillModal"
                                    class="rounded-lg px-4 py-2 text-xs font-semibold text-gray-700 bg-white border border-gray-200 hover:bg-gray-50 dark:bg-slate-800 dark:border-slate-700 dark:text-gray-200 transition">
                                Close
                            </button>
                            <button v-if="!activeBill.isPosted"
                                    type="button"
                                    @@click="saveBillModal"
                                    :disabled="saving"
                                    class="inline-flex items-center gap-1.5 rounded-lg px-4 py-2 text-xs font-semibold text-white bg-blue-600 hover:bg-blue-700 transition shadow-sm">
                                <i class="bi bi-save"></i>
                                <span>{{ activeBill.id ? 'Update Bill' : 'Save Bill' }}</span>
                            </button>
                        </div>
                    </div>
                </div>
            </div>

        </div>
    </div>
</div>




    <script src="~/js/school-manager/bills.js"></script>

