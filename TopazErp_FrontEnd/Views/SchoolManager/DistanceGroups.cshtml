@{
    ViewBag.Title = "Distance Groups";
    Layout = "~/Views/Shared/_adminSchoolManagerLayout.cshtml";
}
<div class="content">
    <div class="mb-6 content-header">
        <div class="flex items-center gap-2 text-sm text-gray-500 mb-2">
            <span>School Manager - Main Setups</span>
            <i class="bi bi-chevron-right text-xs"></i>
            <span class="text-blue-600 font-medium">Distance Groups</span>
        </div>

        <div class="flex items-center gap-3">
            <div class="page-title">
                <h2 class="text-lg font-semibold text-gray-800">
                    Distance Groups
                </h2>
            </div>
        </div>
    </div>
    <div class="card" data-card-title="Distance Groups">
        <div id="app">
            <data-grid
                title="Distance Groups"
                :columns="distanceGroupColumns"
                :data="distanceGroupList"
                :theme="theme"
                row-id="id"
                label-key="description"
                item-label="Distance Group"
                item-label-plural="Distance Groups"
                add-label="Add Distance Group"
                :page-size="10"
                :selectable="true"
                :actions="true"
                :loading="isShimmerLoading"
                :stripes="true"
                @@create="onCreateDistanceGroup"
                @@update="onUpdateDistanceGroup"
                @@delete="onDeleteDistanceGroup"
            ></data-grid>
        </div>
    </div>
</div>
<script src="~/js/school-manager/distance-school-groups.js" asp-append-version="true"></script>
