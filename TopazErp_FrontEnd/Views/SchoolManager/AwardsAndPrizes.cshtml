@{
    ViewBag.Title = "Prize & Awards";
    Layout = "~/Views/Shared/_adminSchoolManagerLayout.cshtml";
}

<div class="content">
    <div class="mb-6 content-header">
        <div class="flex items-center gap-2 text-sm text-gray-500 mb-2 dark:text-gray-400">
            <span>School Manager - Data Entries</span>
            <i class="bi bi-chevron-right text-xs"></i>
            <span class="text-blue-600 font-medium dark:text-blue-400">Prize &amp; Awards</span>
        </div>

        <div class="flex items-center gap-3">
            <div class="page-title">
                <h2 class="text-xl font-semibold text-gray-800 dark:text-white">
                    Prize &amp; Awards
                </h2>
            </div>
        </div>
    </div>

    <div class="card" data-card-title="Prize & Awards">
        <div id="app">

            <!-- TABS -->
            <div class="flex flex-col lg:flex-row lg:items-center lg:justify-between gap-3 mb-5 border-b border-gray-200 dark:border-slate-700">
                <div class="flex items-center gap-1" role="tablist" aria-label="Prize and award sections">
                    <button type="button"
                            role="tab"
                            :aria-selected="activeTab === 'prizes'"
                            :class="activeTab === 'prizes'
                                ? 'text-blue-700 border-blue-600 dark:text-blue-400 dark:border-blue-500'
                                : 'text-gray-500 border-transparent hover:text-blue-700 dark:text-gray-400 dark:hover:text-blue-400'"
                            class="inline-flex items-center gap-2 whitespace-nowrap border-b-2 -mb-px px-4 py-2.5 text-sm font-semibold transition-colors"
                            @@click="activeTab = 'prizes'">
                        <i class="bi bi-gift"></i>
                        <span>Prize Types</span>
                    </button>
                    <button type="button"
                            role="tab"
                            :aria-selected="activeTab === 'awards'"
                            :class="activeTab === 'awards'
                                ? 'text-blue-700 border-blue-600 dark:text-blue-400 dark:border-blue-500'
                                : 'text-gray-500 border-transparent hover:text-blue-700 dark:text-gray-400 dark:hover:text-blue-400'"
                            class="inline-flex items-center gap-2 whitespace-nowrap border-b-2 -mb-px px-4 py-2.5 text-sm font-semibold transition-colors"
                            @@click="activeTab = 'awards'">
                        <i class="bi bi-award"></i>
                        <span>Award Types</span>
                    </button>
                    <button type="button"
                            role="tab"
                            :aria-selected="activeTab === 'awarded'"
                            :class="activeTab === 'awarded'
                                ? 'text-blue-700 border-blue-600 dark:text-blue-400 dark:border-blue-500'
                                : 'text-gray-500 border-transparent hover:text-blue-700 dark:text-gray-400 dark:hover:text-blue-400'"
                            class="inline-flex items-center gap-2 whitespace-nowrap border-b-2 -mb-px px-4 py-2.5 text-sm font-semibold transition-colors"
                            @@click="activeTab = 'awarded'">
                        <i class="bi bi-trophy"></i>
                        <span>Prize Awarded</span>
                    </button>
                </div>
            </div>

            <!-- ============ TAB 1 — PRIZE TYPES (data-grid) ============ -->
            <section v-show="activeTab === 'prizes'" role="tabpanel">
                <data-grid title="Prize Types"
                           :columns="prizeTypeColumns"
                           :data="prizeTypes"
                           :theme="theme"
                           row-id="id"
                           label-key="name"
                           item-label="Prize Type"
                           item-label-plural="Prize Types"
                           add-label="Add Prize Type"
                           :page-size="10"
                           :selectable="true"
                           :actions="true"
                           :loading="isShimmerLoading"
                           :stripes="true"
                           density="compact"
                           @@create="onPrizeCreate"
                           @@update="onPrizeUpdate"
                           @@delete="onPrizeDelete">
                </data-grid>
            </section>

            <!-- ============ TAB 2 — AWARD TYPES (data-grid) ============ -->
            <section v-show="activeTab === 'awards'" role="tabpanel">
                <data-grid title="Award Types"
                           :columns="awardTypeColumns"
                           :data="awardTypes"
                           :theme="theme"
                           row-id="id"
                           label-key="name"
                           item-label="Award Type"
                           item-label-plural="Award Types"
                           add-label="Add Award Type"
                           :page-size="10"
                           :selectable="true"
                           :actions="true"
                           :loading="isShimmerLoading"
                           :stripes="true"
                           density="compact"
                           @@create="onAwardCreate"
                           @@update="onAwardUpdate"
                           @@delete="onAwardDelete">
                </data-grid>
            </section>

            <!-- ============ TAB 3 — PRIZE AWARDED ============ -->
            <section v-show="activeTab === 'awarded'" role="tabpanel">

                <div class="grid grid-cols-1 md:grid-cols-3 lg:grid-cols-4 gap-4 mb-4">
                    <w-select v-model="awarded.academicYearId"
                              :options="academicYears"
                              display-key="name"
                              value-key="id"
                              label="Academic Year:"
                              required>
                    </w-select>

                    <w-select v-model="awarded.termId"
                              :options="terms"
                              display-key="name"
                              value-key="id"
                              label="Term:"
                              required>
                    </w-select>

                    <w-select v-model="awarded.levelId"
                              :options="levels"
                              display-key="name"
                              value-key="id"
                              label="Level:"
                              required>
                    </w-select>
                </div>

                <!-- editing vs creating -->
                <div v-if="awardedContextReady && existingPrizeAward"
                     class="mb-4 flex items-start justify-between gap-3 rounded-lg border border-amber-200 bg-amber-50 px-3 py-2.5 dark:border-amber-800 dark:bg-amber-900/20">
                    <div class="flex items-start gap-2 text-sm text-amber-900 dark:text-amber-200">
                        <i class="bi bi-pencil-square mt-0.5"></i>
                        <div>
                            <p class="font-semibold">A prize award record exists for this level and term.</p>
                            <p class="text-xs mt-0.5 text-amber-800 dark:text-amber-300">
                                You are editing the existing record ({{ existingPrizeAward.details.length }} line(s)).
                            </p>
                        </div>
                    </div>
                    <button type="button"
                            class="inline-flex shrink-0 items-center gap-1.5 whitespace-nowrap rounded-lg border border-red-200 bg-white px-2.5 py-1.5 text-xs font-semibold text-red-700 hover:bg-red-50 dark:border-red-900 dark:bg-slate-800 dark:text-red-400 dark:hover:bg-red-900/30"
                            @@click="deleteExistingPrizeAward"
                            title="Delete this record">
                        <i class="bi bi-trash"></i> Delete
                    </button>
                </div>

                <div v-else-if="awardedContextReady"
                     class="mb-4 flex items-start gap-2 rounded-lg border border-emerald-200 bg-emerald-50 px-3 py-2.5 text-sm text-emerald-900 dark:border-emerald-800 dark:bg-emerald-900/20 dark:text-emerald-200">
                    <i class="bi bi-plus-circle mt-0.5"></i>
                    <div>
                        <p class="font-semibold">New record</p>
                        <p class="text-xs mt-0.5 text-emerald-800 dark:text-emerald-300">No prize award exists for this academic year, term and level yet.</p>
                    </div>
                </div>

                <template v-if="awardedContextReady">

                    <!-- award + prize pickers -->
                    <div class="grid grid-cols-1 md:grid-cols-2 gap-4 mb-4">
                        <w-select v-model="lineDraftAwardId"
                                  :options="awardTypes"
                                  display-key="name"
                                  value-key="id"
                                  label="Award Type:"
                                  required>
                        </w-select>

                        <w-select v-model="lineDraftPrizeId"
                                  :options="prizeTypes"
                                  display-key="name"
                                  value-key="id"
                                  label="Prize Type:"
                                  required>
                        </w-select>
                    </div>

                    <!-- students picker -->
                    <div class="rounded-lg border border-gray-200 dark:border-slate-700 overflow-hidden mb-4">
                        <div class="flex flex-col sm:flex-row sm:items-center justify-between gap-3 px-3 py-2.5 bg-white border-b border-gray-200 dark:border-slate-700 dark:bg-transparent">
                            <div class="flex items-center gap-2">
                                <i class="bi bi-people text-blue-600 dark:text-blue-400"></i>
                                <span class="text-sm font-semibold text-gray-700 dark:text-gray-200">Students</span>
                                <span class="inline-flex items-center whitespace-nowrap rounded-full border border-blue-200 bg-blue-50 px-2.5 py-0.5 text-[11px] font-bold text-blue-800 dark:bg-slate-700 dark:border-slate-900 dark:text-gray-200">{{ selectedStudentIds.length }} ticked</span>
                            </div>
                            <div class="flex items-center gap-2">
                                <div class="relative">
                                    <i class="bi bi-search absolute left-3 top-1/2 -translate-y-1/2 text-gray-400 text-xs"></i>
                                    <input type="text"
                                           class="input-control w-full sm:w-56"
                                           style="padding-left:2rem"
                                           placeholder="Search students…"
                                           v-model="studentFilter" />
                                </div>
                                <button type="button" class="whitespace-nowrap px-1 py-1 text-[13px] font-semibold text-blue-600 hover:underline dark:text-blue-400" @@click="toggleSelectAllStudents">
                                    {{ allFilteredStudentsSelected ? 'DeSelect' : 'Select' }} all
                                </button>
                            </div>
                        </div>

                        <p v-if="studentsHaveLevel" class="px-3 pt-2 text-[11px] text-gray-400 dark:text-gray-500 flex items-center gap-1.5">
                            <i class="bi bi-info-circle"></i> Showing students in the selected level.
                        </p>

                        <div class="grid grid-cols-1 sm:grid-cols-2 xl:grid-cols-3 gap-2 max-h-64 overflow-y-auto p-3">
                            <label v-for="student in filteredStudents"
                                   :key="student.id"
                                   :class="isStudentSelected(student.id)
                                        ? 'border-blue-600 bg-blue-50 dark:bg-slate-900 ring-1 ring-inset ring-blue-600'
                                        : 'border-gray-200 dark:border-slate-700 bg-white dark:bg-slate-800 hover:border-blue-300 hover:bg-blue-50/40'"
                                   class="flex cursor-pointer select-none items-center gap-2 rounded-lg border px-3 py-2 text-[13px] text-gray-700 dark:text-white transition">
                                <input type="checkbox"
                                       class="input-control"
                                       :checked="isStudentSelected(student.id)"
                                       @@change="toggleStudent(student.id)" />
                                <span class="truncate">{{ student.name }}</span>
                            </label>

                            <p v-if="students.length === 0" class="col-span-full py-8 text-center text-sm text-gray-400">
                                <i class="bi bi-inbox block text-xl mb-1"></i>
                                No students loaded.
                            </p>
                            <p v-else-if="filteredStudents.length === 0" class="col-span-full py-8 text-center text-sm text-gray-400">
                                <i class="bi bi-search block text-xl mb-1"></i>
                                No students match.
                            </p>
                        </div>
                    </div>

                    <div class="mb-4 flex items-center justify-end">
                        <button type="button"
                                class="inline-flex items-center gap-2 whitespace-nowrap rounded-lg border border-blue-200 bg-blue-50 px-4 py-2 text-sm font-semibold text-blue-700 transition hover:bg-blue-100 dark:border-slate-600 dark:bg-slate-800 dark:text-blue-300 dark:hover:bg-slate-700 disabled:cursor-not-allowed disabled:opacity-50"
                                :disabled="!lineDraftAwardId || !lineDraftPrizeId || selectedStudentIds.length === 0"
                                @@click="addLines">
                            <i class="bi bi-plus-circle"></i>
                            Add {{ selectedStudentIds.length || '' }} Line{{ selectedStudentIds.length === 1 ? '' : 's' }}
                        </button>
                    </div>

                    <!-- lines table -->
                    <div class="rounded-lg border border-gray-200 dark:border-slate-700 overflow-hidden">
                        <div class="flex items-center justify-between gap-2 border-b border-gray-200 dark:border-slate-700 bg-white dark:bg-transparent px-3 py-2.5">
                            <p class="flex items-center gap-2 text-sm font-semibold text-gray-700 dark:text-gray-200">
                                <i class="bi bi-list-ul"></i> Lines to save
                                <span class="inline-flex items-center whitespace-nowrap rounded-full border border-blue-200 bg-blue-50 px-2.5 py-0.5 text-[11px] font-bold text-blue-800 dark:bg-slate-700 dark:border-slate-900 dark:text-gray-200">{{ lines.length }}</span>
                            </p>
                            <button type="button"
                                    v-if="lines.length"
                                    class="text-[13px] font-semibold text-gray-500 hover:underline dark:text-gray-400"
                                    @@click="clearLines">
                                Clear all
                            </button>
                        </div>

                        <div v-if="lines.length" class="overflow-x-auto">
                            <table class="min-w-full text-sm divide-y divide-gray-100 dark:divide-slate-700">
                                <thead class="bg-gray-50 dark:bg-slate-800">
                                    <tr class="text-left text-[11px] uppercase tracking-wide text-gray-500 dark:text-gray-400">
                                        <th class="px-3 py-2 font-semibold">Award</th>
                                        <th class="px-3 py-2 font-semibold">Prize</th>
                                        <th class="px-3 py-2 font-semibold">Student</th>
                                        <th class="px-3 py-2 font-semibold w-12"></th>
                                    </tr>
                                </thead>
                                <tbody class="divide-y divide-gray-100 dark:divide-slate-700">
                                    <tr v-for="(line, index) in lines" :key="line.id || index" class="text-gray-700 dark:text-gray-200">
                                        <td class="px-3 py-2">{{ line.awardName }}</td>
                                        <td class="px-3 py-2">{{ line.prizeName }}</td>
                                        <td class="px-3 py-2">{{ line.studentName }}</td>
                                        <td class="px-3 py-2 text-right">
                                            <button type="button"
                                                    class="text-gray-400 hover:text-red-600 dark:text-gray-500 dark:hover:text-red-400"
                                                    title="Remove line"
                                                    @@click="removeLine(index)">
                                                <i class="bi bi-x-circle"></i>
                                            </button>
                                        </td>
                                    </tr>
                                </tbody>
                            </table>
                        </div>
                        <p v-else class="py-8 text-center text-sm text-gray-400">
                            <i class="bi bi-list-ul block text-xl mb-1"></i>
                            No lines yet — pick an award, a prize and select students, then press Add.
                        </p>
                    </div>
                    @*<p class="mt-2 flex items-center gap-1.5 text-xs text-gray-400 dark:text-gray-500">
                        <i class="bi bi-info-circle"></i>
                        The same award + prize + student line can never be added twice. Saving one record per level, term and year — duplicates are updated, never inserted.
                    </p>*@

                    <!-- footer actions -->
                    <div class="mt-4 flex flex-col sm:flex-row sm:items-center sm:justify-between gap-3">
                        <p class="text-sm text-gray-500 dark:text-gray-400">
                            {{ lines.length }} line{{ lines.length === 1 ? '' : 's' }} ready to save.
                        </p>
                        <div class="flex items-center gap-2">
                            <button type="button"
                                    class="inline-flex items-center gap-2 rounded-lg border border-gray-300 bg-white px-4 py-2 text-sm font-semibold text-gray-700 hover:bg-gray-50 dark:border-slate-600 dark:bg-slate-800 dark:text-gray-200 dark:hover:bg-slate-700"
                                    @@click="resetAwardedForm"
                                    :disabled="isShimmerLoading">
                                Clear
                            </button>
                            <button type="button"
                                    class="inline-flex items-center gap-2 rounded-lg border border-blue-700 bg-blue-600 px-4 py-2 text-sm font-semibold text-white transition hover:bg-blue-700 disabled:cursor-not-allowed disabled:opacity-50"
                                    :disabled="isShimmerLoading || !awardedContextReady || lines.length === 0"
                                    @@click="savePrizeAwarded">
                                <i class="bi" :class="isShimmerLoading ? 'bi-arrow-repeat animate-spin' : (existingPrizeAward ? 'bi-pencil-square' : 'bi-check2-circle')"></i>
                                {{ isShimmerLoading ? 'Saving…' : (existingPrizeAward ? 'Update Record' : 'Save Record') }}
                            </button>
                        </div>
                    </div>
                </template>

                <div v-else class="py-14 text-center text-gray-400 dark:text-gray-500">
                    <i class="bi bi-arrow-up-circle block text-2xl mb-2"></i>
                    <p class="text-sm">Choose an academic year, a term and a level to start.</p>
                </div>
            </section>

        </div>
    </div>
</div>

<script src="~/js/school-manager/prize-awards.js"></script>
