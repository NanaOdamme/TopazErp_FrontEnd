@{
    ViewBag.Title = "Disciplinary Actions";
    Layout = "~/Views/Shared/_adminSchoolManagerLayout.cshtml";
}

<div class="content">
    <div class="mb-6 content-header">
        <div class="flex items-center gap-2 text-sm text-gray-500 mb-2 dark:text-gray-400">
            <span>School Manager - Data Entries</span>
            <i class="bi bi-chevron-right text-xs"></i>
            <span class="text-blue-600 font-medium dark:text-blue-400">Disciplinary Actions</span>
        </div>

        <div class="flex items-center gap-3">
            <div class="page-title">
                <h2 class="text-xl font-semibold text-gray-800 dark:text-white">
                    Disciplinary Actions
                </h2>
            </div>
        </div>
    </div>

    <div class="card" data-card-title="Disciplinary Actions">
        <div id="app" style="height: 1000px;">


            <!-- scope -->
            <div class="grid grid-cols-1 md:grid-cols-3 lg:grid-cols-4 gap-4 mb-4">
                <w-select v-model="academicYearId"
                          :options="academicYears"
                          display-key="name"
                          value-key="id"
                          label="Academic Year:"
                          required>
                </w-select>

                <w-select v-model="classId"
                          :options="classes"
                          display-key="name"
                          value-key="id"
                          label="Class:"
                          required>
                </w-select>
            </div>

            <template v-if="scopeReady">

                <!-- students table -->
                <div class="rounded-xl border border-gray-200 dark:border-slate-700 bg-white dark:bg-slate-800 shadow-sm overflow-hidden">

                    <!-- table toolbar -->
                    <div class="flex flex-col sm:flex-row sm:items-center justify-between gap-3 border-b border-gray-200 dark:border-slate-700 px-4 py-3 bg-white dark:bg-slate-800">
                        <div class="flex items-center gap-2 flex-wrap">
                            <i class="bi bi-people-fill text-blue-600 dark:text-blue-400"></i>
                            <span class="text-sm font-semibold text-gray-700 dark:text-gray-200">Students in {{ nameOf(classes, classId) }}</span>
                            <span class="inline-flex items-center whitespace-nowrap rounded-full border border-blue-200 bg-blue-50 px-2.5 py-0.5 text-[11px] font-bold text-blue-800 dark:bg-slate-700 dark:border-slate-900 dark:text-gray-200">{{ studentsInClass.length }}</span>
                            <span v-if="actionsInScope.length" class="inline-flex items-center whitespace-nowrap rounded-full border border-red-200 bg-red-50 px-2.5 py-0.5 text-[11px] font-bold text-red-700 dark:bg-red-900/30 dark:border-red-800 dark:text-red-400">{{ actionsInScope.length }} offense(s) this year</span>
                        </div>
                        <div class="relative">
                            <i class="bi bi-search absolute left-3 top-1/2 -translate-y-1/2 text-gray-400 text-xs"></i>
                            <input type="text"
                                   class="input-control w-full sm:w-56"
                                   style="padding-left:2rem"
                                   placeholder="Search students…"
                                   v-model="studentFilter" />
                        </div>
                    </div>

                    <div v-if="visibleStudents.length" class="overflow-x-auto">
                        <table class="min-w-full text-sm divide-y divide-gray-100 dark:divide-slate-700">
                            <thead class="bg-gray-100/70 dark:bg-slate-900/40">
                                <tr class="text-left text-[11px] uppercase tracking-wider text-gray-500 dark:text-gray-400">
                                    <th class="px-4 py-2.5 font-semibold w-14">#</th>
                                    <th class="px-4 py-2.5 font-semibold">Student</th>
                                    <th class="px-4 py-2.5 font-semibold">Offenses</th>
                                    <th class="px-4 py-2.5 font-semibold w-24 text-right">Action</th>
                                    <th class="px-2 py-2.5 font-semibold w-12 text-center"><span class="sr-only">Expand</span></th>
                                </tr>
                            </thead>
                            <tbody class="divide-y divide-gray-100 dark:divide-slate-700">
                                <template v-for="(student, index) in pagedStudents" :key="student.id">
                                    <tr class="text-gray-700 dark:text-gray-200 align-middle transition-colors hover:bg-blue-50/40 dark:hover:bg-slate-700/30"
                                        :class="{ 'bg-blue-50/40 dark:bg-slate-700/30': expandedStudentId === student.id }">
                                        <td class="px-4 py-3 text-gray-400 dark:text-gray-500 font-medium">{{ studentGlobalIndex(index) }}</td>
                                        <td class="px-4 py-3">
                                            <div class="flex items-center gap-2.5">
                                                <span class="flex h-9 w-9 flex-shrink-0 items-center justify-center rounded-full bg-blue-100 text-[11px] font-bold text-blue-700 ring-1 ring-blue-200 dark:bg-slate-700 dark:text-blue-300 dark:ring-slate-600">{{ initials(student.name) }}</span>
                                                <span class="font-medium truncate">{{ student.name }}</span>
                                            </div>
                                        </td>
                                        <td class="px-4 py-3">
                                            <button v-if="actionsFor(student.id).length"
                                                    type="button"
                                                    class="inline-flex items-center gap-1.5 whitespace-nowrap rounded-full border border-red-200 bg-red-50 px-2.5 py-1 text-[11px] font-bold text-red-700 hover:bg-red-100 dark:border-red-900/60 dark:bg-red-900/20 dark:text-red-400 dark:hover:bg-red-900/40"
                                                    @@click="toggleExpand(student)">
                                                <i class="bi bi-clipboard-data"></i>
                                                {{ actionsFor(student.id).length }} recorded
                                                <i class="bi" :class="expandedStudentId === student.id ? 'bi-chevron-up' : 'bi-chevron-down'"></i>
                                            </button>
                                            <span v-else class="text-xs text-gray-400 dark:text-gray-500">No offenses yet</span>
                                        </td>
                                        <td class="px-4 py-3 text-right">
                                            <button type="button"
                                                    class="inline-flex items-center gap-1 whitespace-nowrap rounded-lg border border-blue-200 bg-blue-50 px-2.5 py-1.5 text-xs font-semibold text-blue-700 hover:bg-blue-100 dark:border-slate-600 dark:bg-slate-800 dark:text-blue-300 dark:hover:bg-slate-700"
                                                    @@click="openAddFor(student)">
                                                <i class="bi bi-plus-circle"></i> Add
                                            </button>
                                        </td>
                                        <td class="px-2 py-3 text-center">
                                            <button type="button"
                                                    class="p-2 rounded-lg text-gray-400 hover:text-blue-600 hover:bg-blue-50 dark:text-gray-500 dark:hover:text-blue-400 dark:hover:bg-slate-700"
                                                    :title="expandedStudentId === student.id ? 'Hide child table' : 'Show child table'"
                                                    @@click="toggleExpand(student)">
                                                <i class="bi text-lg" :class="expandedStudentId === student.id ? 'bi-chevron-compact-up' : 'bi-chevron-compact-down'"></i>
                                            </button>
                                        </td>
                                    </tr>

                                    <!-- child table row -->
                                    <tr v-if="expandedStudentId === student.id" class="bg-slate-50/80 dark:bg-slate-900/50">
                                        <td colspan="5" class="px-6 py-4">
                                            <div class="rounded-xl border border-slate-200 dark:border-slate-700 bg-white dark:bg-slate-800 shadow-inner overflow-hidden">

                                                <!-- child toolbar -->
                                                <div class="flex items-center justify-between gap-3 border-b border-gray-100 dark:border-slate-700 bg-gray-50/80 dark:bg-slate-800/80 px-4 py-2.5">
                                                    <p class="flex items-center gap-2 text-xs font-bold uppercase tracking-wider text-gray-500 dark:text-gray-400">
                                                        <i class="bi bi-list-ul text-blue-600 dark:text-blue-400"></i>
                                                        Recorded offenses — {{ student.name }}
                                                        <span class="inline-flex items-center rounded-full border border-gray-200 bg-white px-2 py-0.5 text-[10px] font-bold text-gray-600 dark:border-slate-600 dark:bg-slate-700 dark:text-gray-300">{{ actionsFor(student.id).length }}</span>
                                                    </p>
                                                    <button type="button"
                                                            class="p-1.5 rounded-md text-gray-400 hover:text-gray-600 hover:bg-gray-100 dark:text-gray-500 dark:hover:text-gray-200 dark:hover:bg-slate-700"
                                                            title="Collapse"
                                                            @@click="toggleExpand(student)">
                                                        <i class="bi bi-x-lg text-xs"></i>
                                                    </button>
                                                </div>

                                                <template v-if="actionsFor(student.id).length">
                                                    <div class="overflow-x-auto">
                                                        <table class="min-w-full text-xs divide-y divide-gray-100 dark:divide-slate-700">
                                                            <thead class="bg-gray-50/60 dark:bg-slate-900/30">
                                                                <tr class="text-left text-[10px] uppercase tracking-wider text-gray-400 dark:text-gray-500">
                                                                    <th class="px-4 py-2 font-semibold w-36">Date</th>
                                                                    <th class="px-4 py-2 font-semibold w-40">Offense</th>
                                                                    <th class="px-4 py-2 font-semibold">Description</th>
                                                                    <th class="px-4 py-2 font-semibold w-20 text-right">Actions</th>
                                                                </tr>
                                                            </thead>
                                                            <tbody class="divide-y divide-gray-100 dark:divide-slate-700">
                                                                <tr v-for="action in pagedActions(student.id)"
                                                                    :key="action.id"
                                                                    class="align-middle hover:bg-blue-50/30 dark:hover:bg-slate-700/20">
                                                                    <td class="px-4 py-2.5 whitespace-nowrap text-gray-500 dark:text-gray-400 font-medium">{{ prettyDate(action.actionDate) }}</td>
                                                                    <td class="px-4 py-2.5">
                                                                        <span class="inline-flex items-center whitespace-nowrap rounded-md border border-red-200 bg-red-50 px-2 py-0.5 text-[11px] font-bold text-red-700 dark:border-red-900/60 dark:bg-red-900/30 dark:text-red-300">{{ action.offenseName }}</span>
                                                                    </td>
                                                                    <td class="px-4 py-2.5 text-gray-600 dark:text-gray-300">
                                                                        <span class="block max-w-md truncate" :title="action.description">{{ action.description || '—' }}</span>
                                                                    </td>
                                                                    <td class="px-4 py-2.5 text-right whitespace-nowrap">
                                                                        <button type="button"
                                                                                class="p-1.5 rounded-md text-gray-400 hover:text-blue-600 hover:bg-blue-50 dark:hover:text-gray-500 dark:hover:text-blue-400 dark:hover:bg-slate-700"
                                                                                title="Edit"
                                                                                @@click="openEditFor(student, action)">
                                                                            <i class="bi bi-pencil-square"></i>
                                                                        </button>
                                                                        <button type="button"
                                                                                class="p-1.5 rounded-md text-gray-400 hover:text-red-600 hover:bg-red-50 dark:hover:text-gray-500 dark:hover:text-red-400 dark:hover:bg-slate-700"
                                                                                title="Delete"
                                                                                @@click="deleteAction(action)">
                                                                            <i class="bi bi-trash"></i>
                                                                        </button>
                                                                    </td>
                                                                </tr>
                                                            </tbody>
                                                        </table>
                                                    </div>

                                                    <!-- child pagination -->
                                                    <div class="flex items-center justify-between gap-3 border-t border-gray-100 dark:border-slate-700 bg-gray-50/80 dark:bg-slate-800/80 px-4 py-2">
                                                        <p class="text-[11px] text-gray-500 dark:text-gray-400">
                                                            Showing <span class="font-semibold text-gray-700 dark:text-gray-200">{{ actionShowingFrom(student.id) }}–{{ actionShowingTo(student.id) }}</span> of <span class="font-semibold text-gray-700 dark:text-gray-200">{{ actionsFor(student.id).length }}</span>
                                                        </p>
                                                        <div class="flex items-center gap-1">
                                                            <button type="button"
                                                                    class="p-1.5 rounded-md border border-gray-200 dark:border-slate-600 text-gray-500 hover:text-blue-600 hover:border-blue-300 disabled:opacity-40 disabled:cursor-not-allowed disabled:hover:text-gray-500 dark:text-gray-400 dark:hover:text-blue-400"
                                                                    :disabled="actionClampedPage(student.id) <= 1"
                                                                    title="Previous page"
                                                                    @@click="setActionPage(student.id, actionClampedPage(student.id) - 1)">
                                                                <i class="bi bi-chevron-left text-xs"></i>
                                                            </button>
                                                            <button v-for="p in actionTotalPages(student.id)"
                                                                    :key="p"
                                                                    type="button"
                                                                    class="h-7 w-7 rounded-md border text-[11px] font-bold transition"
                                                                    :class="p === actionClampedPage(student.id)
                                                                        ? 'border-blue-700 bg-blue-600 text-white'
                                                                        : 'border-gray-200 dark:border-slate-600 text-gray-500 hover:text-blue-600 hover:border-blue-300 dark:text-gray-400 dark:hover:text-blue-400'"
                                                                    @@click="setActionPage(student.id, p)">{{ p }}</button>
                                                            <button type="button"
                                                                    class="p-1.5 rounded-md border border-gray-200 dark:border-slate-600 text-gray-500 hover:text-blue-600 hover:border-blue-300 disabled:opacity-40 disabled:cursor-not-allowed disabled:hover:text-gray-500 dark:text-gray-400 dark:hover:text-blue-400"
                                                                    :disabled="actionClampedPage(student.id) >= actionTotalPages(student.id)"
                                                                    title="Next page"
                                                                    @@click="setActionPage(student.id, actionClampedPage(student.id) + 1)">
                                                                <i class="bi bi-chevron-right text-xs"></i>
                                                            </button>
                                                        </div>
                                                    </div>
                                                </template>

                                                <!-- child empty state -->
                                                <div v-else class="px-4 py-6 text-center text-xs text-gray-400 dark:text-gray-500">
                                                    <i class="bi bi-inbox text-lg block mb-1"></i>
                                                    No offenses recorded for {{ student.name }} yet.
                                                </div>
                                            </div>
                                        </td>
                                    </tr>

                                    <!-- inline editor row -->
                                    <tr v-if="editingStudentId === student.id" class="bg-blue-50/60 dark:bg-slate-800/70">
                                        <td colspan="5" class="px-6 py-4">
                                            <div class="rounded-xl border border-blue-200 dark:border-slate-600 bg-white dark:bg-slate-900 shadow-sm p-4">
                                                <p class="flex items-center gap-2 text-sm font-semibold text-gray-700 dark:text-gray-100 mb-3">
                                                    <i class="bi" :class="editingActionId ? 'bi-pencil-square' : 'bi-plus-circle'"></i>
                                                    {{ editingActionId ? 'Edit action for' : 'Record offense for' }} {{ student.name }}
                                                </p>
                                                <div class="grid grid-cols-1 md:grid-cols-12 gap-3 mb-3">
                                                    <div class="md:col-span-6">
                                                        <w-select v-model="draft.offenseId"
                                                                  :options="offenses"
                                                                  display-key="name"
                                                                  value-key="id"
                                                                  label="Offense:"
                                                                  required>
                                                        </w-select>
                                                    </div>
                                                    <div class="md:col-span-6">
                                                        <label class="label" :for="'date-' + student.id">Action Date:</label>
                                                        <input :id="'date-' + student.id"
                                                               type="date"
                                                               class="input-control"
                                                               :max="today"
                                                               v-model="draft.actionDate" />
                                                    </div>
                                                </div>
                                                <label class="label" :for="'desc-' + student.id">Description:</label>
                                                <input :id="'desc-' + student.id"
                                                       type="text"
                                                       class="input-control mb-3"
                                                       placeholder="What happened?"
                                                       v-model="draft.description" />
                                                <div class="flex items-center justify-end gap-2">
                                                    <button type="button"
                                                            class="inline-flex items-center gap-2 rounded-lg border border-gray-300 bg-white px-4 py-2 text-sm font-semibold text-gray-700 hover:bg-gray-50 dark:border-slate-600 dark:bg-slate-800 dark:text-gray-200 dark:hover:bg-slate-700"
                                                            @@click="cancelEditor">
                                                        Cancel
                                                    </button>
                                                    <button type="button"
                                                            class="inline-flex items-center gap-2 rounded-lg border border-blue-700 bg-blue-600 px-4 py-2 text-sm font-semibold text-white transition hover:bg-blue-700 disabled:cursor-not-allowed disabled:opacity-50"
                                                            :disabled="isShimmerLoading || !draft.offenseId || !draft.actionDate"
                                                            @@click="saveEditor(student)">
                                                        <i class="bi" :class="isShimmerLoading ? 'bi-arrow-repeat animate-spin' : 'bi-check2-circle'"></i>
                                                        {{ isShimmerLoading ? 'Saving…' : (editingActionId ? 'Update Action' : 'Save Action') }}
                                                    </button>
                                                </div>
                                            </div>
                                        </td>
                                    </tr>
                                </template>
                            </tbody>
                        </table>

                        <!-- students pagination -->
                        <div class="flex flex-col sm:flex-row items-center justify-between gap-3 border-t border-gray-100 dark:border-slate-700 bg-gray-50/80 dark:bg-slate-800/90 px-4 py-2.5">
                            <p class="text-[11px] text-gray-500 dark:text-gray-400">
                                Showing <span class="font-semibold text-gray-700 dark:text-gray-200">{{ studentShowingFrom }}–{{ studentShowingTo }}</span> of <span class="font-semibold text-gray-700 dark:text-gray-200">{{ visibleStudents.length }}</span> students
                            </p>
                            <div class="flex items-center gap-1">
                                <button type="button"
                                        class="p-1.5 rounded-md border border-gray-200 dark:border-slate-600 text-gray-500 hover:text-blue-600 hover:border-blue-300 disabled:opacity-40 disabled:cursor-not-allowed disabled:hover:text-gray-500 dark:text-gray-400 dark:hover:text-blue-400"
                                        :disabled="clampedStudentPage <= 1"
                                        title="Previous page"
                                        @@click="setStudentPage(clampedStudentPage - 1)">
                                    <i class="bi bi-chevron-left"></i>
                                </button>
                                <button v-for="p in studentPageNumbers"
                                        :key="p"
                                        type="button"
                                        class="h-8 min-w-8 px-1.5 rounded-md border text-xs font-bold transition"
                                        :class="p === clampedStudentPage
                                            ? 'border-blue-700 bg-blue-800 text-white'
                                            : p === '…'
                                                ? 'border-transparent text-gray-400 cursor-default'
                                                : 'border-gray-200 dark:border-slate-600 text-gray-500 hover:text-blue-600 hover:border-blue-300 dark:text-gray-400 dark:hover:text-blue-400'"
                                        :disabled="p === '…'"
                                        @@click="setStudentPage(p)">{{ p }}</button>
                                <button type="button"
                                        class="p-1.5 rounded-md border border-gray-200 dark:border-slate-600 text-gray-500 hover:text-blue-600 hover:border-blue-300 disabled:opacity-40 disabled:cursor-not-allowed disabled:hover:text-gray-500 dark:text-gray-400 dark:hover:text-blue-400"
                                        :disabled="clampedStudentPage >= totalStudentPages"
                                        title="Next page"
                                        @@click="setStudentPage(clampedStudentPage + 1)">
                                    <i class="bi bi-chevron-right"></i>
                                </button>
                            </div>
                        </div>
                    </div>

                    <p v-else-if="studentFilter" class="py-8 text-center text-sm text-gray-400">
                        <i class="bi bi-search block text-xl mb-1"></i>
                        No students match “{{ studentFilter }}”.
                    </p>
                    <p v-else class="py-10 text-center text-sm text-gray-400">
                        <i class="bi bi-inbox block text-xl mb-1"></i>
                        No students found for this class. Check the students have this <code>classId</code> in GetStudentBios.
                    </p>
                </div>

        
            </template>

            <div v-else class="py-14 text-center text-gray-400 dark:text-gray-500">
                <i class="bi bi-arrow-up-circle block text-2xl mb-2"></i>
                <p class="text-sm">Choose an academic year and a class to see the students.</p>
            </div>

        </div>
    </div>
</div>

<script src="~/js/school-manager/student-disciplinary-actions.js"></script>
