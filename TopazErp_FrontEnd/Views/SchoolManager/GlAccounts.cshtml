@{
    ViewBag.Title = "G/L Accounts";
    Layout = "~/Views/Shared/_adminSchoolManagerLayout.cshtml";
}

<div class="content">
    <div class="mb-5 content-header">
        <div class="flex items-center gap-2 text-sm text-gray-500 mb-1 dark:text-gray-400">
            <span>School Manager - Billing &amp; Payments</span>
            <i class="bi bi-chevron-right text-xs"></i>
            <span class="text-blue-600 font-medium dark:text-blue-400">G/L Accounts</span>
        </div>

        <div class="flex flex-col sm:flex-row sm:items-center sm:justify-between gap-3">
            <div>
                <h2 class="text-lg font-bold text-gray-800 dark:text-white tracking-tight flex items-center gap-2.5">
                    School G/L Account Mapping
                </h2>
            </div>
        </div>
    </div>

    <div class="card" data-card-title="G/L Accounts">
        <div id="app">

            <!-- Loader -->
            <div v-if="!setupDone" class="py-24 text-center text-gray-400">
                <i class="text-blue-800 bi bi-arrow-repeat animate-spin text-3xl inline-block mb-2"></i>
                <p class="text-sm">Loading G/L accounts and fee items…</p>
            </div>

            <template v-else>
                <!-- Tabs: Bill Accounts | Payment Accounts | Credit Memo Accounts -->
                <div class="flex items-center gap-2 mb-5 border-b border-gray-200 dark:border-slate-700">
                    <button type="button"
                            class="inline-flex items-center gap-2 whitespace-nowrap border-b-2 -mb-px px-4 py-2.5 text-sm font-semibold transition-colors"
                            :class="activeTab === 'bills'
                                ? 'text-blue-700 border-blue-600 dark:text-blue-400 dark:border-blue-500'
                                : 'text-gray-500 border-transparent hover:text-blue-700 dark:text-gray-400'"
                            @@click="activeTab = 'bills'">
                        <i class="bi bi-receipt-cutoff"></i>
                        <span>Bill Accounts</span>
                    </button>

                    <button type="button"
                            class="inline-flex items-center gap-2 whitespace-nowrap border-b-2 -mb-px px-4 py-2.5 text-sm font-semibold transition-colors"
                            :class="activeTab === 'payments'
                                ? 'text-blue-700 border-blue-600 dark:text-blue-400 dark:border-blue-500'
                                : 'text-gray-500 border-transparent hover:text-blue-700 dark:text-gray-400'"
                            @@click="activeTab = 'payments'">
                        <i class="bi bi-cash-stack"></i>
                        <span>Payment Accounts</span>
                    </button>

                    <button type="button"
                            class="inline-flex items-center gap-2 whitespace-nowrap border-b-2 -mb-px px-4 py-2.5 text-sm font-semibold transition-colors"
                            :class="activeTab === 'memos'
                                ? 'text-blue-700 border-blue-600 dark:text-blue-400 dark:border-blue-500'
                                : 'text-gray-500 border-transparent hover:text-blue-700 dark:text-gray-400'"
                            @@click="activeTab = 'memos'">
                        <i class="bi bi-journal-check"></i>
                        <span>Credit Memo Accounts</span>
                    </button>
                </div>

                <!-- Toolbar -->
                <div class="flex justify-end gap-1.5 mb-2 flex-wrap">
                    <button type="button"
                            @@click="openAccountModal()"
                            class="border border-[#062a81] text-white px-2.5 py-1.5 text-xs rounded-lg bg-[#062a81] hover:bg-blue-800">
                        <i class="bi bi-plus-lg mr-1"></i>New
                    </button>

                    <button type="button"
                            @@click="editSelectedAccount"
                            class="border border-slate-500 text-white px-2.5 py-1.5 text-xs rounded-lg bg-slate-700 hover:bg-slate-600">
                        <i class="bi bi-pencil-square mr-1"></i>Edit
                    </button>

                    <button type="button"
                            @@click="deleteSelectedAccounts"
                            class="border border-rose-600 text-white bg-rose-600 px-2.5 py-1.5 text-xs rounded-lg hover:bg-rose-500">
                        <i class="bi bi-trash mr-1"></i>Delete
                    </button>
                </div>

                <!-- ============ TAB 1: BILL ACCOUNTS ============ -->
                <div v-show="activeTab === 'bills'">
                    <data-grid ref="billAccountsGrid"
                               title="Bill Accounts"
                               :columns="billAccountColumns"
                               :data="billAccounts"
                               :theme="theme"
                               row-id="id"
                               label-key="feeItemId"
                               storage-key="school-manager-bill-accounts"
                               item-label="Bill Account"
                               item-label-plural="Bill Accounts"
                               :page-size="15"
                               :selectable="true"
                               :actions="false"
                               :allow-add="false"
                               :allow-edit="false"
                               :allow-delete="false"
                               :loading="isShimmerLoading"
                               :stripes="true"
                               density="compact">
                    </data-grid>
                </div>

                <!-- ============ TAB 2: PAYMENT ACCOUNTS ============ -->
                <div v-show="activeTab === 'payments'">
                    <data-grid ref="paymentAccountsGrid"
                               title="Payment Accounts"
                               :columns="paymentAccountColumns"
                               :data="paymentAccounts"
                               :theme="theme"
                               row-id="id"
                               label-key="localDebitGlId"
                               storage-key="school-manager-payment-accounts"
                               item-label="Payment Account"
                               item-label-plural="Payment Accounts"
                               :page-size="10"
                               :selectable="true"
                               :actions="false"
                               :allow-add="false"
                               :allow-edit="false"
                               :allow-delete="false"
                               :loading="isShimmerLoading"
                               :stripes="true"
                               density="compact">
                    </data-grid>
                </div>

                <!-- ============ TAB 3: CREDIT MEMO ACCOUNTS ============ -->
                <div v-show="activeTab === 'memos'">
                    <data-grid ref="memoAccountsGrid"
                               title="Credit Memo Accounts"
                               :columns="memoAccountColumns"
                               :data="memoAccounts"
                               :theme="theme"
                               row-id="id"
                               label-key="debitGlId"
                               storage-key="school-manager-credit-memo-accounts"
                               item-label="Credit Memo Account"
                               item-label-plural="Credit Memo Accounts"
                               :page-size="10"
                               :selectable="true"
                               :actions="false"
                               :allow-add="false"
                               :allow-edit="false"
                               :allow-delete="false"
                               :loading="isShimmerLoading"
                               :stripes="true"
                               density="compact">
                    </data-grid>
                </div>
            </template>

            <!-- ===================== MODAL: Create / Edit G/L mapping ===================== -->
            <div v-if="accountModalOpen" class="fixed inset-0 z-50 flex items-center justify-center p-4 bg-black/50 backdrop-blur-sm">
                <div class="w-full max-w-4xl rounded-2xl bg-white dark:bg-slate-800 shadow-2xl border border-gray-100 dark:border-slate-700 overflow-hidden flex flex-col max-h-[92vh]">

                    <!-- Header -->
                    <div class="px-6 py-4 border-b border-gray-100 dark:border-slate-700 flex items-center justify-between bg-white dark:bg-slate-800/80">
                        <div>
                            <h3 class="font-bold text-sm text-gray-800 dark:text-white flex items-center gap-2">
                                <i class="bi bi-diagram-3"></i>
                                <span v-if="activeTab === 'bills'">{{ editMode ? 'Edit Bill Account' : 'New Bill Account' }}</span>
                                <span v-else-if="activeTab === 'payments'">{{ editMode ? 'Edit Payment Account' : 'New Payment Account' }}</span>
                                <span v-else>{{ editMode ? 'Edit Credit Memo Account' : 'New Credit Memo Account' }}</span>
                            </h3>
                        </div>
                        <button type="button" @@click="closeAccountModal" class="text-gray-400 hover:text-gray-600 dark:hover:text-gray-200 transition">
                            <i class="bi bi-x-lg"></i>
                        </button>
                    </div>

                    <!-- Body -->
                    <div class="p-6 space-y-5 overflow-y-auto flex-1">

                        <!-- ======= BILL ACCOUNTS ======= -->
                        <div v-if="activeTab === 'bills'" class="grid grid-cols-1 sm:grid-cols-2 gap-4">
                            <div>
                                <w-select v-model="form.billTypeId"
                                          :options="billTypes"
                                          display-key="name"
                                          value-key="id"
                                          label="Bill Type:"
                                          @@update:model-value="onBillTypeChanged"
                                          required>
                                </w-select>
                            </div>

                            <div>
                                <w-select v-model="form.feeItemId"
                                          :options="feeItemOptions"
                                          display-key="name"
                                          value-key="id"
                                          label="Fee Item:"
                                          required>
                                </w-select>
                                <p class="mt-1 text-[11px] text-gray-400">
                                    Only the items of the selected bill type are listed.
                                </p>
                            </div>

                            <div>
                                <w-select v-model="form.bankGlId"
                                          :options="glAccounts"
                                          display-key="name"
                                          value-key="id"
                                          label="Bank G/L Account:"
                                          required>
                                </w-select>
                            </div>

                            <div>
                                <w-select v-model="form.debitGlId"
                                          :options="glAccounts"
                                          display-key="name"
                                          value-key="id"
                                          label="Receivables G/L Account:"
                                          required>
                                </w-select>
                            </div>

                            <div>
                                <w-select v-model="form.creditGlId"
                                          :options="glAccounts"
                                          display-key="name"
                                          value-key="id"
                                          label="Revenue G/L Account:"
                                          required>
                                </w-select>
                            </div>
                        </div>

                        <!-- ======= PAYMENT ACCOUNTS ======= -->
                        <div v-else-if="activeTab === 'payments'" class="grid grid-cols-1 sm:grid-cols-2 gap-4">
                            <div>
                                <w-select v-model="form.localDebitGlId"
                                          :options="glAccounts"
                                          display-key="name"
                                          value-key="id"
                                          label="Local Bank G/L:"
                                          required>
                                </w-select>
                            </div>

                            <div>
                                <w-select v-model="form.foreignDebitGlId"
                                          :options="glAccounts"
                                          display-key="name"
                                          value-key="id"
                                          label="Foreign Bank G/L:">
                                </w-select>
                            </div>

                            <div>
                                <w-select v-model="form.localCreditGlId"
                                          :options="glAccounts"
                                          display-key="name"
                                          value-key="id"
                                          label="Local Receivable G/L:"
                                          required>
                                </w-select>
                            </div>

                            @*<div>
                                <w-select v-model="form.localOverPaymentGlId"
                                          :options="glAccounts"
                                          display-key="name"
                                          value-key="id"
                                          label="Local Overpayment G/L:">
                                </w-select>
                            </div>

                            <div>
                                <w-select v-model="form.foreignOverPaymentGlId"
                                          :options="glAccounts"
                                          display-key="name"
                                          value-key="id"
                                          label="Foreign Overpayment G/L:">
                                </w-select>
                            </div>

                            <div>
                                <w-select v-model="form.otherPaymentDebitGlId"
                                          :options="glAccounts"
                                          display-key="name"
                                          value-key="id"
                                          label="Other Payment Debit G/L:">
                                </w-select>
                            </div>*@

                            <div>
                                <w-select v-model="form.otherPaymentCreditGlId"
                                          :options="glAccounts"
                                          display-key="name"
                                          value-key="id"
                                          label="Foreign AR Credit G/L:">
                                </w-select>
                            </div>
                        </div>

                        <!-- ======= CREDIT MEMO ACCOUNTS ======= -->
                        <div v-else class="grid grid-cols-1 sm:grid-cols-2 gap-4">
                            <div>
                                <w-select v-model="form.debitGlId"
                                          :options="glAccounts"
                                          display-key="name"
                                          value-key="id"
                                          label="Bank G/L Account:"
                                          required>
                                </w-select>
                            </div>

                            <div>
                                <w-select v-model="form.creditGlId"
                                          :options="glAccounts"
                                          display-key="name"
                                          value-key="id"
                                          label="Receivables G/L Account:"
                                          required>
                                </w-select>
                            </div>
                        </div>
                    </div>

                    <!-- Footer -->
                    <div class="px-6 py-3.5 border-t border-gray-100 dark:border-slate-700 flex items-center justify-between bg-gray-50/50 dark:bg-slate-800/80">
                        <div class="text-xs text-gray-500"></div>
                        <div class="flex items-center gap-2">
                            <button type="button"
                                    @@click="closeAccountModal"
                                    class="rounded-lg px-4 py-2 text-xs font-semibold text-gray-700 bg-white border border-gray-200 hover:bg-gray-50 dark:bg-slate-800 dark:border-slate-700 dark:text-gray-200 transition">
                                Close
                            </button>
                            <button type="button"
                                    @@click="saveAccount"
                                    :disabled="saving"
                                    class="inline-flex items-center gap-1.5 rounded-lg px-4 py-2 text-xs font-semibold text-white bg-blue-600 hover:bg-blue-700 transition shadow-sm disabled:opacity-60">
                                <i class="bi" :class="saving ? 'bi-arrow-repeat animate-spin' : 'bi-save'"></i>
                                <span>{{ saving ? 'Saving…' : (editMode ? 'Update' : 'Save') }}</span>
                            </button>
                        </div>
                    </div>
                </div>
            </div>

        </div>
    </div>
</div>

<script src="~/js/school-manager/glAccounts.js" asp-append-version="true"></script>
