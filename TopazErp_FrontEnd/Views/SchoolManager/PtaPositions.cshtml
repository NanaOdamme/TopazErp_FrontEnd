@{
    ViewBag.Title = "PTA Positions";
    Layout = "~/Views/Shared/_adminSchoolManagerLayout.cshtml";
}
<div class="content">
    <div class="mb-6 content-header">
        <div class="flex items-center gap-2 text-sm text-gray-500 mb-2">
            <span>School Manager - Main Setups</span>
            <i class="bi bi-chevron-right text-xs"></i>
            <span class="text-blue-600 font-medium">PTA Positions</span>
        </div>

        <div class="flex items-center gap-3">
            <div class="page-title">
                <h2 class="text-2xl font-semibold text-gray-800">
                    PTA Positions
                </h2>
            </div>
        </div>
    </div>
    <div class="card" data-card-title="PTA Positions">
        <div id="app">
            <data-grid
                title="PTA Positions"
                :columns="ptaPositionColumns"
                :data="ptaPositionList"
                :theme="theme"
                row-id="id"
                label-key="name"
                item-label="PTA Position"
                item-label-plural="PTA Positions"
                add-label="Add PTA Position"
                :page-size="10"
                :selectable="true"
                :actions="true"
                :loading="isShimmerLoading"
                :stripes="true"
                density="compact"
                @@create="onCreatePtaPosition"
                @@update="onUpdatePtaPosition"
                @@delete="onDeletePtaPosition"
            ></data-grid>
        </div>
    </div>
</div>
<script src="~/js/school-manager/pta-positions.js" asp-append-version="true"></script>
