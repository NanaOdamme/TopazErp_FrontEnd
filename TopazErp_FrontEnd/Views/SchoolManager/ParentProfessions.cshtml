@{
    ViewBag.Title = "Parent Professions";
    Layout = "~/Views/Shared/_adminSchoolManagerLayout.cshtml";
}
<div class="content">
    <div class="mb-6 content-header">
        <div class="flex items-center gap-2 text-sm text-gray-500 mb-2">
            <span>School Manager - Main Setups</span>
            <i class="bi bi-chevron-right text-xs"></i>
            <span class="text-blue-600 font-medium">Parent Professions</span>
        </div>

        <div class="flex items-center gap-3">
            <div class="page-title">
                <h2 class="text-2xl font-semibold text-gray-800">
                    Parent Professions
                </h2>
            </div>
        </div>
    </div>
    <div class="card" data-card-title="Parent Professions">
        <div id="app">
            <data-grid
                title="Parent Professions"
                :columns="parentProfessionColumns"
                :data="parentProfessionList"
                :theme="theme"
                row-id="id"
                label-key="name"
                item-label="Parent Profession"
                item-label-plural="Parent Professions"
                add-label="Add Parent Profession"
                :page-size="10"
                :selectable="true"
                :actions="true"
                :loading="isShimmerLoading"
                :stripes="true"
                @@create="onCreateParentProfession"
                @@update="onUpdateParentProfession"
                @@delete="onDeleteParentProfession"
            ></data-grid>
        </div>
    </div>
</div>

<script src="~/js/school-manager/pta-positions.js" asp-append-version="true"></script>
