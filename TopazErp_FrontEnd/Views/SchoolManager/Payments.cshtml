@{
    ViewBag.Title = "Student Payments";
    Layout = "~/Views/Shared/_adminSchoolManagerLayout.cshtml";
}

<div class="content">
    <div class="mb-5 content-header">
        <div class="flex items-center gap-2 text-sm text-gray-500 mb-1 dark:text-gray-400">
            <span>School Manager - Billing &amp; Payments</span>
            <i class="bi bi-chevron-right text-xs"></i>
            <span class="text-blue-600 font-medium dark:text-blue-400">Student Payments</span>
        </div>

        <div class="flex flex-col sm:flex-row sm:items-center sm:justify-between gap-3">
            <div>
                <h2 class="text-lg font-bold text-gray-800 dark:text-white tracking-tight flex items-center gap-2.5">
                    Student Payments
                </h2>
            </div>
        </div>
    </div>

    <div class="card" data-card-title="Student Payments">
        <div id="app">

            <!-- Loader -->
            <div v-if="!setupDone" class="py-24 text-center text-gray-400">
                <i class="text-blue-800 bi bi-arrow-repeat animate-spin text-3xl inline-block mb-2"></i>
                <p class="text-sm">Loading payments, students and lookups…</p>
            </div>

            <template v-else>
                <!-- Toolbar -->
                <div class="flex justify-end gap-1.5 mb-2 flex-wrap">
                    <button type="button"
                            @@click="openPaymentModal()"
                            class="border border-[#062a81] text-white px-2.5 py-1.5 text-xs rounded-lg bg-[#062a81] hover:bg-blue-800">
                        <i class="bi bi-plus-lg mr-1"></i>New Payment
                    </button>

                    <button type="button"
                            @@click="editSelectedPayment"
                            class="border border-slate-500 text-white px-2.5 py-1.5 text-xs rounded-lg bg-slate-700 hover:bg-slate-600">
                        <i class="bi bi-pencil-square mr-1"></i>Edit
                    </button>

                    <button type="button"
                            @@click="processSelectedPayments"
                            :disabled="busy"
                            class="border border-indigo-600 text-white bg-indigo-600 px-2.5 py-1.5 text-xs rounded-lg hover:bg-indigo-500 disabled:opacity-60">
                        <i class="bi bi-send-check mr-1"></i>Process
                    </button>

                    <button type="button"
                            @@click="cancelSelectedPayments"
                            :disabled="busy"
                            class="border border-rose-600 text-white bg-rose-600 px-2.5 py-1.5 text-xs rounded-lg hover:bg-rose-500 disabled:opacity-60">
                        <i class="bi bi-x-circle mr-1"></i>Cancel
                    </button>
                </div>

                <data-grid ref="paymentsGrid"
                           title="Student Payments"
                           :columns="paymentColumns"
                           :data="payments"
                           :theme="theme"
                           row-id="id"
                           label-key="receiptNumber"
                           storage-key="school-manager-student-payments"
                           item-label="Payment"
                           item-label-plural="Payments"
                           :page-size="10"
                           :selectable="true"
                           :actions="false"
                           :allow-add="false"
                           :allow-edit="false"
                           :allow-delete="false"
                           :loading="isShimmerLoading"
                           :stripes="true"
                           density="compact">
                </data-grid>
            </template>

            <!-- ===================== MODAL: Record / Edit Payment ===================== -->
            <div v-if="paymentModalOpen" class="fixed inset-0 z-50 flex items-center justify-center p-4 bg-black/50 backdrop-blur-sm">
                <div class="w-full max-w-4xl rounded-2xl bg-white dark:bg-slate-800 shadow-2xl border border-gray-100 dark:border-slate-700 overflow-hidden flex flex-col max-h-[92vh]">

                    <!-- Header -->
                    <div class="px-6 py-4 border-b border-gray-100 dark:border-slate-700 flex items-center justify-between bg-white dark:bg-slate-800/80">
                        <div>
                            <h3 class="font-bold text-sm text-gray-800 dark:text-white flex items-center gap-2">
                                <i class="bi bi-cash-coin"></i>
                                <span>{{ editMode ? 'Edit Student Payment' : 'Record Student Payment' }}</span>
                            </h3>
                        
                        </div>
                        <button type="button" @@click="closePaymentModal" class="text-gray-400 hover:text-gray-600 dark:hover:text-gray-200 transition">
                            <i class="bi bi-x-lg"></i>
                        </button>
                    </div>

                    <!-- Body -->
                    <div class="p-6 space-y-5 overflow-y-auto flex-1">

                        <!-- Read-only notice -->
                        <div v-if="form.isLocked"
                             class="p-3 rounded-xl border border-rose-200 bg-rose-50 text-rose-700 text-xs flex items-start gap-2">
                            <i class="bi bi-lock-fill mt-0.5"></i>
                            <span>Read Only</span>
                        </div>

                        <!-- Student + Bill -->
                        <div class="grid grid-cols-1 sm:grid-cols-3 gap-4">
                            <div>
                                <w-select v-model="form.studentId"
                                          :options="studentOptions"
                                          display-key="name"
                                          value-key="studentId"
                                          label="Students (with bills):"
                                          :disabled="editMode || form.isLocked"
                                          @@update:model-value="onStudentChanged"
                                          required>
                                </w-select>
                            
                            </div>
                        <div>   
                                <label class="label">
                                    Payment Date <span class="text-rose-500">*</span>
                                </label>
                                <input type="date"
                                       v-model="form.paymentDate"
                                       :disabled="form.isLocked"
                                       class="input-control" />
                            </div>

                            <div>
                                <label class="label">
                                    Receipt No.
                                </label>
                                <div class="flex items-center gap-1">
                                    <input type="text"
                                           v-model="form.receiptNumber"
                                           readonly
                                           class="input-control" />
                                    <button v-if="!form.isLocked"
                                            type="button"
                                            title="Regenerate receipt number"
                                            @@click="regenerateReceiptNumber"
                                            class="shrink-0 rounded-md  px-2 py-1.5 text-gray-500 hover:text-blue-600 hover:border-blue-300 transition">
                                        <i class="bi bi-arrow-repeat"></i>
                                    </button>
                                </div>
                            </div>

                            <div>
                                <label class="label">
                                    Payment Method <span class="text-rose-500">*</span>
                                </label>
                                <select v-model.number="form.paymentMethod"
                                        :disabled="form.isLocked"
                                        @@change="onPaymentMethodChanged"
                                        class="select text-xs">
                                    <option v-for="m in paymentMethods" :key="m.id" :value="m.id">{{ m.name }}</option>
                                </select>
                            </div>
                            <div>
                                <label class="label">
                                    Reference Number
                                </label>
                                <input type="text"
                                       v-model="form.referenceNumber"
                                       :disabled="form.isLocked"
                                       placeholder="transaction reference"
                                       class="input-control" />
                            </div>
                            
                        </div>

                        <!-- ================= NEW: Bills to settle (auto allocation) ================= -->
                        <div class="rounded-xl border border-gray-200 dark:border-slate-700 p-4">
                            <div class="flex items-center justify-between flex-wrap gap-2 mb-3">
                                <h4 class="text-xs font-bold text-gray-700 dark:text-gray-200 flex items-center gap-1.5">
                                    <i class="bi bi-receipt-cutoff text-blue-600"></i>
                                    <span>Bills to Settle ({{ allocationPlan.length }})</span>
                                </h4>
                                <span class="text-[11px] text-gray-500">
                                    Outstanding:
                                    <strong class="text-gray-700 dark:text-gray-200">{{ formatMoney(outstandingBefore) }}</strong>
                                </span>
                            </div>

                            <div v-if="!form.studentId" class="py-3 text-center text-[11px] text-gray-400">
                                Select a student to load their open bills.
                            </div>

                            <div v-else-if="!hasOpenBills" class="py-3 text-center text-[11px] text-amber-600">
                                <i class="bi bi-info-circle mr-1"></i>
                                This student has no open bill — the whole amount will become a credit.
                            </div>

                            <div v-else class="overflow-x-auto">
                                <table class="w-full text-xs text-left">
                                    <thead class="text-[11px] uppercase tracking-wider text-gray-500 border-b dark:border-slate-700">
                                        <tr>
                                            <th class="py-2 px-2">Bill</th>
                                            <th class="py-2 px-2">Year / Term</th>
                                            <th class="py-2 px-2 text-right">Balance</th>
                                            <th class="py-2 px-2 text-right">Apply</th>
                                            <th class="py-2 px-2 text-right">Remaining</th>
                                            <th class="py-2 px-2 text-center">Status</th>
                                        </tr>
                                    </thead>
                                    <tbody class="divide-y divide-gray-100 dark:divide-slate-800">
                                        <tr v-for="row in allocationPlan" :key="row.id">
                                            <td class="py-2 px-2 font-medium text-gray-700 dark:text-gray-200">
                                                {{ row.billNumber || '—' }}
                                            </td>
                                            <td class="py-2 px-2 text-gray-500">
                                                {{ row.yearName }} <span class="text-gray-300">/</span> {{ row.termName }}
                                            </td>
                                            <td class="py-2 px-2 text-right">{{ formatMoney(row.balance) }}</td>
                                            <td class="py-2 px-2 text-right font-semibold text-emerald-600">{{ formatMoney(row.applied) }}</td>
                                            <td class="py-2 px-2 text-right">{{ formatMoney(row.remaining) }}</td>
                                            <td class="py-2 px-2 text-center">
                                                <span v-if="row.settled"
                                                      class="inline-flex items-center gap-1 rounded-full bg-emerald-50 px-2 py-0.5 text-[10px] font-semibold text-emerald-700">
                                                    <i class="bi bi-check-circle"></i> Settled
                                                </span>
                                                <span v-else
                                                      class="inline-flex items-center gap-1 rounded-full bg-amber-50 px-2 py-0.5 text-[10px] font-semibold text-amber-700">
                                                    Partial
                                                </span>
                                            </td>
                                        </tr>
                                    </tbody>
                                    <tfoot class="border-t border-gray-200 dark:border-slate-700 text-[11px]">
                                        <tr>
                                            <td class="py-2 px-2 font-semibold text-gray-600 dark:text-gray-300" colspan="2">Totals</td>
                                            <td class="py-2 px-2 text-right font-semibold">{{ formatMoney(outstandingBefore) }}</td>
                                            <td class="py-2 px-2 text-right font-semibold text-emerald-600">{{ formatMoney(allocatedTotal) }}</td>
                                            <td class="py-2 px-2 text-right font-semibold">{{ formatMoney(balanceAfterLocal) }}</td>
                                            <td></td>
                                        </tr>
                                    </tfoot>
                                </table>
                            </div>

                            <div v-if="hasCredit"
                                 class="mt-3 p-2.5 rounded-lg border border-amber-200 bg-amber-50 text-[11px] text-amber-800 flex items-start gap-2">
                                <i class="bi bi-wallet2 mt-0.5"></i>
                                <span>
                                    <strong>{{ formatMoney(creditAmount) }}</strong> cannot be applied to a bill.
                                    After saving you will be asked whether to create a credit memo for it.
                                </span>
                            </div>
                        </div>

                      

                        <!-- Amounts -->
                        <div class="rounded-xl border border-gray-200 dark:border-slate-700 p-4">
                            <h4 class="text-xs font-bold text-gray-700 dark:text-gray-200 flex items-center gap-1.5 mb-3">
                                <i class="bi bi-calculator text-blue-600"></i>
                                <span>Payment Details</span>
                            </h4>

                            <div class="grid grid-cols-1 sm:grid-cols-3 gap-4">
                             <div>
                                 <label class="label">
                                     Currency
                                 </label>
                                <w-select v-model="form.currencyId"
                                          :options="currencies"
                                          display-key="currencyName"
                                          value-key="id"
                                        
                                          :disabled="form.isLocked"
                                          @@update:model-value="onCurrencyChanged">
                                </w-select>
                                <p class="mt-1 text-[11px] flex items-center gap-1"
                                   :class="isPaymentMultiCurrency ? 'text-amber-600 font-semibold' : 'text-gray-400'">
                                    <i class="bi" :class="isPaymentMultiCurrency ? 'bi-globe2' : 'bi-check-circle'"></i>
                                    <span v-if="isPaymentMultiCurrency">Foreign currency — amount converts to {{ currencyCode }}</span>
                                    <span v-else>School local currency</span>
                                </p>
                            </div>

                            <div>
                                <label class="label">
                                    Currency Rate
                                </label>
                                <input type="number"
                                       step="0.0001"
                                       v-model.number="form.buyRate"
                                       :disabled="form.isLocked || !isPaymentMultiCurrency"
                                       class="input-control" />
                    
                            </div>
                                <div>
                                    <label class="label">
                                        Amount (Due) · {{ currencyCode }}
                                    </label>
                                    <input type="number"
                                           step="0.01"
                                           v-model.number="form.amountDue"
                                           :disabled="editMode || form.isLocked"
                                           class="input-control" />
                                </div>

                                <div>
                                    <label class="label">
                                        Amount Paid ({{ paymentCurrencyCode }}) <span class="text-rose-500">*</span>
                                    </label>
                                    <input type="number"
                                           step="0.01"
                                           min="0"
                                           v-model.number="form.amountToPaid"
                                           :disabled="form.isLocked"
                                           class="input-control" />

                                    <!-- Always show the converted amount -->
                                    <p class="mt-1 text-[11px] leading-tight"
                                       :class="isPaymentMultiCurrency ? 'text-emerald-600 font-semibold' : 'text-gray-400'">
                                        <i class="bi bi-arrow-left-right mr-0.5"></i>
                                        {{ formatConverted(amountPaidInLocalCurrency) }} · {{ currencyCode }}
                                        <span v-if="isPaymentMultiCurrency" class="font-normal text-gray-500">
                                            @@ {{ effectiveRate }} ({{ paymentCurrencyCode }} → {{ currencyCode }})
                                        </span>
                                    </p>
                                </div>

                                <div>
                                    <label class="label">
                                        Balance · {{ currencyCode }}
                                    </label>
                                    <input type="text"
                                           :value="formatMoney(balanceAfterLocal)"
                                           readonly
                                           class="input-control" />
                                    <p v-if="isPaymentMultiCurrency" class="mt-1 text-[11px] text-gray-500">
                                        {{ formatPaymentMoney(balanceAfterPaymentCurrency) }} in {{ paymentCurrencyCode }}
                                    </p>
                                </div>
                            </div>

                            <div class="mt-3 flex flex-wrap items-center gap-4 text-[11px]">
                                <span class="text-gray-500">
                                    Outstanding before payment:
                                    <strong class="text-gray-700 dark:text-gray-200">{{ formatMoney(outstandingBefore) }}</strong>
                                    <span v-if="isPaymentMultiCurrency">
                                        ({{ formatPaymentMoney(outstandingInPaymentCurrency) }} in {{ paymentCurrencyCode }})
                                    </span>
                                </span>
                            
                                <span v-if="hasCredit" class="text-amber-600 font-semibold flex items-center gap-1">
                                    <i class="bi bi-wallet2"></i>
                                    {{ formatMoney(creditAmount) }} becomes a credit
                                </span>
                            </div>
                             <div  class="grid grid-cols-1 sm:grid-cols-3 gap-4">
                            <div>
                                <w-select v-model="form.bankId"
                                          :options="banks"
                                          display-key="name"
                                          value-key="id"
                                          label="Bank:"
                                          :disabled="form.isLocked"
                                          @@update:model-value="onBankChanged">
                                </w-select>
                            </div>

                            <div>
                                <w-select v-model="form.bankBranchId"
                                          :options="bankBranchChoices"
                                          display-key="name"
                                          value-key="id"
                                          label="Bank Branch:"
                                          :disabled="form.isLocked || !form.bankId">
                                </w-select>
                            </div>

                            <div>
                                <w-select v-model="form.bankGlId"
                                          :options="glAccounts"
                                          display-key="name"
                                          value-key="id"
                                          label="Bank G/L Account:"
                                          :disabled="form.isLocked">
                                </w-select>
                            </div>
                        </div>

                        <div v-if="isCheque" class="grid grid-cols-1 sm:grid-cols-3 gap-4">
                            <div>
                                <label class="label">
                                    Cheque Number <span class="text-rose-500">*</span>
                                </label>
                                <input type="text"
                                       v-model="form.chequeNumber"
                                       :disabled="form.isLocked"
                                       class="input-control" />
                            </div>
                            <div>
                                <label class="label">
                                    Cheque Date
                                </label>
                                <input type="date"
                                       v-model="form.chequeDate"
                                       :disabled="form.isLocked"
                                       class="input-control" />
                            </div>
                        </div>
                        </div>

                    

                        <!-- Description -->
                        <div>
                            <label class="label">
                                Description
                            </label>
                            <textarea v-model="form.description"
                                      rows="2"
                                      :disabled="form.isLocked"
                                      placeholder="Optional remarks for this payment"
                                      class="input-control"></textarea>
                        </div>

                        @*<label class="inline-flex items-center gap-2 text-xs text-gray-600 dark:text-gray-300 cursor-pointer">
                            <input type="checkbox" v-model="form.byLegalGuardian" :disabled="form.isLocked" />
                            <span>Paid by legal guardian</span>
                        </label>*@
                    </div>

                    <!-- Footer -->
                    <div class="px-6 py-3.5 border-t border-gray-100 dark:border-slate-700 flex items-center justify-between bg-gray-50/50 dark:bg-slate-800/80">
                        <div class="text-xs text-gray-500">
                            <span v-if="form.isLocked" class="text-rose-600 font-semibold flex items-center gap-1">
                                <i class="bi bi-lock-fill"></i> Read only
                            </span>
                          
                        </div>
                        <div class="flex items-center gap-2">
                            <button type="button"
                                    @@click="closePaymentModal"
                                    class="rounded-lg px-4 py-2 text-xs font-semibold text-gray-700 bg-white border border-gray-200 hover:bg-gray-50 dark:bg-slate-800 dark:border-slate-700 dark:text-gray-200 transition">
                                Close
                            </button>
                            <button v-if="!form.isLocked"
                                    type="button"
                                    @@click="savePayment"
                                    :disabled="saving"
                                    class="inline-flex items-center gap-1.5 rounded-lg px-4 py-2 text-xs font-semibold text-white bg-blue-600 hover:bg-blue-700 transition shadow-sm disabled:opacity-60">
                                <i class="bi" :class="saving ? 'bi-arrow-repeat animate-spin' : 'bi-save'"></i>
                                <span>{{ saving ? 'Saving…' : (editMode ? 'Update Payment' : 'Save Payment') }}</span>
                            </button>
                        </div>
                    </div>
                </div>
            </div>

        </div>
    </div>
</div>

<script src="~/js/school-manager/payments.js" asp-append-version="true"></script>
