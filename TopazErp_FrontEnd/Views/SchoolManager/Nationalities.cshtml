@{
ViewBag.Title = "Nationalities";
Layout = "~/Views/Shared/_adminSchoolManagerLayout.cshtml";
}
<div class="content">
    <div class="mb-6 content-header">
        <div class="flex items-center gap-2 text-sm text-gray-500 mb-2">
            <span>School Manager - General Setups</span>
            <i class="bi bi-chevron-right text-xs"></i>
            <span class="text-blue-600 font-medium">Nationalities</span>
        </div>

        <div class="flex items-center gap-3">
            <div class="page-title">
                <h2 class="text-2xl font-semibold text-gray-800">
                    Nationalities
                </h2>
            </div>
        </div>
    </div>
    <div class="card" data-card-title="Nationalities">
        <div id="app">
            <data-grid
                title="Nationalities"
                :columns="columns"
                :data="countries"
                :theme="theme"
                row-id="id"
                label-key="name"
                item-label="Nationalities"
                item-label-plural="Nationalities"
                :page-size="10"
                :selectable="true"
                :loading="isShimmerLoading"
                :stripes="true"
                :allow-add="false"
                :allow-edit="false"
                :allow-delete="false"
                density="compact"
            ></data-grid>
        </div>
    </div>
</div>
<script src="~/js/shared/vue3/nationalities.js" asp-append-version="true"></script>