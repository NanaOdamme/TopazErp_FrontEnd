@{
    ViewBag.Title = "Results Entry Period";
    Layout = "~/Views/Shared/_adminSchoolManagerLayout.cshtml";
}

<div class="content">
    <div class="mb-4 content-header">
        <div class="flex items-center gap-2 text-sm text-gray-500 mb-1.5 dark:text-gray-400">
            <span>School Manager - Promotions & Results</span>
            <i class="bi bi-chevron-right text-xs"></i>
            <span class="text-blue-600 font-medium dark:text-blue-400">Results Entry Period</span>
        </div>

        <div class="flex items-center gap-3">
            <div class="page-title">
                <h2 class="text-xl font-semibold text-gray-800 dark:text-white">
                    Results Entry Period
                </h2>
            </div>
           
        </div>
    </div>

    <div class="card" data-card-title="Results Entry Period">
        <div id="app">
            <!-- Initial Loading -->
            <div v-if="!setupDone" class="py-20 text-center text-gray-400">
                <i class="bi bi-arrow-repeat animate-spin text-3xl inline-block mb-2 text-[#062a81]"></i>
                <p class="text-sm">Loading results entry periods…</p>
            </div>

            <!-- Data Table View -->
            <template v-else>
                <data-grid title="Periods"
                           :columns="columns"
                           :data="filteredResultPeriods"
                           :theme="theme"
                           row-id="id"
                           label-key="startDate"
                           item-label="Result Period"
                           item-label-plural="Result Periods"
                           add-label="Add"
                           :page-size="10"
                           :selectable="true"
                           :actions="true"
                           :loading="isShimmerLoading"
                           :stripes="true"
                           density="compact"
                           @@create="onCreate"
                           @@update="onUpdate"
                           @@delete="onDelete">
                </data-grid>
            </template>

        </div><!-- /#app -->
    </div><!-- /.card -->
</div><!-- /.content -->

<script src="~/js/school-manager/result-periods.js"></script>
