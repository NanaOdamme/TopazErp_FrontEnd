@{
    ViewBag.Title = "Class Promotions";
    Layout = "~/Views/Shared/_adminSchoolManagerLayout.cshtml";
}

<div class="content">
    <div class="mb-4 content-header">
        <div class="flex items-center gap-2 text-sm text-gray-500 mb-1.5 dark:text-gray-400">
            <span>School Manager - Academic Setups</span>
            <i class="bi bi-chevron-right text-xs"></i>
            <span class="text-blue-600 font-medium dark:text-blue-400">Class Promotions</span>
        </div>

        <div class="flex flex-col sm:flex-row sm:items-center sm:justify-between gap-3">
            <div class="page-title">
                <h2 class="text-lg font-semibold text-gray-800 dark:text-white flex items-center gap-2">
                
                    Class Promotions
                </h2>
            </div>

        
        </div>
    </div>

    <div class="card" data-card-title="Class Promotions">
        <div id="app">

            <!-- Control Bar: Term Start Date & Actions -->
            <div class="flex flex-col md:flex-row md:items-end justify-between gap-4 mb-6 pb-5 border-b border-gray-100 dark:border-slate-700">
                <div class="w-full sm:w-80">
                    <label class="label">Next Term Start Date</label>
                    <input type="date"
                           v-model="globalStartDate"
                           required
                           class="input-control" />
                </div>

                <div class="flex items-center gap-3">
                    <div class="w-full sm:w-64">
                        <label class="label">Search Class</label>
                        <input type="text"
                               v-model="searchQuery"
                               placeholder="Filter classes..."
                               class="input-control" />
                    </div>

                    <div class="self-end">
                        <button type="button"
                                @@click="saveAllPromotions"
                                :disabled="saving || isShimmerLoading || rows.length === 0"
                                class="inline-flex items-center gap-2 rounded-lg px-4 py-2.5 text-xs font-semibold text-white bg-[#062a81] hover:bg-blue-900 shadow-sm transition disabled:opacity-50 whitespace-nowrap">
                            <i v-if="saving" class="bi bi-arrow-repeat animate-spin"></i>
                            <i v-else class="bi bi-check2-all"></i>
                            <span>Save All Promotions</span>
                        </button>
                    </div>
                </div>
            </div>

            <!-- Initial Loading -->
            <div v-if="!setupDone" class="py-24 text-center text-gray-400">
                <i class="bi bi-arrow-repeat animate-spin text-3xl inline-block mb-2 text-[#062a81]"></i>
                <p class="text-sm">Loading classes and promotion configurations…</p>
            </div>

            <!-- Promotions Table & Pagination -->
            <template v-else>
                <div class="rounded-xl border border-gray-200 dark:border-slate-700 overflow-hidden bg-white dark:bg-slate-800 shadow-sm">
                    <div class="overflow-x-auto">
                        <table class="min-w-full text-sm divide-y divide-gray-100 dark:divide-slate-700">
                            <thead class="bg-gray-50 dark:bg-slate-800 text-[11px] uppercase tracking-wider text-gray-500 dark:text-gray-400">
                                <tr>
                                    <th class="px-5 py-3 text-left font-semibold w-16">#</th>
                                    <th class="px-5 py-3 text-left font-semibold w-1/3">Current Class (From)</th>
                                    <th class="px-5 py-3 text-left font-semibold w-1/3">Target Promotion Class (To)</th>
                                    <th class="px-5 py-3 text-left font-semibold">Start Date</th>
                                    <th class="px-5 py-3 text-right font-semibold w-28">Action</th>
                                </tr>
                            </thead>
                            <tbody class="divide-y divide-gray-100 dark:divide-slate-700">
                                <tr v-for="(row, idx) in paginatedRows"
                                    :key="row.fromClassId"
                                    :class="{ 'bg-blue-50/40 dark:bg-slate-700/30': row.dirty }"
                                    class="hover:bg-gray-50 dark:hover:bg-slate-700/50 transition">
                                    <td class="px-5 py-3.5 text-xs text-gray-400 font-bold">
                                        {{ (currentPage - 1) * pageSize + idx + 1 }}
                                    </td>
                                    <td class="px-5 py-3.5 font-semibold text-gray-800 dark:text-white">
                                        <div class="flex items-center gap-2">
                                            <i class="bi bi-mortarboard text-[#062a81] dark:text-blue-400"></i>
                                            <span>{{ row.fromClassName }}</span>
                                        </div>
                                    </td>
                                    <td class="px-5 py-3.5">
                                        <select v-model="row.toClassId"
                                                @@change="onToClassChange(row)"
                                                class="select">
                                            <option value="00000000-0000-0000-0000-000000000000">-- No Promotion (Completed / Terminal) --</option>
                                            <option v-for="c in classes"
                                                    :key="c.id"
                                                    :value="c.id"
                                                    :disabled="String(c.id).toLowerCase() === String(row.fromClassId).toLowerCase()">
                                                {{ c.name }}
                                            </option>
                                        </select>
                                    </td>
                                    <td class="px-5 py-3.5 text-xs text-gray-600 dark:text-gray-300">
                                        <span class="inline-flex items-center gap-1.5 px-2.5 py-1 rounded-md bg-gray-100 dark:bg-slate-700 font-mono text-[11px]">
                                            <i class="bi bi-calendar-event"></i>
                                            {{ globalStartDate }}
                                        </span>
                                    </td>
                                    <td class="px-5 py-3.5 text-right">
                                        <button type="button"
                                                @@click="saveSingleRow(row)"
                                                :disabled="savingRowId === row.fromClassId"
                                                class="inline-flex items-center gap-1 rounded-lg px-3 py-1.5 text-xs font-semibold text-[#062a81] hover:bg-blue-50 dark:text-blue-300 dark:hover:bg-slate-700 border border-blue-200 dark:border-slate-600 transition disabled:opacity-50">
                                            <i v-if="savingRowId === row.fromClassId" class="bi bi-arrow-repeat animate-spin"></i>
                                            <i v-else class="bi bi-check-lg"></i>
                                            <span>Save</span>
                                        </button>
                                    </td>
                                </tr>

                                <tr v-if="filteredRows.length === 0">
                                    <td colspan="5" class="py-12 text-center text-gray-400">
                                        <i class="bi bi-search text-2xl block mb-1"></i>
                                        <span>No classes found matching search query</span>
                                    </td>
                                </tr>
                            </tbody>
                        </table>
                    </div>

                    <!-- Modern Pagination Controls Footer -->
                    <div class="px-5 py-3.5 bg-gray-50 dark:bg-slate-800/80 border-t border-gray-100 dark:border-slate-700 flex flex-col sm:flex-row sm:items-center sm:justify-between gap-3 text-xs text-gray-600 dark:text-gray-300">
                        <!-- Left: Page Size Selector & Record Count -->
                        <div class="flex items-center gap-3">
                            <div class="flex items-center gap-1.5">
                                <span>Show</span>
                                <select v-model.number="pageSize" class="input-control text-xs" style="width: auto; padding-top: 0.25rem; padding-bottom: 0.25rem;">
                                    <option v-for="size in pageSizeOptions" :key="size" :value="size">{{ size }}</option>
                                </select>
                                <span>entries</span>
                            </div>
                            <span class="text-gray-300 dark:text-gray-600">|</span>
                            <span>Showing <strong>{{ paginationStart }}</strong> to <strong>{{ paginationEnd }}</strong> of <strong>{{ filteredRows.length }}</strong> classes</span>
                        </div>

                        <!-- Right: Page Navigation -->
                        <div v-if="totalPages > 1" class="flex items-center gap-1">
                            <button type="button"
                                    @@click="prevPage"
                                    :disabled="currentPage === 1"
                                    class="px-2.5 py-1.5 rounded-md border border-gray-200 dark:border-slate-600 bg-white dark:bg-slate-700 hover:bg-gray-100 dark:hover:bg-slate-600 disabled:opacity-40 disabled:cursor-not-allowed transition">
                                <i class="bi bi-chevron-left text-xs"></i>
                            </button>

                            <button v-for="page in pageNumbers"
                                    :key="page"
                                    type="button"
                                    @@click="setPage(page)"
                                    :disabled="page === '...'"
                                    :class="currentPage === page
                                        ? 'bg-[#062a81] text-white font-bold border-[#062a81]'
                                        : 'bg-white dark:bg-slate-700 text-gray-700 dark:text-gray-200 border-gray-200 dark:border-slate-600 hover:bg-gray-100 dark:hover:bg-slate-600'"
                                    class="min-w-[32px] px-2.5 py-1.5 rounded-md border text-xs transition">
                                {{ page }}
                            </button>

                            <button type="button"
                                    @@click="nextPage"
                                    :disabled="currentPage === totalPages"
                                    class="px-2.5 py-1.5 rounded-md border border-gray-200 dark:border-slate-600 bg-white dark:bg-slate-700 hover:bg-gray-100 dark:hover:bg-slate-600 disabled:opacity-40 disabled:cursor-not-allowed transition">
                                <i class="bi bi-chevron-right text-xs"></i>
                            </button>
                        </div>
                    </div>
                </div>

                <!-- Footer Summary Bar -->
                <div class="mt-4 flex flex-col sm:flex-row sm:items-center justify-between text-xs text-gray-500 dark:text-gray-400 px-1 gap-2">
                    <div>
                        Configured <strong>{{ configuredCount }}</strong> of <strong>{{ rows.length }}</strong> classes with target promotions.
                    </div>
                    <div>
                        Classes without a target will be assigned an empty GUID.
                    </div>
                </div>
            </template>

        </div><!-- /#app -->
    </div><!-- /.card -->
</div><!-- /.content -->

<script src="~/js/school-manager/class-promotions.js"></script>
