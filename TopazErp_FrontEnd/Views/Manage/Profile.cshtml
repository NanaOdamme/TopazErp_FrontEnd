@{
    ViewBag.Title = "Profile";
    Layout = "~/Views/Shared/_adminTenantLayout.cshtml";
}

<div class="content">
    <div class="mb-6 content-header">
        <div class="flex items-center gap-2 text-sm text-gray-500 mb-2">
            <span>Manage</span>
            <i class="bi bi-chevron-right text-xs"></i>
            <span class="text-blue-600 font-medium">User Profile</span>
        </div>

        <div class="flex items-center gap-3">

            <div class="page-title">
                <h2 class="text-2xl font-semibold text-gray-800">
                    User Profile
                </h2>

                <p class="text-sm text-gray-500">
                    Manage your user profile and account information
                </p>
            </div>
        </div>
    </div>
    <div class="card" data-card-title="Profile">
        <div id="app">
            <div class="grid grid-cols-1 sm:grid-cols-12 gap-6">

    <!-- Spacer -->
    <div class="hidden sm:block sm:col-span-1"></div>


    <!-- Left Column -->
    <div class="sm:col-span-5">

        <!-- First Name -->
        <div class="mb-5">

            <label class="block mb-2 text-sm font-semibold text-gray-700">
                First Name:
            </label>

            <input type="text"
                   v-model="name"
                   ref="name"
                   placeholder="First Name"
                   :class="[
                       'w-full px-4 py-2.5 rounded-lg text-sm transition focus:outline-none focus:ring-2',
                       errors.name
                           ? 'border border-red-500 focus:ring-red-500'
                           : 'border border-gray-300 focus:border-blue-500 focus:ring-blue-500'
                   ]">

            <p v-if="errors.name"
               class="mt-1.5 text-sm text-red-600">
                {{ errors.name }}
            </p>

        </div>


        <!-- Username -->
        <div class="mb-5">

            <label class="block mb-2 text-sm font-semibold text-gray-700">
                Username:
            </label>

            <input type="text"
                   v-model="userName"
                   ref="userName"
                   :readonly="userName == 'admin'"
                   placeholder="Username"
                   :class="[
                       'w-full px-4 py-2.5 rounded-lg text-sm transition focus:outline-none focus:ring-2',
                       errors.userName
                           ? 'border border-red-500 focus:ring-red-500'
                           : 'border border-gray-300 focus:border-blue-500 focus:ring-blue-500',
                       userName == 'admin'
                           ? 'bg-gray-100 text-gray-500'
                           : 'bg-white'
                   ]">

            <p v-if="errors.userName"
               class="mt-1.5 text-sm text-red-600">
                {{ errors.userName }}
            </p>

        </div>


        <!-- Phone Number -->
        <div class="mb-5">

            <label class="block mb-2 text-sm font-semibold text-gray-700">
                Phone Number:
            </label>

            <input type="text"
                   v-model="phoneNumber"
                   ref="phoneNumber"
                   placeholder="Phone Number"
                   class="w-full px-4 py-2.5 border border-gray-300 rounded-lg
                          text-sm text-gray-700 bg-white
                          focus:outline-none focus:ring-2
                          focus:ring-blue-500 focus:border-blue-500">

        </div>

    </div>


    <!-- Right Column -->
    <div class="sm:col-span-5">

        <!-- Last Name -->
        <div class="mb-5">

            <label class="block mb-2 text-sm font-semibold text-gray-700">
                Last Name:
            </label>

            <input type="text"
                   v-model="surname"
                   ref="surname"
                   placeholder="Last Name"
                   :class="[
                       'w-full px-4 py-2.5 rounded-lg text-sm transition focus:outline-none focus:ring-2',
                       errors.surname
                           ? 'border border-red-500 focus:ring-red-500'
                           : 'border border-gray-300 focus:border-blue-500 focus:ring-blue-500'
                   ]">

            <p v-if="errors.surname"
               class="mt-1.5 text-sm text-red-600">
                {{ errors.surname }}
            </p>

        </div>


        <!-- Email -->
        <div class="mb-5">

            <label class="block mb-2 text-sm font-semibold text-gray-700">
                Email:
            </label>

            <input type="text"
                   v-model="emailAddress"
                   ref="emailAddress"
                   placeholder="Email"
                   :class="[
                       'w-full px-4 py-2.5 rounded-lg text-sm transition focus:outline-none focus:ring-2',
                       errors.emailAddress
                           ? 'border border-red-500 focus:ring-red-500'
                           : 'border border-gray-300 focus:border-blue-500 focus:ring-blue-500'
                   ]">

            <p v-if="errors.emailAddress"
               class="mt-1.5 text-sm text-red-600">
                {{ errors.emailAddress }}
            </p>

        </div>


        <!-- Update Button -->
        <div class="flex justify-end mt-6">

            <button type="button"
                    v-on:click="updateProfile()"
                    :disabled="isLoading"
                    class="inline-flex items-center justify-center gap-2
                           px-5 py-2.5
                           bg-blue-600 hover:bg-blue-700
                           disabled:bg-blue-400
                           text-white text-sm font-medium
                           rounded-lg shadow-sm
                           transition duration-200
                           focus:outline-none focus:ring-2
                           focus:ring-blue-500 focus:ring-offset-2">

                <span v-if="!isLoading">
                    Update
                </span>

                <span v-else class="flex items-center gap-2">
                    Updating...
                    <i class="bi bi-arrow-repeat animate-spin"></i>
                </span>

            </button>

        </div>

    </div>

</div>
        </div>
       
    </div>
</div>



<script src="~/js/manage/profile.js" asp-append-version="true"></script>



