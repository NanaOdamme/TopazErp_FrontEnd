@{
    ViewBag.Title = "Profile";
    Layout = "~/Views/Shared/_adminTenantLayout.cshtml";
}

<div class="content">
    <div class="mb-6 content-header">
        <div class="flex items-center gap-2 text-sm text-gray-500 mb-2">
            <span>Manage</span>
            <i class="bi bi-chevron-right text-xs"></i>
            <span class="text-blue-600 font-medium">User Roles</span>
        </div>

        <div class="flex items-center gap-3">

            <div class="page-title">
                <h2 class="text-2xl font-semibold text-gray-800">
                    Update Password
                </h2>

                <p class="text-sm text-gray-500">
                    Update your password
                </p>
            </div>
        </div>
    </div>
    <div class="card" data-card-title="Update Password">
        <div id="app" class="mx-auto">
            <div class="grid grid-cols-1 lg:grid-cols-3 gap-6">
                <div class="mb-5">

                    <label class="block text-sm font-semibold text-gray-700 mb-2">

                        Current Password

                        <span class="text-red-500">*</span>

                    </label>


                    <div class="relative">

                        <input type="password"
                               ref="currentPassword"
                               v-model="currentPassword"
                               @@input="clearError('currentPassword')"
                               autocomplete="current-password"
                               placeholder="Enter your current password"
                               :class="[
                               'w-full px-3 py-2.5 border rounded-lg text-sm text-gray-700 outline-none transition duration-200',
                               errors.currentPassword
                                   ? 'border-red-400 focus:ring-2 focus:ring-red-100'
                                   : 'border-gray-300 focus:border-blue-500 focus:ring-2 focus:ring-blue-100'
                           ]">

                    </div>


                    <!-- ERROR -->
                    <p v-if="errors.currentPassword"
                       class="flex items-center gap-1 mt-1.5 text-xs text-red-600">

                        <i class="bi bi-exclamation-circle"></i>

                        {{ errors.currentPassword }}

                    </p>

                </div>
                <div class="mb-5">

                    <label class="block text-sm font-semibold text-gray-700 mb-2">

                        New Password

                        <span class="text-red-500">*</span>

                    </label>


                    <input type="password"
                           ref="newPassword"
                           v-model="newPassword"
                           @@input="validateNewPassword()"
                           autocomplete="new-password"
                           placeholder="Enter your new password"
                           :class="[
                           'w-full px-3 py-2.5 border rounded-lg text-sm text-gray-700 outline-none transition duration-200',
                           errors.newPassword
                               ? 'border-red-400 focus:ring-2 focus:ring-red-100'
                               : 'border-gray-300 focus:border-blue-500 focus:ring-2 focus:ring-blue-100'
                       ]">


                    <!-- ERROR -->
                    <p v-if="errors.newPassword"
                       class="flex items-center gap-1 mt-1.5 text-xs text-red-600">

                        <i class="bi bi-exclamation-circle"></i>

                        {{ errors.newPassword }}

                    </p>
                
                </div>
                <div class="mb-5">

                    <label class="block text-sm font-semibold text-gray-700 mb-2">

                        Confirm New Password

                        <span class="text-red-500">*</span>

                    </label>


                    <input type="password"
                           ref="confirmNewPassword"
                           v-model="confirmNewPassword"
                           @@input="validateConfirmPassword()"
                           autocomplete="new-password"
                           placeholder="Confirm your new password"
                           :class="[
                           'w-full px-3 py-2.5 border rounded-lg text-sm text-gray-700 outline-none transition duration-200',
                           errors.confirmNewPassword
                               ? 'border-red-400 focus:ring-2 focus:ring-red-100'
                               : 'border-gray-300 focus:border-blue-500 focus:ring-2 focus:ring-blue-100'
                       ]">


                    <!-- ERROR -->
                    <p v-if="errors.confirmNewPassword"
                       class="flex items-center gap-1 mt-1.5 text-xs text-red-600">

                        <i class="bi bi-exclamation-circle"></i>

                        {{ errors.confirmNewPassword }}

                    </p>


                    <!-- MATCH SUCCESS -->
                    <p v-if="confirmNewPassword &&
                         !errors.confirmNewPassword &&
                         confirmNewPassword === newPassword"
                       class="flex items-center gap-1 mt-1.5 text-xs text-green-600">

                        <i class="bi bi-check-circle-fill"></i>

                        Passwords match.

                    </p>

                </div>
       
            </div>
            <!-- PASSWORD REQUIREMENTS -->
        <div class="mb-5 p-3 bg-gray-50 border border-gray-200 rounded-lg">

                    <p class="text-xs font-semibold text-gray-600 mb-2">
                        Password must contain:
                    </p>


                    <div class="grid grid-cols-1 sm:grid-cols-2 gap-1.5">

                        <!-- LENGTH -->
                        <div class="flex items-center gap-2 text-xs"
                             :class="newPassword.length >= 10 ? 'text-green-600' : 'text-gray-500'">

                            <i :class="[
                                'bi',
                                newPassword.length >= 10
                                    ? 'bi-check-circle-fill'
                                    : 'bi-circle'
                            ]"></i>

                            <span>
                                At least 10 characters
                            </span>

                        </div>


                        <!-- LOWERCASE -->
                        <div class="flex items-center gap-2 text-xs"
                             :class="/[a-z]/.test(newPassword) ? 'text-green-600' : 'text-gray-500'">

                            <i :class="[
                                'bi',
                                /[a-z]/.test(newPassword)
                                    ? 'bi-check-circle-fill'
                                    : 'bi-circle'
                            ]"></i>

                            <span>
                                Lowercase letter
                            </span>

                        </div>


                        <!-- UPPERCASE -->
                        <div class="flex items-center gap-2 text-xs"
                             :class="/[A-Z]/.test(newPassword) ? 'text-green-600' : 'text-gray-500'">

                            <i :class="[
                                'bi',
                                /[A-Z]/.test(newPassword)
                                    ? 'bi-check-circle-fill'
                                    : 'bi-circle'
                            ]"></i>

                            <span>
                                Uppercase letter
                            </span>

                        </div>


                        <!-- NUMBER -->
                        <div class="flex items-center gap-2 text-xs"
                             :class="/\d/.test(newPassword) ? 'text-green-600' : 'text-gray-500'">

                            <i :class="[
                                'bi',
                                /\d/.test(newPassword)
                                    ? 'bi-check-circle-fill'
                                    : 'bi-circle'
                            ]"></i>

                            <span>
                                Number
                            </span>

                        </div>


                        <!-- SPECIAL CHARACTER -->
                        <div class="flex items-center gap-2 text-xs sm:col-span-2"
                             :class="/[!@@#$%^&*()\-_=+{};:,<.>]/.test(newPassword) ? 'text-green-600' : 'text-gray-500'">

                            <i :class="[
                                'bi',
                                /[!@@#$%^&*()\-_=+{};:,<.>]/.test(newPassword)
                                    ? 'bi-check-circle-fill'
                                    : 'bi-circle'
                            ]"></i>

                            <span>
                                Special character
                            </span>

                        </div>

                    </div>

                </div>
    <div class="flex justify-end pt-4 border-t border-gray-200">

        <button type="button"
                @@click="updatePassword()"
                :disabled="isLoading"
                class="inline-flex items-center justify-center gap-2 px-5 py-2.5 bg-blue-600 hover:bg-blue-700 disabled:bg-blue-400 disabled:cursor-not-allowed text-white text-sm font-medium rounded-lg shadow-sm transition duration-200">

            <i v-if="!isLoading"
               class="bi bi-shield-check"></i>

            <i v-if="isLoading"
               class="bi bi-arrow-repeat animate-spin"></i>

            <span>
                {{ isLoading ? 'Updating...' : 'Update Password' }}
            </span>

        </button>

    </div>
</div>


        </div>
       
    </div>





 








<script src="~/js/manage/update-password.js" asp-append-version="true"></script>