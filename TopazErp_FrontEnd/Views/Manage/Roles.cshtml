@{
    ViewBag.Title = "Roles";
    Layout = "~/Views/Shared/_adminTenantLayout.cshtml";
}
<style>
    .permission-panel {
        padding: 10px 0;
    }

    .permission-group {
        padding: 6px 0;
    }

    .group-title {
        font-size: 13px;
        letter-spacing: .06em;
        text-transform: uppercase;
        color: #6c757d;
        font-weight: 600;
    }

    .sub-group {
        border-radius: 8px;
    }

    .sub-group-header {
        padding: 8px 10px;
        border-radius: 6px;
        cursor: pointer;
        background: #f8f9fa;
        transition: background 0.2s ease;
    }

    .sub-group-header:hover {
        background: #f1f3f5;
    }

    .sub-group-name {
        font-size: 14px;
        font-weight: 500;
        color: #333;
    }

    .sub-group-body {
        padding: 8px 6px;
    }

    .perm-list {
        display: flex;
        flex-wrap: wrap;
        gap: 6px;
    }

    .perm-chip {
        display: inline-flex;
        align-items: center;
        gap: 6px;
        padding: 4px 10px;
        font-size: 12px;
        border-radius: 20px;
        background: #e9ecef;
        color: #495057;
        cursor: pointer;
        transition: all 0.15s ease;
        user-select: none;
    }

    .perm-chip:hover {
        background: #dee2e6;
    }
    .granted-panel {
        border: 1px solid #dee2e6;
        background: #fbfcfe;
        border-radius: 10px;
        padding: 12px;
    }
    
    .granted-header {
        padding: 8px 10px;
        border-radius: 6px;
        cursor: pointer;
        background: #eef3ff;
        transition: all 0.2s ease;
        border-left: 3px solid #44d35c;
    }
    .granted-header:hover {
        background: #e6edff;
    }

</style>
<div class="content">
    <div class="mb-6 content-header">
        <div class="flex items-center gap-2 text-sm text-gray-500 mb-2">
            <span>Manage</span>
            <i class="bi bi-chevron-right text-xs"></i>
            <span class="text-blue-600 font-medium">User Roles</span>
        </div>

        <div class="flex items-center gap-3">

            <div class="page-title">
                <h2 class="text-2xl font-semibold text-gray-800">
                    User Roles
                </h2>

                <p class="text-sm text-gray-500">
                    Manage user roles and permissions
                </p>
            </div>
        </div>
    </div>
    <div class="card" data-card-title="Roles">
        <div id="app">
         

    <!-- PAGE HEADER -->
    <div class="flex flex-col sm:flex-row items-start sm:items-center justify-between gap-4 mb-6">

        <div>
          
        </div>

        <button type="button"
                @@click="resetModal(); openModal()"
                class="inline-flex items-center gap-2 px-4 py-2.5 bg-white border border-blue-500 text-blue-500 hover:bg-blue-700 hover:text-white text-sm font-medium rounded-lg shadow-sm transition duration-200">

            <i class="bi bi-plus-lg"></i>

            <span>Create New Role</span>

        </button>

    </div>


    <!-- ROLE TABLE CARD -->
    <div class="bg-white rounded-xl shadow-sm border border-gray-200 overflow-hidden">

        <!-- CARD HEADER -->
        <div class="px-5 py-4 border-b border-gray-200 bg-gray-50">

            <div class="flex items-center justify-between">

                <div>
                    <h3 class="text-base font-semibold text-gray-800">
                        System Roles
                    </h3>

                    <p class="text-sm text-gray-500 mt-1">
                        View and manage existing roles
                    </p>
                </div>

                <div class="text-sm text-gray-500">
                    {{ totalCount }} role<span v-if="totalCount !== 1">s</span>
                </div>

            </div>

        </div>


        <!-- TABLE -->
        <div class="overflow-x-auto">

            <table class="min-w-full divide-y divide-gray-200">

                <thead class="bg-gray-50">

                    <tr>

                        <th class="px-6 py-3 text-left text-xs font-semibold text-gray-600 uppercase tracking-wider">
                            Role Name
                        </th>

                        <th class="px-6 py-3 text-left text-xs font-semibold text-gray-600 uppercase tracking-wider">
                            Display Name
                        </th>

                        <th class="px-6 py-3 text-right text-xs font-semibold text-gray-600 uppercase tracking-wider">
                            Actions
                        </th>

                    </tr>

                </thead>


                <tbody class="bg-white divide-y divide-gray-100">

                    <!-- ROLES -->
                    <tr v-for="(role, index) in roleList"
                        :key="role.id"
                        class="hover:bg-gray-50 transition duration-150">

                        <!-- ROLE NAME -->
                        <td class="px-6 py-4 whitespace-nowrap">

                            <div class="flex items-center gap-3">

                                <div class="w-9 h-9 rounded-lg bg-blue-50 text-blue-600 flex items-center justify-center">
                                    <i class="bi bi-shield-check"></i>
                                </div>

                                <div>

                                    <div class="text-sm font-medium text-gray-800">
                                        {{ role.name }}
                                    </div>

                                </div>

                            </div>

                        </td>


                        <!-- DISPLAY NAME -->
                        <td class="px-6 py-4 whitespace-nowrap">

                            <span class="text-sm text-gray-600">
                                {{ role.displayName }}
                            </span>

                        </td>


                        <!-- ACTIONS -->
                        <td class="px-6 py-4 whitespace-nowrap">

                            <div class="flex items-center justify-end gap-2">

                                <!-- VIEW -->
                                <button type="button"
                                        @@click="initUpdate(role)"
                                        class="inline-flex items-center gap-1.5 px-3 py-2 text-sm font-medium text-blue-600 bg-blue-50 hover:bg-blue-100 rounded-lg transition duration-200">

                                    <i class="bi bi-pencil-square"></i>

                                    <span>View Details</span>

                                </button>


                                <!-- DELETE -->
                                <button type="button"
                                        @@click="deleteRole(role.id)"
                                        class="inline-flex items-center justify-center w-9 h-9 text-red-600 bg-red-50 hover:bg-red-100 rounded-lg transition duration-200"
                                        title="Delete Role">

                                    <i class="bi bi-trash3"></i>

                                </button>

                            </div>

                        </td>

                    </tr>


                    <!-- EMPTY STATE -->
                    <tr v-if="roleList.length === 0 && !isLoading">

                        <td colspan="3" class="px-6 py-12 text-center">

                            <div class="flex flex-col items-center justify-center">

                                <div class="w-14 h-14 rounded-full bg-gray-100 flex items-center justify-center mb-4">

                                    <i class="bi bi-shield-x text-2xl text-gray-400"></i>

                                </div>

                                <h4 class="text-sm font-semibold text-gray-700">
                                    No roles found
                                </h4>

                                <p class="text-sm text-gray-500 mt-1">
                                    Create a role to get started.
                                </p>

                            </div>

                        </td>

                    </tr>


                    <!-- LOADING -->
                    <tr v-if="isLoading && roleList.length === 0">

                        <td colspan="3" class="px-6 py-12 text-center">

                            <div class="flex flex-col items-center justify-center">

                                <div class="w-8 h-8 border-4 border-blue-200 border-t-blue-600 rounded-full animate-spin mb-3"></div>

                                <span class="text-sm text-gray-500">
                                    Loading roles...
                                </span>

                            </div>

                        </td>

                    </tr>

                </tbody>

            </table>

        </div>


        <!-- PAGINATION -->
        <div v-if="totalPages > 1"
             class="px-5 py-4 border-t border-gray-200 bg-gray-50 flex flex-col sm:flex-row items-center justify-between gap-3">

            <div class="text-sm text-gray-500">

                Showing
                <span class="font-medium text-gray-700">
                    {{ lowerBound }}
                </span>
                to
                <span class="font-medium text-gray-700">
                    {{ upperBound }}
                </span>
                of
                <span class="font-medium text-gray-700">
                    {{ totalCount }}
                </span>

            </div>


            <div class="flex items-center gap-2">

                <button type="button"
                        :disabled="pageNo <= 1"
                        @@click="pageNo--; getRoles()"
                        class="px-3 py-2 text-sm border border-gray-300 rounded-lg bg-white hover:bg-gray-50 disabled:opacity-50 disabled:cursor-not-allowed">

                    <i class="bi bi-chevron-left"></i>

                </button>


                <span class="px-3 py-2 text-sm text-gray-600">
                    Page {{ pageNo }} of {{ totalPages }}
                </span>


                <button type="button"
                        :disabled="pageNo >= totalPages"
                        @@click="pageNo++; getRoles()"
                        class="px-3 py-2 text-sm border border-gray-300 rounded-lg bg-white hover:bg-gray-50 disabled:opacity-50 disabled:cursor-not-allowed">

                    <i class="bi bi-chevron-right"></i>

                </button>

            </div>

        </div>

    </div>



    <!-- ============================================ -->
    <!-- ADD / EDIT ROLE MODAL -->
    <!-- ============================================ -->

    <div v-if="isModalOpen"
         class="fixed inset-0 z-50 overflow-y-auto"
         aria-labelledby="role-modal-title"
         role="dialog"
         aria-modal="true">

        <!-- BACKDROP -->
        <div class="fixed inset-0 bg-gray-900/50 backdrop-blur-sm"
             @@click="closeModal()">
        </div>


        <!-- MODAL WRAPPER -->
        <div class="relative min-h-screen flex items-center justify-center p-4">

            <div class="relative w-full max-w-6xl bg-white rounded-xl shadow-2xl overflow-hidden">


                <!-- MODAL HEADER -->
                <div class="flex items-center justify-between px-6 py-4 border-b border-gray-200 bg-white">

                    <div>

                        <h3 id="role-modal-title"
                            class="text-lg font-semibold text-gray-800">

                            {{ modalTitle }}

                        </h3>

                        <p class="text-sm text-gray-500 mt-1">
                            Configure role details and permissions
                        </p>

                    </div>


                    <!-- CLOSE -->
                    <button type="button"
                            @@click="closeModal()"
                            class="w-9 h-9 flex items-center justify-center rounded-lg text-gray-400 hover:text-gray-600 hover:bg-gray-100 transition duration-200">

                        <i class="bi bi-x-lg"></i>

                    </button>

                </div>



                <!-- MODAL BODY -->
                <div class="px-6 py-6 max-h-[75vh] overflow-y-auto">


                    <!-- ROLE DETAILS -->
                    <div class="grid grid-cols-1 md:grid-cols-12 gap-5 mb-7">


                        <!-- NAME -->
                        <div class="md:col-span-4">

                            <label class="block text-sm font-semibold text-gray-700 mb-2">
                                Name
                                <span class="text-red-500">*</span>
                            </label>

                            <input type="text"
                                   ref="name"
                                   v-model="name"
                                   @@input="errors.name = ''"
                                   placeholder="Enter role name"
                                   :class="[
                                       'w-full px-3 py-2.5 border rounded-lg text-sm text-gray-700 outline-none transition duration-200',
                                       errors.name
                                           ? 'border-red-400 focus:ring-2 focus:ring-red-100'
                                           : 'border-gray-300 focus:border-blue-500 focus:ring-2 focus:ring-blue-100'
                                   ]">

                            <p v-if="errors.name"
                               class="flex items-center gap-1 mt-1.5 text-xs text-red-600">

                                <i class="bi bi-exclamation-circle"></i>

                                {{ errors.name }}

                            </p>

                        </div>



                        <!-- DISPLAY NAME -->
                        <div class="md:col-span-4">

                            <label class="block text-sm font-semibold text-gray-700 mb-2">
                                Display Name
                            </label>

                            <input type="text"
                                   v-model="displayName"
                                   placeholder="Enter display name"
                                   class="w-full px-3 py-2.5 border border-gray-300 rounded-lg text-sm text-gray-700 outline-none transition duration-200 focus:border-blue-500 focus:ring-2 focus:ring-blue-100">

                        </div>



                        <!-- DESCRIPTION -->
                        <div class="md:col-span-4">

                            <label class="block text-sm font-semibold text-gray-700 mb-2">
                                Description
                            </label>

                            <textarea v-model="description"
                                      rows="3"
                                      placeholder="Enter role description..."
                                      class="w-full px-3 py-2.5 border border-gray-300 rounded-lg text-sm text-gray-700 outline-none resize-none transition duration-200 focus:border-blue-500 focus:ring-2 focus:ring-blue-100"></textarea>

                        </div>

                    </div>



                    <!-- PERMISSIONS SECTION -->
                    <div class="grid grid-cols-1 xl:grid-cols-2 gap-6">


                        <!-- ================================= -->
                        <!-- AVAILABLE PERMISSIONS -->
                        <!-- ================================= -->

                        <div>

                            <div class="flex items-center justify-between mb-3">

                                <div>

                                    <h4 class="text-sm font-semibold text-gray-800">
                                        Add Permissions
                                    </h4>

                                    <p class="text-xs text-gray-500 mt-1">
                                        Select permissions to grant to this role.
                                    </p>

                                </div>


                                <div class="w-8 h-8 rounded-lg bg-blue-50 text-blue-600 flex items-center justify-center">

                                    <i class="bi bi-shield-plus"></i>

                                </div>

                            </div>



                            <div class="border border-gray-200 rounded-xl bg-gray-50 p-4 max-h-[420px] overflow-y-auto">


                                <!-- NO AVAILABLE PERMISSIONS -->
                                <div v-if="Object.keys(groupedAvailablePermissions).length === 0"
                                     class="py-8 text-center">

                                    <div class="w-10 h-10 mx-auto rounded-full bg-gray-200 flex items-center justify-center mb-3">

                                        <i class="bi bi-check-circle text-gray-500"></i>

                                    </div>

                                    <p class="text-sm text-gray-500">
                                        All permissions have been granted.
                                    </p>

                                </div>



                                <!-- PERMISSION GROUPS -->
                                <div v-for="(subGroups, group) in groupedAvailablePermissions"
                                     :key="group"
                                     class="mb-4 last:mb-0">


                                    <!-- MAIN GROUP TITLE -->
                                    <div class="flex items-center gap-2 mb-2">

                                        <div class="w-1 h-4 bg-blue-600 rounded-full"></div>

                                        <h5 class="text-xs font-bold text-gray-700 uppercase tracking-wide">
                                            {{ group }}
                                        </h5>

                                    </div>



                                    <!-- SUB GROUPS -->
                                    <div class="grid grid-cols-1 md:grid-cols-2 gap-2">


                                        <div v-for="(perms, subGroup) in subGroups"
                                             :key="subGroup"
                                             class="bg-white border border-gray-200 rounded-lg overflow-hidden">


                                            <!-- SUB GROUP HEADER -->
                                            <button type="button"
                                                    @@click="togglePermissionGroup('available', group, subGroup)"
                                                    class="w-full flex items-center justify-between px-3 py-2.5 text-left hover:bg-gray-50 transition duration-150">

                                                <span class="text-xs font-semibold text-gray-700">
                                                    {{ subGroup }}
                                                </span>

                                                <i :class="[
                                                    'bi text-gray-400 transition-transform duration-200',
                                                    isPermissionGroupOpen('available', group, subGroup)
                                                        ? 'bi-chevron-up'
                                                        : 'bi-chevron-down'
                                                ]"></i>

                                            </button>



                                            <!-- PERMISSION LIST -->
                                            <div v-if="isPermissionGroupOpen('available', group, subGroup)"
                                                 class="border-t border-gray-100 p-2">

                                                <div class="flex flex-wrap gap-1.5">

                                                    <button v-for="perm in perms"
                                                            :key="perm.name"
                                                            type="button"
                                                            @@click="addPermissionFromList(perm)"
                                                            class="inline-flex items-center gap-1 px-2.5 py-1.5 bg-blue-50 hover:bg-blue-100 text-blue-700 text-xs font-medium rounded-md transition duration-150">

                                                        <span>
                                                            {{ perm.name.split('.').pop() }}
                                                        </span>

                                                        <i class="bi bi-plus-circle"></i>

                                                    </button>

                                                </div>

                                            </div>

                                        </div>

                                    </div>

                                </div>

                            </div>

                        </div>



                        <!-- ================================= -->
                        <!-- GRANTED PERMISSIONS -->
                        <!-- ================================= -->

                        <div>

                            <div class="flex items-center justify-between mb-3">

                                <div>

                                    <h4 class="text-sm font-semibold text-gray-800">
                                        Granted Permissions
                                    </h4>

                                    <p class="text-xs text-gray-500 mt-1">
                                        Permissions currently assigned to this role.
                                    </p>

                                </div>


                                <div class="flex items-center gap-2">

                                    <span class="px-2.5 py-1 text-xs font-semibold bg-green-50 text-green-700 rounded-full">

                                        {{ grantedPermissions.length }}

                                    </span>

                                    <div class="w-8 h-8 rounded-lg bg-green-50 text-green-600 flex items-center justify-center">

                                        <i class="bi bi-shield-check"></i>

                                    </div>

                                </div>

                            </div>



                            <div class="border border-gray-200 rounded-xl bg-gray-50 p-4 max-h-[420px] overflow-y-auto">


                                <!-- EMPTY -->
                                <div v-if="grantedPermissions.length === 0"
                                     class="py-10 text-center">

                                    <div class="w-12 h-12 mx-auto rounded-full bg-gray-200 flex items-center justify-center mb-3">

                                        <i class="bi bi-shield-slash text-xl text-gray-400"></i>

                                    </div>

                                    <p class="text-sm font-medium text-gray-600">
                                        No permissions granted yet.
                                    </p>

                                    <p class="text-xs text-gray-400 mt-1">
                                        Select permissions from the left panel.
                                    </p>

                                </div>



                                <!-- GRANTED GROUPS -->
                                <div v-for="(subGroups, group) in groupedGrantedPermissions"
                                     :key="group"
                                     class="mb-4 last:mb-0">


                                    <!-- GROUP TITLE -->
                                    <div class="flex items-center gap-2 mb-2">

                                        <div class="w-1 h-4 bg-green-500 rounded-full"></div>

                                        <h5 class="text-xs font-bold text-gray-700 uppercase tracking-wide">
                                            {{ group }}
                                        </h5>

                                    </div>



                                    <!-- SUB GROUPS -->
                                    <div class="grid grid-cols-1 md:grid-cols-2 gap-2">


                                        <div v-for="(perms, subGroup) in subGroups"
                                             :key="subGroup"
                                             class="bg-white border border-gray-200 rounded-lg overflow-hidden">


                                            <!-- HEADER -->
                                            <button type="button"
                                                    @@click="togglePermissionGroup('granted', group, subGroup)"
                                                    class="w-full flex items-center justify-between px-3 py-2.5 text-left hover:bg-gray-50 transition duration-150">

                                                <span class="text-xs font-semibold text-gray-700">
                                                    {{ subGroup }}
                                                </span>

                                                <i :class="[
                                                    'bi text-gray-400 transition-transform duration-200',
                                                    isPermissionGroupOpen('granted', group, subGroup)
                                                        ? 'bi-chevron-up'
                                                        : 'bi-chevron-down'
                                                ]"></i>

                                            </button>



                                            <!-- BODY -->
                                            <div v-if="isPermissionGroupOpen('granted', group, subGroup)"
                                                 class="border-t border-gray-100 p-2">

                                                <div class="flex flex-wrap gap-1.5">

                                                    <button v-for="perm in perms"
                                                            :key="perm.name"
                                                            type="button"
                                                            @@click="removePermissionFromList(perm)"
                                                            class="inline-flex items-center gap-1 px-2.5 py-1.5 bg-green-50 hover:bg-red-50 text-green-700 hover:text-red-700 text-xs font-medium rounded-md transition duration-150">

                                                        <span>
                                                            {{ perm.name.split('.').pop() }}
                                                        </span>

                                                        <i class="bi bi-x-circle"></i>

                                                    </button>

                                                </div>

                                            </div>

                                        </div>

                                    </div>

                                </div>

                            </div>

                        </div>

                    </div>

                </div>



                <!-- MODAL FOOTER -->
                <div class="flex flex-col-reverse sm:flex-row items-center justify-end gap-3 px-6 py-4 border-t border-gray-200 bg-gray-50">


                    <!-- CLOSE -->
                    <button type="button"
                            @@click="closeModal()"
                            class="w-full sm:w-auto px-5 py-2.5 text-sm font-medium text-gray-700 bg-white border border-gray-300 hover:bg-gray-100 rounded-lg transition duration-200">

                        Close

                    </button>



                    <!-- SAVE -->
                    <button type="button"
                            @@click="saveRole()"
                            :disabled="isLoading"
                            class="w-full sm:w-auto inline-flex items-center justify-center gap-2 px-5 py-2.5 text-sm font-medium text-white bg-blue-600 hover:bg-blue-700 disabled:bg-blue-400 disabled:cursor-not-allowed rounded-lg shadow-sm transition duration-200">

                        <i v-if="!isLoading"
                           class="bi bi-save"></i>

                        <i v-if="isLoading"
                           class="bi bi-arrow-repeat animate-spin"></i>

                        <span>
                            {{ isLoading ? 'Saving...' : 'Save Changes' }}
                        </span>

                    </button>

                </div>

            </div>

        </div>

    </div>


        </div>
       
    </div>
</div>




 


<script src="~/js/manage/roles.js" asp-append-version="true"></script>