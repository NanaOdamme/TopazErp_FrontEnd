    Layout = "~/Views/Shared/_adminNeutralLayout.cshtml";
}
<div class="content">
    <div class="mb-6 content-header">
        <div class="flex items-center gap-2 text-sm text-gray-500 mb-2">
            <span>Manage</span>
            <i class="bi bi-chevron-right text-xs"></i>
            <span class="text-blue-600 font-medium">Modules</span>
        </div>

       
    </div>
   <div  class="card" data-card-title="Topaz Applications">
 

<div class="grid grid-cols-1 md:grid-cols-2 xl:grid-cols-3 gap-6">

    <!-- General Ledger -->
    <a href="/Dashboard/GeneralLedger"
       class="group block rounded-2xl border border-emerald-100 bg-white p-6 shadow-sm
              transition-all duration-200 hover:-translate-y-1 hover:shadow-lg hover:border-emerald-200
