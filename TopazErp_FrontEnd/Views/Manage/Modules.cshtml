                        dark:bg-emerald-950/60 dark:text-emerald-400">
                <i class="bi bi-journal-text text-2xl"></i>
            </div>

            <i class="bi bi-arrow-up-right text-xl text-slate-300 transition
                      group-hover:text-emerald-500
                      dark:text-slate-600 dark:group-hover:text-emerald-400"></i>
        </div>

        <div class="mt-5">
            <h3 class="text-lg font-semibold text-slate-800 dark:text-white">
                General Ledger
            </h3>

            <p class="mt-2 text-sm leading-6 text-slate-500 dark:text-slate-400">
                Record, store and query accounting journal entries and generate financial statements.
