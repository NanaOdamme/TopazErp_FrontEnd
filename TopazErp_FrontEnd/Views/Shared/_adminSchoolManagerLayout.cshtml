<script src="~/js/app-shell.js" asp-append-version="true"></script>
<script src="~/js/site.js" asp-append-version="true"></script>
<script src="~/js/components/card.js" asp-append-version="true"></script>
<script>
    async function getCurrentAcademicYear() {
        const container = document.getElementById('academicYearName');

        if (!container) return;

        try {
            const response = await fetch('/SchoolManager/GetCurrentAcademicYear');

            if (!response.ok) {
                throw new Error('Failed to retrieve current academic year.');
            }

            const data = await response.json();

            container.textContent = data.result?.academicYearName || 'Set Academic Year';

        } catch (error) {
            console.error('Academic Year Error:', error);
            container.textContent = 'Set Academic Year';
        }
    }

    getCurrentAcademicYear();
</script>
@await RenderSectionAsync("Scripts", required: false)
</body>
