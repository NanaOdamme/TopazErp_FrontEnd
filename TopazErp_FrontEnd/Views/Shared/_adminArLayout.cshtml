@* ============================================================================
   _Layout.cshtml — sidebar + header shell for TopazErp_FrontEnd.

   How the menu works
   ------------------
   The links are ordinary Razor markup with tag helpers, exactly like:

       <a asp-area="" asp-controller="Home" asp-action="Index">Home</a>

   The only extra things are the classes the CSS/JS expect:

       ul.nav-menu                the list
       li.nav-item                one row
       li.nav-item.has-sub        this row opens a submenu
       a.menu-link (top level)    the clickable row   →  a.menu-item inside a submenu
       span.menu-title            the label
       ul.menu-content            the submenu <ul> (put it right after the <a>)
       li.nav-section             a group heading
       span.badge.menu-badge      optional counter

   That's all: no models, no services. Highlighting the current page is done by
   wwwroot/js/shell.js, which compares each rendered href with the current URL —
   so plain asp-controller/asp-action links work on their own. (If you prefer to
   set it server side, just add class="active" / "open" yourself; the script
   leaves your markup alone when no link matches.)

   Contract with your pages: wrap the body in <main class="page-main"> and the
   shell lays itself out around it. Everything else is optional.
   ============================================================================ *@
@{
var title = ViewData["Title"] as string ?? "Dashboard";
var subtitle = ViewData["Subtitle"] as string ?? "Topaz ERP";
var userName = User?.Identity?.Name ?? "Admin";
var initials = string.Concat(userName.Split(new[] { '.', ' ', '_', '-' }, StringSplitOptions.RemoveEmptyEntries)
.Take(2).Select(p => char.ToUpper(p[0])));
}
