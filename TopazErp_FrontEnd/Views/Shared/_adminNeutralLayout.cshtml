@{
var title = ViewData["Title"] as string ?? "Topaz ERP";
}
<!DOCTYPE html>
<html lang="en" class="h-full">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@title | Topaz ERP</title>

    <script>
      /* options for wwwroot/js/shell.js — no menu data here, the menu is markup */
      window.__SHELL__ = {
        breakpoint: 1024,          // below this width the sidebar becomes a drawer
        railWidth: 72, minWidth: 210, maxWidth: 420,
        storagePrefix: 'shell'     // localStorage keys: shell:collapsed, shell:w, shell:theme
      };
    </script>
    <script src="https://cdn.tailwindcss.com?plugins=forms"></script>
    <script>
      tailwind.config = {
        darkMode: 'class',
        theme: {
          extend: {
            colors: {
              primary: {
                50:'#eff6ff', 100:'#dbeafe', 200:'#bfdbfe', 300:'#93c5fd', 400:'#60a5fa',
                500:'#3b82f6', 600:'#2563eb', 700:'#1d4ed8', 800:'#1e40af', 900:'#1e3a8a', 950:'#172554'
              }
            },
            fontFamily: { sans: ['Inter','ui-sans-serif','system-ui','-apple-system','Segoe UI','Roboto','sans-serif'] },
            boxShadow: { card: '0 1px 2px 0 rgb(0 0 0 / 0.04), 0 8px 24px -12px rgb(15 23 42 / 0.18)' }
          }
        }
      }
    </script>
    <script src="~/libs/jquery/jquery.js" asp-append-version="true"></script>
    
 
    <environment names="Development">
        <script src="https://unpkg.com/vue@3/dist/vue.global.js"></script>
    </environment>

    <environment names="Production">
        <script src="https://unpkg.com/vue@3/dist/vue.global.prod.js"></script>
    </environment>


    <link rel="stylesheet"
          href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.min.css" />
    
    <script src="https://cdn.jsdelivr.net/npm/sweetalert2@11"></script>
    <link rel="stylesheet" href="~/css/shell.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/css/card.css" asp-append-version="true" />
    @await RenderSectionAsync("Styles", required: false)
    
    <!-- Report Viewer component script-->
    <script src="~/libs/jquery/jquery.js" asp-append-version="true"></script>

    <!-- Syncfusion EJ1 / Essential JavaScript -->
    <script src="~/ejassets/scripts/jsrender.min.js"></script>
    <script src="~/ejassets/scripts/ej.web.all.min.js"></script>

    <!-- Moment -->
    <script src="https://cdn.jsdelivr.net/npm/moment@2.30.1/moment.min.js"></script>

    <!-- Bold Reports Viewer -->
    <script src="~/js/bold.report-viewer.min.js"></script>

    <script>
        // Application root path.
        // Supports applications hosted under an IIS virtual directory.
        var abp = abp || {};
        abp.appPath = '@Url.Content("~/")';

        var reportApiBaseUrl = 'http://108.181.191.134:78/api/ReportApi';
    </script>
    <link href="~/ejassets/ejthemes/office-365/ej.web.all.min.css" rel="stylesheet" />
 

</head>

<body class="h-full min-h-full bg-grey-50 font-sans text-slate-800 antialiased dark:bg-slate-950 dark:text-slate-200">

<!-- TOP NAVIGATION -->
<nav class="sticky top-0 z-40 flex h-16 items-center justify-end gap-3 border-b border-slate-200/80 bg-white/80 px-6 backdrop-blur-md shadow-sm transition-colors dark:border-slate-800/80 dark:bg-slate-900/80">

    <!-- QUICK ACCESS DROPDOWN -->
    <div class="relative" id="quickAccessMenu">

        <!-- TRIGGER BUTTON -->
        <button type="button"
                id="quickAccessBtn"
                class="group inline-flex items-center gap-2.5 px-4 py-2 rounded-xl text-sm font-semibold text-slate-700 transition-all duration-200 hover:border-slate-300 hover:bg-white hover:shadow-md hover:shadow-slate-100 dark:border-slate-800 dark:bg-slate-800/50 dark:text-slate-200 dark:hover:border-slate-700 dark:hover:bg-slate-800 dark:hover:shadow-none">

            <!-- Gradient background icon badge -->
            <span class="flex h-6 w-6 items-center justify-center rounded-full bg-primary-50 text-primary-600 transition-transform duration-200 group-hover:scale-110 dark:bg-primary-950/60 dark:text-primary-400">
                <i class="bi bi-grid-3x3-gap-fill text-xs"></i>
            </span>

            <span>Quick Access</span>

            <i class="bi bi-chevron-down text-xs text-slate-400 transition-transform duration-200 group-hover:text-slate-600 dark:group-hover:text-slate-300" id="quickAccessArrow"></i>
        </button>

        <!-- DROPDOWN PANEL -->
        <div id="quickAccessDropdown"
             class="absolute right-0 mt-3 hidden w-64 origin-top-right rounded-2xl border border-slate-100 bg-white/95 p-2 shadow-2xl ring-1 ring-slate-900/5 backdrop-blur-xl transition-all dark:border-slate-800 dark:bg-slate-900/95 dark:ring-white/10">

            <div class="px-3 pb-2 pt-2">
                <p class="text-[11px] font-bold uppercase tracking-wider text-slate-400 dark:text-slate-500">
                    Navigation
                </p>
            </div>

            <a asp-area="" asp-controller="Manage" asp-action="Profile"
               class="group flex items-center gap-3 rounded-xl px-3 py-2 text-sm font-medium text-slate-700 transition-all duration-150 hover:bg-primary-50/60 hover:text-primary-600 dark:text-slate-200 dark:hover:bg-primary-950/40 dark:hover:text-primary-400">
                <div class="flex h-8 w-8 items-center justify-center rounded-lg bg-slate-100 text-slate-500 transition-colors group-hover:bg-primary-100 group-hover:text-primary-600 dark:bg-slate-800 dark:text-slate-400 dark:group-hover:bg-primary-900/50 dark:group-hover:text-primary-400">
                    <i class="bi bi-person-circle text-base"></i>
                </div>
                <span>My Profile</span>
            </a>

            <a asp-area="" asp-controller="Manage" asp-action="Users"
               class="group flex items-center gap-3 rounded-xl px-3 py-2 text-sm font-medium text-slate-700 transition-all duration-150 hover:bg-primary-50/60 hover:text-primary-600 dark:text-slate-200 dark:hover:bg-primary-950/40 dark:hover:text-primary-400">
                <div class="flex h-8 w-8 items-center justify-center rounded-lg bg-slate-100 text-slate-500 transition-colors group-hover:bg-primary-100 group-hover:text-primary-600 dark:bg-slate-800 dark:text-slate-400 dark:group-hover:bg-primary-900/50 dark:group-hover:text-primary-400">
                    <i class="bi bi-sliders text-base"></i>
                </div>
                <span>Manage Users</span>
            </a>

            <a asp-area="" asp-controller="Manage" asp-action="UpdatePassword"
               class="group flex items-center gap-3 rounded-xl px-3 py-2 text-sm font-medium text-slate-700 transition-all duration-150 hover:bg-primary-50/60 hover:text-primary-600 dark:text-slate-200 dark:hover:bg-primary-950/40 dark:hover:text-primary-400">
                <div class="flex h-8 w-8 items-center justify-center rounded-lg bg-slate-100 text-slate-500 transition-colors group-hover:bg-primary-100 group-hover:text-primary-600 dark:bg-slate-800 dark:text-slate-400 dark:group-hover:bg-primary-900/50 dark:group-hover:text-primary-400">
                    <i class="bi bi-key text-base"></i>
                </div>
                <span>Update Password</span>
            </a>

            <a asp-area="" asp-controller="Manage" asp-action="Modules"
               class="group flex items-center gap-3 rounded-xl px-3 py-2 text-sm font-medium text-slate-700 transition-all duration-150 hover:bg-primary-50/60 hover:text-primary-600 dark:text-slate-200 dark:hover:bg-primary-950/40 dark:hover:text-primary-400">
                <div class="flex h-8 w-8 items-center justify-center rounded-lg bg-slate-100 text-slate-500 transition-colors group-hover:bg-primary-100 group-hover:text-primary-600 dark:bg-slate-800 dark:text-slate-400 dark:group-hover:bg-primary-900/50 dark:group-hover:text-primary-400">
                    <i class="bi bi-gear text-base"></i>
                </div>
                <span>Modules</span>
            </a>

            <div class="my-1.5 border-t border-slate-100 dark:border-slate-800/80"></div>

            <a href="#"
               class="group flex items-center gap-3 rounded-xl px-3 py-2 text-sm font-medium text-slate-700 transition-all duration-150 hover:bg-primary-50/60 hover:text-primary-600 dark:text-slate-200 dark:hover:bg-primary-950/40 dark:hover:text-primary-400">
                <div class="flex h-8 w-8 items-center justify-center rounded-lg bg-slate-100 text-slate-500 transition-colors group-hover:bg-primary-100 group-hover:text-primary-600 dark:bg-slate-800 dark:text-slate-400 dark:group-hover:bg-primary-900/50 dark:group-hover:text-primary-400">
                    <i class="bi bi-question-circle text-base"></i>
                </div>
                <span>Help &amp; Support</span>
            </a>

        </div>
    </div>

    <!-- THEME TOGGLE -->
    <button type="button"
            id="themeToggle"
            title="Toggle dark/light mode"
            aria-label="Toggle dark/light mode"
            class="group flex h-9 w-9 items-center justify-center rounded-xl text-slate-600 transition-all duration-200 hover:border-slate-300 hover:bg-white hover:text-primary-600 hover:shadow-sm dark:border-slate-800 dark:bg-slate-800/50 dark:text-slate-300 dark:hover:border-slate-700 dark:hover:bg-slate-800 dark:hover:text-primary-400">

        <i id="themeToggleIcon" class="bi bi-moon-stars-fill text-sm transition-transform duration-200 group-hover:rotate-12"></i>
    </button>

</nav>
@* ══════════════════════════════ PAGE ══════════════════════════════ *@
<main role="main">
    <div class="page-container">
        @RenderBody()
    </div>
</main>

<footer class="page-footer">
    <div class="page-container page-footer-inner">
        <span>&copy; @DateTime.Now.Year - Topaz, All rights reserved.</span>
        <a href="#">Privacy</a>
    </div>
</footer>
  
<script>

    (function () {
        'use strict';

        // QUICK ACCESS DROPDOWN
        const quickAccessBtn = document.getElementById('quickAccessBtn');
        const quickAccessDropdown = document.getElementById('quickAccessDropdown');
        const quickAccessArrow = document.getElementById('quickAccessArrow');
        const quickAccessMenu = document.getElementById('quickAccessMenu');

        if (quickAccessBtn && quickAccessDropdown) {

            quickAccessBtn.addEventListener('click', function (e) {
                e.stopPropagation();

                const isHidden = quickAccessDropdown.classList.toggle('hidden');

                quickAccessArrow?.classList.toggle('rotate-180', !isHidden);
            });

            document.addEventListener('click', function (e) {
                if (!quickAccessMenu.contains(e.target)) {
                    quickAccessDropdown.classList.add('hidden');
                    quickAccessArrow?.classList.remove('rotate-180');
                }
            });
        }


        // DARK / LIGHT MODE
        const themeToggle = document.getElementById('themeToggle');
        const themeToggleIcon = document.getElementById('themeToggleIcon');

        const storageKey = 'shell:theme';

        function applyTheme(theme) {
            const isDark = theme === 'dark';

            document.documentElement.classList.toggle('dark', isDark);

            if (themeToggleIcon) {
                themeToggleIcon.className = isDark
                    ? 'bi bi-sun-fill text-lg'
                    : 'bi bi-moon-stars-fill text-lg';
            }

            if (themeToggle) {
                themeToggle.title = isDark
                    ? 'Switch to light mode'
                    : 'Switch to dark mode';

                themeToggle.setAttribute(
                    'aria-label',
                    themeToggle.title
                );
            }

            try {
                localStorage.setItem(storageKey, theme);
            } catch (e) {
                // Continue without persistence if storage is unavailable.
            }
        }

        // Read saved preference
        let savedTheme = 'light';

        try {
            savedTheme = localStorage.getItem(storageKey) || 'light';
        } catch (e) {
            savedTheme = 'light';
        }

        applyTheme(savedTheme);

        if (themeToggle) {
            themeToggle.addEventListener('click', function () {
                const isDark = document.documentElement.classList.contains('dark');

                applyTheme(isDark ? 'light' : 'dark');
            });
        }

    })();

</script>
<script src="~/js/account/user.js" asp-append-version="true"></script>
<script src="~/js/app-shell.js" asp-append-version="true"></script>
<script src="~/js/site.js" asp-append-version="true"></script>
<script src="~/js/components/card.js" asp-append-version="true"></script>
@await RenderSectionAsync("Scripts", required: false)
</body>
</html>
