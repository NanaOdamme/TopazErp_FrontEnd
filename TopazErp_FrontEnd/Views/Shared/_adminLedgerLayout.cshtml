                        </a>
                    </li>
                    <li class="nav-item">
                        <a class="menu-link" asp-area="" asp-controller="GeneralLedger" asp-action="Suppliers">
                            <i class="bi bi-truck" aria-hidden="true"></i>
                            <span class="menu-title">Suppliers</span>
                        </a>
                    </li>
                    <li class="nav-item">
                        <a class="menu-link" asp-area="" asp-controller="GeneralLedger" asp-action="SupplierGroups">
                            <i class="bi bi-people" aria-hidden="true"></i>
                            <span class="menu-title">Supplier Groups</span>
                        </a>
                    </li>
                    <li class="nav-item">
                        <a class="menu-link" asp-area="" asp-controller="GeneralLedger" asp-action="SystemNumbers">
                            <i class="bi bi-hash" aria-hidden="true"></i>
                            <span class="menu-title">System Numbers</span>
                        </a>
                    </li>
                     
                </ul>
            </li>

            <!-- SECTION: LEDGER CORE & CHART OF ACCOUNTS -->
            <li class="nav-section">
                <span class="menu-title">Ledger Core</span>
            </li>

            <li class="nav-item has-sub">
                <a href="#" class="menu-link">
                    <i class="bi bi-diagram-2" aria-hidden="true"></i>
                    <span class="menu-title">Account Setup</span>
                </a>
                <ul class="menu-content">
                    <li class="nav-item">
                        <a class="menu-link" asp-area="" asp-controller="GeneralLedger" asp-action="AccountHeads">
                            <i class="bi bi-folder2-open" aria-hidden="true"></i>
                            <span class="menu-title">Chart of Accounts</span>
                        </a>
                    </li>
                    <li class="nav-item">
                        <a class="menu-link" asp-area="" asp-controller="GeneralLedger" asp-action="CoaControl">
                            <i class="bi bi-list-nested" aria-hidden="true"></i>
                            <span class="menu-title">Chart of Accounts Control</span>
                        </a>
                    </li>
                    <li class="nav-item">
                        <a class="menu-link" asp-area="" asp-controller="GeneralLedger" asp-action="CoaDetails">
                            <i class="bi bi-card-checklist" aria-hidden="true"></i>
                            <span class="menu-title">Chart of Account Details</span>
                        </a>
                    </li>
                    
                    <li class="nav-item">
                        <a class="menu-link" asp-area="" asp-controller="GeneralLedger" asp-action="BankAccounts">
                            <i class="bi bi-wallet2" aria-hidden="true"></i>
                            <span class="menu-title">Bank Accounts</span>
                        </a>
                    </li>
                    
                    <li class="nav-item">
                        <a class="menu-link" asp-area="" asp-controller="GeneralLedger" asp-action="DefaultGlNumbers">
                            <i class="bi bi-journal-check" aria-hidden="true"></i>
                            <span class="menu-title">Default GL Accounts</span>
                        </a>
                    </li>
                    
                </ul>
            </li>

            <li class="nav-item">
                <a class="menu-link" asp-controller="GeneralLedger" asp-action="Budgets">
                    <i class="bi bi-calculator" aria-hidden="true"></i>
                    <span class="menu-title">Budgets</span>
                </a>
            </li>
                

            <!-- SECTION: TRANSACTIONS & VOUCHERS -->
            <li class="nav-section">
                <span class="menu-title">Transactions</span>
            </li>
            
            <li class="nav-item">
                <a class="menu-link" asp-controller="GeneralLedger" asp-action="Journal">
                    <i class="bi bi-journal-text" aria-hidden="true"></i>
                    <span class="menu-title font-medium">Journal Transactions</span>
                </a>
            </li>

            <li class="nav-item">
                <a class="menu-link" asp-controller="GeneralLedger" asp-action="Vouchers">
                    <i class="bi bi-receipt-cutoff" aria-hidden="true"></i>
                    <span class="menu-title">Payment Vouchers</span>
                </a>
            </li>
            
            <li class="nav-item has-sub">
                <a href="#" class="menu-link">
                    <i class="bi bi-cash-coin" aria-hidden="true"></i>
                    <span class="menu-title">Accountable Imprest</span>
                </a>
                <ul class="menu-content">
                    <li class="nav-item">
                        <a class="menu-link" asp-controller="GeneralLedger" asp-action="ImprestCategories">
                            <i class="bi bi-send-plus" aria-hidden="true"></i>
                            <span class="menu-title">Imprest Categories</span>
                        </a>
                    </li>
                    <li class="nav-item">
                        <a class="menu-link" asp-controller="GeneralLedger" asp-action="Imprests">
                            <i class="bi bi-shield-check" aria-hidden="true"></i>
                            <span class="menu-title">Imprests</span>
                        </a>
                    </li>
                </ul>
            </li>

            <li class="nav-item has-sub">
                <a href="#" class="menu-link">
                    <i class="bi bi-wallet-fill" aria-hidden="true"></i>
                    <span class="menu-title">Petty Cash</span>
                </a>
                <ul class="menu-content">
                    
                    <li class="nav-item">
                        <a class="menu-link" asp-controller="GeneralLedger" asp-action="PettyCashRecipients">
                            <i class="bi bi-cash-stack" aria-hidden="true"></i>
