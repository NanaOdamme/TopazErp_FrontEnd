                <a class="menu-link" asp-area="" asp-controller="Dashboard" asp-action="GeneralLedger">
                    <i class="bi bi-speedometer2 text-emerald-600 dark:text-emerald-400" aria-hidden="true"></i>
                    <span class="menu-title font-medium">Dashboard</span>
                </a>
            </li>

            <!-- SECTION: GENERAL SETUPS -->
            <li class="nav-section">
                <span class="menu-title">General Setups</span>
            </li>

            <li class="nav-item has-sub">
                <a href="#" class="menu-link">
                    <i class="bi bi-sliders2" aria-hidden="true"></i>
                    <span class="menu-title">Shared Configurations</span>
                </a>
                <ul class="menu-content">
                    <li class="nav-item">
                        <a class="menu-link" asp-controller="GeneralLedger" asp-action="CompanyProfile">
                            <i class="bi bi-building" aria-hidden="true"></i>
                            <span class="menu-title">Company Profile</span>
                        </a>
                    </li>
                    <li class="nav-item">
                        <a class="menu-link" asp-controller="GeneralLedger" asp-action="Departments">
                            <i class="bi bi-diagram-3" aria-hidden="true"></i>
                            <span class="menu-title">Departments</span>
                        </a>
                    </li>
                    <li class="nav-item">
                        <a class="menu-link" asp-controller="GeneralLedger" asp-action="CostCenters">
                            <i class="bi bi-pie-chart" aria-hidden="true"></i>
                            <span class="menu-title">Cost Centers</span>
                        </a>
                    </li>
                    
                    <li class="nav-item">
                        <a class="menu-link" asp-controller="GeneralLedger" asp-action="CustomerGroups">
                            <i class="bi bi-people" aria-hidden="true"></i>
                            <span class="menu-title">Customer Groups</span>
                        </a>
                    </li>
                    
                    <li class="nav-item">
                        <a class="menu-link" asp-controller="GeneralLedger" asp-action="Customers">
                            <i class="bi bi-people" aria-hidden="true"></i>
                            <span class="menu-title">Customers</span>
                        </a>
                    </li>
                    
                    <li class="nav-item">
                        <a class="menu-link" asp-area="" asp-controller="GeneralLedger" asp-action="Currencies">
                            <i class="bi bi-currency-exchange" aria-hidden="true"></i>
                            <span class="menu-title">Currencies</span>
                        </a>
                    </li>
                    <li class="nav-item">
                        <a class="menu-link" asp-area="" asp-controller="GeneralLedger" asp-action="BanksBranches">
                            <i class="bi bi-bank" aria-hidden="true"></i>
