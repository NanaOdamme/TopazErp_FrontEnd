@* ============================================================================
   _adminLedgerLayout.cshtml — General Ledger Shell for Topaz ERP
   Enterprise Financial ERP UI with Tailwind, Modern Sidebar & Relatable Icons
   ============================================================================ *@
@{
    var title = ViewData["Title"] as string ?? "General Ledger";
    var subtitle = ViewData["Subtitle"] as string ?? "Financial Management System";
    var userName = User?.Identity?.Name ?? "Administrator";
    var initials = string.Concat(userName.Split(new[] { '.', ' ', '_', '-' }, StringSplitOptions.RemoveEmptyEntries)
        .Take(2).Select(p => char.ToUpper(p[0])));
    if (string.IsNullOrWhiteSpace(initials)) { initials = "AD"; }
}
<!DOCTYPE html>
<html lang="en" class="h-full">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@title - Topaz ERP General Ledger</title>

    <script>
        /* Options for shell.js / app-shell.js */
        window.__SHELL__ = {
            breakpoint: 1024,
            railWidth: 72,
            minWidth: 220,
            maxWidth: 420,
            storagePrefix: 'topaz_gl_shell'
        };
    </script>

    <!-- Google Fonts: Inter -->
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@300;400;500;600;700;800&display=swap" rel="stylesheet">

    <!-- Tailwind CSS with Forms -->
    <script src="https://cdn.tailwindcss.com?plugins=forms"></script>
    <script>
        tailwind.config = {
            darkMode: 'class',
            theme: {
                extend: {
                    colors: {
                        primary: {
                            50: '#ecfdf5',
                            100: '#d1fae5',
                            200: '#a7f3d0',
                            300: '#6ee7b7',
                            400: '#34d399',
                            500: '#10b981',
                            600: '#059669',
                            700: '#047857',
                            800: '#065f46',
                            900: '#064e3b',
                            950: '#022c22'
                        },
                        ledger: {
                            emerald: '#10b981',
                            navy: '#0f172a',
                            surface: '#f8fafc'
                        }
                    },
                    fontFamily: {
                        sans: ['Inter', 'ui-sans-serif', 'system-ui', '-apple-system', 'Segoe UI', 'Roboto', 'sans-serif']
                    },
                    boxShadow: {
                        'glow-sm': '0 0 15px rgba(16, 185, 129, 0.15)',
                        'glow-md': '0 0 25px rgba(16, 185, 129, 0.25)',
                        'card-elevated': '0 4px 20px -2px rgba(15, 23, 42, 0.08), 0 2px 6px -1px rgba(15, 23, 42, 0.04)'
                    }
                }
            }
        }
    </script>

    <!-- Core Libraries -->
    <script src="~/libs/jquery/jquery.js" asp-append-version="true"></script>

    <environment names="Development">
        <script src="https://unpkg.com/vue@3/dist/vue.global.js"></script>
    </environment>
    <environment names="Production">
        <script src="https://unpkg.com/vue@3/dist/vue.global.prod.js"></script>
    </environment>
    
    
    <link rel="stylesheet" href="~/css/data-table.css" asp-append-version="true" />
    <script src="~/js/components/dataTable.js" asp-append-version="true"></script>
    <script src="~/js/components/select-input.js" asp-append-version="true"></script>

    <script src="https://cdn.jsdelivr.net/npm/chart.js"></script>
    <script src="https://cdn.jsdelivr.net/npm/axios/dist/axios.min.js"></script>
    <script src="https://cdnjs.cloudflare.com/ajax/libs/numeral.js/2.0.6/numeral.min.js"></script>
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.min.css" />
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/line-awesome@1.3.0/dist/line-awesome/css/line-awesome.min.css" />
    <script src="https://cdn.jsdelivr.net/npm/moment@2.30.1/moment.min.js"></script>
    <script src="https://cdn.jsdelivr.net/npm/sweetalert2@11"></script>

    <!-- Shell and Component Stylesheets -->
    <link rel="stylesheet" href="~/css/shell.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/css/card.css" asp-append-version="true" />

    <!-- Syncfusion EJ1 / Essential JavaScript & Report Viewer -->
    <script src="~/ejassets/scripts/jsrender.min.js"></script>
    <script src="~/ejassets/scripts/ej.web.all.min.js"></script>
    <script src="~/js/bold.report-viewer.min.js"></script>
    <link href="~/ejassets/ejthemes/office-365/ej.web.all.min.css" rel="stylesheet" />
    <script type="text/javascript" src="https://www.gstatic.com/charts/loader.js"></script>

    <script>
        var abp = abp || {};
        abp.appPath = '@Url.Content("~/")';
        var reportApiBaseUrl = 'http://108.181.191.134:78/api/ReportApi';
    </script>

    @await RenderSectionAsync("Styles", required: false)

    <!-- Enhanced ERP UI Styling Overrides -->
    <style>
        :root {
            --shell-accent: #059669;
            --shell-accent-soft: rgba(5, 150, 105, 0.12);
            --shell-accent-strong: #047857;
        }
        .dark {
            --shell-accent: #34d399;
            --shell-accent-soft: rgba(52, 211, 153, 0.15);
            --shell-accent-strong: #6ee7b7;
        }

        /* Topbar Executive Theme */
        .app-topbar-erp {
            background: #0f172a !important;
            border-bottom: 1px solid #1e293b !important;
            color: #f8fafc;
            box-shadow: 0 4px 20px -2px rgba(0, 0, 0, 0.25);
        }
        .dark .app-topbar-erp {
            background: #090d16 !important;
            border-bottom: 1px solid #1e293b !important;
        }

        /* Subtle glow for GL active items */
        .nav-item.active > a, .nav-item > a.active {
            background: var(--shell-accent-soft) !important;
            color: var(--shell-accent-strong) !important;
            font-weight: 600;
        }
        .nav-item.active > a::before {
            background: #10b981 !important;
            width: 4px;
            box-shadow: 0 0 8px rgba(16, 185, 129, 0.8);
        }
        .nav-item > a:hover {
            color: #0f172a;
        }
        .dark .nav-item > a:hover {
            color: #f8fafc;
        }

        /* Module Switcher Dropdown Grid */
        .module-switcher-grid {
            display: grid;
            grid-template-columns: repeat(2, minmax(0, 1fr));
            gap: 0.5rem;
            padding: 0.75rem;
        }
        .module-switcher-card {
            display: flex;
            align-items: center;
            gap: 0.625rem;
            padding: 0.625rem 0.75rem;
            border-radius: 0.625rem;
            font-size: 0.8125rem;
            font-weight: 500;
            color: #334155;
            text-decoration: none;
            transition: all 0.15s ease;
            border: 1px solid transparent;
        }
        .module-switcher-card:hover {
            background: #f1f5f9;
            color: #0f172a;
            border-color: #e2e8f0;
            transform: translateY(-1px);
        }
        .dark .module-switcher-card {
            color: #cbd5e1;
        }
        .dark .module-switcher-card:hover {
            background: #1e293b;
            color: #ffffff;
            border-color: #334155;
        }
        .module-icon-wrap {
            width: 2rem;
            height: 2rem;
            display: grid;
            place-items: center;
            border-radius: 0.5rem;
            font-size: 1rem;
            flex-shrink: 0;
        }
    </style>
</head>

<body class="h-full min-h-full bg-slate-50 font-sans text-slate-800 antialiased dark:bg-slate-950 dark:text-slate-200">

@* ══════════════════════════════ SIDEBAR ══════════════════════════════ *@
<aside class="app-sidebar" id="appSidebar" aria-label="Main navigation">

    <!-- Sidebar Brand -->
    <div class="sidebar-brand">
        <a asp-area="" asp-controller="Dashboard" asp-action="GeneralLedger" class="sidebar-brand-link">
            <span class="sidebar-logo">
                <img class="brand-logo h-8 w-auto object-contain" alt="Topaz ERP" src="/app-assets/images/topazLogo.png" onerror="this.src='https://placehold.co/36x36/10b981/ffffff?text=T'">
            </span>
            <span class="sidebar-brand-text">
                <span class="sidebar-brand-name flex items-center gap-1.5 font-bold tracking-tight text-slate-900 dark:text-white">
                    Topaz ERP
                    <span class="text-[9px] font-bold px-1.5 py-0.5 rounded uppercase tracking-wider bg-emerald-100 text-emerald-800 dark:bg-emerald-950 dark:text-emerald-300">GL</span>
                </span>
                <span class="sidebar-brand-sub text-xs text-slate-500 dark:text-slate-400">General Ledger</span>
            </span>
        </a>
        <button type="button" class="sidebar-icon-btn" data-action="collapse" title="Collapse sidebar (Ctrl+B)" aria-label="Collapse sidebar">
            <i class="bi bi-chevron-double-left" aria-hidden="true"></i>
        </button>
        <button type="button" class="sidebar-icon-btn sidebar-close" data-action="close-drawer" aria-label="Close navigation">
            <i class="bi bi-x-lg" aria-hidden="true"></i>
        </button>
    </div>

