
@{
    ViewBag.Title = "Supplier Groups";
    Layout = "~/Views/Shared/_adminApLayout.cshtml";
}

<div class="content">
    <div class="mb-6 content-header">
        <div class="flex items-center gap-2 text-sm text-gray-500 mb-2">
            <span>AP - Shared Resources</span>
            <i class="bi bi-chevron-right text-xs"></i>
            <span class="text-blue-600 font-medium">Supplier Groups</span>
        </div>

        <div class="flex items-center gap-3">
            <div class="page-title">
                <h2 class="text-2xl font-semibold text-gray-800">
                    Supplier Groups
                </h2>
                <p class="mt-1 text-sm text-gray-500">
                    Manage and organize your supplier groups.
                </p>
            </div>
        </div>
    </div>

    <div class="card" data-card-title="Supplier Groups">
        <div id="app">
            <data-grid
                title="Supplier Groups"
                :columns="supplierGroupColumns"
                :data="supplierGroupList"
                :theme="theme"
                row-id="id"
                label-key="name"
                item-label="supplier group"
                item-label-plural="supplier groups"
                add-label="Add"
                :page-size="10"
                :selectable="true"
                :actions="true"
                @@create="onCreate"
                @@update="onUpdate"
                @@delete="onDelete">
            </data-grid>
        </div>
    </div>
</div>

<script src="~/js/shared/vue3/supplier-groups.js"
    asp-append-version="true"></script>
