@{
    ViewBag.Title = "Ageing Reports";
    Layout = "~/Views/Shared/_adminArLayout.cshtml";
}
<div class="content">
<div class="mb-6 content-header">
    <div class="flex items-center gap-2 text-sm text-gray-500 mb-2">
        <span>AR - Reports</span>
        <i class="bi bi-chevron-right text-xs"></i>
        <span class="text-blue-600 font-medium">Aging</span>
    </div>

    <div class="flex items-center gap-3">

        <div class="page-title">
            <h2 class="text-2xl font-semibold text-gray-800">
                Reports
            </h2>
                
        </div>
    </div>
</div>
<div id="app" class="card" data-card-title="AR - Aging Report">
    <div class="p-4">
        <!-- Report Filters -->
        <div class="grid grid-cols-1 md:grid-cols-2 xl:grid-cols-4 gap-4">

            <!-- Report Type -->
            <div>
        
                <w-select
                    v-model="reportType"
                    :options="[
                        { id: 'byDateSummary', name: 'Ageing Summary by Date' },
                        { id: 'byCustomer', name: 'Ageing by Customer' }
                    ]"
                    display-key="name"
                    value-key="id"
                    placeholder="Select Report Type"
                    label="Report Type">
                </w-select>
            </div>

            <!-- Start Date -->
            <div>
                <label class="label block text-sm mb-1">Start Date</label>
                <input
                    type="date"
                    v-model="startDate"
                    class="input-control w-full">
            </div>

            <!-- Ageing Interval -->
            <div>
                <label class="label block text-sm mb-1">Ageing Interval (Days)</label>
                <input
                    type="number"
                    min="1"
                    v-model.number="agingInterval"
                    class="input-control w-full"
                    placeholder="Enter ageing interval">
            </div>

            <!-- Supplier -->
            <div v-if="reportType === 'byCustomer'">
            
                <w-select
                    v-model="customerId"
                    :options="customerList"
                    display-key="name"
                    value-key="id"
                    placeholder="Select Customer"
                    label="Customer">
                </w-select>
            </div>

        </div>

        <!-- Generate Report -->
        <div class="flex justify-end mt-5">
            <button
                type="button"
                @@click="getReportData()"
                :disabled="isLoading"
                class="px-5 py-2.5 rounded-md bg-blue-600 hover:bg-blue-700 text-white text-sm font-medium flex items-center gap-2 disabled:opacity-50 disabled:cursor-not-allowed">

                <i v-if="isLoading" class="bi bi-arrow-repeat animate-spin"></i>
                <i v-else class="bi bi-file-earmark-bar-graph"></i>

                {{ isLoading ? 'Generating Report...' : 'Generate Report' }}
            </button>
        </div>

        <hr class="my-4">

        <div class="w-full mt-6" style="height: 1000px;">
            <div style="height: 820px;" v-if="showReport">
                <pdf-viewer :src="reportPath"
                            :data="reportData"
                            :color="viewerColor"
                            :title="reportTitle"></pdf-viewer>
            </div>

        </div>

    </div>
</div>
</div>
<script src="~/js/ar/Reports/aging-reports.js" asp-append-version="true"></script>