@{
    ViewBag.Title = "ImportOpeningBalance";
    Layout = "~/Views/Shared/_adminArLayout.cshtml";
}
<div class="content">
    <div class="mb-6 content-header">
        <div class="flex items-center gap-2 text-sm text-gray-500 mb-2">
            <span>AR - Imports</span>
            <i class="bi bi-chevron-right text-xs"></i>
            <span class="text-blue-600 font-medium">Opening Balances</span>
        </div>

        <div class="flex items-center gap-3">

            <div class="page-title">
                <h2 class="text-2xl font-semibold text-gray-800">
                    Opening Balances
                </h2>
                
            </div>
        </div>
    </div>
    <div id="app" class="card" data-card-title="Import Balances">
         <!-- File Upload and Import -->
<div class="grid grid-cols-1 items-end gap-5 sm:grid-cols-2 lg:grid-cols-3">
    <!-- File Upload -->
    <div class="space-y-2">
        <label class="flex flex-wrap items-center gap-2 text-sm font-semibold text-slate-700 dark:text-slate-200">
            Choose File:
            <a href="@Url.Action("DownloadOpeningBalancesUploadSample", "Ar")"
               class="inline-flex items-center gap-1 font-semibold text-blue-600 transition-colors hover:text-blue-700 hover:underline dark:text-blue-400 dark:hover:text-blue-300">
                <i class="la la-download"></i>
                Download Template
            </a>
        </label>

        <input
            type="file"
            @@change="onFileUpload"
            required
            class="block w-full cursor-pointer rounded-lg border border-slate-300 bg-white text-sm text-slate-700 shadow-sm transition-colors
                   file:mr-4 file:cursor-pointer file:border-0 file:bg-slate-100 file:px-4 file:py-2.5 file:text-sm file:font-semibold file:text-slate-700
                   hover:file:bg-slate-200
                   focus:outline-none focus:ring-2 focus:ring-blue-500 focus:ring-offset-1
                   dark:border-slate-600 dark:bg-slate-800 dark:text-slate-200
                   dark:file:bg-slate-700 dark:file:text-slate-200 dark:hover:file:bg-slate-600
                   dark:focus:ring-offset-slate-900" />
    </div>

    <!-- Import Button -->
    <div class="flex items-center">
        <button
            type="button"
            :disabled="hasErrors || !pendingRows || isLoading"
            @@click="importData"
            class="inline-flex items-center justify-center gap-2 rounded-lg bg-blue-600 px-5 py-2.5 text-sm font-semibold text-white shadow-sm transition-all
                   hover:bg-blue-700 focus:outline-none focus:ring-2 focus:ring-blue-500 focus:ring-offset-2
                   disabled:cursor-not-allowed disabled:opacity-50 disabled:shadow-none
                   dark:focus:ring-offset-slate-900">
            <i :class="isLoading ? 'la la-spinner la-spin text-base' : 'la la-file-import text-base'"></i>
            {{ isLoading ? 'Importing…' : 'Import' }}
        </button>
    </div>
</div>

<!-- Import Preview -->
<div class="mt-6 space-y-3">

    <!-- Total Rows -->
    <div class="flex flex-wrap items-center justify-between gap-3">
        <div class="flex items-center gap-2">
            <h3 class="text-sm font-semibold text-slate-700 dark:text-slate-200">
                Total Import Rows
            </h3>

            <span class="inline-flex min-w-7 items-center justify-center rounded-full bg-emerald-100 px-2.5 py-1 text-xs font-bold text-emerald-700 dark:bg-emerald-900/40 dark:text-emerald-300">
                {{ previewData?.length || 0 }}
            </span>
        </div>
    </div>

    <!-- Table -->
    <div class="overflow-x-auto rounded-xl border border-slate-200 bg-white shadow-sm dark:border-slate-700 dark:bg-slate-900">
        <table class="w-full min-w-[1000px] divide-y divide-slate-200 text-left text-sm dark:divide-slate-700">

            <thead class="bg-slate-50 dark:bg-slate-800">
                <tr>
                    <th class="w-[60px] px-4 py-3 font-semibold text-slate-600 dark:text-slate-300">
                        No.
                    </th>
                    <th class="min-w-[280px] px-4 py-3 font-semibold text-slate-600 dark:text-slate-300">
                        Customer
                    </th>
                    <th class="min-w-[200px] px-4 py-3 font-semibold text-slate-600 dark:text-slate-300">
                        Transaction Date
                    </th>
                    <th class="min-w-[220px] px-4 py-3 font-semibold text-slate-600 dark:text-slate-300">
                        Currency
                    </th>
                    <th class="min-w-[150px] px-4 py-3 text-right font-semibold text-slate-600 dark:text-slate-300">
                        Rate
                    </th>
                    <th class="min-w-[200px] px-4 py-3 text-right font-semibold text-slate-600 dark:text-slate-300">
                        Amount
                    </th>
                </tr>
            </thead>

            <tbody class="divide-y divide-slate-100 dark:divide-slate-800">
                <template v-for="(row, index) in paginatedData" :key="index">

                    <!-- Data Row -->
                    <tr class="transition-colors hover:bg-slate-50 dark:hover:bg-slate-800/60">
                        <td class="px-4 py-3 text-slate-500 dark:text-slate-400">
                            {{ (currentPage - 1) * pageSize + index + 1 }}
                        </td>

                        <td class="px-4 py-3 font-medium text-slate-800 dark:text-slate-100">
                            {{ row.customer }}
                            <span v-if="row.imported" class="ml-2 text-xs font-semibold text-emerald-600 dark:text-emerald-400">Imported</span>
                        </td>

                        <td class="px-4 py-3 whitespace-nowrap text-slate-600 dark:text-slate-300">
                            {{ formatDate(row.transactionDate) }}
                        </td>

                        <td class="px-4 py-3 text-slate-600 dark:text-slate-300">
                            {{ row.currencyName }}
                        </td>

                        <td class="px-4 py-3 text-right tabular-nums text-slate-600 dark:text-slate-300">
                            {{ row.currencyRate }}
                        </td>

                        <td class="px-4 py-3 text-right font-semibold tabular-nums text-slate-800 dark:text-slate-100">
                            {{ Number(row.amount || 0).toLocaleString(undefined, {
                                minimumFractionDigits: 2,
                                maximumFractionDigits: 2
                            }) }}
                        </td>
                    </tr>

                    <!-- Validation Errors -->
                    <tr v-if="(row.errors && row.errors.length) || row.importError"
                        class="bg-red-50 dark:bg-red-950/30">

                        <td class="px-4 py-3"></td>

                        <td colspan="5" class="px-4 py-3">
                            <div class="flex items-start gap-2">
                                <i class="la la-exclamation-triangle mt-0.5 text-lg text-red-600 dark:text-red-400"></i>

                                <div>
                                    <p class="mb-1 text-sm font-semibold text-red-700 dark:text-red-300">
                                        Issues
                                    </p>

                                    <ul class="list-inside list-disc space-y-1 text-sm text-red-600 dark:text-red-400">
                                        <li v-for="(e, errorIndex) in row.errors" :key="errorIndex">
                                            {{ e }}
                                        </li>
                                        <li v-if="row.importError">{{ row.importError }}</li>
                                    </ul>
                                </div>
                            </div>
                        </td>
                    </tr>

                </template>

                <!-- Empty State -->
                <tr v-if="!paginatedData || paginatedData.length === 0">
                    <td colspan="6" class="px-4 py-12 text-center">
                        <i class="la la-file-upload mb-2 text-3xl text-slate-400 dark:text-slate-500"></i>
                        <p class="font-medium text-slate-600 dark:text-slate-300">
                            No opening balances to preview
                        </p>
                        <p class="mt-1 text-sm text-slate-400 dark:text-slate-500">
                            Choose a file to view the import data.
                        </p>
                    </td>
                </tr>
            </tbody>

        </table>
    </div>

    <!-- Pagination -->
    <div v-if="totalPages > 1"
         class="flex flex-col gap-3 sm:flex-row sm:items-center sm:justify-between">

        <p class="text-sm text-slate-500 dark:text-slate-400">
            Page
            <span class="font-semibold text-slate-700 dark:text-slate-200">{{ currentPage }}</span>
            of
            <span class="font-semibold text-slate-700 dark:text-slate-200">{{ totalPages }}</span>
        </p>

        <nav class="flex flex-wrap items-center justify-end gap-1" aria-label="Table pagination">

            <!-- Previous -->
            <button
                type="button"
                :disabled="currentPage === 1"
                @@click="currentPage = Math.max(1, currentPage - 1)"
                class="inline-flex items-center gap-1 rounded-lg border border-slate-200 bg-white px-3 py-2 text-sm font-medium text-slate-600 transition-colors
                       hover:bg-slate-50 disabled:cursor-not-allowed disabled:opacity-40
                       dark:border-slate-700 dark:bg-slate-900 dark:text-slate-300 dark:hover:bg-slate-800">
                <i class="la la-angle-left"></i>
                Prev
            </button>

            <!-- Page Numbers -->
            <button
                v-for="p in paginationPages"
                :key="p"
                type="button"
                @@click="currentPage = p"
                :aria-current="currentPage === p ? 'page' : null"
                :class="currentPage === p
                    ? 'border-blue-600 bg-blue-600 text-white'
                    : 'border-slate-200 bg-white text-slate-600 hover:bg-slate-50 dark:border-slate-700 dark:bg-slate-900 dark:text-slate-300 dark:hover:bg-slate-800'"
                class="min-w-9 rounded-lg border px-3 py-2 text-sm font-medium transition-colors">
                {{ p }}
            </button>

            <!-- Next -->
            <button
                type="button"
                :disabled="currentPage === totalPages"
                @@click="currentPage = Math.min(totalPages, currentPage + 1)"
                class="inline-flex items-center gap-1 rounded-lg border border-slate-200 bg-white px-3 py-2 text-sm font-medium text-slate-600 transition-colors
                       hover:bg-slate-50 disabled:cursor-not-allowed disabled:opacity-40
                       dark:border-slate-700 dark:bg-slate-900 dark:text-slate-300 dark:hover:bg-slate-800">
                Next
                <i class="la la-angle-right"></i>
            </button>

        </nav>
    </div>
</div>   
    </div>
</div>
<script src="~/js/ar/Imports/balances.js" asp-append-version="true"></script>


