@{
    ViewBag.Title = "Customers";
    Layout = "~/Views/Shared/_adminArLayout.cshtml";
}
<div class="content">
    <div class="mb-6 content-header">
        <div class="flex items-center gap-2 text-sm text-gray-500 mb-2">
            <span>AR - Reports</span>
            <i class="bi bi-chevron-right text-xs"></i>
            <span class="text-blue-600 font-medium">Customers List</span>
        </div>

        <div class="flex items-center gap-3">

            <div class="page-title">
                <h2 class="text-2xl font-semibold text-gray-800">
                    Customer List
                </h2>
                
            </div>
        </div>
    </div>
    <div id="app" class="card" data-card-title="Reports - Customers">
        <div class="grid grid-cols-1 gap-5 sm:grid-cols-2 xl:grid-cols-4 mb-5">
            <label  class="label block text-sm">
                Select Report Type: <select class="select" v-model="reportType" ref="reportType">
                    <option value="summary-report"> Type 1 </option>
                    <option value="customer-group"> Type 2 </option>
                </select></label>
            <w-select
                v-if = "reportType === 'customer-group'"
                v-model="customerGroupId"
                @@change="getReportData"
                :options="customerGroupList"
                display-key="name"
                value-key="id"
                placeholder="Select Customer Group"
                label="Customer Group:"
                required>
            </w-select>
        
        </div>
        <div class="flex justify-end mb-4 mt-5">
            <button
                type="button"
                @@click="getReportData()"
                :disabled="isLoading"
                class="bg-blue-600 text-white px-4 py-2 rounded-lg hover:bg-blue-700 disabled:opacity-50 disabled:cursor-not-allowed">
            

                <i v-if="isLoading" class="bi bi-arrow-repeat animate-spin"></i>
                <i v-else class="bi bi-file-earmark-bar-graph"></i>

                {{ isLoading ? 'Generating...' : 'Generate Report' }}

            </button>
        </div>
        <hr>
        <div class="w-full mt-6" style="height: 1000px;">
            <div style="height: 820px;" v-if="showReport">
                <pdf-viewer :src="reportPath"
                            :data="reportData"
                            :color="viewerColor"
                            :title="reportTitle"></pdf-viewer>
            </div>

        </div>
    </div>
</div>
<script src="~/js/ar/Reports/customers.js" asp-append-version="true"></script>