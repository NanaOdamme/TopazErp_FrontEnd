@{
    ViewBag.Title = "Credit Memos";
    Layout = "~/Views/Shared/_adminArLayout.cshtml";
}

<div class="content">
    <div class="mb-6 content-header">
        <div class="flex items-center gap-2 text-sm text-gray-500 mb-2">
            <span>AR - Data Entry</span>
            <i class="bi bi-chevron-right text-xs"></i>
            <span class="text-blue-600 font-medium">Credit Memos</span>
        </div>
    </div>

    <div id="app" class="space-y-6">
        <div class="card" data-card-title="Credit Memos">
        <data-grid
                ref="creditMemo"
                title="Credit Memos"
                :columns="creditMemoColumns"
                :data="creditMemoList"
                :theme="theme"
                row-id="id"
                label-key="customerName"
                storage-key="credit-memo-register"
                item-label="credit memo"
                item-label-plural="credit memos"
                :page-size="10"
                :selectable="true"
                @@create="onCreate"
                @@update="onUpdate"
                @@delete="onDelete">
            </data-grid>
               
        </div>
    </div>
</div>



<script src="~/js/ar/data-entry/creditMemo.js" asp-append-version="true"></script>

