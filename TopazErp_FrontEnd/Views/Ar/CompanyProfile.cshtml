@{
ViewBag.Title = "Company Profile";
Layout = "~/Views/Shared/_adminArLayout.cshtml";
}

<div class="content">
    <div class="mb-6 content-header">
        <div class="flex items-center gap-2 text-sm text-gray-500 mb-2">
            <span>AR - SharedResources</span>
            <i class="bi bi-chevron-right text-xs"></i>
            <span class="text-blue-600 font-medium">Company Profile</span>
        </div>

        <div class="flex items-center gap-3">

            <div class="page-title">
                <h2 class="text-2xl font-semibold text-gray-800 ">
                    Company Profile
                </h2>
                
            </div>
        </div>
    </div>
    <div class="card" data-card-title="Company Profile">
        <div id="app">
    <div class="mx-auto max-w-7xl space-y-6">
    
        <!-- Existing Tabs -->
        <div class="border-b border-slate-200 dark:border-slate-800">
            <nav class="-mb-px flex gap-6 overflow-x-auto" aria-label="Company settings tabs">

                <button
                    type="button"
                    @@click="activeTab = 'profile'"
                    :class="activeTab === 'profile'
                ? 'border-blue-600 text-blue-700'
                : 'border-transparent text-slate-500 hover:border-slate-300 hover:text-slate-700'"
                    :aria-selected="activeTab === 'profile'"
                    role="tab"
                    class="inline-flex shrink-0 items-center gap-2 border-b-2 px-1 pb-3 text-sm font-semibold transition-colors">

                    <i class="la la-building text-lg"></i>
                    Company Profile
                </button>

                <button
                    type="button"
                    @@click="activeTab = 'vat'"
                    :class="activeTab === 'vat'
                ? 'border-blue-600 text-blue-700'
                : 'border-transparent text-slate-500 hover:border-slate-300 hover:text-slate-700'"
                    :aria-selected="activeTab === 'vat'"
                    role="tab"
                    class="inline-flex shrink-0 items-center gap-2 border-b-2 px-1 pb-3 text-sm font-semibold transition-colors">

                    <i class="la la-percent text-lg"></i>
                    Tax & VAT Details
                </button>

            </nav>
        </div>

        <div id="profile" class="space-y-6"  v-show="activeTab === 'profile'"
             role="tabpanel">
            <form>
                <!-- BASIC INFORMATION -->
                <section class="overflow-hidden rounded-2xl border border-slate-200 dark:border-slate-800 shadow-sm">
                    <div class="border-b border-slate-100 dark:border-slate-800 px-5 py-5 sm:px-7">
                        <div class="flex items-center gap-3">
                            <div class="flex h-10 w-10 items-center justify-center rounded-lg bg-blue-50 dark:bg-slate-800 text-blue-700">
                                <i class="bi bi-person-vcard text-xl"></i>
                            </div>
                            <div>
                                <h2 class="text-base font-bold text-slate-900 dark:text-white">Basic Information</h2>
                                <p class="mt-1 text-sm text-slate-500">
                                    Your company's identity and contact information.
                                </p>
                            </div>
                        </div>
                    </div>

                    <div class="grid grid-cols-1 gap-7 p-5 sm:p-7 lg:grid-cols-12">

                        <!-- Company Logo -->
                        <div class="lg:col-span-3">
                            <div class="flex flex-col items-center rounded-xl border border-dashed border-slate-200 bg-slate-50 dark:bg-slate-800 px-4 py-6">
                                <div class="relative">
                                    <img
                                        v-if="companyLogoBase64"
                                        :src="companyLogoBase64"
                                        alt="Company Logo"
                                        class="h-36 w-36 rounded-2xl border border-slate-200 bg-white object-contain p-2 shadow-sm">

                                    <img
                                        v-else
                                        src="https://res.cloudinary.com/dusydqiob/image/upload/v1755769638/erp-reports/ap/profile_biwocv.jpg"
                                        alt="Default Company Logo"
                                        class="h-36 w-36 rounded-2xl border border-slate-200 bg-white object-cover shadow-sm">

                                    <button
                                        v-if="companyLogoBase64"
                                        @@click="removeLogo"
                                        type="button"
                                        class="absolute -right-2 -top-2 flex h-8 w-8 items-center justify-center rounded-full bg-red-500 text-white shadow-md transition hover:bg-red-600"
                                        title="Remove logo">
                                        <i class="la la-times"></i>
                                    </button>

                                    <button
                                        v-else
                                        @@click="showUpload"
                                        type="button"
                                        class="absolute -bottom-2 -right-2 flex h-9 w-9 items-center justify-center rounded-full bg-blue-600 text-white shadow-md transition hover:bg-blue-700"
                                        title="Upload logo">
                                        <i class="la la-plus"></i>
                                    </button>
                                </div>

                                <h3 class="mt-4 text-sm font-semibold text-slate-800">
                                    Company Logo
                                </h3>
                                <p class="mt-1 text-center text-xs leading-5 text-slate-500">
                                    Upload your company brand image.
                                </p>

                                <input
                                    type="file"
                                    ref="fileInput"
                                    class="hidden"
                                    @@change="onFileChange"
                                    accept="image/*">

                                <button
                                    type="button"
                                    @@click="showUpload"
                                    class="dark:text-white dark:bg-slate-800 mt-4 inline-flex items-center gap-2 rounded-lg border border-slate-200 bg-white px-4 py-2 text-sm font-semibold text-slate-700 shadow-sm transition hover:bg-slate-100">
                                    <i class="la la-upload text-base"></i>
                                    Upload logo
                                </button>
                            </div>
                        </div>

                        <!-- Company Details -->
                        <div class="grid grid-cols-1 gap-x-5 gap-y-5 sm:grid-cols-2 lg:col-span-9">

                            <div class="sm:col-span-2">
                               <label  class="label mb-2 block text-sm font-semibold text-slate-700">
                                    Company Name <span class="text-red-500">*</span>
                                </label>
                                <input
                                    type="text"
                                    v-model="companyName"
                                    ref="companyName"
                                    placeholder="Enter registered company name"
                                    class="input-control"  >
                                <p v-if="errors.companyName" class="mt-1.5 text-xs font-medium text-red-600">
                                    {{ errors.companyName }}
                                </p>
                            </div>

                            <div>
                               <label  class="label mb-2 block text-sm font-semibold text-slate-700">Country</label>
                                <select
                                    v-model="countryId"
                                    ref="countryId"
                                    class="select">
                                    <option value="">Select country</option>
                                    <option :value="country.id" v-for="country in nationalityList" :key="country.id">
                                        {{ country.name }}
                                    </option>
                                </select>
                            </div>

                            <div>
                               <label  class="label mb-2 block text-sm font-semibold text-slate-700">City / Location</label>
                                <input
                                    type="text"
                                    v-model="cityName"
                                    placeholder="Enter city or location"
                                    class="input-control"  >
                            </div>
                            <div>
                               <label  class="label mb-2 block text-sm font-semibold text-slate-700">
                                    Phone Number <span class="text-red-500">*</span>
                                </label>
                                <input
                                    type="text"
                                    id="phoneNo"
                                    v-model="phoneNo"
                                    ref="phoneNo"
                                    placeholder="e.g. 024 000 0000"
                                    class="input-control"  >
                                <p v-if="errors.phoneNo" class="mt-1.5 text-xs text-red-600">
                                    {{ errors.phoneNo }}
                                </p>
                            </div>

                            <div>
                               <label  class="label mb-2 block text-sm font-semibold text-slate-700">Default Currency</label>
                                <select
                                    v-model="defaultCurrenyId"
                                    id="defaultCurrenyId"
                                    class="select"  >
                                    <option :value="currency.id" v-for="currency in currencyList" :key="currency.id">
                                        {{ currency.currencyName }}
                                    </option>
                                </select>
                            </div>

                            <div>
                               <label  class="label mb-2 block text-sm font-semibold text-slate-700">Company TIN</label>
                                <input
                                    type="text"
                                    v-model="companyTin"
                                    placeholder="Enter company TIN"
                                    class="input-control"  >
                            </div>

                            <div>
                               <label  class="label mb-2 block text-sm font-semibold text-slate-700">
                                    Email Address <span class="text-red-500">*</span>
                                </label>
                                <input
                                    type="email"
                                    v-model="email"
                                    ref="email"
                                    placeholder="company@example.com"
                                    class="input-control"  >
                                <p v-if="errors.email" class="mt-1.5 text-xs text-red-600">
                                    {{ errors.email }}
                                </p>
                            </div>

                            <div>
                               <label  class="label mb-2 block text-sm font-semibold text-slate-700">Company Address</label>
                                <input
                                    type="text"
                                    v-model="address"
                                    ref="address"
                                    placeholder="Enter company address"
                                    class="input-control"  >
                                <p v-if="errors.address" class="mt-1.5 text-xs text-red-600">
                                    {{ errors.address }}
                                </p>
                            </div>

                            <div>
                               <label  class="label mb-2 block text-sm font-semibold text-slate-700">
                                    First Month of Fiscal Year
                                </label>
                                <select
                                    id="firstMonthOfFiscalYear"
                                    v-model="firstMonthOfFiscalYear"
                                    class="select"  >
                                    <option value="1">January</option>
                                    <option value="2">February</option>
                                    <option value="3">March</option>
                                    <option value="4">April</option>
                                    <option value="5">May</option>
                                    <option value="6">June</option>
                                    <option value="7">July</option>
                                    <option value="8">August</option>
                                    <option value="9">September</option>
                                    <option value="10">October</option>
                                    <option value="11">November</option>
                                    <option value="12">December</option>
                                </select>
                            </div>
                        </div>
                    </div>
                </section>

                <!-- SSNIT -->
                <section class="mt-6 rounded-2xl border border-slate-200 dark:border-slate-800 bg-white p-5 shadow-sm sm:p-7 dark:bg-transparent">
                    <div class="mb-6 flex items-center gap-3">
                        <div class="flex h-10 w-10 items-center justify-center rounded-lg bg-blue-50 dark:bg-slate-800 text-blue-700">
                            <i class="la la-shield text-xl"></i>
                        </div>
                        <div>
                            <h2 class="text-base font-bold text-slate-900 dark:text-white">SSNIT Information</h2>
                            <p class="mt-1 text-sm text-slate-500">Employer social security registration details.</p>
                        </div>
                    </div>

                    <div class="max-w-2xl">
                       <label  class="label mb-2 block text-sm font-semibold text-slate-700">
                            Employer Social Security Number
                        </label>
                        <input
                            type="text"
                            v-model="employerSocialSecurityNo"
                            placeholder="Enter employer SSNIT number"
                            class="input-control"  >
                    </div>
                </section>

                <!-- EMAIL SETTINGS -->
                <section class="mt-6 rounded-2xl border border-slate-200 bg-white p-5 shadow-sm sm:p-7 dark:bg-transparent dark:border-slate-800">
                    <div class="mb-6 flex items-center gap-3">
                        <div class="flex h-10 w-10 items-center justify-center rounded-lg bg-blue-50 dark:bg-slate-800 text-blue-700">
                            <i class="la la-envelope text-xl"></i>
                        </div>
                        <div>
                            <h2 class="text-base font-bold text-slate-900 dark:text-white">Email Settings</h2>
                            <p class="mt-1 text-sm text-slate-500">Configure your outgoing email server.</p>
                        </div>
                    </div>

                    <div class="grid grid-cols-1 gap-x-6 gap-y-5 md:grid-cols-2">
                        <div>
                           <label  class="label mb-2 block text-sm font-semibold text-slate-700">Mail Host Name</label>
                            <input
                                type="text"
                                v-model="mailHostName"
                                placeholder="smtp.example.com"
                                class="input-control"  >
                        </div>

                        <div>
                           <label  class="label mb-2 block text-sm font-semibold text-slate-700">Port Number</label>
                            <input
                                type="number"
                                v-model="portNumber"
                                placeholder="587"
                                class="input-control"  >
                        </div>

                        <div>
                           <label  class="label mb-2 block text-sm font-semibold text-slate-700">Primary Email Address</label>
                            <input
                                type="email"
                                v-model="primaryEmailAddress"
                                placeholder="notifications@example.com"
                                class="input-control"  >
                        </div>

                        <div>
                           <label  class="label mb-2 block text-sm font-semibold text-slate-700">SSL Enabled</label>
                            <select
                                v-model="isSSLEnabled"
                                class="select"  >
                                <option :value="false">No</option>
                                <option :value="true">Yes</option>
                            </select>
                        </div>

                        <div class="md:col-span-2">
                           <label  class="label mb-2 block text-sm font-semibold text-slate-700">Mail Password</label>
                            <input
                                type="password"
                                v-model="emailPassword"
                                autocomplete="new-password"
                                placeholder="Enter mail server password"
                                class="input-control"  >
                            <p class="mt-2 text-xs text-slate-500">
                                Your email credentials should be stored securely.
                            </p>
                        </div>
                    </div>
                </section>

                <!-- APPLY SETTINGS -->
                <section class="mt-6 rounded-2xl border border-slate-200 bg-white p-5 shadow-sm sm:p-7 dark:bg-transparent dark:border-slate-800">
                    <div class="mb-6 flex items-center gap-3">
                        <div class="flex h-10 w-10 items-center justify-center rounded-lg bg-blue-50 dark:bg-slate-800 text-blue-700">
                            <i class="la la-sliders text-xl"></i>
                        </div>
                        <div>
                            <h2 class="text-base font-bold text-slate-900 dark:text-white">Application Settings</h2>
                            <p class="mt-1 text-sm text-slate-500">Configure tax and invoice approval behavior.</p>
                        </div>
                    </div>

                    <div class="grid grid-cols-1 gap-4 md:grid-cols-2">
                      

                       <label  class="label flex cursor-pointer items-start gap-3 rounded-xl border border-slate-200 dark:border-slate-800 p-4 transition hover:border-blue-300 hover:bg-blue-50/40">
                            <input
                                type="checkbox"
                                id="approveBeforePayment"
                                v-model="approveInvoiceBeforePayment"
                                class="mt-1 h-4 w-4 rounded border-slate-300 text-blue-600 focus:ring-blue-500">
                            <span>
                                <span class="block text-sm font-semibold text-slate-800">Approval Required</span>
                                <span class="mt-1 block text-xs leading-5 text-slate-500">
                                    Require invoice approval before payment can proceed.
                                </span>
                            </span>
                        </label>
                    </div>
                </section>

                <!-- GENERAL LEDGER -->
                <section class="mt-6 rounded-2xl border border-slate-200 bg-white p-5 shadow-sm sm:p-7 dark:bg-transparent dark:border-slate-800">
                    <div class="mb-5 flex items-center gap-3">
                        <div class="flex h-10 w-10 items-center justify-center rounded-lg bg-blue-50 dark:bg-slate-800 text-blue-700">
                            <i class="la la-sitemap text-xl"></i>
                        </div>
                        <div>
                            <h2 class="text-base font-bold text-slate-900 dark:text-white">General Ledger</h2>
                            <p class="mt-1 text-sm text-slate-500">Configure organizational unit enforcement.</p>
                        </div>
                    </div>

                   <label  class="label flex cursor-pointer items-start gap-3 rounded-xl border border-slate-200 dark:border-slate-800 p-4 transition hover:border-blue-300 hover:bg-blue-50/40 md:max-w-xl">
                        <input
                            type="checkbox"
                            id="enforceOu"
                            v-model="enforceOu"
                            class="mt-1 h-4 w-4 rounded border-slate-300 text-blue-600 focus:ring-blue-500">
                        <span>
                            <span class="block text-sm font-semibold text-slate-800">Enforce Organizational Unit (OU)</span>
                            <span class="mt-1 block text-xs leading-5 text-slate-500">
                                Apply organizational unit restrictions where configured.
                            </span>
                        </span>
                    </label>
                </section>

                <!-- STICKY ACTION BAR -->
                <div class="sticky bottom-0 z-10 mt-6 border-t border-slate-200 dark:border-slate-800 bg-white/95 px-4 py-4 backdrop-blur sm:rounded-xl sm:border sm:px-6 dark:bg-transparent dark:border-slate-800">
                    <div class="flex flex-col gap-3 sm:flex-row sm:items-center sm:justify-between">
                        <p class="text-xs text-slate-500">
                            <i class="la la-info-circle mr-1"></i>
                            Review your changes before saving.
                        </p>

                        <button
                            @@click="saveProfile"
                            :disabled="isLoading"
                            class="inline-flex items-center justify-center gap-2 rounded-lg bg-blue-600 px-6 py-3 text-sm font-semibold text-white shadow-sm transition hover:bg-blue-700 focus:outline-none focus:ring-4 focus:ring-blue-500/20 disabled:cursor-not-allowed disabled:opacity-60">
                            <i v-if="isLoading" class="la la-circle-o-notch animate-spin text-lg"></i>
                            <i v-else class="la la-save text-lg"></i>
                            {{ isLoading ? 'Saving Profile...' : 'Save Profile' }}
                        </button>
                    </div>
                </div>

            </form>
        </div>

        <!-- TAX & VAT TAB CONTENT -->
        <div id="vat" class="space-y-6"  v-show="activeTab === 'vat'"
             role="tabpanel">
            <section class="rounded-2xl border border-slate-200 bg-white dark:bg-transparent dark:border-slate-800 p-5 shadow-sm sm:p-7">
                <div class="mb-5 flex items-center gap-3">
                    <div class="flex h-10 w-10 items-center justify-center rounded-lg bg-blue-50 text-blue-700 dark:bg-slate-800">
                        <i class="la la-percent text-xl"></i>
                    </div>
                    <div>
                        <h2 class="text-base font-bold text-slate-900 dark:text-white">Tax Levy Details</h2>
                        <p class="mt-1 text-sm text-slate-500">Manage applicable tax levies.</p>
                    </div>
                </div>
                <div class="overflow-x-auto">
                    @*<div class="min-w-0" id="dataTable"></div>*@
                    <data-grid
                        title="Tax Levy Details"
                        :columns="taxesCol"
                        :data="otherTaxLevyList"
                        :theme="theme"
                        row-id="id"
                        label-key="name"
                        item-label="data"
                        item-label-plural="Tax Levies"
                        add-label="Add"
                        :page-size="10"
                        :selectable="true"
                        :actions="true"
                    ></data-grid>
                </div>
            </section>

            <section class="rounded-2xl border border-slate-200 bg-white dark:bg-transparent dark:border-slate-800  p-5 shadow-sm sm:p-7">
                <div class="mb-5 flex items-center gap-3">
                    <div class="flex h-10 w-10 items-center justify-center rounded-lg bg-blue-50 dark:bg-slate-800 text-blue-700">
                        <i class="la la-receipt text-xl"></i>
                    </div>
                    <div>
                        <h2 class="text-base font-bold text-slate-900 dark:text-white">VAT Details</h2>
                        <p class="mt-1 text-sm text-slate-500">Manage VAT configuration.</p>
                    </div>
                </div>
                <div class="overflow-x-auto">
                    @*<div class="min-w-0" id="dataTable1"></div>*@
                    <data-grid
                        title="Vat Details"
                        :columns="vatCol"
                        :data="vatTaxLevyList"
                        :theme="theme"
                        row-id="id"
                        label-key="name"
                        item-label="data"
                        item-label-plural="Vat"
                        add-label="Add"
                        :page-size="10"
                        :selectable="true"
                        :actions="true"
                    ></data-grid>
                </div>
            </section>
        </div>

    </div>
</div>

        </div>
                                            
</div>
                                

<script src="~/js/shared/vue3/company-profile.js" asp-append-version="true"></script>