@{
ViewBag.Title = "Quotations";
Layout = "~/Views/Shared/_adminArLayout.cshtml";
}

<div class="content">
    <div class="mb-6 content-header">
        <div class="flex items-center gap-2 text-sm text-gray-500 mb-2">
            <span>AR - Data Entry</span>
            <i class="bi bi-chevron-right text-xs"></i>
            <span class="text-blue-600 font-medium">Quotations</span>
        </div>
        <div class="flex items-center gap-3">
            <div class="page-title">
                <h2 class="text-2xl font-semibold text-gray-800">AR Quotations</h2>
            </div>
        </div>
    </div>

    <div id="app">
        <div class="card" data-card-title="Quotations">
            <div class="flex justify-end gap-1.5 mb-2 flex-wrap">
                <button type="button" @@click="createNewQuotation" class="border border-blue-600 text-blue-600 px-2.5 py-1.5 text-xs rounded-lg hover:bg-blue-600 hover:text-white">
                    <i class="bi bi-plus-lg mr-1"></i>New
                </button>
                <button type="button" @@click="setCurrentQuotation" class="border border-slate-500 text-slate-600 px-2.5 py-1.5 text-xs rounded-lg hover:bg-slate-600 hover:text-white">
                    <i class="bi bi-pencil-square mr-1"></i>Edit
                </button>
                <button type="button" @@click="deleteSelectedQuotations" class="border border-rose-600 text-rose-600 px-2.5 py-1.5 text-xs rounded-lg hover:bg-rose-600 hover:text-white">
                    <i class="bi bi-trash mr-1"></i>Delete
                </button>
                <button type="button" @@click="convertToInvoice" class="border border-emerald-600 text-emerald-600 px-2.5 py-1.5 text-xs rounded-lg hover:bg-emerald-600 hover:text-white">
                    <i class="bi bi-arrow-left-right mr-1"></i>Convert to Invoice
                </button>
                <button type="button" class="border border-sky-600 text-sky-600 px-2.5 py-1.5 text-xs rounded-lg hover:bg-sky-600 hover:text-white">
                    <i class="bi bi-printer mr-1"></i>Print
                </button>
            </div>

            <data-grid
                ref="quotations"
                title="Quotation List"
                :columns="quotationColumns"
                :data="quotationList"
                :child="quotationDetailChild"
                :theme="theme"
                row-id="id"
                label-key="quotationNumber"
                item-label="quotation"
                item-label-plural="quotations"
                :page-size="5"
                :selectable="true"
                :actions="false"
                data-density="compact"
                :allow-add="false"
                :allow-edit="false"
                :allow-delete="false"
                :loading="isShimmerLoading">
            </data-grid>

            <div id="add" class="my-5">
                <section id="quotation-editor" class="scroll-mt-4 rounded-xl p-4 sm:p-5">
                    <div class="mb-4 flex flex-wrap items-center justify-between gap-3">
                        <div>
                            <h2 class="text-base font-semibold text-slate-900">{{ isEditing ? 'Edit quotation' : 'New quotation' }}</h2>
                            <p v-if="quotationNumber" class="text-xs text-slate-500 mt-1">Ref: {{ quotationNumber }} <span v-if="isConvertedToInvoice" class="ml-2 inline-flex items-center rounded-full bg-emerald-100 px-2 py-0.5 text-xs font-medium text-emerald-700"><i class="bi bi-check-circle mr-1"></i>Converted to Invoice</span></p>
                        </div>
                        <span class="rounded-full bg-slate-100 px-3 py-1 text-xs font-medium text-slate-600">{{ quotationNumber || 'Quotation number assigned on save' }}</span>
                    </div>

                    <div v-if="formMessage" class="mb-4 rounded-lg border px-3 py-2 text-sm"
                         :class="formMessageType === 'error' ? 'border-rose-200 bg-rose-50 text-rose-700' : formMessageType === 'warning' ? 'border-amber-200 bg-amber-50 text-amber-800' : formMessageType === 'success' ? 'border-emerald-200 bg-emerald-50 text-emerald-800' : 'border-blue-200 bg-blue-50 text-blue-800'">
                        {{ formMessage }}
                    </div>

                    <div class="grid grid-cols-1 gap-4 sm:grid-cols-2 lg:grid-cols-4 my-4">
                        <w-select
                            @@change="onCustomerChange"
                            v-model="customerId"
                            :options="customers"
                            display-key="name"
                            value-key="id"
                            label="Customer:"
                            required>
                        </w-select>
                        <label class="label block text-sm font-medium text-slate-700 dark:text-white">Customer account no.
                            <input v-model="accountNumber" type="text" readonly class="input-control rounded-lg">
                        </label>
                        <w-select
                            @@change="onCurrencyChange"
                            v-model="currencyId"
                            :options="currencies"
                            display-key="currencyName"
                            value-key="id"
                            label="Currency:"
                            required></w-select>
                        <label class="label block text-sm font-medium text-slate-700 dark:text-white">Buy rate
                            <input v-model.number="buyRate" type="number" min="0" step="0.0001" class="input-control rounded-lg">
                        </label>

                        <label class="label block text-sm font-medium text-slate-700 dark:text-white">Quotation No.
                            <input v-model="quotationNumber" type="text" readonly placeholder="Assigned on save" class="input-control rounded-lg">
                        </label>
                        <label class="label block text-sm font-medium text-slate-700 dark:text-white">Quotation date <span class="text-rose-500">*</span>
                            <input v-model="quotationDate" type="date" required class="input-control rounded-lg">
                        </label>
                        <label class="label block text-sm font-medium text-slate-700 dark:text-white">Address
                            <input v-model.trim="address" type="text" class="input-control rounded-lg">
                        </label>
                        <label class="label block text-sm font-medium text-slate-700 dark:text-white">Quotation total
                            <input :value="totalQuotationAmount.toFixed(2)" type="number" readonly class="input-control rounded-lg">
                        </label>

                        <label class="label block text-sm font-medium text-slate-700 dark:text-white sm:col-span-2 lg:col-span-4">Notes
                            <textarea v-model.trim="notes" rows="2" placeholder="Notes / terms & conditions" class="input-control rounded-lg"></textarea>
                        </label>

                    
                        <label v-if="isEditing" class="label flex items-center gap-2 rounded-lg bg-slate-100 px-3 py-2.5 text-sm text-slate-700">
                            <input v-model="isConvertedToInvoice" type="checkbox" disabled class="input-control"> Converted to Invoice
                        </label>
                    </div>

                    <hr>
                    <section class="mt-5 rounded-xl p-4">
                        <div class="mb-4 flex items-start gap-3">
                            <div class="grid h-10 w-10 shrink-0 place-items-center rounded-lg bg-blue-100 text-blue-700 dark:bg-blue-500/30"><i class="bi bi-percent text-lg"></i></div>
                            <div>
                                <h3 class="text-sm font-semibold text-slate-800 dark:text-white">Tax levies</h3>
                                <p class="dark:text-white mt-1 text-xs text-slate-500">Toggle a levy to add or remove its calculated detail row.</p>
                            </div>
                        </div>
                        <div class="flex flex-col gap-5 lg:flex-row lg:items-end lg:justify-between">
                            <div class="min-w-0 flex-1">
                                <span class="dark:text-slate-200 mb-2 block text-sm font-medium text-slate-700">Applicable levies</span>
                                <div class="flex flex-wrap gap-2">
                                    <button v-for="tax in taxLevyList" :key="tax.id" type="button" @@click="toggleTaxLevy(tax.id)" :disabled="tax.isActive === false"
                                            :class="tax.isApplied ? 'border-blue-600 bg-blue-600 text-white hover:bg-blue-700' : 'border-slate-300 bg-white text-slate-700 hover:border-blue-400 hover:bg-blue-50 dark:bg-transparent dark:text-blue-50'"
                                            class="inline-flex items-center gap-2 rounded-lg border px-3 py-2 text-sm font-medium transition disabled:cursor-not-allowed disabled:opacity-50">
                                        <i :class="tax.isApplied ? 'bi bi-check-circle-fill' : 'bi bi-plus-circle'"></i>
                                        <span>{{ tax.name }}</span>
                                        <span class="rounded bg-black/5 px-1.5 py-0.5 text-xs">{{ tax.rate.toFixed(2) }}%</span>
                                    </button>
                                </div>
                            </div>
                        </div>
                        <div v-if="computedTaxLevies.length" class="mt-4 flex flex-wrap items-center gap-2 border-t border-slate-200 pt-3">
                            <span class="text-xs font-medium text-slate-500">Applied:</span>
                            <span v-for="tax in computedTaxLevies" :key="tax.id" class="rounded-full bg-blue-100 px-2.5 py-1 text-xs font-medium text-blue-800">{{ tax.name }} {{ formatMoney(tax.amount) }}</span>
                        </div>
                    </section>

                    <section class="mt-5">
                        <div class="mb-3 flex flex-wrap items-end justify-between gap-3">
                            <div>
                                <h3 class="text-base font-semibold text-slate-900">Quotation details</h3>
                            </div>
                            <div class="text-right text-sm text-slate-600">
                                <div>Subtotal: <strong>{{ formatMoney(detailsList.filter(r => !r.isTax).reduce((s,r)=> s + Number(r.subTotal||0),0)) }}</strong></div>
                                <div>Tax: <strong>{{ formatMoney(computedTaxLevies.reduce((s,t)=> s + Number(t.amount||0),0)) }}</strong></div>
                            </div>
                        </div>
                        <data-grid
                            ref="quotationDetails"
                            title="Quotation Details"
                            :columns="detailColumns"
                            :data="detailsList"
                            :theme="theme1"
                            row-id="id"
                            label-key="description"
                            item-label="quotation detail"
                            item-label-plural="quotation details"
                            add-label="Add Detail"
                            :page-size="10"
                            :selectable="true"
                            :actions="true"
                            :allow-add="true"
                            :allow-edit="true"
                            :allow-delete="true"
                            data-density="compact"
                            @@create="onCreateDetail"
                            @@update="onUpdateDetail"
                            @@delete="onDeleteDetail"
                            :loading="isShimmerLoading">
                        </data-grid>
                    </section>

                    <div class="mt-5 flex flex-wrap justify-end gap-2 border-t border-slate-200 pt-4">
                        <button type="button" @@click="createNewQuotation" class="rounded-lg border border-slate-300 px-4 py-2 text-sm font-medium text-slate-700 hover:bg-slate-50">Clear / New</button>
                        <button type="button" @@click="saveQuotation" class="rounded-lg bg-blue-600 px-5 py-2 text-sm font-semibold text-white hover:bg-blue-700"><i class="bi bi-check-lg mr-1"></i>{{ isEditing ? 'Update quotation' : 'Save quotation' }}</button>
                    </div>
                </section>
            </div>
        </div>
    </div>
</div>

<script src="~/js/ar/DataEntry/quotations.js" asp-append-version="true"></script>
