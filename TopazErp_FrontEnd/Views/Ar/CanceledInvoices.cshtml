@{
    ViewBag.Title = "Canceled Invoices";
    Layout = "~/Views/Shared/_adminArLayout.cshtml";
}
<div class="content">
    <div class="mb-6 content-header">
        <div class="flex items-center gap-2 text-sm text-gray-500 mb-2">
            <span>AR - Enquiries</span>
            <i class="bi bi-chevron-right text-xs"></i>
            <span class="text-blue-600 font-medium">Canceled Invoices</span>
        </div>

        <div class="flex items-center gap-3">

            <div class="page-title">
                <h2 class="text-2xl font-semibold text-gray-800">
                    Enquiries
                </h2>
                
            </div>
        </div>
    </div>
    <div id="app" class="card" data-card-title="Canceled Invoices">
        <data-grid
            ref="invoices"
            title="Canceled Invoices"
            :columns="invoiceColumns"
            :data="invoiceList"
            :child="detailColumns"
            :theme="theme"
            row-id="id"
            label-key="invoiceNumber"
            item-label="invoice"
            item-label-plural="invoices"
            :page-size="10"
            :selectable="true"
            :actions="false"
            :allow-add="false"
            :allow-edit="false"
            :allow-delete="false"
            group-header="currencyId">
        </data-grid>
    </div>
</div>


<script src="~/js/ar/enquiries/canceled-invoices.js" asp-append-version="true"></script>
