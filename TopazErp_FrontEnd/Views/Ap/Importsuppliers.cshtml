@{
    ViewBag.Title = "ImportSuppliers";
    Layout = "~/Views/Shared/_adminApLayout.cshtml";
}
<div class="content">
    <div class="mb-6 content-header">
        <div class="flex items-center gap-2 text-sm text-gray-500 mb-2">
            <span>AP - Imports</span>
            <i class="bi bi-chevron-right text-xs"></i>
            <span class="text-blue-600 font-medium">Aging</span>
        </div>

        <div class="flex items-center gap-3">

            <div class="page-title">
                <h2 class="text-2xl font-semibold text-gray-800">
                    Suppliers
                </h2>
                
            </div>
        </div>
    </div>
    <div id="app" class="card" data-card-title="Import Suppliers">
    <div class="grid grid-cols-1 items-end gap-5 sm:grid-cols-2 lg:grid-cols-3">

    <!-- File Upload -->
    <div class="space-y-2">
        <label class="flex flex-wrap items-center gap-2 text-sm font-semibold text-slate-700 dark:text-slate-200">
            Choose File:
            <a href="@Url.Action("DownloadSuppliersUploadSample", "Ap")"
               class="inline-flex items-center gap-1 font-semibold text-blue-600 transition-colors hover:text-blue-700 hover:underline dark:text-blue-400 dark:hover:text-blue-300">
                <i class="la la-download"></i>
                Download Template
            </a>
        </label>

        <input
            type="file"
            @@change="onFileUpload"
            required
            class="block w-full cursor-pointer rounded-lg border border-slate-300 bg-white text-sm text-slate-700 shadow-sm transition-colors
                   file:mr-4 file:cursor-pointer file:border-0 file:bg-slate-100 file:px-4 file:py-2.5 file:text-sm file:font-semibold file:text-slate-700
                   hover:file:bg-slate-200
                   focus:outline-none focus:ring-2 focus:ring-blue-500 focus:ring-offset-1
                   dark:border-slate-600 dark:bg-slate-800 dark:text-slate-200
                   dark:file:bg-slate-700 dark:file:text-slate-200 dark:hover:file:bg-slate-600
                   dark:focus:ring-offset-slate-900" />
    </div>

    <!-- Import Button -->
    <div class="flex items-center sm:pb-0">
        <button
            type="button"
            :disabled="hasErrors || previewData.length === 0"
            @@click="importData"
            class="inline-flex items-center justify-center gap-2 rounded-lg bg-blue-600 px-5 py-2.5 text-sm font-semibold text-white shadow-sm transition-all
                   hover:bg-blue-700 focus:outline-none focus:ring-2 focus:ring-blue-500 focus:ring-offset-2
                   disabled:cursor-not-allowed disabled:opacity-50 disabled:shadow-none
                   dark:focus:ring-offset-slate-900">
            <i class="la la-file-import text-base"></i>
            Import
        </button>
    </div>

</div>
        <div class="w-full">
    <!-- Import Summary -->
    <div class="mb-4 flex flex-wrap items-center gap-2">
        <span class="text-sm font-semibold text-slate-700 dark:text-slate-200">
            Total Import Rows:
        </span>

        <span class="inline-flex items-center rounded-full bg-emerald-100 px-2.5 py-1 text-xs font-semibold text-emerald-700 dark:bg-emerald-900/40 dark:text-emerald-300">
            {{ previewData?.length || 0 }}
        </span>
    </div>

    <!-- Table -->
    <div class="w-full overflow-x-auto rounded-xl border border-slate-200 bg-white shadow-sm dark:border-slate-700 dark:bg-slate-900">
        <table class="w-full min-w-[2600px] border-collapse text-left text-sm">
            <thead class="bg-slate-100 text-xs uppercase tracking-wide text-slate-600 dark:bg-slate-800 dark:text-slate-300">
                <tr>
                    <th class="w-[60px] whitespace-nowrap px-4 py-3 font-semibold">No.</th>
                    <th class="min-w-[250px] whitespace-nowrap px-4 py-3 font-semibold">Name</th>
                    <th class="min-w-[150px] whitespace-nowrap px-4 py-3 font-semibold">Account No</th>
                    <th class="min-w-[200px] whitespace-nowrap px-4 py-3 font-semibold">Email</th>
                    <th class="min-w-[150px] whitespace-nowrap px-4 py-3 font-semibold">Phone</th>
                    <th class="min-w-[200px] whitespace-nowrap px-4 py-3 font-semibold">Address</th>
                    <th class="min-w-[150px] whitespace-nowrap px-4 py-3 text-right font-semibold">Balance</th>
                    <th class="min-w-[200px] whitespace-nowrap px-4 py-3 font-semibold">Currency</th>
                    <th class="min-w-[140px] whitespace-nowrap px-4 py-3 font-semibold">Group</th>
                    <th class="min-w-[140px] whitespace-nowrap px-4 py-3 text-right font-semibold">Credit Limit</th>
                    <th class="min-w-[250px] whitespace-nowrap px-4 py-3 font-semibold">Credit GL</th>
                    <th class="min-w-[250px] whitespace-nowrap px-4 py-3 font-semibold">Debit GL</th>
                    <th class="min-w-[250px] whitespace-nowrap px-4 py-3 font-semibold">IRS GL</th>
                    <th class="min-w-[250px] whitespace-nowrap px-4 py-3 font-semibold">VAT GL</th>
                    <th class="min-w-[150px] whitespace-nowrap px-4 py-3 font-semibold">VAT No</th>
                    <th class="min-w-[150px] whitespace-nowrap px-4 py-3 font-semibold">Status</th>
                </tr>
            </thead>

            <tbody class="divide-y divide-slate-200 dark:divide-slate-700">
                <template v-for="(row, index) in paginatedData" :key="index">
                    <tr class="transition-colors hover:bg-blue-50/60 dark:hover:bg-slate-800/70">
                        <td class="whitespace-nowrap px-4 py-3 text-slate-500 dark:text-slate-400">
                            {{ (currentPage - 1) * pageSize + index + 1 }}
                        </td>

                        <td class="px-4 py-3 font-medium text-slate-900 dark:text-slate-100">
                            {{ row.name }}
                        </td>

                        <td class="whitespace-nowrap px-4 py-3 text-slate-600 dark:text-slate-300">
                            {{ row.accountNumber }}
                        </td>

                        <td class="px-4 py-3 text-slate-600 dark:text-slate-300">
                            {{ row.email }}
                        </td>

                        <td class="whitespace-nowrap px-4 py-3 text-slate-600 dark:text-slate-300">
                            {{ row.phoneNo }}
                        </td>

                        <td class="px-4 py-3 text-slate-600 dark:text-slate-300">
                            {{ row.address }}
                        </td>

                        <td class="whitespace-nowrap px-4 py-3 text-right font-medium tabular-nums text-slate-800 dark:text-slate-200">
                            {{ row.balance.toLocaleString(undefined, {
                                minimumFractionDigits: 2,
                                maximumFractionDigits: 2
                            }) }}
                        </td>

                        <td class="whitespace-nowrap px-4 py-3 text-slate-600 dark:text-slate-300">
                            {{ row.currencyName }}
                        </td>

                        <td class="px-4 py-3 text-slate-600 dark:text-slate-300">
                            {{ row.supplierGroupName }}
                        </td>

                        <td class="whitespace-nowrap px-4 py-3 text-right font-medium tabular-nums text-slate-800 dark:text-slate-200">
                            {{ row.creditLimit.toLocaleString(undefined, {
                                minimumFractionDigits: 2,
                                maximumFractionDigits: 2
                            }) }}
                        </td>

                        <td class="px-4 py-3 text-slate-600 dark:text-slate-300">
                            {{ row.creditAccountName }}
                        </td>

                        <td class="px-4 py-3 text-slate-600 dark:text-slate-300">
                            {{ row.debitAccountName }}
                        </td>

                        <td class="px-4 py-3 text-slate-600 dark:text-slate-300">
                            {{ row.irsAccountName }}
                        </td>

                        <td class="px-4 py-3 text-slate-600 dark:text-slate-300">
                            {{ row.vatAccountName }}
                        </td>

                        <td class="whitespace-nowrap px-4 py-3 text-slate-600 dark:text-slate-300">
                            {{ row.vatNumber }}
                        </td>

                        <td class="whitespace-nowrap px-4 py-3">
                            <span
                                class="inline-flex items-center rounded-full px-2.5 py-1 text-xs font-semibold"
                                :class="row.status?.trim().toLowerCase() === 'active'
                                    ? 'bg-emerald-100 text-emerald-700 dark:bg-emerald-900/40 dark:text-emerald-300'
                                    : 'bg-slate-100 text-slate-600 dark:bg-slate-700 dark:text-slate-300'">
                                {{ row.status }}
                            </span>
                        </td>
                    </tr>

                    <!-- Validation Errors -->
                    <tr v-if="row.errors && row.errors.length">
                        <td colspan="16" class="border-b border-red-200 bg-red-50 px-4 py-4 dark:border-red-900/60 dark:bg-red-950/30">
                            <div class="flex items-start gap-3">
                                <div class="mt-0.5 flex h-8 w-8 shrink-0 items-center justify-center rounded-lg bg-red-100 text-red-600 dark:bg-red-900/50 dark:text-red-300">
                                    <i class="la la-exclamation-triangle text-lg"></i>
                                </div>

                                <div class="min-w-0">
                                    <p class="mb-2 text-sm font-semibold text-red-800 dark:text-red-300">
                                        Import issues for {{ row.name || 'this row' }}
                                    </p>

                                    <ul class="list-inside list-disc space-y-1 text-sm text-red-700 dark:text-red-300">
                                        <li v-for="(e, errorIndex) in row.errors" :key="errorIndex">
                                            {{ e }}
                                        </li>
                                    </ul>
                                </div>
                            </div>
                        </td>
                    </tr>
                </template>

                <!-- Empty State -->
                <tr v-if="!paginatedData || paginatedData.length === 0">
                    <td colspan="16" class="px-6 py-12 text-center">
                        <div class="flex flex-col items-center gap-2">
                            <i class="la la-file-import text-3xl text-slate-400"></i>
                            <p class="text-sm font-semibold text-slate-700 dark:text-slate-200">
                                No import data available
                            </p>
                            <p class="text-xs text-slate-500 dark:text-slate-400">
                                Upload a file to preview the records here.
                            </p>
                        </div>
                    </td>
                </tr>
            </tbody>
        </table>
    </div>

    <!-- Pagination -->
    <div class="mt-4 flex flex-col gap-3 sm:flex-row sm:items-center sm:justify-between">
        <p class="text-sm text-slate-500 dark:text-slate-400">
            Page
            <span class="font-semibold text-slate-700 dark:text-slate-200">{{ currentPage }}</span>
            of
            <span class="font-semibold text-slate-700 dark:text-slate-200">{{ totalPages }}</span>
        </p>

        <nav class="flex flex-wrap items-center justify-end gap-1" aria-label="Table pagination">
            <!-- Previous -->
            <button
                type="button"
                @@click="currentPage = Math.max(1, currentPage - 1)"
                :disabled="currentPage === 1"
                class="inline-flex items-center gap-1 rounded-lg border border-slate-200 bg-white px-3 py-2 text-sm font-medium text-slate-600 transition-colors hover:bg-slate-50 disabled:cursor-not-allowed disabled:opacity-40 dark:border-slate-700 dark:bg-slate-900 dark:text-slate-300 dark:hover:bg-slate-800">
                <i class="la la-angle-left"></i>
                Prev
            </button>

            <!-- Page Numbers -->
            <button
                v-for="p in paginationPages"
                :key="p"
                type="button"
                @@click="currentPage = p"
                :aria-current="currentPage === p ? 'page' : null"
                :class="currentPage === p
                    ? 'border-blue-600 bg-blue-600 text-white shadow-sm'
                    : 'border-slate-200 bg-white text-slate-600 hover:bg-slate-50 dark:border-slate-700 dark:bg-slate-900 dark:text-slate-300 dark:hover:bg-slate-800'"
                class="min-w-9 rounded-lg border px-3 py-2 text-sm font-medium transition-colors">
                {{ p }}
            </button>

            <!-- Next -->
            <button
                type="button"
                @@click="currentPage = Math.min(totalPages, currentPage + 1)"
                :disabled="currentPage === totalPages || totalPages === 0"
                class="inline-flex items-center gap-1 rounded-lg border border-slate-200 bg-white px-3 py-2 text-sm font-medium text-slate-600 transition-colors hover:bg-slate-50 disabled:cursor-not-allowed disabled:opacity-40 dark:border-slate-700 dark:bg-slate-900 dark:text-slate-300 dark:hover:bg-slate-800">
                Next
                <i class="la la-angle-right"></i>
            </button>
        </nav>
    </div>
</div>
       
    </div>
</div>
<script src="~/js/ap/Imports/suppliers.js" asp-append-version="true"></script>