@{
    ViewBag.Title = "Invoices";
    Layout = "~/Views/Shared/_adminApLayout.cshtml";
}

<div class="content">
    <div class="mb-6 content-header">
        <div class="flex items-center gap-2 text-sm text-gray-500 mb-2">
            <span>AP - Data Entry</span>
            <i class="bi bi-chevron-right text-xs"></i>
            <span class="text-blue-600 font-medium">Invoices</span>
        </div>
    </div>

    <div id="app" class="space-y-6">
            <div class="card" data-card-title="Invoices">
                <div class="flex justify-end gap-2 mb-2 flex-wrap">
                  <button type="button" @@click="createNewInvoice" class="border border-green-500 text-green-500 px-4 py-2 rounded-xl hover:bg-green-500 hover:text-white"><i class="bi bi-plus-lg mr-1"></i>New</button>
                  <button type="button" @@click="setCurrentInvoice" class="border border-blue-800 text-blue-800 px-4 py-2 rounded-xl hover:bg-blue-800 hover:text-white"><i class="bi bi-pencil-square mr-1"></i>Edit</button>
                  <button type="button" @@click="cancelSelectedInvoices" class="border border-rose-500 text-rose-500 px-4 py-2 rounded-xl hover:bg-red-500 hover:text-white"><i class="bi bi-x-circle mr-1"></i>Cancel</button>
                  <button type="button" @@click="postSelectedInvoices" class="border border-blue-500 text-blue-500 px-4 py-2 rounded-xl hover:bg-blue-500 hover:text-white"><i class="bi bi-send mr-1"></i>Post</button>
                  <button @@click="printReport" class="border border-indigo-500 text-indigo-500 px-4 py-2 rounded-xl hover:bg-indigo-500 hover:text-white"> <i class="bi bi-printer"></i> Print </button>
        
                </div>
                
                <data-grid
                    ref="invoices"
                    title="Invoices"
                    :columns="invoiceColumns"
                    :data="invoiceList"
                    :child="invoiceDetailChild"
                    :theme="theme"
                    row-id="id"
                    label-key="invoiceNumber"
                    item-label="invoice"
                    item-label-plural="invoices"
                    :page-size="5"
                    :selectable="true"
                    :actions="false"
                    :allow-add="false"
                    :allow-edit="false"
                    :allow-delete="false">
                </data-grid>
                
                <div id="add" class="my-5">
                    <section id="invoice-editor" class="scroll-mt-4 rounded-xl p-4 sm:p-5">
        <div class="mb-4 flex flex-wrap items-center justify-between gap-3">
          <div>
            <h2 class="text-base font-semibold text-slate-900">{{ isEditing ? 'Edit invoice' : 'New invoice' }}</h2>
        
          </div>
          <span class="rounded-full bg-slate-100 px-3 py-1 text-xs font-medium text-slate-600">{{ invoiceNumber || 'Invoice number assigned on save' }}</span>
        </div>

        <div v-if="formMessage" class="mb-4 rounded-lg border px-3 py-2 text-sm"
          :class="formMessageType === 'error' ? 'border-rose-200 bg-rose-50 text-rose-700' : formMessageType === 'warning' ? 'border-amber-200 bg-amber-50 text-amber-800' : formMessageType === 'success' ? 'border-emerald-200 bg-emerald-50 text-emerald-800' : 'border-blue-200 bg-blue-50 text-blue-800'">
          {{ formMessage }}
        </div>

        <div class="grid grid-cols-1 gap-4 sm:grid-cols-2 lg:grid-cols-4 my-4">
         <label  class="label block text-sm font-medium text-slate-700 dark:text-white">Supplier <span class="text-rose-500">*</span>
           
            <select v-model="supplierId" @@change="onSupplierChange" required
            class="select">
              <option value="" class="bg-white text-slate-500 dark:bg-slate-800 dark:text-slate-400">
                Select supplier…
              </option>
              <option
                v-for="supplier in suppliers"
                :key="supplier.id"
                :value="supplier.id"
                class="bg-white text-slate-900 dark:bg-slate-800 dark:text-slate-100"
              >
                {{ supplier.name }}
              </option>
            </select>

          </label>
         <label  class="label block text-sm font-medium text-slate-700 dark:text-white">Supplier account no.
            <input v-model="accountNumber" type="text" readonly class="input-control rounded-lg">
          </label>
      
         <label  class="label block text-sm font-medium text-slate-700 dark:text-white">Currency <span class="text-rose-500">*</span>
            <select v-model="currencyId" @@change="onCurrencyChange" required class="select">
              <option value="">Select currency…</option>
              <option v-for="currency in currencies" :key="currency.id" :value="currency.id">{{ currency.name }}</option>
            </select>
          </label>
         <label  class="label block text-sm font-medium text-slate-700 dark:text-white">Buy rate
            <input v-model.number="buyRate" type="number" min="0" step="0.0001" class="input-control rounded-lg">
          </label>
         <label  class="label flex items-center gap-2 self-end rounded-lg select">
            <input v-model="isMultiCurrency" type="checkbox" disabled class="input-control rounded-lg"> Is multi-currency
          </label>

         <label  class="label block text-sm font-medium text-slate-700 dark:text-white">Invoice no.
            <input :value="invoiceNumber || 'Assigned on save'" type="text" readonly class="input-control rounded-lg">
          </label>
         <label  class="label block text-sm font-medium text-slate-700 dark:text-white">Invoice date <span class="text-rose-500">*</span>
            <input v-model="invoiceDate" type="date" required class="input-control rounded-lg">
          </label>
         <label  class="label block text-sm font-medium text-slate-700 dark:text-white">Projected pay date <span class="text-rose-500">*</span>
            <input v-model="projectedPayDate" type="date" required class="input-control rounded-lg">
          </label>
         <label  class="label block text-sm font-medium text-slate-700 dark:text-white">Voucher no.
            <input v-model.trim="voucherNumber" type="text" class="input-control rounded-lg">
          </label>

         <label  class="label block text-sm font-medium text-slate-700 dark:text-white">Purchase order no.
            <input v-model.trim="purchaseOrderNumber" type="text" class="input-control rounded-lg">
          </label>
        
         <label  class="label block text-sm font-medium text-slate-700 dark:text-white">OU / cost centre
            <select v-model="ouId" @@change="onOuChange" class="select">
              <option value="">Select OU…</option>
              <option v-for="unit in organizationalUnits" :key="unit.id" :value="unit.id">{{ unit.name }}</option>
            </select>
          </label>
         <label  class="label block text-sm font-medium text-slate-700 dark:text-white">Liability G/L
            <select v-model="liabilityAccountId" @@change="onLiabilityAccountChange" class="select">
              <option value="">Select account…</option>
              <option v-for="account in accounts" :key="account.id" :value="account.id">{{ account.accountIdentifier }}</option>
            </select>
          </label>

         <label  class="label block text-sm font-medium text-slate-700 dark:text-white">Batch no.
            <input v-model="batchNumber" type="text" readonly placeholder="Assigned on save" class="input-control rounded-lg">
          </label>
      
         <label  class="label block text-sm font-medium text-slate-700 dark:text-white">Invoice total
            <input :value="totalInvoiceAmount.toFixed(2)" type="number" readonly class="input-control rounded-lg">
          </label>
         <label  class="label block text-sm font-medium text-slate-700 dark:text-white">Balance
            <input :value="invoiceBalance.toFixed(2)" type="number" readonly class="input-control rounded-lg">
          </label>

        </div>
                      <hr>
        <section class="mt-5 rounded-xl p-4">
          <div class="mb-4 flex items-start gap-3">
            <div class="grid h-10 w-10 shrink-0 place-items-center rounded-lg bg-blue-100 text-blue-700 dark:bg-blue-500/30"><i class="bi bi-percent text-lg"></i></div>
            <div>
              <h3 class="text-sm font-semibold text-slate-800 dark:text-white">Tax levies</h3>
              <p class="dark:text-white mt-1 text-xs text-slate-500">Toggle a levy to add or remove its calculated detail row. Each levy below is calculated on the pre-tax detail subtotal.</p>
            </div>
          </div>
          <div class="flex flex-col gap-5 lg:flex-row lg:items-end lg:justify-between">
            <div class="min-w-0 flex-1">
              <span class="dark:text-slate-200 mb-2 block text-sm font-medium text-slate-700">Applicable levies</span>
              <div class="flex flex-wrap gap-2">
                <button v-for="tax in taxLevyList" :key="tax.id" type="button" @@click="toggleTaxLevy(tax.id)" :disabled="isVatInclusive || tax.isActive === false" :aria-pressed="tax.isApplied"
                  :class="tax.isApplied ? 'border-blue-600 bg-blue-600 text-white hover:bg-blue-700 dark:bg-blue-950' : 'border-slate-300 bg-white text-slate-700 hover:border-blue-400 hover:bg-blue-50 dark:bg-transparent dark:text-blue-50'"
                  class="inline-flex items-center gap-2 rounded-lg border px-3 py-2 text-sm font-medium transition disabled:cursor-not-allowed disabled:opacity-50">
                  <i :class="tax.isApplied ? 'bi bi-check-circle-fill' : 'bi bi-plus-circle'"></i>
                  <span>{{ tax.name }}</span>
                  <span class="rounded bg-black/5 px-1.5 py-0.5 text-xs" :class="tax.isApplied ? 'bg-white/20' : ''">{{ (tax.type === 'vat' ? vatRate : tax.rate).toFixed(2) }}</span>
                </button>
              </div>
            </div>
           <label  class="label block w-full text-sm font-medium text-slate-700 lg:max-w-56 dark:text-gray-50">VAT rate
              <div class="relative mt-1">
                <input v-model.number="vatRate" type="number" min="0" max="100" step="0.01" :disabled="isVatInclusive" class="input-control">
                <span class="pointer-events-none absolute inset-y-0 right-3 flex items-center text-slate-400">%</span>
              </div>
            </label>
           <label  class="label flex items-center gap-2 rounded-lg border border-slate-200 bg-white px-3 py-2.5 text-sm text-slate-700 dark:bg-transparent">
              <input v-model="isVatInclusive" type="checkbox" class="input-control" disabled>
              VAT-inclusive pricing
            </label>
          </div>
          <div v-if="computedTaxLevies.length" class="mt-4 flex flex-wrap items-center gap-2 border-t border-slate-200 pt-3">
            <span class="text-xs font-medium text-slate-500">Applied:</span>
            <span v-for="tax in computedTaxLevies" :key="tax.id" class="rounded-full bg-blue-100 px-2.5 py-1 text-xs font-medium text-blue-800">{{ tax.name }} {{ formatMoney(tax.amount) }}</span>
          </div>
          <p v-if="isVatInclusive" class="mt-3 text-xs text-amber-700"><i class="bi bi-info-circle mr-1"></i>Separate levy rows are disabled while VAT-inclusive pricing is on.</p>
        </section>

        <section class="mt-5">
          <div class="mb-3 flex flex-wrap items-end justify-between gap-3">
            <div>
              <h3 class="text-base font-semibold text-slate-900">Invoice details</h3>
             </div>
            <div class="text-right text-sm text-slate-600">
              <div>Subtotal: <strong>{{ formatMoney(detailsList.filter(row => !row.isTax).reduce((sum, row) => sum + Number(row.subTotal || 0), 0)) }}</strong></div>
              <div>Tax: <strong>{{ formatMoney(computedTaxLevies.reduce((sum, tax) => sum + Number(tax.amount || 0), 0)) }}</strong></div>
            </div>
          </div>
          <data-grid
            ref="invoiceDetails"
            title="Invoice Details"
            :columns="detailColumns"
            :data="detailsList"
            :theme="theme1"
            row-id="id"
            label-key="description"
            item-label="invoice detail"
            item-label-plural="invoice details"
            add-label="Add Detail"
            :page-size="10"
            :selectable="true"
            :actions="true"
            :allow-add="true"
            :allow-edit="true"
            :allow-delete="true"
            @@create="onCreateDetail"
            @@update="onUpdateDetail"
            @@delete="onDeleteDetail">
          </data-grid>
        </section>

        <div class="mt-5 flex flex-wrap justify-end gap-2 border-t border-slate-200 pt-4">
          <button type="button" @@click="createNewInvoice" class="rounded-lg border border-slate-300 px-4 py-2 text-sm font-medium text-slate-700 hover:bg-slate-50">Clear / New</button>
          <button type="button" @@click="saveInvoice" class="rounded-lg bg-blue-600 px-5 py-2 text-sm font-semibold text-white hover:bg-blue-700"><i class="bi bi-check-lg mr-1"></i>Save invoice</button>
        </div>
      </section>
                    </div>
               
            </div>
        </div>
        </div>



<script src="~/js/ap/DataEntry/invoices.js" asp-append-version="true"></script>

