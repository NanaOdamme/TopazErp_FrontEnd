@{
    ViewBag.Title = "Invoices";
    Layout = "~/Views/Shared/_adminApLayout.cshtml";
}
<div class="content">
    <div class="mb-6 content-header">
        <div class="flex items-center gap-2 text-sm text-gray-500 mb-2">
            <span>AP - Reports</span>
            <i class="bi bi-chevron-right text-xs"></i>
            <span class="text-blue-600 font-medium">Invoices</span>
        </div>

        <div class="flex items-center gap-3">

            <div class="page-title">
                <h2 class="text-2xl font-semibold text-gray-800">
                    Invoices
                </h2>
                
            </div>
        </div>
    </div>
    <div id="app" class="card" data-card-title="Reports - Invoices">

       
        <div class="grid grid-cols-1 gap-5 sm:grid-cols-2 xl:grid-cols-4 mb-5">
            <label  class="label block text-sm">
                Select Report Type: <select class="select" v-model="reportType" ref="reportType">
                    <option value="summary-report"> All </option>
                    <option value="bySupplier"> By Supplier </option>
                    <option value="byInvoiceNumber"> By Invoice Number </option>
                    <option value="byDate"> By Date </option>
                    <option value="byInvoiceRange"> By Range</option>
                </select></label>
            <w-select v-show="reportType == 'bySupplier'"
                @@change="getReportData"
                v-model="supplierId"
                :options="supplierList"
                display-key="name"
                value-key="id"
                label="Supplier:"
            >
            </w-select>
        
            <w-select v-show="reportType == 'byInvoiceNumber'"
                @@change="getReportData"
                v-model="invoiceNumber"
                :options="invoiceList"
                display-key="invoiceNumber"
                value-key="invoiceNumber"
                label="Invoice Number:"
            >
        
            </w-select>
            <label v-show="reportType == 'byInvoiceRange'" class="label block text-sm">
                Start Number: <input v-model="startNumber" ref="startNumber" type="number" class="input-control" />
            </label>
            <label v-show="reportType == 'byInvoiceRange'" class="label block text-sm">
                End Number: <input v-model="endNumber" ref="endNumber" type="number" class="input-control" />
            </label>
            <label v-show="reportType == 'byDate'" class="label block text-sm">
                Start Date: <input id="startDate" v-model="startDate"  type="date" class="input-control" />
            </label>
            <label v-show="reportType == 'byDate'" class="label block text-sm">
                End Date: <input id="endDate" v-model="endDate"  type="date" class="input-control" />
            </label>
        </div>
        <!-- Generate Report -->
        <div class="flex justify-end mb-5">
            <button type="button"
                    @@click="getReportData"
                    :disabled="isLoading"
                    class="bg-blue-600 text-white px-4 py-2 rounded-lg hover:bg-blue-700 disabled:opacity-50 disabled:cursor-not-allowed">
                <span v-if="isLoading">
                    <i class="las la-spinner la-spin mr-1"></i>
                    Generating...
                </span>
                <span v-else>
                    <i class="las la-file-alt mr-1"></i>
                    Generate Report
                </span>
            </button>
        </div>

        <hr class="my-4">
        <div class="w-full mt-6" style="height: 1000px;">
            <div style="height: 820px;" v-if="showReport">
                <pdf-viewer :src="reportPath"
                            :data="reportData"
                            :color="viewerColor"
                            :title="reportTitle"></pdf-viewer>
            </div>

        </div>
      
    </div>
</div>
<script src="~/js/ap/Reports/invoices.js" asp-append-version="true"></script>