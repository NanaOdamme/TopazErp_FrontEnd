@{
    ViewBag.Title = "ImportOpeningBalance";
    Layout = "~/Views/Shared/_adminApLayout.cshtml";
}
<div class="content">
    <div class="mb-6 content-header">
        <div class="flex items-center gap-2 text-sm text-gray-500 mb-2">
            <span>AP - Emails</span>
            <i class="bi bi-chevron-right text-xs"></i>
            <span class="text-blue-600 font-medium">Invoices</span>
        </div>

        <div class="flex items-center gap-3">

            <div class="page-title">
                <h2 class="text-2xl font-semibold text-gray-800">
                    Email Invoices
                </h2>
                
            </div>
        </div>
    </div>
    <div id="app" class="card" data-card-title="Emails Invoices">
        <div class="flex justify-end gap-2 mb-2 flex-wrap">
            <button type="button" @@click="sendEmails" class="border border-blue-500 text-blue-500 px-4 py-2 rounded-xl hover:bg-blue-500 hover:text-white"><i class="bi bi-send"></i>Send Email</button>
        
        </div>
        <data-grid
            ref="invoices"
            title="Invoices"
            :columns="invoiceColumns"
            :data="invoiceList"
            :child="invoiceDetailChild"
            :theme="theme"
            row-id="id"
            label-key="invoiceNumber"
            item-label="invoice"
            item-label-plural="invoices"
            :page-size="5"
            :selectable="true"
            :actions="false"
            :allow-add="false"
            :allow-edit="false"
            :allow-delete="false">
        </data-grid>
    </div>
</div>
<script src="~/js/ap/Email/invoices.js" asp-append-version="true"></script>
