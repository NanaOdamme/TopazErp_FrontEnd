@{
ViewBag.Title = "Suppliers";
Layout = "~/Views/Shared/_adminApLayout.cshtml";
}
<style>
    #add {
        scroll-margin-top: 80px;
    }
</style>

<div class="content">
    <div class="mb-6 content-header">
        <div class="flex items-center gap-2 text-sm text-gray-500 mb-2">
            <span>AP - Shared Resources</span>
            <i class="bi bi-chevron-right text-xs"></i>
            <span class="text-blue-600 font-medium">Suppliers</span>
        </div>
    </div>

    <div id="app" class="space-y-6">
        <div class="card" data-card-title="Suppliers">

            <!-- Toolbar -->
            <div class="flex justify-end gap-1.5 mb-2 flex-wrap">
                <button type="button" @@click="newSupplier"
                        class="border border-blue-600 text-blue-600 px-2.5 py-1.5 text-xs rounded-lg hover:bg-blue-600 hover:text-white">
                    <i class="bi bi-plus-lg mr-1"></i>New
                </button>
                <button type="button" @@click="setCurrentSupplier()"
                        class="border border-slate-500 text-slate-600 px-2.5 py-1.5 text-xs rounded-lg hover:bg-slate-600 hover:text-white">
                    <i class="bi bi-pencil-square mr-1"></i>Edit
                </button>
                <button type="button" @@click="deleteSelectedSuppliers"
                        class="border border-rose-600 text-rose-600 px-2.5 py-1.5 text-xs rounded-lg hover:bg-rose-600 hover:text-white">
                    <i class="bi bi-trash mr-1"></i>Delete
                </button>
            </div>

            <div id="supplierApp">
                <data-grid
                    ref="suppliersGrid"
                    title="Suppliers"
                    :columns="supplierColumns"
                    :data="suppliers"
                    :theme="theme"
                    row-id="id"
                    label-key="name"
                    storage-key="ap-supplier-register"
                    item-label="supplier"
                    item-label-plural="suppliers"
                    add-label="Add Supplier"
                    :page-size="10"
                    :selectable="true"
                    :allow-add="false" :allow-edit="false" :allow-delete="false"
            
                    :loading="isShimmerLoading">
                </data-grid>

                <div id="add" class="my-5">
                    <p class="my-4 text-blue-500">Add / Update</p>

                    <form ref="supplierForm" class="supplierForm">
                        <!-- ============================================================
                             BASIC INFORMATION
                             ============================================================ -->
                        <div class="grid grid-cols-1 gap-5 sm:grid-cols-2 lg:grid-cols-4 my-4">

                            <!-- Account Number -->
                            <div>
                                <label for="accountNumber" class="label mb-1.5 block text-sm font-semibold text-gray-700">
                                    Account No.: <span class="text-red-500">*</span>
                                </label>
                                <div class="flex gap-2">
                                    <input id="accountNumber"
                                           v-model.trim="form.accountNumber"
                                           type="text"
                                           required
                                           placeholder="Account number"
                                           class="input-control" />
                                    <button type="button"
                                            @@click="generateAccountNumber"
                                            title="Generate account number"
                                            class="rounded-lg border border-rose-200 bg-rose-50 px-3 text-rose-700 hover:bg-rose-100">
                                        <i v-if="isLoadingAccountNo" class="la la-circle-o-notch animate-spin text-lg"></i>
                                        <i v-else class="bi bi-magic"></i>
                                    </button>
                                </div>
                            </div>

                            <!-- Supplier Name -->
                            <div>
                                <label for="supplierName" class="label mb-1.5 block text-sm font-semibold text-gray-700">
                                    Supplier Name: <span class="text-red-500">*</span>
                                </label>
                                <input id="supplierName"
                                       v-model.trim="form.name"
                                       type="text"
                                       required
                                       placeholder="Enter supplier name"
                                       class="input-control" />
                            </div>

                            <!-- Supplier Group -->
                            <div>
                                <w-select
                                    v-model="form.supplierGroupId"
                                    :options="supplierGroups"
                                    display-key="name"
                                    value-key="id"
                                    label="Supplier Group:">
                                </w-select>
                            </div>

                            <!-- Status -->
                            <div>
                                <w-select
                                    v-model="form.statusId"
                                    :options="statusList"
                                    display-key="name"
                                    value-key="id"
                                    label="Status:"
                                    required>
                                </w-select>
                            </div>

                            <!-- Address -->
                            <div>
                                <label for="supplierAddress" class="label mb-1.5 block text-sm font-semibold text-gray-700">
                                    Address: <span class="text-red-500">*</span>
                                </label>
                                <input id="supplierAddress"
                                       v-model.trim="form.address"
                                       type="text"
                                       required
                                       placeholder="Supplier address"
                                       class="input-control" />
                            </div>

                            <!-- TIN -->
                            <div>
                                <label for="tinNumber" class="label mb-1.5 block text-sm font-semibold text-gray-700">
                                    TIN Number: <span class="text-red-500">*</span>
                                </label>
                                <input id="tinNumber"
                                       v-model.trim="form.tinNumber"
                                       type="text"
                                       required
                                       placeholder="TIN number"
                                       class="input-control" />
                            </div>

                            <!-- VAT Number -->
                            <div>
                                <label for="vatNumber" class="label mb-1.5 block text-sm font-semibold text-gray-700">
                                    VAT Number:
                                </label>
                                <input id="vatNumber"
                                       v-model.trim="form.vatNumber"
                                       type="text"
                                       placeholder="VAT number"
                                       class="input-control" />
                            </div>

                            <!-- Phone -->
                            <div>
                                <label for="phoneNo" class="label mb-1.5 block text-sm font-semibold text-gray-700">
                                    Contact Number: <span class="text-red-500">*</span>
                                </label>
                                <input id="phoneNo"
                                       v-model.trim="form.phoneNo"
                                       type="tel"
                                       required
                                       placeholder="Supplier phone number"
                                       class="input-control" />
                            </div>

                            <!-- Email -->
                            <div>
                                <label for="email" class="label mb-1.5 block text-sm font-semibold text-gray-700">
                                    Email Address: <span class="text-red-500">*</span>
                                </label>
                                <input id="email"
                                       v-model.trim="form.email"
                                       type="email"
                                       required
                                       placeholder="supplier@example.com"
                                       class="input-control" />
                            </div>

                            <!-- Currency -->
                            <div>
                                <w-select
                                    v-model="form.currencyId"
                                    :options="currencies"
                                    display-key="currencyName"
                                    value-key="id"
                                    label="Default Currency:"
                                    required>
                                </w-select>
                            </div>

                            <!-- Balance (read-only) -->
                            <div>
                                <label for="balance" class="label mb-1.5 block text-sm font-semibold text-gray-700">
                                    Balance
                                </label>
                                <input id="balance"
                                       :value="form.balance"
                                       type="text"
                                       disabled
                                       readonly
                                       class="input-control" />
                                @*<p class="mt-1 text-xs text-gray-400">
                                    Read-only. A supplier can only be deleted when this is 0.00.
                                </p>*@
                            </div>

                            <!-- Tax Office -->
                            <div>
                                <label for="taxOffice" class="label mb-1.5 block text-sm font-semibold text-gray-700">
                                    Tax Office
                                </label>
                                <input id="taxOffice"
                                       v-model.trim="form.taxOffice"
                                       type="text"
                                       placeholder="Tax office"
                                       class="input-control" />
                            </div>

                            <!-- Resident -->
                            <div class="flex items-center gap-2 self-end rounded-lg border border-gray-200 bg-gray-50 px-3 py-3">
                                <input id="isResident"
                                       v-model="form.isResident"
                                       type="checkbox"
                                       class="h-4 w-4 rounded border-gray-300 accent-blue-600" />
                                <label for="isResident" class="label cursor-pointer text-sm font-medium text-gray-600">
                                    Is Resident
                                </label>
                            </div>
                        </div>

                        <hr class="my-4" />

                        <!-- ============================================================
                             GENERAL LEDGER MAPPING
                             ============================================================ -->
                        <p class="my-4 text-blue-500">General Ledger Mapping</p>

                        <div class="grid grid-cols-1 gap-5 sm:grid-cols-2 lg:grid-cols-4 my-4">
                            <div>
                                <w-select
                                    v-model="form.debitAccountId"
                                    :options="accounts"
                                    display-key="accountIdentifier"
                                    value-key="id"
                                    label="Debit G/L:"
                                    required>
                                </w-select>
                            </div>

                            <div>
                                <w-select
                                    v-model="form.creditAccountId"
                                    :options="accounts"
                                    display-key="accountIdentifier"
                                    value-key="id"
                                    label="Credit G/L:"
                                    required>
                                </w-select>
                            </div>

                            <div>
                                <w-select
                                    v-model="form.vatAccountId"
                                    :options="accounts"
                                    display-key="accountIdentifier"
                                    value-key="id"
                                    label="VAT G/L Number:"
                                    required>
                                </w-select>
                            </div>

                            <div>
                                <w-select
                                    v-model="form.irsAccountId"
                                    :options="accounts"
                                    display-key="accountIdentifier"
                                    value-key="id"
                                    label="IRS G/L Number:"
                                    required>
                                </w-select>
                            </div>
                        </div>

                        <hr class="my-4" />

                        <!-- ============================================================
                             CONTACT PERSON
                             ============================================================ -->
                        <p class="my-4 text-blue-500">Contact Person</p>

                        <div class="grid grid-cols-1 gap-5 sm:grid-cols-2 lg:grid-cols-3 my-4">
                            <div>
                                <label for="contactPerson" class="label mb-1.5 block text-sm font-semibold text-gray-700">
                                    Contact Person Name
                                </label>
                                <input id="contactPerson"
                                       v-model.trim="form.contactPerson"
                                       type="text"
                                       placeholder="Contact person name"
                                       class="input-control" />
                            </div>

                            <div>
                                <label for="contactPersonPhone" class="label mb-1.5 block text-sm font-semibold text-gray-700">
                                    Contact Person Phone
                                </label>
                                <input id="contactPersonPhone"
                                       v-model.trim="form.contactPersonPhone"
                                       type="tel"
                                       placeholder="Contact person phone"
                                       class="input-control" />
                            </div>

                            <div>
                                <label for="contactPersonEmail" class="label mb-1.5 block text-sm font-semibold text-gray-700">
                                    Contact Person Email
                                </label>
                                <input id="contactPersonEmail"
                                       v-model.trim="form.contactPersonEmail"
                                       type="email"
                                       placeholder="Contact person email"
                                       class="input-control" />
                            </div>
                        </div>
                    </form>
                </div>
            </div>

            <!-- Actions -->
            <div class="flex flex-col-reverse gap-3 sm:flex-row sm:items-center sm:justify-between my-2">
                <button type="button"
                        @@click="resetSupplierFields"
                        class="inline-flex items-center justify-center gap-2 rounded-lg border border-gray-200 px-4 py-2 text-sm font-medium text-gray-700 hover:bg-gray-50">
                    <i class="bi bi-arrow-counterclockwise"></i>
                    Clear Form
                </button>

                <div class="flex flex-col gap-3 sm:flex-row">
                    <button v-if="isEditing"
                            type="button"
                            @@click="confirmDeleteCurrent"
                            :disabled="isLoading"
                            class="inline-flex items-center justify-center gap-2 rounded-lg border border-red-200 px-4 py-2 text-sm font-medium text-red-600 hover:bg-red-50 disabled:cursor-not-allowed disabled:opacity-60">
                        <i class="bi bi-trash"></i>
                        Delete Supplier
                    </button>

                    <button type="button"
                            @@click="saveSupplier"
                            :disabled="isLoading"
                            class="inline-flex items-center justify-center gap-2 rounded-lg bg-blue-600 px-4 py-2 text-sm font-semibold text-white shadow-sm transition hover:bg-blue-700 focus:outline-none focus:ring-4 focus:ring-blue-500/20 disabled:cursor-not-allowed disabled:opacity-60">
                        <i v-if="isLoading" class="la la-circle-o-notch animate-spin text-lg"></i>
                        <i v-else class="bi bi-check text-lg"></i>
                        {{ isLoading ? 'Saving Supplier...' : (isEditing ? 'Update Supplier' : 'Save Supplier') }}
                    </button>
                </div>
            </div>
        </div>
    </div>
</div>

<script src="~/js/ap/DataEntry/suppliers.js" asp-append-version="true"></script>
