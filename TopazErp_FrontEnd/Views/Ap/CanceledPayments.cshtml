@{
    ViewBag.Title = "Canceled Payments";
    Layout = "~/Views/Shared/_adminApLayout.cshtml";
}
<div class="content">
    <div class="mb-6 content-header">
        <div class="flex items-center gap-2 text-sm text-gray-500 mb-2">
            <span>AP - Enquiries</span>
            <i class="bi bi-chevron-right text-xs"></i>
            <span class="text-blue-600 font-medium">Canceled Payments</span>
        </div>

        <div class="flex items-center gap-3">

            <div class="page-title">
                <h2 class="text-2xl font-semibold text-gray-800">
                    Enquiries
                </h2>
                
            </div>
        </div>
    </div>
    <div id="app" class="card" data-card-title="Canceled Payments">
        <data-grid
            ref="payments"
            title="Canceled Payments"
            :columns="paymentColumns"
            :data="paymentList"
            :child="paymentInvoices"
            :theme="theme"
            row-id="id"
            label-key="batchNumber"
            storage-key="ap-payment-register"
            item-label="payment"
            item-label-plural="payments"
            :page-size="10"
            :selectable="true"
            :allow-add="false" :allow-edit="false" :allow-delete="false"
        >
        </data-grid>
    </div>
</div>


<script src="~/js/ap/Enquiries/canceled-payments.js" asp-append-version="true"></script>