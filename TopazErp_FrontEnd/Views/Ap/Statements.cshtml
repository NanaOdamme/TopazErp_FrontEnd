@{
    ViewBag.Title = "Statements";
    Layout = "~/Views/Shared/_adminApLayout.cshtml";
}
<div class="content">
    <div class="mb-6 content-header">
        <div class="flex items-center gap-2 text-sm text-gray-500 mb-2">
            <span>AP - Reports</span>
            <i class="bi bi-chevron-right text-xs"></i>
            <span class="text-blue-600 font-medium">Statements</span>
        </div>

        <div class="flex items-center gap-3">

            <div class="page-title">
                <h2 class="text-2xl font-semibold text-gray-800">
                    Statements
                </h2>
                
            </div>
        </div>
    </div>
   <div id="app" class="card" data-card-title="Reports - Statements">

    <div class="space-y-5">

        <!-- Report Type -->
        <div>
            <label class="label block text-sm mb-2">
                Select Report Type:
            </label>

            <div class="flex flex-wrap items-center gap-3">

                <!-- Type 1 -->
                <label for="type1"
                       class="flex cursor-pointer items-center gap-3 rounded-lg border border-slate-200 bg-white px-4 py-3 transition-colors hover:border-blue-300 hover:bg-blue-50/50 dark:border-slate-700 dark:bg-slate-900 dark:hover:border-blue-500 dark:hover:bg-slate-800">

                    <input id="type1"
                           type="radio"
                           value="type1"
                           v-model="reportType"
                           class="input-control" />

                    <span>Type 1</span>
                </label>

                <!-- Type 2 -->
                <label for="type2"
                       class="flex cursor-pointer items-center gap-3 rounded-lg border border-slate-200 bg-white px-4 py-3 transition-colors hover:border-blue-300 hover:bg-blue-50/50 dark:border-slate-700 dark:bg-slate-900 dark:hover:border-blue-500 dark:hover:bg-slate-800">

                    <input id="type2"
                           type="radio"
                           value="type2"
                           v-model="reportType"
                           class="input-control" />

                    <span>Type 2</span>
                </label>

                <!-- Type 3 -->
                <label for="type3"
                       class="flex cursor-pointer items-center gap-3 rounded-lg border border-slate-200 bg-white px-4 py-3 transition-colors hover:border-blue-300 hover:bg-blue-50/50 dark:border-slate-700 dark:bg-slate-900 dark:hover:border-blue-500 dark:hover:bg-slate-800">

                    <input id="type3"
                           type="radio"
                           value="type3"
                           v-model="reportType"
                           class="input-control" />

                    <span>Type 3</span>
                </label>

            </div>
        </div>

        <!-- Supplier -->
        <div class="grid grid-cols-1 gap-5 sm:grid-cols-3 xl:grid-cols-4">

            <w-select
                @@change="getReportData"
                v-model="supplierId"
                :options="supplierList"
                display-key="name"
                value-key="id"
                placeholder="Select Supplier"
                label="Supplier:"
                required>
            </w-select>

        </div>

        <!-- Date Filters: Only Type 2 and Type 3 -->
        <div v-if="reportType === 'type2' || reportType === 'type3'"
             class="grid grid-cols-1 gap-5 sm:grid-cols-2 xl:grid-cols-4">

            <label class="label block text-sm">
                Start Date:
                <input id="startDate"
                       v-model="startDate"
                       type="date"
                       class="input-control" />
            </label>

            <label class="label block text-sm">
                End Date:
                <input id="endDate"
                       v-model="endDate"
                       type="date"
                       class="input-control" />
            </label>

        </div>

        <!-- Generate Report -->
        <div class="flex justify-end">
            <button type="button"
                    @@click="getReportData"
                    :disabled="isLoading"
                    class="bg-blue-600 text-white px-4 py-2 rounded-lg hover:bg-blue-700 disabled:opacity-50 disabled:cursor-not-allowed">
                <span v-if="isLoading">
                    <i class="las la-spinner la-spin mr-1"></i>
                    Generating...
                </span>
                <span v-else>
                    <i class="las la-file-alt mr-1"></i>
                    Generate Report
                </span>
            </button>
        </div>

    </div>

    <hr class="my-4">

    <!-- Report Viewer -->
    <div class="p-4 my-4 rounded-xl dark:bg-slate-800">
        <div id="reportView"
             style="height:auto;width:auto;min-height:500px;">
        </div>
    </div>

</div>
</div>
<script src="~/js/ap/Reports/statements.js" asp-append-version="true"></script>