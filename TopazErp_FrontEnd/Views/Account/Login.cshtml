
@{
    ViewBag.Title = "Login";
    Layout = "~/Views/Shared/_Layout.cshtml";
}

<div id="loginApp"
     class="min-h-screen flex items-center justify-center bg-slate-50 px-4 py-10">

    <div class="w-full max-w-md">

      

        <div class="rounded-2xl border border-slate-200 bg-white p-6 shadow-xl shadow-slate-200/60 sm:p-8">

            <h2 class="text-xl font-semibold text-slate-900">
                Sign in
            </h2>

            <p class="mt-1 mb-6 text-sm text-slate-500">
                Enter your username and password to continue.
            </p>

            <div v-if="errorMessage"
                 role="alert"
                 class="mb-5 rounded-xl border border-red-200 bg-red-50 px-4 py-3 text-sm text-red-700">
                {{ errorMessage }}
            </div>
            <form v-on:submit.prevent="login">
               
                <div class="mb-3">
                    <label for="tenancyName"
                           class="mb-2 block text-sm font-medium text-slate-700">
                       Account ID
                    </label>

                    <input
                        type="text"
                        id="tenancyName"
                        v-model.trim="tenancyName"
                      
                        placeholder="Enter your school name"
                        autocomplete="organization"
                        required
                        class="w-full rounded-xl border border-slate-300 px-4 py-3 text-sm outline-none transition placeholder:text-slate-400 focus:border-blue-500 focus:ring-4 focus:ring-blue-500/10" />
                 
                </div>
            

                <div class="mb-5">
                    <label for="username"
                           class="mb-2 block text-sm font-medium text-slate-700">
                        Username or email
                    </label>

                    <input id="username"
                           v-model.trim="username"
                           type="text"
                           autocomplete="username"
                           placeholder="Enter your username"
                           required
                           class="w-full rounded-xl border border-slate-300 px-4 py-3 text-sm outline-none transition placeholder:text-slate-400 focus:border-blue-500 focus:ring-4 focus:ring-blue-500/10" />

                    <p v-if="errors.username"
                       class="mt-1.5 text-xs text-red-600">
                        {{ errors.username }}
                    </p>
                </div>

                <div class="mb-5">
                    <div class="mb-2 flex items-center justify-between">
                        <label for="password"
                               class="text-sm font-medium text-slate-700">
                            Password
                        </label>

                        <a href="/Account/ForgotPassword"
                           class="text-xs font-medium text-blue-600 hover:text-blue-800">
                            Forgot password?
                        </a>
                    </div>

                    <div class="relative">
                        <input id="password"
                               v-model="password"
                               :type="showPassword ? 'text' : 'password'"
                               autocomplete="current-password"
                               placeholder="Enter your password"
                               required
                               class="w-full rounded-xl border border-slate-300 py-3 pl-4 pr-12 text-sm outline-none transition placeholder:text-slate-400 focus:border-blue-500 focus:ring-4 focus:ring-blue-500/10" />

                        <button type="button"
                                @@click="showPassword = !showPassword"
                                class="absolute inset-y-0 right-0 px-4 text-sm text-slate-500 hover:text-slate-800">
                            {{ showPassword ? 'Hide' : 'Show' }}
                        </button>
                    </div>

                    <p v-if="errors.password"
                       class="mt-1.5 text-xs text-red-600">
                        {{ errors.password }}
                    </p>
                </div>

                <div class="mb-6 flex items-center">
                    <input id="rememberMe"
                           v-model="rememberMe"
                           type="checkbox"
                           class="h-4 w-4 rounded border-slate-300 text-blue-600 focus:ring-blue-500" />

                    <label for="rememberMe"
                           class="ml-2.5 text-sm text-slate-600">
                        Remember me
                    </label>
                </div>

                <button type="submit"
                        :disabled="isLoading"
                        class="flex w-full items-center justify-center gap-2 rounded-xl bg-blue-600 px-4 py-3 text-sm font-semibold text-white shadow-lg shadow-blue-600/20 transition hover:bg-blue-700 disabled:cursor-not-allowed disabled:opacity-70">

                    <i v-if="isLoading"
                       class="bi bi-arrow-repeat animate-spin text-lg"
                       aria-hidden="true"></i>

                    <i v-else
                       class="bi bi-box-arrow-in-right text-lg"
                       aria-hidden="true"></i>

                    {{ isLoading ? 'Signing in...' : 'Sign in' }}
                </button>
            </form>

            <div class="mt-6 text-center text-sm text-slate-500">
                Don't have an account?
                <a href="/Account/Register"
                   class="font-semibold text-blue-600 hover:text-blue-800">
                    Create an account
                </a>
            </div>
        </div>

     
    </div>
</div>

@section scripts {
    <script>
        const { createApp } = Vue;

        createApp({
            data() {
                return {
                    tenancyName: '',
                    username: '',
                    password: '',
                    rememberMe: false,
                    showPassword: false,
                    isLoading: false,
                    errorMessage: '',
                    errors: {
                        username: '',
                        password: ''
                    }
                };
            },

            methods: {
                validateForm() {
                    this.errors = {
                        username: '',
                        password: ''
                    };

                    this.errorMessage = '';
                    let valid = true;

                    if (!this.username) {
                        this.errors.username = 'Username is required.';
                        valid = false;
                    }

                    if (!this.password) {
                        this.errors.password = 'Password is required.';
                        valid = false;
                    }

                    return valid;
                },

              
            }
        }).mount('#loginApp');
    </script>
}

