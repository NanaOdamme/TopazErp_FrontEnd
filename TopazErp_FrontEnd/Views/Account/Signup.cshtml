@{
    ViewBag.Title = "Signup";
    Layout = "~/Views/Shared/_Layout.cshtml";
}

<div class="min-h-screen bg-slate-50 dark:bg-slate-950 flex items-center justify-center px-4 py-8">

    <div class="w-full max-w-md">


        <!-- Signup Card -->
        <div class="rounded-2xl border border-slate-200 bg-white p-6 shadow-xl
                    dark:border-slate-800 dark:bg-slate-900">

            <form>

                <!-- Account ID -->
                <div class="mb-5">
                   <label  class="label mb-2 block text-sm font-medium text-slate-700 dark:text-slate-300">
                        Account ID
                    </label>

                    <div class="relative">
                        <span class="pointer-events-none absolute inset-y-0 left-0 flex items-center pl-3
                                     text-slate-400">
                            <i class="bi bi-building"></i>
                        </span>

                        <input type="text"
                               name="accountId"
                               placeholder="Enter your account ID"
                               class="w-full rounded-xl border border-slate-300 bg-white py-3 pl-10 pr-4
                                      text-sm text-slate-900 outline-none transition
                                      placeholder:text-slate-400
                                      focus:border-blue-500 focus:ring-4 focus:ring-blue-500/10
                                      dark:border-slate-700 dark:bg-slate-800 dark:text-white
                                      dark:placeholder:text-slate-500 dark:focus:border-blue-500" />
                    </div>
                </div>


                <!-- Username -->
                <div class="mb-5">
                   <label  class="label mb-2 block text-sm font-medium text-slate-700 dark:text-slate-300">
                        Username
                    </label>

                    <div class="relative">
                        <span class="pointer-events-none absolute inset-y-0 left-0 flex items-center pl-3
                                     text-slate-400">
                            <i class="bi bi-person"></i>
                        </span>

                        <input type="text"
                               name="username"
                               placeholder="Enter your username"
                               class="w-full rounded-xl border border-slate-300 bg-white py-3 pl-10 pr-4
                                      text-sm text-slate-900 outline-none transition
                                      placeholder:text-slate-400
                                      focus:border-blue-500 focus:ring-4 focus:ring-blue-500/10
                                      dark:border-slate-700 dark:bg-slate-800 dark:text-white
                                      dark:placeholder:text-slate-500 dark:focus:border-blue-500" />
                    </div>
                </div>


                <!-- Password -->
                <div class="mb-6">
                   <label  class="label mb-2 block text-sm font-medium text-slate-700 dark:text-slate-300">
                        Password
                    </label>

                    <div class="relative">
                        <span class="pointer-events-none absolute inset-y-0 left-0 flex items-center pl-3
                                     text-slate-400">
                            <i class="bi bi-lock"></i>
                        </span>

                        <input :type="showPassword ? 'text' : 'password'"
                               name="password"
                               placeholder="Enter your password"
                               class="w-full rounded-xl border border-slate-300 bg-white py-3 pl-10 pr-12
                                      text-sm text-slate-900 outline-none transition
                                      placeholder:text-slate-400
                                      focus:border-blue-500 focus:ring-4 focus:ring-blue-500/10
                                      dark:border-slate-700 dark:bg-slate-800 dark:text-white
                                      dark:placeholder:text-slate-500 dark:focus:border-blue-500" />

                        <button type="button"
                                @@click="showPassword = !showPassword"
                                class="absolute inset-y-0 right-0 flex items-center px-4
                                       text-slate-400 transition hover:text-blue-600
                                       dark:hover:text-blue-400">
                            <i :class="showPassword ? 'bi bi-eye-slash' : 'bi bi-eye'"></i>
                        </button>
                    </div>
                </div>


                <!-- Signup Button -->
                <button type="submit"
                        class="flex w-full items-center justify-center gap-2 rounded-xl
                               bg-blue-600 px-4 py-3 text-sm font-semibold text-white
                               shadow-sm transition hover:bg-blue-700
                               focus:outline-none focus:ring-4 focus:ring-blue-500/20">
                    <i class="bi bi-person-plus"></i>
                    Create Account
                </button>

            </form>


            <!-- Login Link -->
            <div class="mt-6 border-t border-slate-100 pt-5 text-center
                        dark:border-slate-800">

                <p class="text-sm text-slate-500 dark:text-slate-400">
                    Already have an account?

                    <a href="/Account/Login"
                       class="font-semibold text-blue-600 hover:text-blue-700
                              dark:text-blue-400 dark:hover:text-blue-300">
                        Sign in
                    </a>
                </p>

            </div>

        </div>

    </div>

</div>

<script>
const { createApp } = Vue;

createApp({
    data() {
        return {
            accountId: '',
            username: '',
            password: '',

            showPassword: false,

            errors: {
                accountId: '',
                username: '',
                password: ''
            },

            isLoading: false
        };
    },

    methods: {
        validateForm() {
            this.errors = {
                accountId: '',
                username: '',
                password: ''
            };

            let isValid = true;

            if (!this.accountId.trim()) {
                this.errors.accountId = 'Account ID is required.';
                isValid = false;
            }

            if (!this.username.trim()) {
                this.errors.username = 'Username is required.';
                isValid = false;
            }

            if (!this.password) {
                this.errors.password = 'Password is required.';
                isValid = false;
            } else if (this.password.length < 6) {
                this.errors.password = 'Password must be at least 6 characters.';
                isValid = false;
            }

            return isValid;
        },

        async signup() {
            if (!this.validateForm()) {
                return;
            }

            this.isLoading = true;

            try {
                const response = await axios.post('/Account/Signup', {
                    accountId: this.accountId,
                    username: this.username,
                    password: this.password
                });

                if (response.data.success) {
                    await Swal.fire({
                        icon: 'success',
                        title: 'Account Created',
                        text: 'Your account has been created successfully.',
                        confirmButtonColor: '#2563eb'
                    });

                    window.location.href = '/Account/Login';
                } else {
                    Swal.fire({
                        icon: 'error',
                        title: 'Signup Failed',
                        text: response.data.message || 'Unable to create your account.',
                        confirmButtonColor: '#2563eb'
                    });
                }

            } catch (error) {
                console.error(error);

                Swal.fire({
                    icon: 'error',
                    title: 'Something went wrong',
                    text: error.response?.data?.message ||
                          'Unable to create your account. Please try again.',
                    confirmButtonColor: '#2563eb'
                });
            } finally {
                this.isLoading = false;
            }
        }
    }
}).mount('#signupApp');
</script>