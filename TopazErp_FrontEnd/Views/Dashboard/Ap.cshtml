@{
ViewBag.Title = "Dashboard | Ap";
Layout = "~/Views/Shared/_adminApLayout.cshtml";
}
<style>
    /* GL-style surface for the classes the AP scripts already write into.
       Scoped to this page; mirrors the GL dashboard card/table look. */
    #apDashboard .card {
        background: #fff;
        border: 1px solid #e5e7eb;
        border-radius: .75rem;
        box-shadow: 0 1px 2px rgb(0 0 0 / .05);
        overflow: hidden;
    }
    #apDashboard .table-scroll { max-height: 340px; overflow: auto; }

    #apDashboard .data-table { width: 100%; min-width: 640px; border-collapse: collapse; text-align: left; font-size: .75rem; }
    #apDashboard .data-table thead {
        position: sticky; top: 0; z-index: 10;
        background: #f1f5f9; color: #64748b;
        font-size: 11px; letter-spacing: .04em; text-transform: uppercase;
    }
    #apDashboard .data-table thead th { padding: .75rem 1.25rem; font-weight: 600; white-space: nowrap; }
    #apDashboard .data-table thead th.text-right { text-align: right; }
    #apDashboard .data-table tbody tr { border-top: 1px solid #f3f4f6; transition: background-color .15s; }
    #apDashboard .data-table tbody tr:hover { background: #f8fafc; }
    #apDashboard .data-table tbody td { padding: .75rem 1.25rem; color: #334155; vertical-align: middle; }
    #apDashboard .data-table tbody td.text-right { text-align: right; }
    #apDashboard .data-table tbody tr td[colspan] { padding: 2.5rem 1.25rem; text-align: center; color: #9ca3af; }

  
    .dark #apDashboard .card { background: #1e293b; border-color: #334155; }
    .dark #apDashboard .data-table thead { background: #1e293b; color: #94a3b8; }
    .dark #apDashboard .data-table tbody tr { border-top-color: #334155; }
    .dark #apDashboard .data-table tbody tr:hover { background: rgb(30 41 59 / .6); }
    .dark #apDashboard .data-table tbody td { color: #e2e8f0; }
</style>

<div class="content" id="apDashboard">

    <!-- Page Header & Breadcrumbs -->
    <div class="mb-6 content-header">
        <div class="mb-2 flex items-center gap-2 text-sm text-gray-500">
            <span>AP</span>
            <i class="bi bi-chevron-right text-xs"></i>
            <span class="font-medium text-blue-600">Dashboard</span>
        </div>

        <div class="flex flex-wrap items-center justify-between gap-4">
            <div class="page-title">
                <h2 class="text-2xl font-bold tracking-tight text-gray-900 dark:text-white">
                    Accounts Payable Dashboard
                </h2>
                <p class="mt-1 text-sm text-gray-500 dark:text-gray-400">
                    Payables control center — invoices, payments, supplier balances and aging at a glance.
                </p>
            </div>

            <div class="flex flex-wrap items-end gap-2.5">
                <label class="block">
                    <span class="mb-1 block text-xs font-semibold text-gray-500 dark:text-gray-400">Aging as of</span>
                    <input id="asOfDate" type="date"
                           class="rounded-lg border border-gray-200 bg-white px-3 py-2.5 text-sm text-gray-700 shadow-sm outline-none transition focus:border-blue-400 focus:ring-4 focus:ring-blue-100 dark:border-slate-700 dark:bg-slate-800 dark:text-gray-200" />
                </label>
                <label class="block">
                    <span class="mb-1 block text-xs font-semibold text-gray-500 dark:text-gray-400">Interval</span>
                    <select id="agingInterval"
                            class="rounded-lg border border-gray-200 bg-white px-3 py-2.5 text-sm text-gray-700 shadow-sm outline-none transition focus:border-blue-400 focus:ring-4 focus:ring-blue-100 dark:border-slate-700 dark:bg-slate-800 dark:text-gray-200">
                        <option value="30">30 days</option>
                        <option value="60">60 days</option>
                        <option value="90">90 days</option>
                    </select>
                </label>
                <button id="refreshButton" type="button"
                        class="inline-flex items-center gap-2 rounded-lg bg-blue-600 px-4 py-2.5 text-sm font-semibold text-white shadow-sm transition hover:bg-blue-700 disabled:cursor-not-allowed disabled:opacity-60">
                    <i class="bi bi-arrow-clockwise"></i>
                    <span>Refresh</span>
                </button>
            </div>
        </div>
    </div>

    <!-- Quick Actions -->
    <div class="card mb-6" data-card-title="Quick Actions">
        <div class="flex flex-wrap items-center gap-2.5">
            <a id="agingAction" href="/Ap/Aging"
               class="inline-flex items-center gap-2 rounded-lg border border-blue-200 bg-blue-50 px-3.5 py-2 text-xs font-semibold text-blue-700 transition hover:bg-blue-100 dark:border-slate-700 dark:bg-slate-800 dark:text-blue-400 dark:hover:bg-slate-700">
                <i class="bi bi-hourglass-split"></i> Aging Summary
            </a>
            <a id="glAction" href="/Ap/GlTransactions"
               class="inline-flex items-center gap-2 rounded-lg border border-emerald-200 bg-emerald-50 px-3.5 py-2 text-xs font-semibold text-emerald-700 transition hover:bg-emerald-100 dark:border-slate-700 dark:bg-slate-800 dark:text-emerald-400 dark:hover:bg-slate-700">
                <i class="bi bi-journal-text"></i> G/L Transactions
            </a>
            <a href="/Ap/Vouchers"
               class="inline-flex items-center gap-2 rounded-lg border border-slate-200 bg-white px-3.5 py-2 text-xs font-semibold text-slate-600 transition hover:bg-slate-50 dark:border-slate-700 dark:bg-slate-800 dark:text-slate-300 dark:hover:bg-slate-700">
                <i class="bi bi-receipt"></i> Payment Vouchers
            </a>
            <a href="/Ap/OpeningBalances"
               class="inline-flex items-center gap-2 rounded-lg border border-slate-200 bg-white px-3.5 py-2 text-xs font-semibold text-slate-600 transition hover:bg-slate-50 dark:border-slate-700 dark:bg-slate-800 dark:text-slate-300 dark:hover:bg-slate-700">
                <i class="bi bi-wallet2"></i> Opening Balances
            </a>
            <a href="/Ap/CanceledInvoices"
               class="inline-flex items-center gap-2 rounded-lg border border-slate-200 bg-white px-3.5 py-2 text-xs font-semibold text-slate-600 transition hover:bg-slate-50 dark:border-slate-700 dark:bg-slate-800 dark:text-slate-300 dark:hover:bg-slate-700">
                <i class="bi bi-x-circle"></i> Canceled Invoices
            </a>
            <a href="/Ap/DebitMemos"
               class="inline-flex items-center gap-2 rounded-lg border border-slate-200 bg-white px-3.5 py-2 text-xs font-semibold text-slate-600 transition hover:bg-slate-50 dark:border-slate-700 dark:bg-slate-800 dark:text-slate-300 dark:hover:bg-slate-700">
                <i class="bi bi-file-earmark-minus"></i> Debit Memos
            </a>
        </div>
    </div>

    <!-- KPI Cards -->
    <div class="mb-6 grid grid-cols-1 gap-4 sm:grid-cols-2 xl:grid-cols-4">

        <!-- Open invoices -->
        <div class="card flex items-center gap-4">
            <div class="flex h-12 w-12 shrink-0 items-center justify-center rounded-xl bg-indigo-50 text-indigo-600 dark:bg-indigo-900/30 dark:text-indigo-400">
                <i class="bi bi-journal-text text-2xl"></i>
            </div>
            <div class="min-w-0">
                <p class="text-xs font-medium uppercase tracking-wider text-gray-500 dark:text-gray-400">Open Invoices</p>
                <h3 id="openInvoiceCount" class="text-2xl font-bold text-gray-900 dark:text-white">—</h3>
                <p class="mt-0.5 text-xs text-gray-400">Invoices with an outstanding balance</p>
            </div>
        </div>

        <!-- Suppliers -->
        <div class="card flex items-center gap-4 p-5">
            <div class="flex h-12 w-12 shrink-0 items-center justify-center rounded-xl bg-blue-50 text-blue-600 dark:bg-blue-900/30 dark:text-blue-400">
                <i class="bi bi-truck text-2xl"></i>
            </div>
            <div class="min-w-0">
                <p class="text-xs font-medium uppercase tracking-wider text-gray-500 dark:text-gray-400">Suppliers</p>
                <h3 id="supplierCount" class="text-2xl font-bold text-gray-900 dark:text-white">—</h3>
                <p class="mt-0.5 text-xs text-gray-400">Records returned by the shared resource API</p>
            </div>
        </div>

        <!-- Payments -->
        <div class="card flex items-center gap-4 p-5">
            <div class="flex h-12 w-12 shrink-0 items-center justify-center rounded-xl bg-emerald-50 text-emerald-600 dark:bg-emerald-900/30 dark:text-emerald-400">
                <i class="bi bi-credit-card-2-front text-2xl"></i>
            </div>
            <div class="min-w-0">
                <p class="text-xs font-medium uppercase tracking-wider text-gray-500 dark:text-gray-400">Payments</p>
                <h3 id="paymentCount" class="text-2xl font-bold text-gray-900 dark:text-white">—</h3>
                <p class="mt-0.5 text-xs text-gray-400">Records returned by the AP payments report</p>
            </div>
        </div>

        <!-- Opening balances -->
        <div class="card flex items-center gap-4 p-5">
            <div class="flex h-12 w-12 shrink-0 items-center justify-center rounded-xl bg-amber-50 text-amber-600 dark:bg-amber-900/30 dark:text-amber-400">
                <i class="bi bi-cash-coin text-2xl"></i>
            </div>
            <div class="min-w-0">
                <p class="text-xs font-medium uppercase tracking-wider text-gray-500 dark:text-gray-400">Opening Balances</p>
                <h3 id="openingBalanceCount" class="text-2xl font-bold text-gray-900 dark:text-white">—</h3>
                <p class="mt-0.5 text-xs text-gray-400">Opening balance records across all statuses</p>
            </div>
        </div>
    </div>

    <!-- Charts Row -->
    <div class="mb-6 grid grid-cols-1 gap-4 xl:grid-cols-3">

        <!-- Invoice aging -->
        <div class="card xl:col-span-2" data-card-title="Invoice Aging">
            <div class="flex items-start justify-between gap-4 border-b border-gray-100 px-5 py-4 dark:border-slate-800">
                <div>
                    <h4 class="text-sm font-bold text-gray-900 dark:text-white">Invoice Aging</h4>
                    <p class="mt-0.5 text-xs text-gray-500 dark:text-gray-400">Invoice counts by aging bucket</p>
                </div>
                <span class="inline-flex shrink-0 items-center gap-1.5 rounded-lg border border-gray-200 bg-white px-3 py-2 text-xs font-semibold text-gray-600 shadow-sm dark:border-slate-700 dark:bg-slate-800 dark:text-gray-300">
                    <i class="bi bi-calendar3 text-blue-500"></i>
                    <span id="agingAsOfLabel"></span>
                </span>
            </div>
            <div class="h-[290px] p-4">
                <div id="agingChart" class="h-full w-full"></div>
            </div>
            <p class="border-t border-gray-100 px-5 py-3 text-xs text-gray-400 dark:border-slate-800">
                Counts are used so invoices in different currencies are not added together.
            </p>
        </div>

        <!-- Invoices by currency -->
        <div class="card" data-card-title="Invoices by Currency">
            <div class="border-b border-gray-100 px-5 py-4 dark:border-slate-800">
                <h4 class="text-sm font-bold text-gray-900 dark:text-white">Invoices by Currency</h4>
                <p class="mt-0.5 text-xs text-gray-500 dark:text-gray-400">Invoice records per currency</p>
            </div>
            <div class="h-[290px] p-4">
                <div id="currencyChart" class="h-full w-full"></div>
                <div id="currencyEmpty" class="hidden py-10 text-center text-sm text-gray-400">
                    <i class="bi bi-pie-chart block text-4xl mb-2"></i>
                    No invoice currency data available.
                </div>
            </div>
        </div>
    </div>

    <!-- Tables Row -->
    <div class="grid grid-cols-1 gap-4 xl:grid-cols-3">

        <!-- Recent invoices -->
        <div class="card xl:col-span-2" data-card-title="Recent Invoices">
            <div class="flex items-center justify-between border-b border-gray-100 px-5 py-4 dark:border-slate-800">
                <div>
                    <h4 class="text-sm font-bold text-gray-900 dark:text-white">Recent Invoices</h4>
                    <p class="mt-0.5 text-xs text-gray-500 dark:text-gray-400">Latest records returned by the AP invoice endpoint</p>
                </div>
                <a href="/Ap/GetAllApInvoices" target="_blank" rel="noopener"
                   class="text-xs font-semibold text-blue-600 hover:text-blue-700 dark:text-blue-400">
                    View all <i class="bi bi-arrow-right"></i>
                </a>
            </div>
            <div class="table-scroll">
                <table class="data-table">
                    <thead>
                    <tr>
                        <th>Supplier</th>
                        <th>Invoice</th>
                        <th>Invoice date</th>
                        <th>Currency</th>
                        <th class="text-right">Balance</th>
                        <th>Status</th>
                    </tr>
                    </thead>
                    <tbody id="invoiceTableBody">
                    <tr>
                        <td colspan="6">
                            <i class="bi bi-inbox block text-3xl mb-2"></i>
                            Loading invoices…
                        </td>
                    </tr>
                    </tbody>
                </table>
            </div>
        </div>

        <!-- Recent payments -->
        <div class="card" data-card-title="Recent Payments">
            <div class="flex items-center justify-between border-b border-gray-100 px-5 py-4 dark:border-slate-800">
                <div>
                    <h4 class="text-sm font-bold text-gray-900 dark:text-white">Recent Payments</h4>
                    <p class="mt-0.5 text-xs text-gray-500 dark:text-gray-400">Payment activity from the AP payments report</p>
                </div>
                <a href="/Ap/GetApPaymentsReport" target="_blank" rel="noopener"
                   class="text-xs font-semibold text-blue-600 hover:text-blue-700 dark:text-blue-400">
                    View all <i class="bi bi-arrow-right"></i>
                </a>
            </div>
            <div class="table-scroll">
                <table class="data-table">
                    <thead>
                    <tr>
                        <th>Supplier</th>
                        <th>Payment / batch</th>
                        <th>Date</th>
                        <th>Currency</th>
                        <th class="text-right">Amount</th>
                    </tr>
                    </thead>
                    <tbody id="paymentTableBody">
                    <tr>
                        <td colspan="5">
                            <i class="bi bi-credit-card block text-3xl mb-2"></i>
                            Loading payments…
                        </td>
                    </tr>
                    </tbody>
                </table>
            </div>
        </div>
    </div>

    <footer class="py-8 text-center text-xs text-gray-400">
        Accounts Payable dashboard · amounts remain grouped by their source currencies
    </footer>
</div>
       
@*<script src="~/js/ap/Dashboard/ap.js" asp-append-version="true"></script>*@
   

  <script>
        (function () {
            'use strict';

            const endpoints = {
                aging: '/Ap/GetApAgingSummary',
                invoices: '/Ap/GetInvoices',
                payments: '/Ap/GetPayments',
                balances: '/Ap/GetApBalancesReport?status=all',
                suppliers: '/SharedResource/GetSuppliers'
            };

            const byId = id => document.getElementById(id);
            const today = new Date();
            const localToday = new Date(
                today.getTime() - today.getTimezoneOffset() * 60000
            ).toISOString().slice(0, 10);

            byId('asOfDate').value = localToday;
            byId('agingAsOfLabel').textContent = 'As of ' + localToday;

            function escapeHtml(value) {
                return String(value ?? '').replace(/[&<>"']/g, character => ({
                    '&': '&amp;',
                    '<': '&lt;',
                    '>': '&gt;',
                    '"': '&quot;',
                    "'": '&#39;'
                })[character]);
            }

            function property(row, name) {
                if (!row) return undefined;
                const pascalName = name.charAt(0).toUpperCase() + name.slice(1);
                return row[name] ?? row[pascalName];
            }

            function firstValue(row, names) {
                for (const name of names) {
                    const value = property(row, name);
                    if (value !== undefined && value !== null && value !== '') {
                        return value;
                    }
                }
                return '';
            }

            function rowsFrom(raw) {
                if (!raw) return [];
                if (Array.isArray(raw)) return raw;
                if (typeof raw !== 'object') return [];

                const keys = [
                    'result',
                    'items',
                    'data',
                    'invoices',
                    'payments',
                    'balances',
                    'openingBalances',
                    'apOpeningBalances',
                    'suppliers',
                    'records'
                ];

                for (const key of keys) {
                    const pascalKey = key.charAt(0).toUpperCase() + key.slice(1);
                    const value = raw[key] ?? raw[pascalKey];
                    if (Array.isArray(value)) return value;
                }

                for (const key of ['result', 'data']) {
                    const pascalKey = key.charAt(0).toUpperCase() + key.slice(1);
                    const nested = raw[key] ?? raw[pascalKey];
                    if (nested && typeof nested === 'object') {
                        const found = rowsFrom(nested);
                        if (found.length) return found;
                    }
                }

                return [];
            }

            async function fetchRows(url) {
                const response = await fetch(url, {
                    headers: { 'Accept': 'application/json' },
                    credentials: 'same-origin'
                });

                if (!response.ok) {
                    throw new Error('Request failed (' + response.status + ') for ' + url);
                }

                return rowsFrom(await response.json());
            }

            async function safeRows(url, label, issues) {
                try {
                    return await fetchRows(url);
                } catch (error) {
                    console.error(label + ' loading error:', error);
                    issues.push(label);
                    return [];
                }
            }

            function numberValue(value) {
                const parsed = Number(String(value ?? 0).replace(/,/g, ''));
                return Number.isFinite(parsed) ? parsed : 0;
            }

            function formatNumber(value) {
                return new Intl.NumberFormat(undefined, {
                    maximumFractionDigits: 2
                }).format(numberValue(value));
            }

            function formatDate(value) {
                if (!value) return '—';
                const text = String(value);
                const dotNetDate = text.match(/\/Date\((-?\d+)\)\//);
                let date;

                if (dotNetDate) {
                    date = new Date(Number(dotNetDate[1]));
                } else if (/^\d{4}-\d{2}-\d{2}/.test(text)) {
                    const parts = text.slice(0, 10).split('-').map(Number);
                    date = new Date(parts[0], parts[1] - 1, parts[2]);
                } else {
                    date = new Date(text);
                }

                if (Number.isNaN(date.getTime())) return escapeHtml(text);

                return new Intl.DateTimeFormat(undefined, {
                    day: '2-digit',
                    month: 'short',
                    year: 'numeric'
                }).format(date);
            }

            function setCellText(id, value) {
                byId(id).textContent = value;
            }

            function renderAgingChart(rows) {
                const buckets = [
                    { label: 'Current', key: 'currentDay' },
                    { label: '1–30 days', key: 'agingFirst' },
                    { label: '31–60 days', key: 'agingSecond' },
                    { label: '61+ days', key: 'agingThird' }
                ];

                const counts = buckets.map(bucket => ({
                    label: bucket.label,
                    count: rows.filter(row => numberValue(property(row, bucket.key)) > 0).length
                }));

                const max = Math.max(1, ...counts.map(item => item.count));

                byId('agingChart').innerHTML = counts.map(item => {
                    const width = item.count === 0 ? 0 : Math.max(3, (item.count / max) * 100);
                    return '<div class="chart-row">' +
                        '<span class="text-xs font-medium text-slate-500">' + escapeHtml(item.label) + '</span>' +
                        '<div class="chart-track"><div class="chart-fill" style="width:' + width + '%"></div></div>' +
                        '<span class="text-right text-xs font-bold text-slate-700">' + item.count + '</span>' +
                    '</div>';
                }).join('');
            }

            function renderCurrencyChart(rows) {
                const totals = new Map();

                rows.forEach(row => {
                    const currency = String(
                        firstValue(row, ['currencyCode', 'currencyName']) || 'Unspecified'
                    );
                    totals.set(currency, (totals.get(currency) || 0) + 1);
                });

                const values = Array.from(totals.entries())
                    .sort((a, b) => b[1] - a[1])
                    .slice(0, 6);

                if (!values.length) {
                    byId('currencyChart').innerHTML = '';
                    byId('currencyEmpty').classList.remove('hidden');
                    return;
                }

                byId('currencyEmpty').classList.add('hidden');
                const max = Math.max(1, ...values.map(item => item[1]));

                byId('currencyChart').innerHTML = values.map(item => {
                    const width = Math.max(3, (item[1] / max) * 100);
                    return '<div class="chart-row">' +
                        '<span class="truncate text-xs font-medium text-slate-500" title="' + escapeHtml(item[0]) + '">' + escapeHtml(item[0]) + '</span>' +
                        '<div class="chart-track"><div class="chart-fill currency-fill" style="width:' + width + '%"></div></div>' +
                        '<span class="text-right text-xs font-bold text-slate-700">' + item[1] + '</span>' +
                    '</div>';
                }).join('');
            }

            function statusBadge(status) {
                const label = String(status || '—');
                const normalized = label.toLowerCase();
                const color = normalized.includes('cancel')
                    ? 'bg-rose-50 text-rose-700'
                    : normalized.includes('post')
                        ? 'bg-emerald-50 text-emerald-700'
                        : 'bg-amber-50 text-amber-700';

                return '<span class="rounded-full px-2.5 py-1 text-xs font-semibold ' +
                    color + '">' + escapeHtml(label) + '</span>';
            }

            function renderInvoiceTable(rows) {
                const recent = rows.slice().sort((a, b) => {
                    const dateA = String(firstValue(a, ['invoiceDate', 'transactionDate', 'creationTime']));
                    const dateB = String(firstValue(b, ['invoiceDate', 'transactionDate', 'creationTime']));
                    return dateB.localeCompare(dateA);
                }).slice(0, 7);

                if (!recent.length) {
                    byId('invoiceTableBody').innerHTML =
                        '<tr><td colspan="6" class="py-8 text-center text-slate-400">No invoice records returned.</td></tr>';
                    return;
                }

                byId('invoiceTableBody').innerHTML = recent.map(row => {
                    const supplier = firstValue(row, ['supplierName', 'name']);
                    const invoice = firstValue(row, ['invoiceNumber', 'invoiceNo']);
                    const date = firstValue(row, ['invoiceDate', 'transactionDate', 'creationTime']);
                    const currency = firstValue(row, ['currencyCode', 'currencyName']);
                    const balance = firstValue(row, ['balance', 'invoiceBalance', 'amount']);
                    const status = firstValue(row, ['statusName', 'status', 'isPosted']);

                    return '<tr>' +
                        '<td class="font-medium text-slate-800">' + escapeHtml(supplier || '—') + '</td>' +
                        '<td>' + escapeHtml(invoice || '—') + '</td>' +
                        '<td>' + formatDate(date) + '</td>' +
                        '<td>' + escapeHtml(currency || '—') + '</td>' +
                        '<td class="text-right font-semibold tabular-nums">' + formatNumber(balance) + '</td>' +
                        '<td>' + statusBadge(status === true ? 'Posted' : status === false ? 'Unposted' : status) + '</td>' +
                    '</tr>';
                }).join('');
            }

            function renderPaymentTable(rows) {
                const recent = rows.slice().sort((a, b) => {
                    const dateA = String(firstValue(a, ['transactionDate', 'paymentDate', 'creationTime']));
                    const dateB = String(firstValue(b, ['transactionDate', 'paymentDate', 'creationTime']));
                    return dateB.localeCompare(dateA);
                }).slice(0, 6);

                if (!recent.length) {
                    byId('paymentTableBody').innerHTML =
                        '<tr><td colspan="5" class="py-8 text-center text-slate-400">No payment records returned.</td></tr>';
                    return;
                }

                byId('paymentTableBody').innerHTML = recent.map(row => {
                    const supplier = firstValue(row, ['supplierName', 'name']);
                    const reference = firstValue(row, ['paymentNumber', 'voucherNumber', 'batchNumber', 'referenceNumber']);
                    const date = firstValue(row, ['transactionDate', 'paymentDate', 'creationTime']);
                    const currency = firstValue(row, ['currencyCode', 'currencyName']);
                    const amount = firstValue(row, ['amount', 'paidAmount', 'totalAmount']);

                    return '<tr>' +
                        '<td class="font-medium text-slate-800">' + escapeHtml(supplier || '—') + '</td>' +
                        '<td>' + escapeHtml(reference || '—') + '</td>' +
                        '<td>' + formatDate(date) + '</td>' +
                        '<td>' + escapeHtml(currency || '—') + '</td>' +
                        '<td class="text-right font-semibold tabular-nums">' + formatNumber(amount) + '</td>' +
                    '</tr>';
                }).join('');
            }

            function updateActionLinks() {
                const startDate = byId('asOfDate').value || localToday;
                const interval = byId('agingInterval').value || '30';
                const endDate = localToday;

                byId('agingAction').href =
                    endpoints.aging +
                    '?startDate=' + encodeURIComponent(startDate) +
                    '&agingInterval=' + encodeURIComponent(interval);

                byId('glAction').href =
                    '/Ap/GetApGlTransaction' +
                    '?startDate=' + encodeURIComponent(startDate) +
                    '&endDate=' + encodeURIComponent(endDate) +
                    '&isMultiCurrency=false';
            }

            function showIssues(issues) {
                const notice = byId('loadNotice');

                if (!issues.length) {
                    notice.classList.add('hidden');
                    notice.textContent = '';
                    return;
                }

                notice.textContent =
                    'Some dashboard data could not be loaded: ' + issues.join(', ') + '.';
                notice.classList.remove('hidden');
            }

            async function loadDashboard() {
                const button = byId('refreshButton');
                const issues = [];
                const startDate = byId('asOfDate').value || localToday;
                const interval = byId('agingInterval').value || '30';

                button.disabled = true;
                button.textContent = 'Loading…';
                button.classList.add('loading-pulse');
                byId('agingAsOfLabel').textContent = 'As of ' + startDate;
                updateActionLinks();

                const agingUrl = endpoints.aging +
                    '?startDate=' + encodeURIComponent(startDate) +
                    '&agingInterval=' + encodeURIComponent(interval);

                const [agingRows, invoices, payments, balances, suppliers] =
                    await Promise.all([
                        safeRows(agingUrl, 'Aging summary', issues),
                        safeRows(endpoints.invoices, 'Invoices', issues),
                        safeRows(endpoints.payments, 'Payments', issues),
                        safeRows(endpoints.balances, 'Opening balances', issues),
                        safeRows(endpoints.suppliers, 'Suppliers', issues)
                    ]);

                const openInvoices = invoices.filter(row => {
                    const balance = firstValue(row, ['balance', 'invoiceBalance']);
                    return balance === '' || numberValue(balance) > 0;
                });

                setCellText('openInvoiceCount', formatNumber(openInvoices.length));
                setCellText('supplierCount', formatNumber(suppliers.length));
                setCellText('paymentCount', formatNumber(payments.length));
                setCellText('openingBalanceCount', formatNumber(balances.length));

                renderAgingChart(agingRows);
                renderCurrencyChart(invoices);
                renderInvoiceTable(invoices);
                renderPaymentTable(payments);
                showIssues(issues);

                button.disabled = false;
                button.textContent = 'Refresh data';
                button.classList.remove('loading-pulse');
            }

            byId('refreshButton').addEventListener('click', loadDashboard);
            byId('asOfDate').addEventListener('change', updateActionLinks);
            byId('agingInterval').addEventListener('change', updateActionLinks);

            updateActionLinks();
            loadDashboard();
        })();
    </script>


