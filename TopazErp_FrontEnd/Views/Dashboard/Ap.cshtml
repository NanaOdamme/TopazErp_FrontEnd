@{
ViewBag.Title = "Dashboard | Ap";
Layout = "~/Views/Shared/_adminApLayout.cshtml";
}
<style>
    .hover-card:hover {
        transform: scale(1.03); 
        box-shadow: 0 4px 15px rgba(42, 42, 43, 0.15);
        border: 1px solid #7cb7e8;
        border-radius: 15px;
      
    }
    .invoices{
        border-bottom: 1px solid #7cb7e8;
       /* border-top: 1px solid #7cb7e8;*/
        box-shadow: 0 4px 15px rgba(0, 0, 0, 0.03);
        margin-bottom: 2px;
      
    }
    .card{
        transition: transform 0.2s, box-shadow 0.2s;
        box-shadow: 0 2px 8px rgba(0, 0, 0, 0.03) !important;
    }
    .icon-circle {
        width: 50px;
        height: 50px;
        border-radius: 50%;
        background: rgba(255, 255, 255, 0.2);
        display: flex;
        align-items: center;
        justify-content: center;
    }

    .icon-circle i {
        font-size: 20px;
        color: #fff;
    }
    .number-cards{
        font-family: "Inter";
    }
</style>
<div class="content" id="app">
    
    <section id="number-cards" class="number-cards mb-5">
        <div class="grid grid-cols-1 md:grid-cols-2 xl:grid-cols-4 gap-6">
            <div class="dark:bg-none rounded-2xl bg-gradient-to-r from-sky-800 via-sky-600 to-sky-500 p-5 text-white shadow-lg dark:bg-sky-950">
                <div class="flex items-center gap-4">
                    <div class="icon-circle">
                        <i class="bi bi-people-fill text-2xl"></i>
                    </div>
                    <div class="text-left">
                        <h1 class="text-2xl font-bold leading-none">
                            2150
                        </h1>

                        <p class="mt-2 text-sm font-medium text-white/80">
                            Total Suppliers
                        </p>
                    </div>

                

            </div>
            </div>
            <div class="dark:bg-none rounded-2xl bg-gradient-to-r from-sky-500 via-sky-600 to-sky-800 p-5 text-white shadow-lg dark:bg-sky-950">
                <div class="flex items-center gap-4">
                    <div class="icon-circle">
                        <i class="bi bi-card-list text-2xl"></i>
                    </div>
                    <div class="text-left">
                        <h1 class="text-2xl font-bold leading-none">
                            54
                        </h1>

                        <p class="mt-2 text-sm font-medium text-white/80">
                            Total Invoices
                        </p>
                    </div>

                

                </div>
            </div>
            <div class="dark:bg-none rounded-2xl bg-gradient-to-r from-sky-800 via-sky-600 to-sky-500 p-5 text-white shadow-lg dark:bg-sky-950">
                <div class="flex items-center gap-4">
                    <div class="icon-circle">
                        <i class="bi bi-box-arrow-in-up text-2xl"></i>
                    </div>
                    <div class="text-left">
                        <h1 class="text-2xl font-bold leading-none">
                            54
                        </h1>

                        <p class="mt-2 text-sm font-medium text-white/80">
                            Posted Invoices
                        </p>
                    </div>

                

                </div>
            </div>
            <div class="dark:bg-none rounded-2xl bg-gradient-to-r from-sky-500 via-sky-600 to-sky-800 p-5 text-white shadow-lg dark:bg-sky-950">
                <div class="flex items-center gap-4">
                    <div class="icon-circle">
                        <i class="bi bi-bank text-2xl"></i>
                    </div>
                    <div class="text-left">
                        <h1 class="text-2xl font-bold leading-none">
                            14
                        </h1>

                        <p class="mt-2 text-sm font-medium text-white/80">
                            Posted Payments
                        </p>
                    </div>

                

                </div>
            </div>
    </div>
    </section>
   <section id="c3-pie-bar-charts">
       <div class="grid grid-cols-1 md:grid-cols-1 xl:grid-cols-2 gap-6">
           <div class="card " data-card-title="Invoice Analysis">
               <div class="p-5">
                   <canvas id="invoiceChart"></canvas>
               </div>
              
           </div>
            <div class="card " data-card-title="Invoices">
                    <div class="p-5" style="height: 300px; overflow: auto;">
                        <div class="grid grid-cols-1">
                            <div v-for="invoice in paginatedInvoices" :key="invoice.id">
                                <div class="invoices hover-card p-1 d-flex justify-content-between align-items-center"
                                    style="cursor:pointer; transition: transform 0.2s;"
                                    @@click="printReport(invoice.id)">
                                    <div class="d-flex align-items-center">
                                        <div>
                                            <div class="text-sky-500"><strong>{{ invoice.supplierName }}</strong></div>
                                            <div class="text-muted" style="font-size: 12px;">Inv #: {{ invoice.invoiceNumber }}</div>
                                        </div>
                                    </div>
                                        <div class="text-end d-flex ">
                                            <div class="text-success mr-1" style="font-size: 12px; ">{{ invoice.currencyCode }}</div>
                                            <div style="font-size: 12px; font-weight: bold;">{{ parseFloat(invoice.totalInvoiceAmount).toFixed(2) }}</div>
                                        </div>
                                   
                                </div>
                            </div>
                        </div>

                        <!-- Pagination Controls -->
                        <div class="pagination-controls flex justify-center mt-5" style="font-size: 11px">
                            <button class="text-xs bg-sky-500 text-white mx-2 py-1 px-2 rounded" @@click="prevPage" :disabled="currentPage === 1">Previous</button>
                            <span>Page {{ currentPage }} of {{ totalPages }}</span>
                            <button class="text-xs bg-sky-500 text-white mx-2 py-1 px-2 rounded" @@click="nextPage" :disabled="currentPage === totalPages">Next</button>
                        </div>

                    </div>
            </div>
            
            <div class="card " data-card-title="Opening Balances">
              
<div class="max-h-[200px] overflow-auto rounded-xl border border-slate-200 dark:border-slate-700">

    <table class="w-full min-w-[600px] text-left text-xs">

        <!-- Table Header -->
        <thead class="sticky top-0 z-10 bg-slate-100 text-[11px] uppercase tracking-wide text-slate-500 dark:bg-slate-800 dark:text-slate-400">
            <tr>

                <th
                    class="cursor-pointer whitespace-nowrap px-4 py-3 font-semibold transition-colors hover:text-sky-600 dark:hover:text-sky-400"
                    @@click="sortBTable('supplierName')"
                >
                    <div class="flex items-center gap-1">
                        <span>Supplier</span>

                        <span
                            v-if="bSortKey === 'supplierName'"
                            class="text-sky-600 dark:text-sky-400"
                        >
                            {{ sortOrder === 'asc' ? '↑' : '↓' }}
                        </span>
                    </div>
                </th>

                <th
                    class="cursor-pointer whitespace-nowrap px-4 py-3 font-semibold transition-colors hover:text-sky-600 dark:hover:text-sky-400"
                    @@click="sortBTable('amount')"
                >
                    <div class="flex items-center gap-1">
                        <span>Amount</span>

                        <span
                            v-if="bSortKey === 'amount'"
                            class="text-sky-600 dark:text-sky-400"
                        >
                            {{ sortOrder === 'asc' ? '↑' : '↓' }}
                        </span>
                    </div>
                </th>

                <th
                    class="cursor-pointer whitespace-nowrap px-4 py-3 font-semibold transition-colors hover:text-sky-600 dark:hover:text-sky-400"
                    @@click="sortBTable('transactionDate')"
                >
                    <div class="flex items-center gap-1">
                        <span>Date</span>

                        <span
                            v-if="bSortKey === 'transactionDate'"
                            class="text-sky-600 dark:text-sky-400"
                        >
                            {{ sortOrder === 'asc' ? '↑' : '↓' }}
                        </span>
                    </div>
                </th>

                <th
                    class="cursor-pointer whitespace-nowrap px-4 py-3 font-semibold transition-colors hover:text-sky-600 dark:hover:text-sky-400"
                    @@click="sortBTable('currencyCode')"
                >
                    <div class="flex items-center gap-1">
                        <span>Currency</span>

                        <span
                            v-if="bSortKey === 'currencyCode'"
                            class="text-sky-600 dark:text-sky-400"
                        >
                            {{ sortOrder === 'asc' ? '↑' : '↓' }}
                        </span>
                    </div>
                </th>

            </tr>
        </thead>

        <!-- Table Body -->
        <tbody class="divide-y divide-slate-100 dark:divide-slate-800">

            <tr
                v-for="balance in paginatedBalances"
                :key="balance.supplierName"
                class="group transition-colors hover:bg-sky-50 dark:hover:bg-slate-800/70"
            >

                <!-- Supplier -->
                <td class="px-4 py-3">

                    <div class="flex items-center gap-2.5">

                        <div class="flex h-8 w-8 shrink-0 items-center justify-center rounded-full border border-sky-200 bg-sky-50 text-sky-600 dark:border-sky-800 dark:bg-sky-950/50 dark:text-sky-400">
                            <i class="bi bi-person-fill text-xs"></i>
                        </div>

                        <span class="max-w-[180px] truncate font-medium text-slate-700 dark:text-slate-200">
                            {{ balance.supplierName }}
                        </span>

                    </div>

                </td>

                <!-- Amount -->
                <td class="whitespace-nowrap px-4 py-3 font-semibold text-slate-700 dark:text-slate-200">
                    {{ parseFloat(balance.amount).toFixed(2) }}
                </td>

                <!-- Date -->
                <td class="whitespace-nowrap px-4 py-3 text-slate-500 dark:text-slate-400">
                    {{ balance.transactionDate }}
                </td>

                <!-- Currency -->
                <td class="px-4 py-3">

                    <span class="inline-flex rounded-md bg-emerald-50 px-2 py-1 text-[10px] font-semibold uppercase text-emerald-600 dark:bg-emerald-950/40 dark:text-emerald-400">
                        {{ balance.currencyCode }}
                    </span>

                </td>

            </tr>

            <!-- Empty State -->
            <tr v-if="paginatedBalances.length === 0">

                <td
                    colspan="4"
                    class="px-4 py-8 text-center text-slate-500 dark:text-slate-400"
                >
                    <div class="flex flex-col items-center justify-center gap-2">

                        <i class="bi bi-inbox text-2xl text-slate-300 dark:text-slate-600"></i>

                        <span>No opening balances found.</span>

                    </div>
                </td>

            </tr>

        </tbody>

    </table>

</div>


                        <div class="pagination-controls d-flex justify-content-center m-2">
                            <button  class="text-xs bg-sky-500 text-white mx-2 py-1 px-2 rounded" @@click="prevBPage" :disabled="currentBPage === 1">Previous</button>
                            <span>Page {{ currentBPage }} of {{ totalBPages }}</span>
                            <button class="text-xs bg-sky-500 text-white mx-2 py-1 px-2 rounded" @@click="nextBPage" :disabled="currentBPage === totalBPages">Next</button>
                        </div>

            
            </div>
            <div class="card " data-card-title="Invoice Payments">
                <div class="p-5" style="height: 300px">
                    <canvas id="supplierChart"></canvas>
                </div>
                       
                
            </div>
       


    </div>

   
  

    </section>
</div>




@*<script src="~/js/Ap/Dashboard/ap.js" asp-append-version="true"></script>*@
<script>
 

const { createApp } = Vue;

// ---- Dummy data -----------------------------------------------------------
const supplierNames = [
"Accra Office Supplies Ltd",
"Kumasi Steel Works",
"Tema Logistics Co.",
"Golden Palm Foods",
"Takoradi Marine Services",
"Ashanti Print House",
"Volta Fresh Produce",
"Cape Coast Hardware",
"Sunyani Timber Mills",
"Tamale Agro Traders",
"Osu Tech Solutions",
"Ho Water Systems"
];

const dummyInvoices = Array.from({ length: 23 }, (_, i) => ({
id: i + 1,
supplierName: supplierNames[i % supplierNames.length],
invoiceNumber: `INV-2026-${String(1001 + i)}`,
currencyCode: i % 6 === 5 ? "USD" : "GHS",
totalInvoiceAmount: (((i * 7919) % 9000) + 350 + 0.35).toFixed(2),
// spread invoices across Apr - Oct 2026
invoiceDate: new Date(2026, 3 + (i % 7), 1 + ((i * 3) % 27)).toISOString().slice(0, 10),
isPosted: i % 4 !== 0
}));

const dummyBalances = [
{ supplierName: "Accra Office Supplies Ltd", amount: 12450.0, transactionDate: "2026-01-02", currencyCode: "GHS" },
{ supplierName: "Kumasi Steel Works", amount: 58200.5, transactionDate: "2026-01-02", currencyCode: "GHS" },
{ supplierName: "Tema Logistics Co.", amount: 9800.75, transactionDate: "2026-01-05", currencyCode: "GHS" },
{ supplierName: "Golden Palm Foods", amount: 23100.0, transactionDate: "2026-01-05", currencyCode: "GHS" },
{ supplierName: "Takoradi Marine Services", amount: 4300.0, transactionDate: "2026-01-08", currencyCode: "USD" },
{ supplierName: "Ashanti Print House", amount: 7650.25, transactionDate: "2026-01-10", currencyCode: "GHS" },
{ supplierName: "Volta Fresh Produce", amount: 15920.0, transactionDate: "2026-01-12", currencyCode: "GHS" },
{ supplierName: "Cape Coast Hardware", amount: 31400.9, transactionDate: "2026-01-15", currencyCode: "GHS" },
{ supplierName: "Sunyani Timber Mills", amount: 2750.0, transactionDate: "2026-01-15", currencyCode: "USD" },
{ supplierName: "Tamale Agro Traders", amount: 18890.4, transactionDate: "2026-01-20", currencyCode: "GHS" },
{ supplierName: "Osu Tech Solutions", amount: 41250.0, transactionDate: "2026-01-22", currencyCode: "GHS" },
{ supplierName: "Ho Water Systems", amount: 6120.0, transactionDate: "2026-01-25", currencyCode: "GHS" }
];

const dummyPayments = [
{ supplierName: "Kumasi Steel Works", amount: 48000 },
{ supplierName: "Osu Tech Solutions", amount: 36500 },
{ supplierName: "Cape Coast Hardware", amount: 27800 },
{ supplierName: "Golden Palm Foods", amount: 19400 },
{ supplierName: "Tamale Agro Traders", amount: 14250 },
{ supplierName: "Other Suppliers", amount: 22100 }
];

// ---- App ------------------------------------------------------------------
createApp({
data() {
return {
// number cards
stats: {
totalSuppliers: 2150,
totalInvoices: 54,
postedInvoices: 54,
postedPayments: 14
},

// invoices list
invoices: dummyInvoices,
currentPage: 1,
pageSize: 5,

// opening balances table
balances: dummyBalances,
currentBPage: 1,
bPageSize: 5,
bSortKey: "supplierName",
sortOrder: "asc",

// payments chart data
payments: dummyPayments
};
},

computed: {
// invoices pagination
totalPages() {
return Math.max(1, Math.ceil(this.invoices.length / this.pageSize));
},
paginatedInvoices() {
const start = (this.currentPage - 1) * this.pageSize;
return this.invoices.slice(start, start + this.pageSize);
},

// balances sorting + pagination
sortedBalances() {
const key = this.bSortKey;
const dir = this.sortOrder === "asc" ? 1 : -1;
return [...this.balances].sort((a, b) => {
const x = a[key];
const y = b[key];
if (typeof x === "number" && typeof y === "number") return (x - y) * dir;
return String(x).localeCompare(String(y)) * dir;
});
},
totalBPages() {
return Math.max(1, Math.ceil(this.balances.length / this.bPageSize));
},
paginatedBalances() {
const start = (this.currentBPage - 1) * this.bPageSize;
return this.sortedBalances.slice(start, start + this.bPageSize);
},

// chart data: invoice totals per month, posted vs unposted
invoiceChartData() {
const months = ["Apr", "May", "Jun", "Jul", "Aug", "Sep", "Oct"];
const posted = Array(7).fill(0);
const unposted = Array(7).fill(0);
this.invoices.forEach(inv => {
const idx = new Date(inv.invoiceDate).getMonth() - 3;
if (idx < 0 || idx > 6) return;
const amt = parseFloat(inv.totalInvoiceAmount);
if (inv.isPosted) posted[idx] += amt;
else unposted[idx] += amt;
});
return { months, posted, unposted };
}
},

methods: {
// invoices pagination
prevPage() {
if (this.currentPage > 1) this.currentPage--;
},
nextPage() {
if (this.currentPage < this.totalPages) this.currentPage++;
},

// balances pagination + sorting
prevBPage() {
if (this.currentBPage > 1) this.currentBPage--;
},
nextBPage() {
if (this.currentBPage < this.totalBPages) this.currentBPage++;
},
sortBTable(key) {
if (this.bSortKey === key) {
this.sortOrder = this.sortOrder === "asc" ? "desc" : "asc";
} else {
this.bSortKey = key;
this.sortOrder = "asc";
}
this.currentBPage = 1;
},

// replace with your real report call, e.g. window.open(`/Reports/Invoice?id=${id}`, "_blank")
printReport(id) {
console.log("Print report for invoice id:", id);
},

renderCharts() {
const isDark = document.documentElement.classList.contains("dark");
const textColor = isDark ? "#cbd5e1" : "#475569";
const gridColor = isDark ? "rgba(148,163,184,0.15)" : "rgba(100,116,139,0.15)";
Chart.defaults.color = textColor;

// Chart instances are kept off `data` so Vue doesn't make them reactive
this._charts = this._charts || {};
Object.values(this._charts).forEach(c => c.destroy());

const { months, posted, unposted } = this.invoiceChartData;

this._charts.invoice = new Chart(document.getElementById("invoiceChart"), {
type: "bar",
data: {
labels: months,
datasets: [
{ label: "Posted", data: posted, backgroundColor: "#0ea5e9", borderRadius: 4 },
{ label: "Unposted", data: unposted, backgroundColor: "#f59e0b", borderRadius: 4 }
]
},
options: {
responsive: true,
plugins: { legend: { position: "bottom" } },
scales: {
x: { stacked: true, grid: { color: gridColor } },
y: { stacked: true, grid: { color: gridColor } }
}
}
});

this._charts.supplier = new Chart(document.getElementById("supplierChart"), {
type: "doughnut",
data: {
labels: this.payments.map(p => p.supplierName),
datasets: [{
data: this.payments.map(p => p.amount),
backgroundColor: ["#0ea5e9", "#06b6d4", "#10b981", "#f59e0b", "#8b5cf6", "#94a3b8"],
borderWidth: 0
}]
},
options: {
responsive: true,
plugins: { legend: { position: "bottom" } }
}
});
}
},

mounted() {
this.renderCharts();
},

beforeUnmount() {
if (this._charts) Object.values(this._charts).forEach(c => c.destroy());
}
}).mount("#app");    
</script>

