@{
    ViewBag.Title = "Dashboard | School Manager";
    Layout = "~/Views/Shared/_adminSchoolManagerLayout.cshtml";
}
<style>
    [v-cloak] { display: none; }
    .school-scroll::-webkit-scrollbar { width: 8px; height: 8px; }
    .school-scroll::-webkit-scrollbar-thumb { border-radius: 9999px; background: rgba(100,116,139,.3); }
    .school-line { stroke-dasharray: 1; stroke-dashoffset: 1; transition: stroke-dashoffset 1.15s cubic-bezier(.22,1,.36,1); }
    .school-line.is-drawn { stroke-dashoffset: 0; }
    @@media (prefers-reduced-motion: reduce) { .school-line { transition: none; } }
</style>
<div class="content" id="schoolDashboard" v-cloak>
    <section class="relative mb-6 overflow-hidden rounded-2xl border border-slate-200/80 bg-white shadow-sm dark:border-slate-700/70 dark:bg-slate-800">
        <div class="pointer-events-none absolute -right-24 -top-32 h-72 w-72 rounded-full bg-gradient-to-br from-blue-600/25 via-cyan-300/15 to-transparent blur-3xl"></div>
        <div class="pointer-events-none absolute -bottom-36 left-1/3 h-64 w-64 rounded-full bg-gradient-to-tr from-emerald-300/20 to-transparent blur-3xl"></div>
        <div class="relative flex flex-wrap items-start justify-between gap-6 p-6">
            <div>
                <h2 class="text-2xl font-bold tracking-tight text-slate-900 dark:text-white">School Manager</h2>
                <p class="mt-1 max-w-xl text-sm text-slate-500 dark:text-slate-400">Your school at a glance — students, staff, assessments and payments.</p>
                <div class="mt-4 flex flex-wrap items-center gap-2">
                    <span class="inline-flex items-center gap-1.5 rounded-full border border-emerald-200 bg-emerald-50 px-2.5 py-1 text-[11px] font-semibold text-emerald-700 dark:border-emerald-500/20 dark:bg-emerald-500/10 dark:text-emerald-300"><span class="h-1.5 w-1.5 rounded-full bg-emerald-500"></span>Dashboard</span>
                    <span class="rounded-full border border-slate-200 bg-white px-2.5 py-1 text-[11px] text-slate-500 dark:border-slate-700 dark:bg-slate-800 dark:text-slate-400"><i class="bi bi-clock-history"></i> Last refresh {{ lastUpdatedLabel }}</span>
                </div>
            </div>
            <button type="button" v-on:click="loadDashboard" :disabled="isLoading" class="inline-flex items-center gap-2 rounded-xl bg-gradient-to-r from-blue-800 to-blue-600 px-4 py-2.5 text-sm font-semibold text-white shadow-lg shadow-blue-800/20 transition hover:shadow-blue-800/30 disabled:cursor-not-allowed disabled:opacity-60"><i class="bi bi-arrow-clockwise" :class="{ 'animate-spin': isLoading }"></i> Refresh</button>
        </div>
    </section>
    <div v-if="loadIssues.length" role="alert" class="mb-6 rounded-2xl border border-amber-200 bg-amber-50/80 p-4 text-xs text-amber-800 dark:border-amber-500/20 dark:bg-amber-500/10 dark:text-amber-200"><i class="bi bi-exclamation-triangle-fill"></i> Some data could not be loaded: <strong>{{ loadIssues.join(', ') }}</strong>. Related figures are unavailable.</div>

    <div class="mb-6 grid grid-cols-1 gap-4 sm:grid-cols-2 lg:grid-cols-3 xl:grid-cols-5">
        <article v-for="card in cards" :key="card.label" class="group relative overflow-hidden rounded-2xl border border-slate-200/80 bg-white p-5 shadow-sm transition duration-300 hover:-translate-y-1 hover:shadow-xl hover:shadow-slate-200/60 dark:border-slate-700/70 dark:bg-slate-800 dark:hover:shadow-slate-900/60">
            <div class="absolute inset-x-0 top-0 h-1" :style="{ background: card.gradient }"></div>
            <div class="flex items-start justify-between gap-3"><div class="min-w-0"><p class="text-[11px] font-semibold uppercase tracking-wider text-slate-400">{{ card.label }}</p><h3 class="mt-2 text-3xl font-bold tabular-nums tracking-tight text-slate-900 dark:text-white">{{ card.value }}</h3><p class="mt-1 text-xs text-slate-400">{{ card.caption }}</p></div><span class="flex h-11 w-11 shrink-0 items-center justify-center rounded-xl bg-indigo-50 text-indigo-600 transition group-hover:scale-110 dark:bg-indigo-500/10 dark:text-indigo-300"><i class="bi text-lg" :class="card.icon"></i></span></div>
        </article>
    </div>

    <div class="mb-6 grid grid-cols-1 gap-4 xl:grid-cols-3">
        <section class="overflow-hidden rounded-2xl border border-slate-200/80 bg-white shadow-sm dark:border-slate-700/70 dark:bg-slate-800 xl:col-span-2">
            <div class="border-b border-slate-100 p-5 dark:border-slate-700/70"><h4 class="flex items-center gap-2 text-sm font-bold text-slate-900 dark:text-white"><i class="bi bi-graph-up-arrow text-indigo-500"></i> Admission Trend</h4><p class="mt-0.5 text-xs text-slate-500 dark:text-slate-400">Students by admission month · latest 12 months in the data</p></div>
            <div v-if="hasIssue('Students')" class="p-12 text-center text-sm text-slate-400">Could not load students.</div>
            <div v-else-if="isLoading && !students.length" class="h-64 animate-pulse bg-slate-50 dark:bg-slate-700/30"></div>
            <div v-else-if="!admissionChart.points.length" class="flex h-64 flex-col items-center justify-center text-sm text-slate-400"><i class="bi bi-graph-up mb-2 text-3xl"></i>No admission dates available.</div>
            <div v-else class="school-scroll h-[290px] overflow-x-auto p-3"><svg viewBox="0 0 960 270" class="h-full w-full min-w-[620px]" role="img" aria-label="Students admitted by month">
                <defs><linearGradient id="schoolArea" x1="0" y1="0" x2="0" y2="1"><stop offset="0%" stop-color="#1d4ed8" stop-opacity=".3"></stop><stop offset="100%" stop-color="#1d4ed8" stop-opacity="0"></stop></linearGradient></defs>
                <line v-for="tick in admissionChart.ticks" :key="tick.value" x1="55" x2="940" :y1="tick.y" :y2="tick.y" class="stroke-slate-200 dark:stroke-slate-700" stroke-dasharray="4 6"></line>
                <text v-for="tick in admissionChart.ticks" :key="'t'+tick.value" x="45" :y="tick.y+4" text-anchor="end" class="fill-slate-400 text-[12px]">{{ tick.value }}</text>
                <path :d="admissionChart.area" fill="url(#schoolArea)"></path><path :d="admissionChart.line" fill="none" stroke="#1d4ed8" stroke-width="3" stroke-linejoin="round" pathLength="1" class="school-line" :class="{ 'is-drawn': chartReady }"></path>
                <circle v-for="p in admissionChart.points" :key="p.key" :cx="p.x" :cy="p.y" r="4" fill="white" stroke="#1d4ed8" stroke-width="2"><title>{{ p.label }}: {{ p.count }} admissions</title></circle>
                <text v-for="p in admissionChart.points" :key="'x'+p.key" :x="p.x" y="257" text-anchor="middle" class="fill-slate-400 text-[11px]">{{ p.label }}</text>
            </svg></div>
        </section>
        <section class="overflow-hidden rounded-2xl border border-slate-200/80 bg-white shadow-sm dark:border-slate-700/70 dark:bg-slate-800">
            <div class="border-b border-slate-100 p-5 dark:border-slate-700/70"><h4 class="flex items-center gap-2 text-sm font-bold text-slate-900 dark:text-white"><i class="bi bi-pie-chart text-violet-500"></i> School Community</h4><p class="mt-0.5 text-xs text-slate-500 dark:text-slate-400">Breakdown of student and staff records</p></div>
            <div class="space-y-5 p-5">
                <div v-for="group in community" :key="group.label"><div class="mb-2 flex justify-between gap-2 text-xs"><span class="font-semibold text-slate-700 dark:text-slate-200">{{ group.label }}</span><span class="text-slate-400">{{ group.text }}</span></div><div class="h-2.5 overflow-hidden rounded-full bg-slate-100 dark:bg-slate-700"><div class="h-full rounded-full transition-all duration-700" :style="{ width: group.percent + '%', backgroundColor: group.color }"></div></div></div>
            </div>
        </section>
    </div>
    <div class="mb-6 grid grid-cols-1 gap-4 xl:grid-cols-3">
        <section class="overflow-hidden rounded-2xl border border-slate-200/80 bg-white shadow-sm dark:border-slate-700/70 dark:bg-slate-800 xl:col-span-2">
            <div class="border-b border-slate-100 p-5 dark:border-slate-700/70"><h4 class="flex items-center gap-2 text-sm font-bold text-slate-900 dark:text-white"><i class="bi bi-bar-chart text-sky-500"></i> Assessments by Type</h4><p class="mt-0.5 text-xs text-slate-500 dark:text-slate-400">Non-canceled records from GetResults · all academic years</p></div>
            <div v-if="hasIssue('Results')" class="p-12 text-center text-sm text-slate-400">Could not load results.</div>
            <div v-else-if="isLoading && !results.length" class="h-48 animate-pulse bg-slate-50 dark:bg-slate-700/30"></div>
            <div v-else class="space-y-3 p-5"><div v-for="item in assessmentTypes" :key="item.label" class="flex items-center gap-3"><span class="w-28 shrink-0 text-xs font-semibold text-slate-600 dark:text-slate-300">{{ item.label }}</span><div class="h-3 flex-1 overflow-hidden rounded-full bg-slate-100 dark:bg-slate-700"><div class="h-full rounded-full" :style="{ width: item.width + '%', backgroundColor: item.color }"></div></div><span class="w-12 text-right text-xs font-bold tabular-nums text-slate-700 dark:text-slate-200">{{ formatCount(item.count) }}</span></div><p v-if="!activeResults.length" class="pt-2 text-xs text-slate-400">No non-canceled assessments found.</p></div>
        </section>
        <section class="overflow-hidden rounded-2xl border border-slate-200/80 bg-white shadow-sm dark:border-slate-700/70 dark:bg-slate-800">
            <div class="border-b border-slate-100 p-5 dark:border-slate-700/70"><h4 class="flex items-center gap-2 text-sm font-bold text-slate-900 dark:text-white"><i class="bi bi-cash-stack text-emerald-500"></i> Payments by Currency</h4><p class="mt-0.5 text-xs text-slate-500 dark:text-slate-400">Non-canceled payments · amounts kept separate by currency</p></div>
            <div v-if="hasIssue('Payments')" class="p-10 text-center text-xs text-slate-400">Could not load payments.</div><div v-else-if="isLoading && !payments.length" class="h-32 animate-pulse bg-slate-50 dark:bg-slate-700/30"></div><div v-else-if="!paymentGroups.length" class="p-10 text-center text-xs text-slate-400">No payments found.</div>
            <ul v-else class="divide-y divide-slate-100 dark:divide-slate-700/60"><li v-for="group in paymentGroups" :key="group.id" class="flex items-center justify-between gap-3 px-5 py-3"><span class="min-w-0"><span class="block break-all text-xs font-semibold text-slate-700 dark:text-slate-200">{{ group.name }}</span><span class="text-[11px] text-slate-400">{{ formatCount(group.count) }} payments</span></span><span class="shrink-0 text-sm font-bold tabular-nums text-emerald-600">{{ formatAmount(group.total) }}</span></li></ul>
            <p class="border-t border-slate-100 px-5 py-3 text-[11px] text-slate-400 dark:border-slate-700/70">Includes posted and unposted records. Currency IDs are shown if a name is unavailable.</p>
        </section>
    </div>
    <div class="mb-6 grid grid-cols-1 gap-4 xl:grid-cols-3">
        <section class="overflow-hidden rounded-2xl border border-slate-200/80 bg-white shadow-sm dark:border-slate-700/70 dark:bg-slate-800 xl:col-span-2">
            <div class="border-b border-slate-100 p-5 dark:border-slate-700/70"><h4 class="flex items-center gap-2 text-sm font-bold text-slate-900 dark:text-white"><i class="bi bi-mortarboard text-indigo-500"></i> Recent Students</h4><p class="mt-0.5 text-xs text-slate-500 dark:text-slate-400">Most recent admission dates · includes alumni</p></div>
            <div class="school-scroll max-h-[340px] overflow-auto"><table class="w-full min-w-[650px] text-left text-xs"><thead class="sticky top-0 bg-slate-50 text-[11px] uppercase tracking-wider text-slate-500 dark:bg-slate-900 dark:text-slate-400"><tr><th class="px-5 py-3">Student</th><th class="px-5 py-3">Identifier</th><th class="px-5 py-3">Class</th><th class="px-5 py-3">Admission</th><th class="px-5 py-3">Category</th></tr></thead><tbody class="divide-y divide-slate-100 dark:divide-slate-700/60"><tr v-if="isLoading && !students.length"><td colspan="5" class="px-5 py-10 text-center text-slate-400">Loading students…</td></tr><tr v-else-if="hasIssue('Students')"><td colspan="5" class="px-5 py-10 text-center text-slate-400">Could not load students.</td></tr><tr v-else-if="!recentStudents.length"><td colspan="5" class="px-5 py-10 text-center text-slate-400">No students found.</td></tr><tr v-for="(row, i) in recentStudents" :key="value(row, 'id') || i" class="hover:bg-slate-50 dark:hover:bg-slate-700/40"><td class="px-5 py-3 font-semibold text-slate-800 dark:text-slate-100">{{ fullName(row) }}</td><td class="px-5 py-3 text-slate-500">{{ value(row, 'studentIdentifier') || '—' }}</td><td class="px-5 py-3 text-slate-500">{{ className(row) }}</td><td class="px-5 py-3 text-slate-500">{{ formatDate(value(row, 'admissionDate')) }}</td><td class="px-5 py-3"><span class="rounded-full bg-indigo-50 px-2.5 py-1 font-semibold text-indigo-700 dark:bg-indigo-500/10 dark:text-indigo-300">{{ bool(row, 'isPreClassStudent') ? 'Pre-class' : 'Other' }}</span></td></tr></tbody></table></div>
        </section>
        <section class="overflow-hidden rounded-2xl border border-slate-200/80 bg-white shadow-sm dark:border-slate-700/70 dark:bg-slate-800"><div class="border-b border-slate-100 p-5 dark:border-slate-700/70"><h4 class="text-sm font-bold text-slate-900 dark:text-white"><i class="bi bi-clipboard-check text-violet-500"></i> Recent Assessments</h4><p class="mt-0.5 text-xs text-slate-500 dark:text-slate-400">Latest non-canceled assigned dates</p></div><div v-if="isLoading && !results.length" class="p-10 text-center text-xs text-slate-400">Loading assessments…</div><div v-else-if="hasIssue('Results')" class="p-10 text-center text-xs text-slate-400">Could not load results.</div><div v-else-if="!recentResults.length" class="p-10 text-center text-xs text-slate-400">No assessments found.</div><ul v-else class="divide-y divide-slate-100 dark:divide-slate-700/60"><li v-for="(row, i) in recentResults" :key="value(row, 'id') || i" class="flex items-center justify-between gap-3 px-5 py-3"><span class="min-w-0"><span class="block truncate text-xs font-semibold text-slate-700 dark:text-slate-200">{{ value(row, 'subjectName') || '—' }}</span><span class="text-[11px] text-slate-400">{{ className(row) }} · {{ typeLabel(value(row, 'type')) }}</span></span><span class="shrink-0 text-xs text-slate-400">{{ formatDate(value(row, 'assignedDate')) }}</span></li></ul></section>
    </div>
    <section class="overflow-hidden rounded-2xl border border-slate-200/80 bg-white shadow-sm dark:border-slate-700/70 dark:bg-slate-800"><div class="border-b border-slate-100 p-5 dark:border-slate-700/70"><h4 class="text-sm font-bold text-slate-900 dark:text-white"><i class="bi bi-receipt text-emerald-500"></i> Recent Payments</h4><p class="mt-0.5 text-xs text-slate-500 dark:text-slate-400">Non-canceled payment records by payment date</p></div><div class="school-scroll overflow-x-auto"><table class="w-full min-w-[760px] text-left text-xs"><thead class="bg-slate-50 text-[11px] uppercase tracking-wider text-slate-500 dark:bg-slate-900 dark:text-slate-400"><tr><th class="px-5 py-3">Receipt / reference</th><th class="px-5 py-3">Student</th><th class="px-5 py-3">Class</th><th class="px-5 py-3">Date</th><th class="px-5 py-3">Currency</th><th class="px-5 py-3">Status</th><th class="px-5 py-3 text-right">Amount</th></tr></thead><tbody class="divide-y divide-slate-100 dark:divide-slate-700/60"><tr v-if="isLoading && !payments.length"><td colspan="7" class="px-5 py-10 text-center text-slate-400">Loading payments…</td></tr><tr v-else-if="hasIssue('Payments')"><td colspan="7" class="px-5 py-10 text-center text-slate-400">Could not load payments.</td></tr><tr v-else-if="!recentPayments.length"><td colspan="7" class="px-5 py-10 text-center text-slate-400">No payments found.</td></tr><tr v-for="(row, i) in recentPayments" :key="value(row, 'id') || i" class="hover:bg-slate-50 dark:hover:bg-slate-700/40"><td class="px-5 py-3 font-semibold text-slate-800 dark:text-slate-100">{{ value(row, 'receiptNumber') || value(row, 'referenceNumber') || '—' }}</td><td class="px-5 py-3 text-slate-500">{{ studentName(row) }}</td><td class="px-5 py-3 text-slate-500">{{ className(row) }}</td><td class="px-5 py-3 text-slate-500">{{ formatDate(value(row, 'paymentDate')) }}</td><td class="px-5 py-3 text-slate-500">{{ currencyName(currencyId(row)) }}</td><td class="px-5 py-3"><span class="rounded-full bg-slate-100 px-2.5 py-1 font-semibold text-slate-600 dark:bg-slate-700 dark:text-slate-300">{{ bool(row, 'isPosted') ? 'Posted' : 'Unposted' }}</span></td><td class="px-5 py-3 text-right font-bold tabular-nums text-slate-800 dark:text-slate-100">{{ formatAmount(value(row, 'amountToPaid')) }}</td></tr></tbody></table></div></section>
</div>
<script src="~/js/school-manager/dashboard.js" asp-append-version="true"></script>
