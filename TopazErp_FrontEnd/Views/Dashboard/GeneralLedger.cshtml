@{
    ViewBag.Title = "Dashboard | General Ledger";
    Layout = "~/Views/Shared/_adminLedgerLayout.cshtml";
}

<div class="content" id="app">
    <!-- Page Header & Breadcrumbs -->
    <div class="mb-6 content-header">
        <div class="flex items-center gap-2 text-sm text-gray-500 mb-2">
            <span>GL</span>
            <i class="bi bi-chevron-right text-xs"></i>
            <span class="text-blue-600 font-medium">Dashboard</span>
        </div>

        <div class="flex flex-wrap items-center justify-between gap-4">
            <div class="page-title">
                <h2 class="text-2xl font-bold tracking-tight text-gray-900 dark:text-white">
                    General Ledger Dashboard
                </h2>
                <p class="mt-1 text-sm text-gray-500 dark:text-gray-400">
                    Financial control center — journals, vouchers, payables and chart of accounts at a glance.
                </p>
            </div>

            <div class="flex items-center gap-2.5">
                <span v-if="periodLabel"
                      class="inline-flex items-center gap-1.5 rounded-lg border border-gray-200 bg-white px-3 py-2 text-xs font-semibold text-gray-600 shadow-sm dark:border-slate-700 dark:bg-slate-800 dark:text-gray-300">
                    <i class="bi bi-calendar3 text-blue-500"></i>
                    <span>{{ periodLabel }}</span>
                </span>
                <button type="button"
                        @@click="loadData"
                        :disabled="isLoading"
                        class="inline-flex items-center gap-2 rounded-lg bg-blue-600 px-4 py-2.5 text-sm font-semibold text-white shadow-sm hover:bg-blue-700 transition disabled:cursor-not-allowed disabled:opacity-60">
                    <i class="bi" :class="isLoading ? 'bi-arrow-repeat animate-spin' : 'bi-arrow-clockwise'"></i>
                    <span>{{ isLoading ? 'Loading...' : 'Refresh' }}</span>
                </button>
            </div>
        </div>
    </div>

    <!-- Quick Actions -->
    <div class="card mb-6" data-card-title="Quick Actions">
        <div class="flex flex-wrap items-center gap-2.5 p-4">
            <a href="/GeneralLedger/CreateJournal"
               class="inline-flex items-center gap-2 rounded-lg border border-blue-200 bg-blue-50 px-3.5 py-2 text-xs font-semibold text-blue-700 hover:bg-blue-100 transition dark:border-slate-700 dark:bg-slate-800 dark:text-blue-400 dark:hover:bg-slate-700">
                <i class="bi bi-journal-plus"></i> New Journal
            </a>
            <a href="/GeneralLedger/SupplierPaymentVoucher"
               class="inline-flex items-center gap-2 rounded-lg border border-emerald-200 bg-emerald-50 px-3.5 py-2 text-xs font-semibold text-emerald-700 hover:bg-emerald-100 transition dark:border-slate-700 dark:bg-slate-800 dark:text-emerald-400 dark:hover:bg-slate-700">
                <i class="bi bi-cash-stack"></i> Supplier Payment Voucher
            </a>
            <a href="/GeneralLedger/JournalHistory"
               class="inline-flex items-center gap-2 rounded-lg border border-slate-200 bg-white px-3.5 py-2 text-xs font-semibold text-slate-600 hover:bg-slate-50 transition dark:border-slate-700 dark:bg-slate-800 dark:text-slate-300 dark:hover:bg-slate-700">
                <i class="bi bi-clock-history"></i> Journal History
            </a>
            <a href="/GeneralLedger/VoucherHistory"
               class="inline-flex items-center gap-2 rounded-lg border border-slate-200 bg-white px-3.5 py-2 text-xs font-semibold text-slate-600 hover:bg-slate-50 transition dark:border-slate-700 dark:bg-slate-800 dark:text-slate-300 dark:hover:bg-slate-700">
                <i class="bi bi-receipt"></i> Voucher History
            </a>
            <a href="/GeneralLedger/CoaDetails"
               class="inline-flex items-center gap-2 rounded-lg border border-slate-200 bg-white px-3.5 py-2 text-xs font-semibold text-slate-600 hover:bg-slate-50 transition dark:border-slate-700 dark:bg-slate-800 dark:text-slate-300 dark:hover:bg-slate-700">
                <i class="bi bi-diagram-3"></i> Chart of Accounts
            </a>
            <a href="/GeneralLedger/Suppliers"
               class="inline-flex items-center gap-2 rounded-lg border border-slate-200 bg-white px-3.5 py-2 text-xs font-semibold text-slate-600 hover:bg-slate-50 transition dark:border-slate-700 dark:bg-slate-800 dark:text-slate-300 dark:hover:bg-slate-700">
                <i class="bi bi-truck"></i> Suppliers
            </a>
        </div>
    </div>

    <!-- KPI Cards -->
    <div class="mb-6 grid grid-cols-1 gap-4 sm:grid-cols-2 xl:grid-cols-4">
        <!-- GL Accounts -->
        <div class="card flex items-center gap-4 p-5">
            <div class="flex h-12 w-12 shrink-0 items-center justify-center rounded-xl bg-indigo-50 text-indigo-600 dark:bg-indigo-900/30 dark:text-indigo-400">
                <i class="bi bi-journal-bookmark-fill text-2xl"></i>
            </div>
            <div class="min-w-0">
                <p class="text-xs font-medium uppercase tracking-wider text-gray-500 dark:text-gray-400">Active GL Accounts</p>
                <h3 v-if="!isLoading" class="text-2xl font-bold text-gray-900 dark:text-white">{{ formatInt(accountCount) }}</h3>
                <div v-else class="h-8 w-20 animate-pulse rounded bg-slate-200 dark:bg-slate-700"></div>
                <p class="mt-0.5 text-xs text-gray-400">Posted to the chart of accounts</p>
            </div>
        </div>

        <!-- Journal Batches -->
        <div class="card flex items-center gap-4 p-5">
            <div class="flex h-12 w-12 shrink-0 items-center justify-center rounded-xl bg-blue-50 text-blue-600 dark:bg-blue-900/30 dark:text-blue-400">
                <i class="bi bi-journal-text text-2xl"></i>
            </div>
            <div class="min-w-0">
                <p class="text-xs font-medium uppercase tracking-wider text-gray-500 dark:text-gray-400">Journal Batches</p>
                <h3 v-if="!isLoading" class="text-2xl font-bold text-gray-900 dark:text-white">{{ formatInt(journalHeaders.length) }}</h3>
                <div v-else class="h-8 w-20 animate-pulse rounded bg-slate-200 dark:bg-slate-700"></div>
                <p v-if="!isLoading" class="mt-0.5 text-xs">
                    <span class="font-semibold text-emerald-600 dark:text-emerald-400">{{ postedCount }} posted</span>
                    <span class="text-gray-400"> · </span>
                    <span class="font-semibold text-amber-600 dark:text-amber-400">{{ pendingCount }} pending</span>
                </p>
            </div>
        </div>

        <!-- Vouchers (30 days) -->
        <div class="card flex items-center gap-4 p-5">
            <div class="flex h-12 w-12 shrink-0 items-center justify-center rounded-xl bg-emerald-50 text-emerald-600 dark:bg-emerald-900/30 dark:text-emerald-400">
                <i class="bi bi-credit-card-2-front text-2xl"></i>
            </div>
            <div class="min-w-0">
                <p class="text-xs font-medium uppercase tracking-wider text-gray-500 dark:text-gray-400">Vouchers · Last 30 Days</p>
                <h3 v-if="!isLoading" class="text-2xl font-bold text-gray-900 dark:text-white">{{ formatInt(voucherTotalCount) }}</h3>
                <div v-else class="h-8 w-20 animate-pulse rounded bg-slate-200 dark:bg-slate-700"></div>
                <p v-if="!isLoading" class="mt-0.5 text-xs font-mono font-semibold text-gray-600 dark:text-gray-300">
                    GHS {{ formatNumber(voucherTotalValue) }}
                </p>
            </div>
        </div>

        <!-- Payables -->
        <div class="card flex items-center gap-4 p-5">
            <div class="flex h-12 w-12 shrink-0 items-center justify-center rounded-xl bg-amber-50 text-amber-600 dark:bg-amber-900/30 dark:text-amber-400">
                <i class="bi bi-cash-coin text-2xl"></i>
            </div>
            <div class="min-w-0">
                <p class="text-xs font-medium uppercase tracking-wider text-gray-500 dark:text-gray-400">Total Payables</p>
                <h3 v-if="!isLoading" class="text-xl font-bold font-mono text-gray-900 dark:text-white">{{ formatNumber(payables.totalBalance || 0) }}</h3>
                <div v-else class="h-8 w-28 animate-pulse rounded bg-slate-200 dark:bg-slate-700"></div>
                <p v-if="!isLoading" class="mt-0.5 text-xs text-gray-400">
                    {{ payables.activeSupplierCount || 0 }} active of {{ payables.supplierCount || 0 }} suppliers
                </p>
            </div>
        </div>
    </div>

    <!-- Charts Row -->
    <div class="mb-6 grid grid-cols-1 gap-4 xl:grid-cols-3">
        <!-- Journal value by month -->
        <div class="card xl:col-span-2" data-card-title="Journal Value by Month">
            <div class="border-b border-gray-100 px-5 py-4 dark:border-slate-800">
                <h4 class="text-sm font-bold text-gray-900 dark:text-white">Journal Value by Month</h4>
                <p class="mt-0.5 text-xs text-gray-500 dark:text-gray-400">Total debits booked per month — last 6 months</p>
            </div>
            <div class="h-[290px] p-4">
                <canvas id="journalChart" v-show="!isLoading && journalHeaders.length"></canvas>
                <div v-if="!isLoading && !journalHeaders.length"
                     class="flex h-full flex-col items-center justify-center text-gray-400">
                    <i class="bi bi-journal-x text-4xl mb-2"></i>
                    <span class="text-sm">No journal activity in this period</span>
                </div>
            </div>
        </div>

        <!-- Voucher mix -->
        <div class="card" data-card-title="Voucher Activity">
            <div class="border-b border-gray-100 px-5 py-4 dark:border-slate-800">
                <h4 class="text-sm font-bold text-gray-900 dark:text-white">Voucher Activity</h4>
                <p class="mt-0.5 text-xs text-gray-500 dark:text-gray-400">Last 30 days · by type</p>
            </div>
            <div class="h-[290px] p-4">
                <canvas id="voucherChart" v-show="!isLoading && voucherTotalCount"></canvas>
                <div v-if="!isLoading && !voucherTotalCount"
                     class="flex h-full flex-col items-center justify-center text-gray-400">
                    <i class="bi bi-credit-card text-4xl mb-2"></i>
                    <span class="text-sm">No vouchers in the last 30 days</span>
                </div>
            </div>
        </div>
    </div>

    <!-- Tables Row -->
    <div class="grid grid-cols-1 gap-4 xl:grid-cols-3">
        <!-- Recent journal batches -->
        <div class="card xl:col-span-2" data-card-title="Recent Journal Batches">
            <div class="flex items-center justify-between border-b border-gray-100 px-5 py-4 dark:border-slate-800">
                <div>
                    <h4 class="text-sm font-bold text-gray-900 dark:text-white">Recent Journal Batches</h4>
                    <p class="mt-0.5 text-xs text-gray-500 dark:text-gray-400">Latest entries across all sources</p>
                </div>
                <a href="/GeneralLedger/JournalHistory"
                   class="text-xs font-semibold text-blue-600 hover:text-blue-700 dark:text-blue-400">
                    View all <i class="bi bi-arrow-right"></i>
                </a>
            </div>

            <div class="max-h-[340px] overflow-auto">
                <table class="w-full min-w-[640px] text-left text-xs">
                    <thead class="sticky top-0 z-10 bg-slate-100 text-[11px] uppercase tracking-wide text-slate-500 dark:bg-slate-800 dark:text-slate-400">
                        <tr>
                            <th class="whitespace-nowrap px-5 py-3 font-semibold">Batch No</th>
                            <th class="whitespace-nowrap px-5 py-3 font-semibold">Date</th>
                            <th class="whitespace-nowrap px-5 py-3 font-semibold">Description</th>
                            <th class="whitespace-nowrap px-5 py-3 font-semibold">Source</th>
                            <th class="whitespace-nowrap px-5 py-3 font-semibold">Status</th>
                            <th class="whitespace-nowrap px-5 py-3 text-right font-semibold">Debit (GHS)</th>
                        </tr>
                    </thead>
                    <tbody v-if="recentJournals.length" class="divide-y divide-gray-100 dark:divide-slate-800">
                        <tr v-for="j in recentJournals" :key="j.id"
                            class="transition-colors hover:bg-slate-50 dark:hover:bg-slate-800/60">
                            <td class="whitespace-nowrap px-5 py-3">
                                <span class="rounded bg-slate-100 px-2 py-0.5 font-mono text-xs font-semibold text-slate-700 dark:bg-slate-800 dark:text-slate-300">{{ j.batchNumber || '—' }}</span>
                            </td>
                            <td class="whitespace-nowrap px-5 py-3 font-mono text-slate-600 dark:text-slate-300">{{ formatDate(j.batchDate) }}</td>
                            <td class="max-w-[260px] truncate px-5 py-3 text-slate-700 dark:text-slate-200" :title="j.batchDescription">{{ j.batchDescription || '—' }}</td>
                            <td class="whitespace-nowrap px-5 py-3">
                                <span class="rounded-full bg-slate-100 px-2 py-0.5 text-[11px] font-semibold text-slate-600 dark:bg-slate-800 dark:text-slate-300">{{ j.transactionSource || 'GL' }}</span>
                            </td>
                            <td class="whitespace-nowrap px-5 py-3">
                                <span v-if="j.isPosted"
                                      class="inline-flex items-center gap-1 rounded-full bg-emerald-50 px-2 py-0.5 text-[11px] font-semibold text-emerald-700 ring-1 ring-inset ring-emerald-600/20 dark:bg-emerald-950/40 dark:text-emerald-300">
                                    <i class="bi bi-check-circle-fill"></i> Posted
                                </span>
                                <span v-else
                                      class="inline-flex items-center gap-1 rounded-full bg-amber-50 px-2 py-0.5 text-[11px] font-semibold text-amber-700 ring-1 ring-inset ring-amber-600/20 dark:bg-amber-950/40 dark:text-amber-300">
                                    <i class="bi bi-hourglass-split"></i> Pending
                                </span>
                            </td>
                            <td class="whitespace-nowrap px-5 py-3 text-right font-mono font-semibold text-slate-800 dark:text-slate-100">{{ formatNumber(j.totalDebit) }}</td>
                        </tr>
                    </tbody>
                    <tbody v-else>
                        <tr>
                            <td colspan="6" class="px-5 py-10 text-center text-gray-400">
                                <i class="bi bi-inbox block text-3xl mb-2"></i>
                                {{ isLoading ? 'Loading journal batches…' : 'No journal batches found' }}
                            </td>
                        </tr>
                    </tbody>
                </table>
            </div>
        </div>

        <!-- Top payables -->
        <div class="card" data-card-title="Top Supplier Balances">
            <div class="border-b border-gray-100 px-5 py-4 dark:border-slate-800">
                <h4 class="text-sm font-bold text-gray-900 dark:text-white">Top Supplier Balances</h4>
                <p class="mt-0.5 text-xs text-gray-500 dark:text-gray-400">Largest accounts payable positions</p>
            </div>

            <div class="p-5">
                <div v-if="isLoading" class="space-y-4">
                    <div v-for="n in 5" :key="n" class="h-12 animate-pulse rounded-lg bg-slate-200 dark:bg-slate-700"></div>
                </div>

                <div v-else-if="payables.topSuppliers && payables.topSuppliers.length" class="space-y-4">
                    <div v-for="(s, i) in payables.topSuppliers" :key="s.id || i">
                        <div class="mb-1 flex items-center justify-between gap-3">
                            <div class="flex min-w-0 items-center gap-2">
                                <span class="flex h-5 w-5 shrink-0 items-center justify-center rounded-full text-[10px] font-bold"
                                      :class="i === 0 ? 'bg-blue-600 text-white' : 'bg-slate-200 text-slate-600 dark:bg-slate-700 dark:text-slate-300'">
                                    {{ i + 1 }}
                                </span>
                                <span class="truncate text-xs font-semibold text-slate-700 dark:text-slate-200" :title="s.name">{{ s.name }}</span>
                            </div>
                            <span class="shrink-0 font-mono text-xs font-bold text-slate-800 dark:text-slate-100">{{ formatNumber(s.balance) }}</span>
                        </div>
                        <div class="h-1.5 w-full overflow-hidden rounded-full bg-slate-100 dark:bg-slate-800">
                            <div class="h-full rounded-full bg-gradient-to-r from-blue-500 to-indigo-500 transition-all duration-500"
                                 :style="{ width: topBalanceBar(s.balance) }"></div>
                        </div>
                    </div>
                </div>

                <div v-else class="flex flex-col items-center justify-center py-8 text-gray-400">
                    <i class="bi bi-cash-stack text-3xl mb-2"></i>
                    <span class="text-sm">No supplier balances</span>
                </div>
            </div>
        </div>
    </div>
</div>

<script src="~/js/gl/dashboard.js" asp-append-version="true"></script>
